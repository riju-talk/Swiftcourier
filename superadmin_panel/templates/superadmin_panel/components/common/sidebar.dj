{% load static %}

<div :class="{ 'dark text-white-dark': $store.app.semidark }">
    <nav x-data="sidebar"
         class="sidebar fixed min-h-screen h-full top-0 bottom-0 w-[260px] shadow-[5px_0_25px_0_rgba(94,92,154,0.1)] z-50 transition-all duration-300">
        <div class="bg-white dark:bg-black h-full">
            <div class="flex justify-between items-center px-4 py-3">
                <a href="/"
                   class="main-logo flex items-center shrink-0 gap-2">
                    <span class="flex h-8 w-8 flex-none items-center justify-center rounded-lg bg-black text-sm font-extrabold text-white dark:bg-white dark:text-black">S</span>
                    <span class="text-2xl font-extrabold tracking-tight align-middle lg:inline text-black dark:text-white">Swift<span class="text-red-600">Courier</span></span>
                </a>
                <a href="javascript:;"
                   class="collapse-icon w-8 h-8 rounded-full flex items-center hover:bg-gray-500/10 dark:hover:bg-dark-light/10 dark:text-white-light transition duration-300 rtl:rotate-180"
                   @click="$store.app.toggleSidebar()">
                    <svg class="w-5 h-5 m-auto"
                         width="20"
                         height="20"
                         viewBox="0 0 24 24"
                         fill="none"
                         xmlns="http://www.w3.org/2000/svg">
                        <path d="M13 19L7 12L13 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                        <path opacity="0.5" d="M16.9998 19L10.9998 12L16.9998 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                </a>
            </div>
            <ul class="perfect-scrollbar relative font-semibold space-y-0.5 h-[calc(100vh-80px)] overflow-y-auto overflow-x-hidden p-4 py-0"
                x-data="{ activeDropdown: null }">
                <li class="menu nav-item">
                    <a href="{% url 'superadmin_panel:dashboard' %}" class="nav-link group">
                        <div class="flex items-center">
                            <svg class="group-hover:text-primary! shrink-0"
                                 width="20"
                                 height="20"
                                 viewBox="0 0 24 24"
                                 fill="none"
                                 xmlns="http://www.w3.org/2000/svg">
                                <path opacity="0.5" d="M2 12.2039C2 9.91549 2 8.77128 2.5192 7.82274C3.0384 6.87421 3.98695 6.28551 5.88403 5.10813L7.88403 3.86687C9.88939 2.62229 10.8921 2 12 2C13.1079 2 14.1106 2.62229 16.116 3.86687L18.116 5.10812C20.0131 6.28551 20.9616 6.87421 21.4808 7.82274C22 8.77128 22 9.91549 22 12.2039V13.725C22 17.6258 22 19.5763 20.8284 20.7881C19.6569 22 17.7712 22 14 22H10C6.22876 22 4.34315 22 3.17157 20.7881C2 19.5763 2 17.6258 2 13.725V12.2039Z" fill="currentColor" />
                                <path d="M9 17.25C8.58579 17.25 8.25 17.5858 8.25 18C8.25 18.4142 8.58579 18.75 9 18.75H15C15.4142 18.75 15.75 18.4142 15.75 18C15.75 17.5858 15.4142 17.25 15 17.25H9Z" fill="currentColor" />
                            </svg>
                            <span class="ltr:pl-3 rtl:pr-3 text-black dark:text-[#506690] dark:group-hover:text-white-dark">Dashboard</span>
                        </div>
                    </a>
                </li>

                <h2 class="mt-4 mb-1 px-3 flex items-center text-[11px] font-bold uppercase tracking-[0.15em] text-neutral-400 dark:text-neutral-500">

                    <svg class="w-4 h-5 flex-none hidden"
                         viewBox="0 0 24 24"
                         stroke="currentColor"
                         stroke-width="1.5"
                         fill="none"
                         stroke-linecap="round"
                         stroke-linejoin="round">
                        <line x1="5" y1="12" x2="19" y2="12"></line>
                    </svg>
                    <span>Courier Management</span>
                </h2>

                <li class="nav-item">
                    <ul>

                        <li class="menu nav-item">
                            <button type="button"
                                    class="nav-link group"
                                    :class="{ 'active': activeDropdown === 'courier-settings' }"
                                    @click="activeDropdown === 'courier-settings' ? activeDropdown = null : activeDropdown = 'courier-settings'">
                                <div class="flex items-center">
                                    <svg class="group-hover:text-primary! shrink-0"
                                         width="20"
                                         height="20"
                                         viewBox="0 0 32 32"
                                         fill="none"
                                         xmlns="http://www.w3.org/2000/svg">
                                        <g>
                                        <path d="M31.01,9c0,0.55-0.45,1-1,1c0,0-0.01,0-0.02,0h-28C1.63,10,1.3,9.81,1.12,9.5c-0.17-0.31-0.17-0.69,0-1 l4-7C5.3,1.19,5.63,1,5.99,1h20c0.36,0,0.69,0.19,0.87,0.5l3.91,6.85C30.92,8.53,31.01,8.75,31.01,9z" fill="currentColor" opacity="0.5" />
                                        <path d="M30.99,9v21c0,0.55-0.45,1-1,1h-28c-0.55,0-1-0.45-1-1V9H30.99z" fill="currentColor" opacity="0.5" />
                                        <rect height="8" width="2" x="15" y="1" fill="currentColor" />
                                        <path d="M21.063,27H10.937c-0.5522,0-1-0.4478-1-1s0.4478-1,1-1h10.126c0.5522,0,1,0.4478,1,1 S21.6152,27,21.063,27z" fill="currentColor" />
                                        </g>
                                    </svg>


                                    <span class="ltr:pl-3 rtl:pr-3 text-black dark:text-[#506690] dark:group-hover:text-white-dark">Courier Settings</span>
                                </div>
                                <div class="rtl:rotate-180"
                                     :class="{ 'rotate-90!': activeDropdown === 'courier-settings' }">

                                    <svg width="16"
                                         height="16"
                                         viewBox="0 0 24 24"
                                         fill="none"
                                         xmlns="http://www.w3.org/2000/svg">
                                        <path d="M9 5L15 12L9 19" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                                    </svg>
                                </div>
                            </button>
                            <ul x-cloak
                                x-show="activeDropdown === 'courier-settings'"
                                x-collapse
                                class="sub-menu text-gray-500">
                                <li>
                                    <a href="{% url 'superadmin_panel:api-integration' %}">API Integration</a>
                                </li>
                                <li>
                                    <a href="{% url 'superadmin_panel:rate-card' %}">Rate Card</a>
                                </li>
                                <li>
                                    <a href="{% url 'superadmin_panel:send_notification' %}">Send Notification</a>
                                </li>
                                {% comment %} <li>
                                    <a href="{% url 'user_panel:failed-order' %}">Default Commercials</a>
                                </li> {% endcomment %}
                            </ul>
                        </li>
                    </ul>
                </li>

                <h2 class="mt-4 mb-1 px-3 flex items-center text-[11px] font-bold uppercase tracking-[0.15em] text-neutral-400 dark:text-neutral-500">

                    <svg class="w-4 h-5 flex-none hidden"
                         viewBox="0 0 24 24"
                         stroke="currentColor"
                         stroke-width="1.5"
                         fill="none"
                         stroke-linecap="round"
                         stroke-linejoin="round">
                        <line x1="5" y1="12" x2="19" y2="12"></line>
                    </svg>
                    <span>Admin</span>
                </h2>

                <li class="menu nav-item">
                    <button type="button"
                            class="nav-link group"
                            :class="{ 'active': activeDropdown === 'admin-dropdown' }"
                            @click="activeDropdown === 'admin-dropdown' ? activeDropdown = null : activeDropdown = 'admin-dropdown'">
                        <div class="flex items-center">
                            <svg class="shrink-0 w-5 h-5 group-hover:text-primary! transition duration-300 ease-in-out"
                                 version="1.1"
                                 xmlns="http://www.w3.org/2000/svg"
                                 xmlns:xlink="http://www.w3.org/1999/xlink"
                                 viewBox="0 0 511.992 511.992"
                                 fill="currentColor">
                                <path style="fill:currentColor;" d="M460.207,386.351l-1.812-0.531c-26.467-7.109-35.42-13.938-47.201-18.406 c-41.811-15.937-52.686-27.405-55.467-32.826c-0.094-0.203-0.172-0.406-0.266-0.609l-0.344-48.546l-99.122-1.126l-99.122,1.125 l-0.344,48.546c-0.094,0.203-0.172,0.406-0.281,0.609c-2.781,5.421-13.656,16.89-55.451,32.826 c-11.781,4.469-20.734,11.297-47.202,18.406l-1.812,0.531c-24.093,7.969-40.311,30.312-40.311,55.529v70.107h244.523H500.52v-70.107 C500.519,416.663,484.301,394.32,460.207,386.351z" />
                                <polygon style="fill:currentColor;" points="305.212,511.988 208.246,511.988 221.902,415.991 289.775,415.991 " />
                                <polygon style="fill:currentColor;" points="289.932,415.991 222.058,415.991 202.668,309.322 309.321,309.322 " />
                                <polygon style="fill:#F5F7FA;" points="202.137,394.758 252.464,354.649 156.685,291.542 156.247,334.588 " />
                                <polygon style="fill:#F5F7FA;" points="309.743,394.758 259.416,354.649 355.195,291.542 355.633,334.588 " />
                                <path style="fill:currentColor;" d="M393.537,191.482c0,89.372-85.2,171.619-137.542,171.619s-137.543-82.247-137.543-171.619 c0-89.373,61.577-148.34,137.543-148.34S393.537,102.11,393.537,191.482z" />
                                <path style="fill:currentColor;" d="M341.086,28.409c-23.39-21.187-104.653-51.624-180.026,0 c-59.436,40.702-53.436,143.371-53.436,143.371s77.998,19.703,167.323-31.327c57.748-32.999,77.873,0.562,88.232,29.765 c10.062,28.452,30.357,21.265,30.357,21.265S415.943,96.172,341.086,28.409z" />
                                <path style="fill:currentColor;" d="M316.884,126.812c8.108,0,14.89,2.093,20.593,5.578c11.125-44.28,36.155-51.577,42.077-52.686 c-3.047-6.375-6.625-12.765-10.78-19.093C354.273,65.548,328.586,80.704,316.884,126.812z" />
                                <rect x="320.805" y="447.994" style="fill:#F5F7FA;" width="106.65" height="63.998" />
                                <path style="fill:currentColor;" d="M384.804,437.318h-21.343c-5.891,0-10.656,4.781-10.656,10.672s4.766,10.656,10.656,10.656h21.343 c5.874,0,10.655-4.766,10.655-10.656S390.678,437.318,384.804,437.318z" />
                            </svg>

                            <span class="ltr:pl-3 rtl:pr-3 text-black dark:text-[#506690] dark:group-hover:text-white-dark">All About Admins</span>
                        </div>
                        <div class="rtl:rotate-180"
                             :class="{ 'rotate-90!': activeDropdown === 'admin-dropdown' }">
                            <svg width="16"
                                 height="16"
                                 viewBox="0 0 24 24"
                                 fill="none"
                                 xmlns="http://www.w3.org/2000/svg">
                                <path d="M9 5L15 12L9 19" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                            </svg>
                        </div>
                    </button>
                    <ul x-cloak
                        x-show="activeDropdown === 'admin-dropdown'"
                        x-collapse
                        class="sub-menu text-gray-500">
                        <li>
                            <a href="{% url 'superadmin_panel:list-admin' %}">Admin Lists</a>
                        </li>
                        <li>
                            <a href="{% url 'superadmin_panel:add-admin' %}">Add Admin </a>
                        </li>
                    </ul>
                </li>

                <h2 class="mt-4 mb-1 px-3 flex items-center text-[11px] font-bold uppercase tracking-[0.15em] text-neutral-400 dark:text-neutral-500">
                    <svg class="w-4 h-5 flex-none hidden"
                         viewBox="0 0 24 24"
                         stroke="currentColor"
                         stroke-width="1.5"
                         fill="none"
                         stroke-linecap="round"
                         stroke-linejoin="round">
                        <line x1="5" y1="12" x2="19" y2="12"></line>
                    </svg>
                    <span>Client</span>

                </h2>
                <li class="menu nav-item">
                    <button type="button"
                            class="nav-link group"
                            :class="{ 'active': activeDropdown === 'client' }"
                            @click="activeDropdown === 'client' ? activeDropdown = null : activeDropdown = 'client'">
                        <div class="flex items-center">
                            <svg class="group-hover:text-primary! shrink-0"
                                 width="20"
                                 height="20"
                                 viewBox="0 0 1024 1024"
                                 fill="none"
                                 xmlns="http://www.w3.org/2000/svg">
                                <path d="M512 505.6c-108.8 0-204.8-89.6-204.8-204.8S396.8 102.4 512 102.4c108.8 0 204.8 89.6 204.8 204.8S620.8 505.6 512 505.6z m0-358.4c-83.2 0-153.6 70.4-153.6 153.6s64 153.6 153.6 153.6 153.6-70.4 153.6-153.6S595.2 147.2 512 147.2z" fill="currentColor" />
                                <path d="M832 864c0-211.2-147.2-377.6-326.4-377.6s-326.4 166.4-326.4 377.6H832z" fill="currentColor" />
                                <path d="M832 889.6H147.2v-25.6c0-224 160-403.2 352-403.2s352 179.2 352 396.8v25.6l-19.2 6.4z m-633.6-51.2h608C800 659.2 665.6 512 505.6 512c-166.4 0-294.4 147.2-307.2 326.4zM710.4 499.2c-12.8 0-25.6-12.8-25.6-25.6s12.8-25.6 25.6-25.6c64 0 121.6-51.2 121.6-121.6 0-51.2-32-96-83.2-115.2-12.8-6.4-19.2-19.2-12.8-32 6.4-12.8 19.2-19.2 32-12.8 70.4 19.2 115.2 83.2 115.2 160-6.4 96-83.2 172.8-172.8 172.8z" fill="currentColor" />
                                <path d="M966.4 806.4h-57.6c-12.8 0-25.6-12.8-25.6-25.6s12.8-25.6 25.6-25.6h32c-12.8-140.8-115.2-249.6-236.8-249.6-12.8 0-25.6-12.8-25.6-25.6s12.8-25.6 25.6-25.6c160 0 288 147.2 288 326.4v25.6h-25.6z" fill="currentColor" />
                                <path d="M300.8 499.2c-6.4 0-6.4 0 0 0-44.8 0-89.6-12.8-121.6-44.8-32-32-44.8-76.8-44.8-121.6 0-70.4 44.8-134.4 115.2-160 12.8-6.4 25.6 0 32 12.8 6.4 12.8 0 25.6-12.8 32-57.6 19.2-89.6 64-89.6 115.2 0 32 12.8 64 32 83.2 19.2 25.6 51.2 32 83.2 38.4 19.2 0 25.6 12.8 25.6 25.6s-6.4 19.2-19.2 19.2z" fill="currentColor" />
                                <path d="M89.6 806.4H12.8v-25.6c0-179.2 128-320 288-320 12.8 0 25.6 12.8 25.6 25.6s-12.8 25.6-25.6 25.6C179.2 512 76.8 620.8 64 761.6h32c12.8 0 25.6 12.8 25.6 25.6-6.4 6.4-12.8 19.2-32 19.2z" fill="currentColor" />
                            </svg>

                            <span class="ltr:pl-3 rtl:pr-3 text-black dark:text-[#506690] dark:group-hover:text-white-dark">Client</span>
                        </div>
                        <div class="rtl:rotate-180"
                             :class="{ 'rotate-90!': activeDropdown === 'client' }">
                            <svg width="16"
                                 height="16"
                                 viewBox="0 0 24 24"
                                 fill="none"
                                 xmlns="http://www.w3.org/2000/svg">
                                <path d="M9 5L15 12L9 19" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                            </svg>
                        </div>
                    </button>
                    <ul x-cloak
                        x-show="activeDropdown === 'client'"
                        x-collapse
                        class="sub-menu text-gray-500">
                        <li>
                            <a href="{% url 'superadmin_panel:all-client' %}">Client Details</a>
                        </li>
                        {% comment %} <li>
                            <a href="{% url 'superadmin_panel:assign-admin' %}">Assign Admin</a>
                        </li> {% endcomment %}
                    </ul>
                </li>

                <h2 class="mt-4 mb-1 px-3 flex items-center text-[11px] font-bold uppercase tracking-[0.15em] text-neutral-400 dark:text-neutral-500">
                    <span>Pincode</span>
                </h2>
                <li class="menu nav-item">
                    <a href="{% url 'superadmin_panel:manage_pincode' %}" class="nav-link group">
                        <div class="flex items-center">
                            <svg class="group-hover:text-primary! shrink-0"
                                 width="20"
                                 height="20"
                                 viewBox="0 0 24 24"
                                 fill="none"
                                 xmlns="http://www.w3.org/2000/svg">
                                <g id="style=bulk">
                                <g id="location">
                                <path id="vector (Stroke)" fill-rule="evenodd" clip-rule="evenodd" d="M8.9461 21.1315L8.89129 21.0787L8.89035 21.0778C8.81273 21.0023 8.73386 20.9254 8.65394 20.8471C7.2824 19.5029 5.57222 17.7231 4.34999 15.6268C3.12314 13.5227 2.35382 11.04 2.96276 8.32592C5.09133 -1.11519 18.9197 -1.10413 21.0372 8.33595C21.6639 11.1292 20.831 13.6741 19.5403 15.8149C18.2545 17.9477 16.4747 19.7455 15.0992 21.0783C14.0956 22.0555 13.1259 22.7323 12.0296 22.7449C10.9283 22.7576 9.95462 22.098 8.95039 21.1357L8.9461 21.1315Z" fill="currentColor" opacity="0.5" />
                                <path id="ellipse (Stroke)" fill-rule="evenodd" clip-rule="evenodd" d="M8.75 9.5C8.75 7.70507 10.2051 6.25 12 6.25C13.7949 6.25 15.25 7.70507 15.25 9.5C15.25 11.2949 13.7949 12.75 12 12.75C10.2051 12.75 8.75 11.2949 8.75 9.5Z" fill="currentColor" />
                                </g>
                                </g>
                            </svg>
                            <span class="ltr:pl-3 rtl:pr-3 text-black dark:text-[#506690] dark:group-hover:text-white-dark">Pincode Manage</span>
                        </div>
                    </a>
                </li>

            </ul>
    </div>
</nav>
</div>
<script>
    document.addEventListener("alpine:init", () => {
        Alpine.data("sidebar", () => ({
            init() {
                const selector = document.querySelector('.sidebar ul a[href="' + window.location
                    .pathname + '"]');
                if (selector) {
                    selector.classList.add('active');
                    const ul = selector.closest('ul.sub-menu');
                    if (ul) {
                        let ele = ul.closest('li.menu').querySelectorAll('.nav-link');
                        if (ele) {
                            ele = ele[0];
                            setTimeout(() => {
                                ele.click();
                            });
                        }
                    }
                }
            },
        }));
    });
</script>
