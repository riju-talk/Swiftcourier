{% extends 'components/layouts/layout.dj' %}

{% block title %}
  Overview | Super Admin - Dashboard
{% endblock %}

{% load static %}

{% block body %}
  <div class="w-full">
    {% include "superadmin_panel/dashboard/_tabs.dj" with active="overview" %}

    <div class="space-y-6">
      <!-- Header -->
      <div>
        <h1 class="text-2xl font-bold tracking-tight text-black dark:text-white">Dashboard Overview</h1>
        <p class="mt-1 text-sm text-neutral-500 dark:text-neutral-400">Real-time shipment and order performance summary</p>
      </div>

      <!-- KPI Cards -->
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
        <div class="rounded-lg border border-neutral-200 bg-white p-5 dark:border-white/10 dark:bg-black">
          <p class="text-xs font-semibold uppercase tracking-wider text-neutral-500 dark:text-neutral-400">Today So Far</p>
          <h2 id="todaySoFar" class="mt-2 text-3xl font-bold text-black dark:text-white">N/A</h2>
        </div>
        <div class="rounded-lg border border-neutral-200 bg-white p-5 dark:border-white/10 dark:bg-black">
          <p class="text-xs font-semibold uppercase tracking-wider text-neutral-500 dark:text-neutral-400">Yesterday</p>
          <h2 id="yesterdayOrders" class="mt-2 text-3xl font-bold text-black dark:text-white">N/A</h2>
        </div>
        <div class="rounded-lg border border-neutral-200 bg-white p-5 dark:border-white/10 dark:bg-black">
          <p class="text-xs font-semibold uppercase tracking-wider text-neutral-500 dark:text-neutral-400">Last 7 Days</p>
          <h2 id="last_7_days" class="mt-2 text-3xl font-bold text-black dark:text-white">N/A</h2>
        </div>
        <div class="rounded-lg border border-neutral-200 border-l-2 border-l-red-600 bg-white p-5 dark:border-white/10 dark:border-l-red-600 dark:bg-black">
          <p class="text-xs font-semibold uppercase tracking-wider text-red-600">Last 30 Days</p>
          <h2 id="last_30_days_orders" class="mt-2 text-3xl font-bold text-black dark:text-white">N/A</h2>
        </div>
      </div>

      <!-- Secondary Metrics -->
      <div class="grid grid-cols-1 gap-4 md:grid-cols-3">
        <div class="rounded-lg border border-neutral-200 bg-white p-5 dark:border-white/10 dark:bg-black">
          <p class="text-xs font-semibold uppercase tracking-wider text-neutral-500 dark:text-neutral-400">This Month</p>
          <h2 id="thisMonthOrders" class="mt-2 text-2xl font-bold text-black dark:text-white">N/A</h2>
        </div>
        <div class="rounded-lg border border-neutral-200 bg-white p-5 dark:border-white/10 dark:bg-black">
          <p class="text-xs font-semibold uppercase tracking-wider text-neutral-500 dark:text-neutral-400">Prev Month</p>
          <h2 id="prevMonthOrders" class="mt-2 text-2xl font-bold text-black dark:text-white">N/A</h2>
        </div>
        <div class="rounded-lg border border-neutral-200 bg-white p-5 dark:border-white/10 dark:bg-black">
          <p class="text-xs font-semibold uppercase tracking-wider text-neutral-500 dark:text-neutral-400">This Year</p>
          <h2 id="thisYearOrders" class="mt-2 text-2xl font-bold text-black dark:text-white">N/A</h2>
        </div>
      </div>

      <!-- Quick Insights -->
      <div class="grid grid-cols-1 gap-6 lg:grid-cols-2">
        <div class="rounded-lg border border-neutral-200 bg-white p-6 dark:border-white/10 dark:bg-black">
          <h3 class="mb-4 text-sm font-semibold uppercase tracking-wider text-neutral-500 dark:text-neutral-400">Courier Performance</h3>
          <div id="courierPerformance" class="space-y-3 text-sm"></div>
        </div>

        <div class="rounded-lg border border-neutral-200 bg-white p-6 dark:border-white/10 dark:bg-black">
          <h3 class="mb-4 text-sm font-semibold uppercase tracking-wider text-neutral-500 dark:text-neutral-400">Attention Required</h3>
          <ul class="space-y-3 text-sm">
            <li class="flex items-center justify-between">
              <span class="text-neutral-600 dark:text-neutral-400">High NDR Rate</span>
              <span id="alert-high-ndr" class="font-semibold text-red-600">+N/A%</span>
            </li>
            <li class="flex items-center justify-between">
              <span class="text-neutral-600 dark:text-neutral-400">Pickup Delays</span>
              <span id="alert-pickup-delay" class="font-semibold text-black dark:text-white">N/A</span>
            </li>
            <li class="flex items-center justify-between">
              <span class="text-neutral-600 dark:text-neutral-400">Courier Exceptions</span>
              <span id="courier-exceptions" class="font-semibold text-red-600">N/A</span>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </div>
{% endblock %}

{% block js %}
  <script>
    document.addEventListener('DOMContentLoaded', function () {
      fetch(`${window.location.pathname}?data=true`)
        .then((response) => response.json())
        .then((data) => {
          // --- KPI ---
          document.getElementById('todaySoFar').innerText = data.todaySoFar
          document.getElementById('yesterdayOrders').innerText = data.yesterdayOrders
          document.getElementById('last_7_days').innerText = data.last_7_days
          document.getElementById('last_30_days_orders').innerText = data.last_30_days_orders

          document.getElementById('thisMonthOrders').innerText = data.thisMonthOrders
          document.getElementById('prevMonthOrders').innerText = data.prevMonthOrders
          document.getElementById('thisYearOrders').innerText = data.thisYearOrders

          // --- Courier Performance (DYNAMIC) ---
          const courierContainer = document.getElementById('courierPerformance')
          courierContainer.innerHTML = ''

          Object.entries(data.courier_performance).forEach(([courier, percent]) => {
            const row = document.createElement('div')
            row.className = 'flex items-center justify-between'
            row.innerHTML = `
              <span class="text-neutral-600 dark:text-neutral-400">${courier.charAt(0).toUpperCase() + courier.slice(1)}</span>
              <span class="font-semibold text-black dark:text-white">${percent}% Delivered</span>
            `
            courierContainer.appendChild(row)
          })

          // --- Alerts ---
          document.getElementById('alert-high-ndr').innerText = `${data.attention_required.high_ndr_rate}%`
          document.getElementById('alert-pickup-delay').innerText = data.attention_required.pickup_delays
          document.getElementById('courier-exceptions').innerText = data.attention_required.courier_exceptions
        })
        .catch((error) => console.error('Dashboard error:', error))
    })
  </script>
{% endblock %}
