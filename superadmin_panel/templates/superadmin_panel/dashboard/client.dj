{% extends 'components/layouts/layout.dj' %}

{% block title %}
  Clients | Super Admin - Dashboard
{% endblock %}

{% load static %}

{% block body %}
  <div class="w-full">
    {% include "superadmin_panel/dashboard/_tabs.dj" with active="client" %}

    <div class="space-y-6">
      <div>
        <h1 class="text-2xl font-bold tracking-tight text-black dark:text-white">All Clients Overview</h1>
        <p class="mt-1 text-sm text-neutral-500 dark:text-neutral-400">Consolidated shipment performance across all active clients</p>
      </div>

      <!-- Primary KPIs -->
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-6">
        <div class="rounded-lg border border-neutral-200 bg-white p-4 dark:border-white/10 dark:bg-black">
          <p class="text-xs font-semibold uppercase tracking-wider text-neutral-500 dark:text-neutral-400">Total Shipments</p>
          <h2 id="totalShipments" class="mt-1 text-2xl font-bold text-black dark:text-white">N/A</h2>
        </div>
        <div class="rounded-lg border border-neutral-200 bg-white p-4 dark:border-white/10 dark:bg-black">
          <p class="text-xs font-semibold uppercase tracking-wider text-neutral-500 dark:text-neutral-400">Pending Pickup</p>
          <h2 id="pendingPickup" class="mt-1 text-2xl font-bold text-black dark:text-white">N/A</h2>
        </div>
        <div class="rounded-lg border border-neutral-200 bg-white p-4 dark:border-white/10 dark:bg-black">
          <p class="text-xs font-semibold uppercase tracking-wider text-neutral-500 dark:text-neutral-400">In Transit</p>
          <h2 id="inTransit" class="mt-1 text-2xl font-bold text-black dark:text-white">N/A</h2>
        </div>
        <div class="rounded-lg border border-neutral-200 bg-white p-4 dark:border-white/10 dark:bg-black">
          <p class="text-xs font-semibold uppercase tracking-wider text-neutral-500 dark:text-neutral-400">Delivered</p>
          <h2 id="delivered" class="mt-1 text-2xl font-bold text-black dark:text-white">N/A</h2>
        </div>
        <div class="rounded-lg border border-neutral-200 border-l-2 border-l-red-600 bg-white p-4 dark:border-white/10 dark:border-l-red-600 dark:bg-black">
          <p class="text-xs font-semibold uppercase tracking-wider text-red-600">RTO</p>
          <h2 id="rtoOrders" class="mt-1 text-2xl font-bold text-black dark:text-white">N/A</h2>
        </div>
        <div class="rounded-lg border border-neutral-200 bg-white p-4 dark:border-white/10 dark:bg-black">
          <p class="text-xs font-semibold uppercase tracking-wider text-neutral-500 dark:text-neutral-400">NDR</p>
          <h2 id="ndrOrders" class="mt-1 text-2xl font-bold text-black dark:text-white">N/A</h2>
        </div>
      </div>

      <!-- Business Health -->
      <div class="grid grid-cols-1 gap-6 lg:grid-cols-3">
        <div class="rounded-lg border border-neutral-200 bg-white p-6 dark:border-white/10 dark:bg-black">
          <h3 class="mb-4 text-sm font-semibold uppercase tracking-wider text-neutral-500 dark:text-neutral-400">Client Metrics</h3>
          <div class="space-y-3 text-sm">
            <div class="flex items-center justify-between">
              <span class="text-neutral-600 dark:text-neutral-400">Active Clients</span>
              <span id="activeClients" class="font-semibold text-black dark:text-white">N/A</span>
            </div>
            <div class="flex items-center justify-between">
              <span class="text-neutral-600 dark:text-neutral-400">Clients with Live Orders</span>
              <span id="clientsWithLiveOrders" class="font-semibold text-black dark:text-white">N/A</span>
            </div>
            <div class="flex items-center justify-between">
              <span class="text-neutral-600 dark:text-neutral-400">New Clients (30 days)</span>
              <span id="newClients" class="font-semibold text-red-600">N/A</span>
            </div>
          </div>
        </div>

        <div class="rounded-lg border border-neutral-200 bg-white p-6 dark:border-white/10 dark:bg-black">
          <h3 class="mb-4 text-sm font-semibold uppercase tracking-wider text-neutral-500 dark:text-neutral-400">Courier Performance (Avg)</h3>
          <div id="clientCourierPerformance" class="space-y-3 text-sm"></div>
        </div>

        <div class="rounded-lg border border-neutral-200 bg-white p-6 dark:border-white/10 dark:bg-black">
          <h3 class="mb-4 text-sm font-semibold uppercase tracking-wider text-neutral-500 dark:text-neutral-400">Risk Indicators</h3>
          <ul class="space-y-3 text-sm">
            <li class="flex items-center justify-between">
              <span class="text-neutral-600 dark:text-neutral-400">High RTO Clients</span>
              <span id="highRtoClients" class="font-semibold text-red-600">N/A</span>
            </li>
            <li class="flex items-center justify-between">
              <span class="text-neutral-600 dark:text-neutral-400">High NDR Rate</span>
              <span id="highNdrClients" class="font-semibold text-red-600">N/A</span>
            </li>
            <li class="flex items-center justify-between">
              <span class="text-neutral-600 dark:text-neutral-400">SLA Breaches</span>
              <span id="slaBreaches" class="font-semibold text-black dark:text-white">N/A</span>
            </li>
          </ul>
        </div>
      </div>

      <!-- Client-wise Shipment Breakdown -->
      <div class="rounded-lg border border-neutral-200 bg-white p-6 dark:border-white/10 dark:bg-black">
        <div class="mb-4 flex items-center justify-between">
          <h3 class="text-sm font-semibold uppercase tracking-wider text-neutral-500 dark:text-neutral-400">Client Shipment Breakdown</h3>
          <span class="text-xs text-neutral-400">All active clients</span>
        </div>
        <div class="overflow-x-auto">
          <table class="min-w-full overflow-hidden rounded-lg border border-neutral-200 text-sm dark:border-white/10">
            <thead class="bg-neutral-50 text-left text-xs uppercase tracking-wider text-neutral-500 dark:bg-white/5 dark:text-neutral-400">
              <tr>
                <th class="px-4 py-3 font-semibold">Client Name</th>
                <th class="px-4 py-3 text-center font-semibold">Pending</th>
                <th class="px-4 py-3 text-center font-semibold">In Transit</th>
                <th class="px-4 py-3 text-center font-semibold">Delivered</th>
                <th class="px-4 py-3 text-center font-semibold">RTO</th>
                <th class="px-4 py-3 text-center font-semibold">NDR</th>
                <th class="px-4 py-3 text-right font-semibold">Total</th>
              </tr>
            </thead>
            <tbody id="clientShipmentTable" class="divide-y divide-neutral-200 text-neutral-700 dark:divide-white/10 dark:text-neutral-300"></tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
{% endblock %}

{% block js %}
<script>
  document.addEventListener("DOMContentLoaded", function () {
    fetch(`${window.location.pathname}?data=true`)
      .then(res => res.json())
      .then(data => {
        totalShipments.innerText = data.total_orders;
        pendingPickup.innerText = data.pending_pickup;
        inTransit.innerText = data.in_transit;
        delivered.innerText = data.delivered;
        rtoOrders.innerText = data.rto_orders;
        ndrOrders.innerText = data.ndr_orders;

        activeClients.innerText = data.client_metrices.active;
        clientsWithLiveOrders.innerText = data.client_metrices.with_live_orders;
        newClients.innerText = `+${data.client_metrices.new_last_30_days}`;

        const courierBox = document.getElementById("clientCourierPerformance");
        courierBox.innerHTML = "";
        Object.entries(data.courier_performance).forEach(([courier, percent]) => {
          courierBox.innerHTML += `
            <div class="flex items-center justify-between">
              <span class="text-neutral-600 dark:text-neutral-400">${courier.charAt(0).toUpperCase() + courier.slice(1)}</span>
              <span class="font-semibold text-black dark:text-white">${percent}%</span>
            </div>`;
        });

        highRtoClients.innerText = data.risk_indicator.high_rto_clients;
        highNdrClients.innerText = `${data.risk_indicator.high_ndr_clients}%`;
        slaBreaches.innerText = data.risk_indicator.sla_breach;

        const tableBody = document.getElementById("clientShipmentTable");
        tableBody.innerHTML = "";
        Object.entries(data.client_shipments).forEach(([client, stats]) => {
          tableBody.innerHTML += `
            <tr class="hover:bg-neutral-50 dark:hover:bg-white/5">
              <td class="px-4 py-3 font-medium text-black dark:text-white">${client}</td>
              <td class="px-4 py-3 text-center">${stats.pending}</td>
              <td class="px-4 py-3 text-center">${stats.in_transit}</td>
              <td class="px-4 py-3 text-center">${stats.delivered}</td>
              <td class="px-4 py-3 text-center text-red-600">${stats.rto}</td>
              <td class="px-4 py-3 text-center">${stats.ndr}</td>
              <td class="px-4 py-3 text-right font-semibold text-black dark:text-white">${stats.total}</td>
            </tr>`;
        });
      })
      .catch(err => console.error("Client dashboard error:", err));
  });
</script>
{% endblock %}
