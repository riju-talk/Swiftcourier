{% extends 'components/layouts/layout.dj' %}

{% block title %}
  Courier Partner | Super Admin - Dashboard
{% endblock %}

{% load static %}

{% block body %}
  <div class="w-full">
    {% include "superadmin_panel/dashboard/_tabs.dj" with active="courier_partner" %}

    <div class="rounded-lg border border-neutral-200 bg-white p-6 dark:border-white/10 dark:bg-black">
      <h3 class="mb-4 text-sm font-semibold uppercase tracking-wider text-neutral-500 dark:text-neutral-400">Courier-wise Performance</h3>

      <div class="overflow-x-auto">
        <table class="min-w-full overflow-hidden rounded-lg border border-neutral-200 text-sm dark:border-white/10">
          <thead class="bg-neutral-50 text-left text-xs uppercase tracking-wider text-neutral-500 dark:bg-white/5 dark:text-neutral-400">
            <tr>
              <th class="px-4 py-3 font-semibold">Courier Partner</th>
              <th class="px-4 py-3 text-center font-semibold">Pending</th>
              <th class="px-4 py-3 text-center font-semibold">In Transit</th>
              <th class="px-4 py-3 text-center font-semibold">Delivered</th>
              <th class="px-4 py-3 text-center font-semibold">RTO</th>
              <th class="px-4 py-3 text-center font-semibold">NDR</th>
              <th class="px-4 py-3 text-center font-semibold">Delivery %</th>
              <th class="px-4 py-3 text-right font-semibold">Total Orders</th>
            </tr>
          </thead>
          <tbody id="courierPartnerTable" class="divide-y divide-neutral-200 text-neutral-700 dark:divide-white/10 dark:text-neutral-300">
            <!-- Rows will be injected by JS -->
          </tbody>
        </table>
      </div>
    </div>
  </div>
{% endblock %}

{% block js %}
  <script>
    document.addEventListener('DOMContentLoaded', function () {
      fetch(`${window.location.pathname}?data=true`)
        .then((res) => res.json())
        .then((data) => {
          const tableBody = document.getElementById('courierPartnerTable')
          tableBody.innerHTML = ''

          Object.entries(data).forEach(([courier, stats]) => {
            tableBody.innerHTML += `
                <tr class="hover:bg-neutral-50 dark:hover:bg-white/5">
                  <td class="px-4 py-3 font-medium text-black dark:text-white">${courier.charAt(0).toUpperCase() + courier.slice(1)}</td>
                  <td class="px-4 py-3 text-center">${stats.pending_pickup}</td>
                  <td class="px-4 py-3 text-center">${stats.in_transit}</td>
                  <td class="px-4 py-3 text-center">${stats.delivered}</td>
                  <td class="px-4 py-3 text-center text-red-600">${stats.rto}</td>
                  <td class="px-4 py-3 text-center">${stats.ndr}</td>
                  <td class="px-4 py-3 text-center font-semibold text-black dark:text-white">${stats.delivery_perc}%</td>
                  <td class="px-4 py-3 text-right font-bold text-black dark:text-white">${stats.total_orders}</td>
                </tr>
              `
          })
        })
        .catch((err) => console.error('Courier partner dashboard error:', err))
    })
  </script>
{% endblock %}
