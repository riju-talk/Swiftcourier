{% extends 'components/layouts/layout.dj' %}

{% block title %}
  Courier Performance | Super Admin - Dashboard
{% endblock %}

{% load static %}

{% block body %}
  <div class="w-full">
    {% include "superadmin_panel/dashboard/_tabs.dj" with active="courier_performance" %}

    <div class="rounded-lg border border-neutral-200 bg-white p-6 dark:border-white/10 dark:bg-black">
      <h3 class="mb-4 text-sm font-semibold uppercase tracking-wider text-neutral-500 dark:text-neutral-400">Courier Performance</h3>

      <!-- KPI Row -->
      <div class="mb-6 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
        <div class="rounded-lg border border-neutral-200 p-4 dark:border-white/10">
          <p class="text-xs font-semibold uppercase tracking-wider text-neutral-500 dark:text-neutral-400">Avg Delivery Success</p>
          <p id="avgDeliverySuccess" class="mt-1 text-2xl font-bold text-black dark:text-white">N/A%</p>
        </div>
        <div class="rounded-lg border border-neutral-200 p-4 dark:border-white/10">
          <p class="text-xs font-semibold uppercase tracking-wider text-neutral-500 dark:text-neutral-400">Avg Pickup TAT</p>
          <p id="avgPickupTat" class="mt-1 text-2xl font-bold text-black dark:text-white">N/A Days</p>
        </div>
        <div class="rounded-lg border border-neutral-200 p-4 dark:border-white/10">
          <p class="text-xs font-semibold uppercase tracking-wider text-neutral-500 dark:text-neutral-400">Avg Delivery TAT</p>
          <p id="avgDeliveryTat" class="mt-1 text-2xl font-bold text-black dark:text-white">N/A Days</p>
        </div>
        <div class="rounded-lg border border-neutral-200 border-l-2 border-l-red-600 p-4 dark:border-white/10 dark:border-l-red-600">
          <p class="text-xs font-semibold uppercase tracking-wider text-red-600">Avg RTO Rate</p>
          <p id="avgRtoTat" class="mt-1 text-2xl font-bold text-black dark:text-white">N/A%</p>
        </div>
      </div>

      <!-- Performance Table -->
      <div class="overflow-x-auto">
        <table class="min-w-full overflow-hidden rounded-lg border border-neutral-200 text-sm dark:border-white/10">
          <thead class="bg-neutral-50 text-left text-xs uppercase tracking-wider text-neutral-500 dark:bg-white/5 dark:text-neutral-400">
            <tr>
              <th class="px-4 py-3 font-semibold">Courier Partner</th>
              <th class="px-4 py-3 text-center font-semibold">Delivery %</th>
              <th class="px-4 py-3 text-center font-semibold">Pickup TAT</th>
              <th class="px-4 py-3 text-center font-semibold">Delivery TAT</th>
              <th class="px-4 py-3 text-center font-semibold">RTO %</th>
              <th class="px-4 py-3 text-center font-semibold">NDR %</th>
              <th class="px-4 py-3 text-center font-semibold">SLA Status</th>
            </tr>
          </thead>
          <tbody id="courierPerformanceTable" class="divide-y divide-neutral-200 text-neutral-700 dark:divide-white/10 dark:text-neutral-300">
          </tbody>
        </table>
      </div>
    </div>
  </div>
{% endblock %}

{% block js %}
<script>
  document.addEventListener("DOMContentLoaded", function () {
    fetch(`${window.location.pathname}?data=true`)
      .then(res => res.json())
      .then(data => {

        /* ---------- KPIs ---------- */
        avgDeliverySuccess.innerText = `${data.avg_delivery_success}%`;
        avgPickupTat.innerText = `${data.avg_pickup_tat} Days`;
        avgDeliveryTat.innerText = `${data.avg_delivery_tat} Days`;
        avgRtoTat.innerText = `${data.avg_rto_tat}%`;

        /* ---------- Table ---------- */
        const tableBody = document.getElementById("courierPerformanceTable");
        tableBody.innerHTML = "";

        const badgeClass = {
          "Good": "bg-black text-white dark:bg-white dark:text-black",
          "Watch": "bg-neutral-100 text-neutral-700 dark:bg-white/10 dark:text-neutral-200",
          "Risk": "bg-red-50 text-red-700 dark:bg-red-500/15 dark:text-red-300",
        };

        Object.entries(data.courier_partners).forEach(([courier, stats]) => {
          const status = stats.sla_status;
          const cls = badgeClass[status] || "bg-neutral-100 text-neutral-700";

          tableBody.innerHTML += `
            <tr class="hover:bg-neutral-50 dark:hover:bg-white/5">
              <td class="px-4 py-3 font-medium text-black dark:text-white">${courier.charAt(0).toUpperCase() + courier.slice(1)}</td>
              <td class="px-4 py-3 text-center font-semibold text-black dark:text-white">${stats.delivery_perc}%</td>
              <td class="px-4 py-3 text-center">${stats.pickup_tat} d</td>
              <td class="px-4 py-3 text-center">${stats.delivery_tat} d</td>
              <td class="px-4 py-3 text-center text-red-600">${stats.rto_perc}%</td>
              <td class="px-4 py-3 text-center">${stats.ndr_perc}%</td>
              <td class="px-4 py-3 text-center">
                <span class="rounded-md px-2 py-1 text-xs font-semibold ${cls}">${status}</span>
              </td>
            </tr>
          `;
        });
      })
      .catch(err => console.error("Courier performance dashboard error:", err));
  });
</script>
{% endblock %}
