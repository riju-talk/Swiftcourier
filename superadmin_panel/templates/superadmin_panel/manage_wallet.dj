{% extends "components/layouts/layout.dj" %}

{% block title %}
    Super Admin - Wallet Management
{% endblock title %}

{% load static %}

{% block css %}
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap');

        body {
            font-family: 'Poppins', sans-serif;
        }

        .card {
            box-shadow: 0 6px 20px rgba(0, 0, 0, 0.05);
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }

        .card:hover {
            transform: translateY(-5px);
            box-shadow: 0 12px 25px rgba(0, 0, 0, 0.08);
        }

        .wallet-icon {
            width: 50px;
            height: 50px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 14px;
        }

        .input-group {
            position: relative;
        }

        .currency {
            position: absolute;
            left: 15px;
            top: 50%;
            transform: translateY(-50%);
            font-weight: 500;
        }

        .btn {
            transition: all 0.3s ease;
        }

        .btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        }
    </style>
{% endblock css %}

{% block body %}
    <div class="max-w-4xl mx-auto px-4 py-6">
        <div>
            <button onclick="history.back()"
                    class="border border-blue-500 hover:bg-blue-700 text-blue-500 hover:text-white font-bold py-2 px-4 rounded">
                Back
            </button>
        </div>
        <!-- Header -->
        <div class="text-center mb-8">
            <h1 class="text-3xl md:text-4xl font-bold text-gray-800 dark:text-gray-100">Wallet Management</h1>
            <p class="text-gray-600 dark:text-gray-400">Super Admin Dashboard</p>
        </div>
        <div class="card bg-white dark:bg-zinc-800 rounded-2xl p-6 mb-8">
            <div class="flex flex-col md:flex-row items-center justify-between">
                <div class="flex items-center mb-4 md:mb-0">
                    <div class="wallet-icon bg-blue-100 text-blue-600 dark:bg-blue-900 dark:text-blue-300 mr-4">
                        <img class="w-9 h-9 rounded-full object-cover saturate-50 group-hover:saturate-100"
                             src="{{ request.user.photo.url }}"
                             alt="image" />
                    </div>
                    <div>
                        <h2 class="text-xl font-bold text-gray-800 dark:text-gray-100">{{ user.full_name }}</h2>
                        <p class="text-gray-500 dark:text-gray-400">Client ID: {{ user.shipzee_code }}</p>
                    </div>
                </div>
                <div class="flex items-center">
                    <div class="wallet-icon bg-green-100 text-green-600 dark:bg-green-900 dark:text-green-300 mr-4">
                        <i class="fas fa-wallet text-xl"></i>
                    </div>
                    <div class="text-center md:text-right">
                        <p class="text-gray-500 dark:text-gray-400">Wallet Balance</p>
                        <h3 class="text-3xl font-bold text-gray-800 dark:text-gray-100">₹ {{ wallet_balance }}</h3>
                    </div>
                </div>
            </div>
        </div>

        <!-- Transaction Actions -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
            <!-- Add -->
            <div class="card bg-white dark:bg-zinc-800 rounded-2xl p-6">
                <form method="post"
                    action="{% url 'superadmin_panel:add-balance' user.id %}">
                    {% csrf_token %}
                    <div class="flex items-center mb-5">
                        <div class="wallet-icon bg-green-100 text-green-600 dark:bg-green-900 dark:text-green-300 mr-4">
                            <i class="fas fa-plus-circle"></i>
                        </div>
                        <h3 class="text-xl font-bold text-gray-800 dark:text-gray-100">Add Money</h3>
                    </div>

                    <!-- Amount -->
                    <div class="mb-4">
                        <label class="block text-gray-700 dark:text-gray-300 mb-2">Enter Amount</label>
                        <div class="input-group">
                            <span class="currency text-gray-600 dark:text-gray-400">₹</span>
                            <input type="number"
                                name="amount"
                                placeholder="eg: 500, 1000"
                                required
                                class="w-full pl-10 py-3 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-zinc-700 text-gray-800 dark:text-gray-100 focus:outline-none focus:ring-2 focus:ring-blue-500">
                        </div>
                    </div>

                    <!-- Reason Dropdown -->
                    <div class="mb-4">
                        <label class="block text-gray-700 dark:text-gray-300 mb-2">Select Reason</label>
                        <select id="reason_select"
                                name="reason"
                                required
                                class="w-full py-3 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-zinc-700 text-gray-800 dark:text-gray-100 focus:outline-none focus:ring-2 focus:ring-blue-500">

                            <option value="" disabled selected>Select reason</option>

                            {% for reason in cn_dn_reasons %}
                                <option value="{{ reason.0 }}">{{ reason.1 }}</option>
                            {% endfor %}
                        </select>
                    </div>

                    <!-- OTHER DESCRIPTION BOX (Hidden Initially) -->
                    <div id="other_reason_box" class="mb-4 hidden">
                        <label class="block text-gray-700 dark:text-gray-300 mb-2">
                            Enter Proper Reason
                        </label>

                        <textarea id="other_reason"
                                name="other_reason"
                                placeholder="Write detailed reason..."
                                class="w-full py-3 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-zinc-700 text-gray-800 dark:text-gray-100 focus:outline-none focus:ring-2 focus:ring-blue-500"></textarea>
                    </div>

                    <button class="bg-green-500 hover:bg-green-600 w-full py-3 text-white font-medium rounded-lg btn">
                        Add to Wallet
                    </button>
                </form>
            </div>

            <!-- Deduct -->
            <div class="card bg-white dark:bg-zinc-800 rounded-2xl p-6">
                <form method="post"
                    action="{% url 'superadmin_panel:deduct-balance' user.id %}">
                    {% csrf_token %}

                    <div class="flex items-center mb-5">
                        <div class="wallet-icon bg-red-100 text-red-600 dark:bg-red-900 dark:text-red-300 mr-4">
                            <i class="fas fa-minus-circle"></i>
                        </div>
                        <h3 class="text-xl font-bold text-gray-800 dark:text-gray-100">Deduct Money</h3>
                    </div>

                    <!-- Amount -->
                    <div class="mb-4">
                        <label class="block text-gray-700 dark:text-gray-300 mb-2">Enter Amount</label>
                        <div class="input-group">
                            <span class="currency text-gray-600 dark:text-gray-400">₹</span>
                            <input type="number"
                                name="amount"
                                required
                                placeholder="eg: 500, 1000"
                                class="w-full pl-10 py-3 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-zinc-700 text-gray-800 dark:text-gray-100 focus:outline-none focus:ring-2 focus:ring-blue-500">
                        </div>
                    </div>

                    <!-- Reason -->
                    <div class="mb-4">
                        <label class="block text-gray-700 dark:text-gray-300 mb-2">Select Reason</label>

                        <select id="deduct_reason_select"
                                name="reason"
                                required
                                class="w-full py-3 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-zinc-700 text-gray-800 dark:text-gray-100 focus:outline-none focus:ring-2 focus:ring-blue-500">

                            <option value="" disabled selected>Select reason</option>

                            {% for reason in cn_dn_reasons %}
                                <option value="{{ reason.0 }}">{{ reason.1 }}</option>
                            {% endfor %}
                        </select>
                    </div>

                    <!-- OTHER DESCRIPTION -->
                    <div id="deduct_other_reason_box" class="mb-4 hidden">
                        <label class="block text-gray-700 dark:text-gray-300 mb-2">
                            Enter Proper Reason
                        </label>

                        <textarea id="deduct_other_reason"
                                name="other_reason"
                                placeholder="Write detailed reason..."
                                class="w-full py-3 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-zinc-700 text-gray-800 dark:text-gray-100 focus:outline-none focus:ring-2 focus:ring-blue-500"></textarea>
                    </div>

                    <button class="bg-red-500 hover:bg-red-600 w-full py-3 text-white font-medium rounded-lg btn">
                        Deduct from Wallet
                    </button>
                </form>
            </div>
        </div>

        <!-- Debit Limit -->
        <div class="card bg-white dark:bg-zinc-800 rounded-2xl p-6 mb-8">
            <form method="post"
                  action="{% url 'superadmin_panel:set-debit-limit' user.id %}">
                {% csrf_token %}
                <div class="flex items-center mb-6">
                    <div class="wallet-icon bg-purple-100 text-purple-600 dark:bg-purple-900 dark:text-purple-300 mr-4">
                        <i class="fas fa-credit-card"></i>
                    </div>
                    <h3 class="text-xl font-bold text-gray-800 dark:text-gray-100">Debit Limit</h3>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                    <div class="md:col-span-2">
                        <label class="block text-gray-700 dark:text-gray-300 mb-2">Enter Limit</label>
                        <div class="input-group">
                            <span class="currency text-gray-600 dark:text-gray-400">₹</span>
                            <input type="number"
                                   name="amount"
                                   class="w-full pl-12 py-3 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-zinc-700 text-gray-800 dark:text-gray-100 focus:outline-none focus:ring-2 focus:ring-blue-500"
                                   placeholder="10000">
                        </div>
                    </div>
                    <div class="flex items-end">
                        <button class="bg-blue-500 hover:bg-blue-600 w-full py-3 text-white font-medium rounded-lg btn">Set Limit</button>
                    </div>
                </div>
            </form>
        </div>

        <!-- Recent Transaction -->
        <div class="card bg-white dark:bg-zinc-800 rounded-2xl p-6">
            <div class="flex items-center mb-6">
                <div class="wallet-icon bg-blue-100 text-blue-600 dark:bg-blue-900 dark:text-blue-300 mr-4">
                    <i class="fas fa-exchange-alt"></i>
                </div>
                <h3 class="text-xl font-bold text-gray-800 dark:text-gray-100">Recent Transaction</h3>
            </div>
            <div class="overflow-x-auto">
                <table class="w-full">
                    <thead>
                        <tr class="bg-gray-50 dark:bg-zinc-700">
                            <th class="py-3 px-4 text-left text-gray-700 dark:text-gray-300">Date</th>
                            <th class="py-3 px-4 text-left text-gray-700 dark:text-gray-300">Transaction Type</th>
                            <th class="py-3 px-4 text-left text-gray-700 dark:text-gray-300">Description</th>
                            <th class="py-3 px-4 text-left text-gray-700 dark:text-gray-300">Amount</th>
                            <th class="py-3 px-4 text-left text-gray-700 dark:text-gray-300">Closing Amount</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for t in recent_transactions %}
                            <tr class="hover:bg-gray-50 dark:hover:bg-zinc-700">
                                <td class="py-3 px-4 text-gray-800 dark:text-gray-100">{{ t.created_at }}</td>
                                <td class="py-3 px-4 text-gray-800 dark:text-gray-100">{{ t.get_transaction_type_display }}</td>
                                <td class="py-3 px-4 text-gray-800 dark:text-gray-100">{{ t.get_desc_display }}</td>
                                <td class="py-3 px-4 text-gray-800 dark:text-gray-100">{{ t.amount }}</td>
                                <td class="py-3 px-4 text-gray-800 dark:text-gray-100">₹{{ t.closing_amount }}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
{% endblock body %}

{% block js %}
    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const reasonSelect = document.getElementById("reason_select");
            const otherBox = document.getElementById("other_reason_box");
            const otherTextarea = document.getElementById("other_reason");

            reasonSelect.addEventListener("change", function () {

                if (this.value === "other") {
                    otherBox.classList.remove("hidden");
                    otherTextarea.required = true;
                } else {
                    otherBox.classList.add("hidden");
                    otherTextarea.required = false;
                    otherTextarea.value = "";
                }

            });
        });
    </script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {

            function setupOtherReason(selectId, boxId, textareaId) {

                const select = document.getElementById(selectId);
                const box = document.getElementById(boxId);
                const textarea = document.getElementById(textareaId);

                if (!select) return;

                select.addEventListener("change", function () {
                    if (this.value === "other") {
                        box.classList.remove("hidden");
                        textarea.required = true;
                    } else {
                        box.classList.add("hidden");
                        textarea.required = false;
                        textarea.value = "";
                    }
                });
            }

            // Add Wallet Form
            setupOtherReason(
                "reason_select",
                "other_reason_box",
                "other_reason"
            );

            // Deduct Wallet Form
            setupOtherReason(
                "deduct_reason_select",
                "deduct_other_reason_box",
                "deduct_other_reason"
            );

        });
    </script>
{% endblock js %}
