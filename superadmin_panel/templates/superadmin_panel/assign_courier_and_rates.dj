{% extends "components/layouts/layout.dj" %}

{% block title %}
    Courier Rate Configuration
{% endblock title %}

{% load static %}

{% block css %}
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        .container {
            transform: scale(0.95);
            transform-origin: top center;
            width: 105%;
            max-width: 1400px;
            margin: 0 auto;
            background: white;
            border-radius: 12px;
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.05);
            overflow: hidden;
        }
        select {
            appearance: none;          /* For most browsers */
            -webkit-appearance: none;  /* Safari / Chrome */
            -moz-appearance: none;     /* Firefox */
            background-image: none;    /* Remove default arrow */
        }
        
        .header {
            background: linear-gradient(135deg, #3B82F6 0%, #2563EB 100%);
            color: white;
            padding: 25px 30px;
        }

        .header h1 {
            font-size: 28px;
            font-weight: 700;
            margin-bottom: 5px;
        }

        .header p {
            opacity: 0.9;
            font-size: 16px;
        }

        .user-card {
            display: flex;
            align-items: center;
            padding: 20px 30px;
            border-bottom: 1px solid #eaeaea;
            background: #f9fafb;
        }

        .user-avatar {
            width: 50px;
            height: 50px;
            border-radius: 50%;
            background: linear-gradient(135deg, #8B5CF6 0%, #6D28D9 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-weight: bold;
            font-size: 20px;
            margin-right: 15px;
        }

        .user-info h2 {
            font-size: 18px;
            font-weight: 600;
            margin-bottom: 3px;
        }

        .user-info p {
            color: #6b7280;
            font-size: 14px;
        }

        .content-section {
            padding: 30px;
        }

        .section-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 25px;
        }

        .section-header h2 {
            font-size: 22px;
            font-weight: 600;
            color: #1f2937;
        }

        .btn {
            padding: 10px 20px;
            border-radius: 8px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
            border: none;
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }

        .btn-primary {
            background: #3B82F6;
            color: white;
        }

        .btn-primary:hover {
            background: #2563EB;
        }

        .btn-outline {
            background: transparent;
            border: 2px solid #3B82F6;
            color: #3B82F6;
        }

        .btn-outline:hover {
            background: #eff6ff;
        }

        .rate-configuration {
            margin-top: 30px;
        }

        .rate-table-container {
            overflow-x: auto;
            border: 1px solid #e5e7eb;
            border-radius: 10px;
            margin-bottom: 25px;
            background: white;
            box-shadow: 0 2px 5px rgba(0, 0, 0, 0.03);
        }

        .rate-table {
            width: 100%;
            border-collapse: collapse;
            min-width: 1200px;
        }

        .rate-table th {
            background-color: #f9fafb;
            padding: 14px 16px;
            text-align: left;
            font-weight: 600;
            color: #4b5563;
            font-size: 14px;
            border-bottom: 1px solid #e5e7eb;
        }

        .rate-table th.zone-header {
            text-align: center;
        }

        .rate-table td {
            padding: 12px 16px;
            border-bottom: 1px solid #e5e7eb;
            font-size: 14px;
        }







        .input-compact {
            width: 100%;
            padding: 10px;
            border-radius: 6px;
            border: 1px solid #d1d5db;
            font-size: 14px;
            text-align: center;
            transition: all 0.2s;
        }

        .input-compact:focus {
            outline: none;
            border-color: #3B82F6;
            box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.2);
        }

        select.input-compact {
            text-align-last: center;
            padding: 9px;
            background-color: white;
            cursor: pointer;
        }

        .additional-info {
            font-size: 12px;
            color: #6b7280;
            margin-top: 4px;
        }

        .action-buttons {
            display: flex;
            justify-content: flex-end;
            gap: 15px;
            padding: 25px 0;
            border-top: 1px solid #eaeaea;
            margin-top: 20px;
        }

        .empty-state {
            text-align: center;
            padding: 50px 20px;
            color: #6b7280;
            background-color: #f9fafb;
            border-radius: 10px;
            border: 2px dashed #d1d5db;
            margin-top: 20px;
        }

        .empty-state i {
            font-size: 48px;
            margin-bottom: 15px;
            color: #9ca3af;
        }

        .empty-state h3 {
            font-size: 20px;
            font-weight: 600;
            margin-bottom: 10px;
        }

        .empty-state p {
            max-width: 500px;
            margin: 0 auto;
        }

        .remove-btn {
            background: #fef2f2;
            color: #ef4444;
            border: none;
            width: 32px;
            height: 32px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all 0.2s;
        }

        .remove-btn:hover {
            background: #fee2e2;
        }

        .table-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 15px 20px;
            background: #f9fafb;
            border-bottom: 1px solid #e5e7eb;
            border-radius: 10px 10px 0 0;
        }

        .table-title {
            font-weight: 600;
            color: #1f2937;
        }

        .table-actions {
            display: flex;
            gap: 10px;
        }

        @media (max-width: 768px) {
            .section-header {
                flex-direction: column;
                align-items: flex-start;
                gap: 15px;
            }

            .action-buttons {
                flex-direction: column;
            }
        }

        .zone-grid {
            width: 100%;
        }

        .zone-header-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            text-align: center;
            font-size: 12px;
            color: #6b7280;
            margin-bottom: 6px;
        }

        .zone-input-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 6px;
        }
    </style>
{% endblock css %}

{% block body %}
<div>
            <button onclick="history.back()"
                    class="border border-blue-500 hover:bg-blue-700 text-blue-500 hover:text-white font-bold py-2 px-4 rounded">
                Back
            </button>
        </div>
        <br>
    <div class="container">
    
        <div class="header">
        
            <h1>Courier Rate Configuration</h1>
            <p>Configure shipping rates for your seller</p>
        </div>

        <div class="user-card">
            <img class="user-avatar" src="{{ user.photo.url }}" alt="{{ user.full_name }}'s Avatar"/>
            <div class="user-info">
                <h2>{{ user.full_name }}</h2>
                <p>Idiotship ID: #{{ user.shipzee_code }}</p>
            </div>
        </div>

        <div class="content-section">
            <form method="post"
                  action="{% url 'superadmin_panel:assign-courier-and-rates' user.id %}">
                {% csrf_token %}
                <div class="section-header">
                    <h2>Shipping Rate Configuration</h2>
                    <button id="add-table-btn" class="btn btn-outline" type="button">
                        <i class="fas fa-plus"></i> Add New Configuration
                    </button>
                </div>

                <div id="rate-configuration">
                    <!-- Rate tables will be added here dynamically -->
                    <div class="empty-state" id="empty-state">
                        <i class="fas fa-table"></i>
                        <h3>No Rate Configuration Added</h3>
                        <p>Click "Add New Configuration" to start setting up your shipping rates.</p>
                    </div>
                </div>

                <div class="action-buttons">
                    <button id="save-btn" class="btn btn-primary">
                        <i class="fas fa-save"></i> Save All Configurations
                    </button>
                </div>
            </form>
        </div>
    </div>
{% endblock body %}

{% block js %}
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const rateConfigContainer = document.getElementById('rate-configuration');
            const addTableBtn = document.getElementById('add-table-btn');
            const saveBtn = document.getElementById('save-btn');
            const emptyState = document.getElementById('empty-state');
            let tableCount = 0;

            // Preprocess couriers data to create a modes lookup map
            const couriers = {{ couriers|safe }};
            const courierModesMap = {};
            couriers.forEach(courier => {
                courierModesMap[courier.id] = courier.available_modes;
            });

            function createRateTable() {
                tableCount++;

                if (tableCount === 1 && emptyState) {
                    emptyState.style.display = 'none';
                }

                const tableId = `table-${tableCount}`;
                const tableContainer = document.createElement('div');
                tableContainer.className = 'rate-configuration';
                tableContainer.id = tableId;

                const tableHeader = document.createElement('div');
                tableHeader.className = 'table-header';
                tableHeader.innerHTML = `
                    <div class="table-title">Rate Configuration #${tableCount}</div>
                    <div class="table-actions">
                        <button class="remove-btn remove-table-btn" data-table="${tableId}">
                            <i class="fas fa-times"></i>
                        </button>
                    </div>
                `;

                const tableWrapper = document.createElement('div');
                tableWrapper.className = 'rate-table-container';

                function generateZoneInputs(zone) {
                    return `
                        <td>
                            <div class="zone-grid">
                                <div class="zone-header-row">
                                    <div>Fwd</div>
                                    <div>RTO</div>
                                </div>
                                <div class="zone-input-grid">
                                    <input type="text" name="${tableId}_${zone}_fwd1" class="input-compact" value="">
                                    <input type="text" name="${tableId}_${zone}_rto1" class="input-compact" value="">
                                    <input type="text" name="${tableId}_${zone}_fwd2" class="input-compact" value="">
                                    <input type="text" name="${tableId}_${zone}_rto2" class="input-compact" value="">
                                </div>
                            </div>
                        </td>
                    `;
                }

                const table = document.createElement('table');
                table.className = 'rate-table';
                table.innerHTML = `
                    <thead>
                        <tr>
                            <th>Courier</th>
                            <th>Mode</th>
                            <th>Weight (kg)</th>
                           
                            <th class="zone-header">Within City</th>
                            <th class="zone-header">Within State</th>
                            <th class="zone-header">Metro</th>
                            <th class="zone-header">Rest of India</th>
                            <th class="zone-header">NE / J&K</th>
                            <th>COD ₹</th>
                            <th>COD %</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>
                                <div style="display: flex; flex-direction: column; gap: 6px;">
                                    <select name="${tableId}_courier" class="input-compact courier-select">
                                        ${couriers.map(c => `<option value="${c.id}">${c.name}</option>`).join('')}
                                    </select>
                                    <input type="text" name="${tableId}_additional_weight" placeholder="Additional Weight (kg)" class="input-compact">
                                </div>
                            </td>
                            
                            <!-- Mode dropdown will be populated dynamically -->
                            <td>
                                <select name="${tableId}_mode" class="input-compact mode-select"></select>
                            </td>

                            <td>
                                <input type="text" name="${tableId}_base_weight" value="0.5" class="input-compact">
                            </td>

                            ${generateZoneInputs('within_city')}
                            ${generateZoneInputs('within_state')}
                            ${generateZoneInputs('metro_to_metro')}
                            ${generateZoneInputs('rest_of_india')}
                            ${generateZoneInputs('ne_jk')}

                            <td>
                                <input type="text" name="${tableId}_cod_charges" placeholder="30" class="input-compact" value="30">
                            </td>

                            <td>
                                <input type="text" name="${tableId}_cod_percentage" placeholder="1.5%" class="input-compact" value="1.5">
                            </td>
                        </tr>
                    </tbody>
                `;

                tableWrapper.appendChild(table);
                tableContainer.appendChild(tableHeader);
                tableContainer.appendChild(tableWrapper);
                rateConfigContainer.appendChild(tableContainer);

                // Initialize modes for the selected courier
                const courierSelect = tableContainer.querySelector(`.courier-select`);
                const modeSelect = tableContainer.querySelector(`.mode-select`);
                updateModesForCourier(courierSelect.value, modeSelect);

                // Add event listener for courier change
                courierSelect.addEventListener('change', function() {
                    updateModesForCourier(this.value, modeSelect);
                });

                tableContainer.scrollIntoView({
                    behavior: 'smooth',
                    block: 'nearest'
                });
            }

            // Update shipping modes based on selected courier
            function updateModesForCourier(courierId, modeSelect) {
                // Clear existing options
                modeSelect.innerHTML = '';
                
                // Get available modes for this courier
                const modes = courierModesMap[courierId] || {};
                console.log(courierModesMap);
                
                // Create new options
                for (const [value, label] of Object.entries(modes)) {
                    const option = document.createElement('option');
                    console.log(value, label);
                    option.value = label;
                    option.textContent = label;
                    modeSelect.appendChild(option);
                }
                
                // Set default selection if no selection exists
                if (modeSelect.selectedIndex === -1 && modeSelect.options.length > 0) {
                    modeSelect.selectedIndex = 0;
                }
            }

            function removeTable(tableId) {
                const tableToRemove = document.getElementById(tableId);
                if (tableToRemove) {
                    tableToRemove.remove();
                    tableCount--;

                    if (tableCount === 0 && emptyState) {
                        emptyState.style.display = 'block';
                    }
                }
            }

            function saveConfigurations() {
                const tables = document.querySelectorAll('.rate-configuration');
                const configurations = [];

                tables.forEach(table => {
                    const tableId = table.id;
                    const inputs = table.querySelectorAll('input, select');
                    const config = {};

                    inputs.forEach(input => {
                        config[input.name] = input.value;
                    });

                    configurations.push(config);
                });

                console.log('Saving configurations:', configurations);
            }

            addTableBtn.addEventListener('click', createRateTable);
            saveBtn.addEventListener('click', saveConfigurations);

            rateConfigContainer.addEventListener('click', function(e) {
                if (e.target.closest('.remove-table-btn')) {
                    const tableId = e.target.closest('.remove-table-btn').dataset.table;
                    removeTable(tableId);
                }
            });
        });
    </script>
{% endblock js %}
