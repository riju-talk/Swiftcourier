{% extends "components/layouts/layout.dj" %}

{% block title %}
    Send Notification
{% endblock title %}

{% load static %}

{% block css %}
    <style>
        /* Custom Styles */
        .notification-card {
            background: #ffffff;
            border: 1px solid #e5e7eb;
            border-radius: 0.5rem;
            padding: 1rem;
            margin-bottom: 1rem;
            box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05);
        }

        .dark .notification-card {
            background: #1f2937;
            border-color: #374151;
        }

        .notification-actions button {
            font-size: 0.875rem;
            font-weight: 500;
            padding: 0.25rem 0.5rem;
            border-radius: 0.375rem;
            cursor: pointer;
            transition: 0.2s;
        }

        .notification-actions .edit-btn {
            color: #2563eb;
        }

        .notification-actions .delete-btn {
            color: #dc2626;
        }

        .pagination a,
        .pagination span {
            margin: 0 0.25rem;
            padding: 0.5rem 0.75rem;
            border-radius: 0.375rem;
            text-decoration: none;
        }

        .pagination .current {
            background: #4f46e5;
            color: #fff;
        }

        .pagination a:hover {
            background: #e5e7eb;
        }

        .dark .pagination a:hover {
            background: #374151;
        }

        .per-page-form {
            display: flex;
            align-items: center;
            margin-bottom: 1rem;
        }

        .per-page-form label {
            margin-right: 0.5rem;
            font-weight: 500;
        }

        .per-page-form select {
            margin-right: 0.5rem;
            padding: 0.25rem 0.5rem;
            border: 1px solid #d1d5db;
            border-radius: 0.375rem;
            background: #ffffff;
            color: #111827;
        }

        .dark .per-page-form select {
            background: #1f2937;
            color: #f9fafb;
            border-color: #4b5563;
        }

        .per-page-form button {
            padding: 0.5rem 1rem;
            background: #10b981;
            color: #ffffff;
            border: none;
            border-radius: 0.375rem;
            cursor: pointer;
        }

        .per-page-form button:hover {
            background: #059669;
        }
    </style>
{% endblock css %}

{% block body %}
    <div class="container mx-auto px-4 py-8">
        <!-- Notification Form -->
        <div class="mb-8">
            <h1 class="text-2xl font-semibold text-gray-800 dark:text-gray-100 mb-4">Send Notification</h1>
            <form class="space-y-4" method="post">
                {% csrf_token %}
                <textarea name="message"
                          rows="4"
                          class="w-full rounded-lg border border-gray-300 dark:border-gray-600 bg-gray-100 dark:bg-gray-800 text-gray-900 dark:text-gray-100 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500"
                          placeholder="Enter your notification message here..."></textarea>
                <button type="submit"
                        class="px-6 py-2 bg-blue-500 hover:bg-blue-600 dark:bg-blue-400 dark:hover:bg-blue-500 text-white font-semibold rounded-full shadow-md dark:shadow-lg focus:outline-hidden focus:ring-2 focus:ring-blue-300 focus:ring-offset-2 transition">
                    Send Notification
                </button>
            </form>
        </div>

        <!-- Per Page Selector -->
        <div class="per-page-form text-gray-800 dark:text-gray-100">
            <label for="perPageSelect">Show per page:</label>
            <select id="perPageSelect" name="perPage">
                <option>10</option>
                <option>20</option>
                <option>50</option>
                <option>100</option>
                <option>500</option>
            </select>
            <button type="button">Apply</button>
        </div>

        <!-- Notifications List -->
        <div>
            <h2 class="text-xl font-semibold text-gray-800 dark:text-gray-100 mb-4">Previous Notifications</h2>

            {% if notifications %}
                {% for note in notifications %}
                    <div class="notification-card flex justify-between items-start">
                        <div>
                            <p class="text-gray-800 dark:text-gray-100">{{ note.msg }}</p>
                            <p class="text-sm text-gray-500 dark:text-gray-400 mt-2">Sent on {{ note.created_at|date:"F j, Y, g:i A" }}</p>
                            <p class="text-xs mt-1 text-gray-500 dark:text-gray-400">
                                Category: {{ note.get_category_display }}
                                {% if note.is_read %}· Read at {{ note.read_at|date:"F j, Y, g:i A" }}{% endif %}
                            </p>
                        </div>
                        <div class="notification-actions flex space-x-2">
                            <button class="edit-btn">Edit</button>
                            <button class="delete-btn">Delete</button>
                        </div>
                    </div>
                {% endfor %}
            {% else %}
                <p class="text-gray-600 dark:text-gray-400">No notifications have been sent yet.</p>
            {% endif %}
        </div>
    </div>
{% endblock body %}

{% block js %}
    <script>
        console.log('Notification page loaded');
    </script>
{% endblock js %}
