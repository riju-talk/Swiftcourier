{% extends "components/layouts/layout.dj" %}

{% block title %}Change Password{% endblock title %}

{% load static %}

{% block body %}
<div class="min-h-screen bg-neutral-50 dark:bg-[#0a0d14] flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8">
    <div class="w-full max-w-md">
        <div class="rounded-lg border border-neutral-200 dark:border-white/10 bg-white dark:bg-black/50 p-8 shadow-sm">
            <div class="mb-8">
                <h1 class="text-2xl font-bold text-black dark:text-white">Change password</h1>
                <p class="mt-2 text-sm text-neutral-600 dark:text-neutral-400">Update your password to keep your account secure</p>
            </div>

            <form class="space-y-5" method="POST" novalidate>
                {% csrf_token %}

                <div>
                    <label for="current_password" class="block text-sm font-medium text-black dark:text-white mb-1.5">Current password</label>
                    <input id="current_password"
                           name="current_password"
                           type="password"
                           required
                           placeholder="Enter current password"
                           class="block w-full rounded-lg border border-neutral-300 dark:border-white/10 bg-white dark:bg-white/5 px-3.5 py-2.5 text-sm text-black dark:text-white placeholder:text-neutral-400 dark:placeholder:text-neutral-500 focus:border-red-600 dark:focus:border-red-500 focus:outline-none focus:ring-2 focus:ring-red-600/20" />
                </div>

                <div>
                    <label for="new_password" class="block text-sm font-medium text-black dark:text-white mb-1.5">New password</label>
                    <input id="new_password"
                           name="new_password"
                           type="password"
                           required
                           placeholder="Enter new password"
                           class="block w-full rounded-lg border border-neutral-300 dark:border-white/10 bg-white dark:bg-white/5 px-3.5 py-2.5 text-sm text-black dark:text-white placeholder:text-neutral-400 dark:placeholder:text-neutral-500 focus:border-red-600 dark:focus:border-red-500 focus:outline-none focus:ring-2 focus:ring-red-600/20" />
                </div>

                <div>
                    <label for="confirm_password" class="block text-sm font-medium text-black dark:text-white mb-1.5">Confirm new password</label>
                    <input id="confirm_password"
                           name="confirm_password"
                           type="password"
                           required
                           placeholder="Re-enter new password"
                           class="block w-full rounded-lg border border-neutral-300 dark:border-white/10 bg-white dark:bg-white/5 px-3.5 py-2.5 text-sm text-black dark:text-white placeholder:text-neutral-400 dark:placeholder:text-neutral-500 focus:border-red-600 dark:focus:border-red-500 focus:outline-none focus:ring-2 focus:ring-red-600/20" />
                    <p id="passwordMismatchTip"
                       class="mt-1.5 max-h-0 overflow-hidden text-xs font-medium text-red-600 opacity-0 transition-all duration-200 ease-out">
                        Passwords do not match
                    </p>
                </div>

                <button type="submit" id="changePasswordSubmitBtn"
                        class="w-full rounded-lg bg-black dark:bg-red-600 px-4 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-red-600 dark:hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-red-600/20 disabled:cursor-not-allowed disabled:opacity-50">
                    Update password
                </button>
            </form>
        </div>
    </div>
</div>
{% endblock body %}

{% block js %}
<script>
document.addEventListener('DOMContentLoaded', function () {
    var passwordInput = document.getElementById('new_password');
    var confirmInput = document.getElementById('confirm_password');
    var tip = document.getElementById('passwordMismatchTip');
    var submitBtn = document.getElementById('changePasswordSubmitBtn');
    function checkMatch() {
        var mismatch = confirmInput.value.length > 0 && passwordInput.value !== confirmInput.value;
        tip.classList.toggle('opacity-100', mismatch);
        tip.classList.toggle('max-h-6', mismatch);
        tip.classList.toggle('opacity-0', !mismatch);
        tip.classList.toggle('max-h-0', !mismatch);
        confirmInput.classList.toggle('border-red-600', mismatch);
        submitBtn.disabled = mismatch;
    }
    if (passwordInput && confirmInput && tip && submitBtn) {
        passwordInput.addEventListener('input', checkMatch);
        confirmInput.addEventListener('input', checkMatch);
    }
});
</script>
{% endblock js %}
