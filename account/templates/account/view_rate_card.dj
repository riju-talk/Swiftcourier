{% extends "components/layouts/layout.dj" %}

{% load static %}

{% block title %}
    Rate Card
{% endblock title %}

{% block css %}
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        primary: {
                            50: '#f0f9ff',
                            100: '#e0f2fe',
                            600: '#0284c7',
                            700: '#0369a1',
                        },
                    }
                }
            }
        }
    </script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap');

        .card {
            border-radius: 16px;
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1), 0 8px 10px -6px rgba(0, 0, 0, 0.05);
            transition: all 0.3s ease;
        }

        .card:hover {
            transform: translateY(-5px);
            box-shadow: 0 20px 30px -10px rgba(0, 0, 0, 0.15);
        }

        .table-header {
            position: sticky;
            top: 0;
            z-index: 10;
        }

        .table-row:hover {
            background-color: #f8fafc;
        }

        .dark .table-row:hover {
            background-color: #1e293b;
        }

        .mode-badge {
            display: inline-block;
            padding: 3px 10px;
            border-radius: 20px;
            font-size: 0.75rem;
            font-weight: 600;
            min-width: 80px;
            text-align: center;
        }

        .surface-badge {
            background-color: #fee2e2;
            color: #b91c1c;
        }

        .air-badge {
            background-color: #f0fdf4;
            color: #15803d;
        }

        .express-badge {
            background-color: #fdf2f8;
            color: #db2777;
        }

        .hyperlocal-badge {
            background-color: #fffbeb;
            color: #b45309;
        }

        .dark .surface-badge {
            background-color: #1e3a8a;
            color: #fee2e2;
        }

        .dark .air-badge {
            background-color: #14532d;
            color: #bbf7d0;
        }

        .dark .express-badge {
            background-color: #831843;
            color: #fbcfe8;
        }

        .dark .hyperlocal-badge {
            background-color: #78350f;
            color: #fde68a;
        }

        .courier-icon {
            width: 36px;
            height: 36px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-right: 12px;
            flex-shrink: 0;
        }

        .highlight-cell {
            position: relative;
            font-weight: 600;
        }

        .highlight-cell::after {
            content: "";
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: 36px;
            height: 36px;
            border-radius: 50%;
            background-color: #e0f2fe;
            z-index: -1;
        }

        .dark .highlight-cell::after {
            background-color: #0c4a6e;
        }

        /* New styles for additional pricing */
        .price-container {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
        }

        .base-price {
            font-weight: 600;
            font-size: 1rem;
            margin-bottom: 2px;
        }

        .additional-price {
            font-size: 0.8rem;
            color: #64748b;
            display: flex;
            align-items: center;
        }

        .additional-price-label {
            font-size: 0.7rem;
            margin-right: 4px;
            color: #64748b;
        }

        .price-divider {
            margin: 0 4px;
            color: #cbd5e1;
        }

        .dark .additional-price {
            color: #94a3b8;
        }

        .dark .additional-price-label {
            color: #94a3b8;
        }

        .dark .price-divider {
            color: #475569;
        }

        @media (max-width: 1024px) {
            .responsive-table {
                display: block;
                overflow-x: auto;
                white-space: nowrap;
            }

            .responsive-table table {
                min-width: 900px;
            }
        }
    </style>
{% endblock css %}

{% block body %}
    <div>
        <button onclick="history.back()"
                class="border border-red-500 hover:bg-red-700 text-red-500 hover:text-white font-bold py-2 px-4 rounded-sm">
            Back
        </button>
    </div>
    {% if user.rate_card %}
        <div class="max-w-6xl mx-auto px-4">
            <!-- Header -->
            <div class="text-center mb-12">
                <h1 class="text-3xl md:text-4xl font-bold text-gray-800 dark:text-white mb-3">Courier Shipping Rates</h1>
                <p class="text-gray-600 dark:text-gray-300 max-w-2xl mx-auto">
                    Compare rates across different courier services and shipping zones
                </p>
            </div>

            <!-- Card Container -->
            <div class="card bg-white dark:bg-[#12151f] p-4 md:p-6">
                <!-- Filters Section -->
                <div class="flex flex-wrap gap-4 justify-between items-center mb-6 pb-4 border-b border-gray-200 dark:border-white/10">
                    <div class="flex flex-wrap gap-4">
                        <!-- Mode Filter -->
                        <div>
                            <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Mode / Type</label>
                            <div class="relative">
                                <select class="w-44 px-3 py-2.5 border border-gray-300 dark:border-white/10 rounded-xl bg-white dark:bg-[#12151f] text-sm text-black dark:text-white focus:outline-hidden focus:ring-2 focus:ring-primary-600">
                                    <option value="">All Types</option>
                                    <option value="Surface">Surface</option>
                                    <option value="Air">Air</option>
                                    <option value="Express">Express</option>
                                    <option value="Hyperlocal">Hyperlocal</option>
                                </select>
                                <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-2 text-gray-700 dark:text-gray-300">
                                    <i class="fas fa-chevron-down text-sm"></i>
                                </div>
                            </div>
                        </div>

                        <!-- Weight Filter -->
                        <div>
                            <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Weight</label>
                            <div class="relative">
                                <select class="w-44 px-3 py-2.5 border border-gray-300 dark:border-white/10 rounded-xl bg-white dark:bg-[#12151f] text-sm text-black dark:text-white focus:outline-hidden focus:ring-2 focus:ring-primary-600">
                                    <option value="">All Weights</option>
                                    <option value="0.5kg">0.5 KG</option>
                                    <option value="1kg">1 KG</option>
                                    <option value="1.5kg">1.5 KG</option>
                                    <option value="2kg">2 KG</option>
                                </select>
                                <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-2 text-gray-700 dark:text-gray-300">
                                    <i class="fas fa-chevron-down text-sm"></i>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="flex items-center">
                        <div class="relative">
                            <input type="text"
                                   placeholder="Search couriers"
                                   class="pl-10 pr-4 py-2.5 border border-gray-300 dark:border-white/10 rounded-xl bg-white dark:bg-[#12151f] text-sm w-64 focus:outline-hidden focus:ring-2 focus:ring-primary-600">
                            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                                <i class="fas fa-search text-gray-400"></i>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Table Section -->
                <div class="responsive-table overflow-x-auto rounded-xl">
                    <table class="w-full text-sm">
                        <thead>
                            <tr class="table-header bg-gray-100 dark:bg-[#12151f]">
                                <th class="px-4 py-4 text-left font-semibold text-gray-700 dark:text-gray-300">Courier</th>
                                <th class="px-4 py-4 text-left font-semibold text-gray-700 dark:text-gray-300">Mode</th>
                                <th class="px-4 py-4 text-center font-semibold text-gray-700 dark:text-gray-300">
                                    <div class="text-xs text-gray-400 mb-1">Zone A</div>
                                    Within City
                                </th>
                                <th class="px-4 py-4 text-center font-semibold text-gray-700 dark:text-gray-300">
                                    <div class="text-xs text-gray-400 mb-1">Zone B</div>
                                    Within State
                                </th>
                                <th class="px-4 py-4 text-center font-semibold text-gray-700 dark:text-gray-300">
                                    <div class="text-xs text-gray-400 mb-1">Zone C</div>
                                    Metro to Metro
                                </th>
                                <th class="px-4 py-4 text-center font-semibold text-gray-700 dark:text-gray-300">
                                    <div class="text-xs text-gray-400 mb-1">Zone D</div>
                                    Rest of India
                                </th>
                                <th class="px-4 py-4 text-center font-semibold text-gray-700 dark:text-gray-300">
                                    <div class="text-xs text-gray-400 mb-1">Zone E</div>
                                    NE / J&amp;K
                                </th>
                                <th class="px-4 py-4 text-center font-semibold text-gray-700 dark:text-gray-300">COD Charges</th>
                                <th class="px-4 py-4 text-center font-semibold text-gray-700 dark:text-gray-300">COD %</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-200 dark:divide-gray-700">
                            <!-- Surface Row -->
                            <tr class="table-row bg-white dark:bg-[#12151f] hover:bg-gray-50 dark:hover:bg-gray-800/50">
                                <td class="px-4 py-4 font-medium align-top">
                                    <div class="flex items-start space-x-3">
                                        <!-- Icon for Xpressbees -->
                                        <div class="courier-icon bg-red-100 dark:bg-red-900 p-2 rounded-sm">
                                            <i class="fas fa-shipping-fast text-red-600 dark:text-red-400"></i>
                                        </div>

                                        <!-- Courier Info -->
                                        <div class="flex flex-col">
                                            <span class="text-base font-semibold text-gray-800 dark:text-white">{{ user.rate_card.get_courier_display }}</span>
                                            <span class="text-xs text-gray-500 dark:text-gray-400 mt-1">Addl. 1kg</span>
                                        </div>
                                    </div>
                                </td>

                                <td class="px-4 py-4">
                                    <span class="mode-badge surface-badge">Surface</span>
                                </td>

                                <!-- Zones for Surface -->
                                <!-- Within City -->
                                <td class="px-4 py-4 text-center">
                                    <div class="price-container">
                                        <div class="base-price">₹{{ user.rate_card.surface_within_city.forward_base }}</div>
                                        <div class="additional-price">
                                            <span>₹{{ user.rate_card.surface_within_city.forward_additional }} | ₹{{ user.rate_card.surface_within_city.rto_additional }}</span>
                                        </div>
                                    </div>
                                </td>

                                <!-- Within State -->
                                <td class="px-4 py-4 text-center">
                                    <div class="price-container">
                                        <div class="base-price">₹{{ user.rate_card.surface_within_state.forward_base }}</div>
                                        <div class="additional-price">
                                            <span>₹{{ user.rate_card.surface_within_state.forward_additional }} | ₹{{ user.rate_card.surface_within_state.rto_additional }}</span>
                                        </div>
                                    </div>
                                </td>

                                <!-- Metro to Metro -->
                                <td class="px-4 py-4 text-center">
                                    <div class="price-container">
                                        <div class="base-price">₹{{ user.rate_card.surface_metro_to_metro.forward_base }}</div>
                                        <div class="additional-price">
                                            <span>₹{{ user.rate_card.surface_metro_to_metro.forward_additional }} | ₹{{ user.rate_card.surface_metro_to_metro.rto_additional }}</span>
                                        </div>
                                    </div>
                                </td>

                                <!-- Rest of India -->
                                <td class="px-4 py-4 text-center">
                                    <div class="price-container">
                                        <div class="base-price">₹{{ user.rate_card.surface_rest_of_india.forward_base }}</div>
                                        <div class="additional-price">
                                            <span>₹{{ user.rate_card.surface_rest_of_india.forward_additional }} | ₹{{ user.rate_card.surface_rest_of_india.rto_additional }}</span>
                                        </div>
                                    </div>
                                </td>

                                <!-- NE / J&K -->
                                <td class="px-4 py-4 text-center">
                                    <div class="price-container">
                                        <div class="base-price">₹{{ user.rate_card.surface_ne_jk.forward_base }}</div>
                                        <div class="additional-price">
                                            <span>₹{{ user.rate_card.surface_ne_jk.forward_additional }} | ₹{{ user.rate_card.surface_ne_jk.rto_additional }}</span>
                                        </div>
                                    </div>
                                </td>

                                <!-- COD Charges -->
                                <td class="px-4 py-4 text-center text-gray-700 dark:text-gray-300">₹{{ user.rate_card.surface_cod_charges }}</td>

                                <!-- COD % -->
                                <td class="px-4 py-4 text-center text-gray-700 dark:text-gray-300">{{ user.rate_card.surface_cod_percentage }}%</td>
                            </tr>

                            <!-- Air Row -->
                            <tr class="table-row bg-white dark:bg-[#12151f] hover:bg-gray-50 dark:hover:bg-gray-800/50">
                                <td class="px-4 py-4 font-medium align-top">
                                    <div class="flex items-start space-x-3">
                                        <!-- Icon for Xpressbees -->
                                        <div class="courier-icon bg-red-100 dark:bg-red-900 p-2 rounded-sm">
                                            <i class="fas fa-shipping-fast text-red-600 dark:text-red-400"></i>
                                        </div>

                                        <!-- Courier Info -->
                                        <div class="flex flex-col">
                                            <span class="text-base font-semibold text-gray-800 dark:text-white">{{ user.rate_card.get_courier_display }}</span>
                                            <span class="text-xs text-gray-500 dark:text-gray-400 mt-1">Addl. 1kg</span>
                                        </div>
                                    </div>
                                </td>

                                <td class="px-4 py-4">
                                    <span class="mode-badge air-badge">Air</span>
                                </td>

                                <!-- Zones for Air -->
                                <!-- Within City -->
                                <td class="px-4 py-4 text-center">
                                    <div class="price-container">
                                        <div class="base-price">₹{{ user.rate_card.air_within_city.forward_base }}</div>
                                        <div class="additional-price">
                                            <span>₹{{ user.rate_card.air_within_city.forward_additional }} | ₹{{ user.rate_card.air_within_city.rto_additional }}</span>
                                        </div>
                                    </div>
                                </td>

                                <!-- Within State -->
                                <td class="px-4 py-4 text-center">
                                    <div class="price-container">
                                        <div class="base-price">₹{{ user.rate_card.air_within_state.forward_base }}</div>
                                        <div class="additional-price">
                                            <span>₹{{ user.rate_card.air_within_state.forward_additional }} | ₹{{ user.rate_card.air_within_state.rto_additional }}</span>
                                        </div>
                                    </div>
                                </td>

                                <!-- Metro to Metro -->
                                <td class="px-4 py-4 text-center">
                                    <div class="price-container">
                                        <div class="base-price">₹{{ user.rate_card.air_metro_to_metro.forward_base }}</div>
                                        <div class="additional-price">
                                            <span>₹{{ user.rate_card.air_metro_to_metro.forward_additional }} | ₹{{ user.rate_card.air_metro_to_metro.rto_additional }}</span>
                                        </div>
                                    </div>
                                </td>

                                <!-- Rest of India -->
                                <td class="px-4 py-4 text-center">
                                    <div class="price-container">
                                        <div class="base-price">₹{{ user.rate_card.air_rest_of_india.forward_base }}</div>
                                        <div class="additional-price">
                                            <span>₹{{ user.rate_card.air_rest_of_india.forward_additional }} | ₹{{ user.rate_card.air_rest_of_india.rto_additional }}</span>
                                        </div>
                                    </div>
                                </td>

                                <!-- NE / J&K -->
                                <td class="px-4 py-4 text-center">
                                    <div class="price-container">
                                        <div class="base-price">₹{{ user.rate_card.air_ne_jk.forward_base }}</div>
                                        <div class="additional-price">
                                            <span>₹{{ user.rate_card.air_ne_jk.forward_additional }} | ₹{{ user.rate_card.air_ne_jk.rto_additional }}</span>
                                        </div>
                                    </div>
                                </td>

                                <!-- COD Charges -->
                                <td class="px-4 py-4 text-center text-gray-700 dark:text-gray-300">₹{{ user.rate_card.air_cod_charges }}</td>

                                <!-- COD % -->
                                <td class="px-4 py-4 text-center text-gray-700 dark:text-gray-300">{{ user.rate_card.air_cod_percentage }}%</td>
                            </tr>
                        </tbody>
                    </table>
                </div>


                <!-- Info Section -->
                <div class="mt-8 grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div class="card bg-white dark:bg-[#12151f] p-5">
                        <div class="flex items-start">
                            <div class="bg-red-100 dark:bg-red-900 p-3 rounded-lg mr-4">
                                <i class="fas fa-info-circle text-red-600 dark:text-red-400 text-xl"></i>
                            </div>
                            <div>
                                <h3 class="font-semibold text-lg mb-1">Zone Definitions</h3>
                                <p class="text-gray-600 dark:text-gray-400 text-sm">
                                    Within City: Same city delivery
                                    <br>
                                    Within State: Same state delivery
                                    <br>
                                    Metro: Delivery to metro cities
                                    <br>
                                    Rest of India: Non-metro cities
                                    <br>
                                    NE / J&amp;K: North East &amp; Jammu/Kashmir
                                </p>
                            </div>
                        </div>
                    </div>

                    <div class="card bg-white dark:bg-[#12151f] p-5">
                        <div class="flex items-start">
                            <div class="bg-green-100 dark:bg-green-900 p-3 rounded-lg mr-4">
                                <i class="fas fa-percentage text-green-600 dark:text-green-400 text-xl"></i>
                            </div>
                            <div>
                                <h3 class="font-semibold text-lg mb-1">Weight Pricing</h3>
                                <p class="text-gray-600 dark:text-gray-400 text-sm">
                                    Base price: For first kg (or 0.5kg as specified)
                                    <br>
                                    Additional price: Per kg or 0.5kg beyond base weight
                                    <br>
                                    Example: ₹35 base + ₹25 per 0.5kg
                                </p>
                            </div>
                        </div>
                    </div>
                </div>

                
            <!-- Terms & Conditions -->
            <div class="card bg-white dark:bg-[#12151f] p-6 rounded-2xl shadow-md hover:shadow-lg transition-shadow mt-8">
                <div class="flex items-start space-x-4">

                    <!-- Icon -->
                    <div class="shrink-0 bg-yellow-100 dark:bg-yellow-900 p-3 rounded-xl">
                        <i class="fas fa-file-contract text-yellow-600 dark:text-yellow-400 text-2xl"></i>
                    </div>

                    <!-- Content -->
                    <div class="flex-1">
                        <h3 class="font-bold text-xl mb-4 text-black dark:text-white">Terms & Conditions</h3>

                        <ul class="space-y-3 text-gray-700 dark:text-gray-300 text-sm leading-relaxed">
                            <li class="flex items-start">
                                <span class="font-semibold mr-2 text-yellow-600 dark:text-yellow-400">1.</span>
                                <span>Above prices are inclusive of GST.</span>
                            </li>
                            <li class="flex items-start">
                                <span class="font-semibold mr-2 text-yellow-600 dark:text-yellow-400">2.</span>
                                <span>Chargeable Weight will be Physical / Dead Weight or Volumetric Weight whichever is Higher.</span>
                            </li>
                            <li class="flex items-start">
                                <span class="font-semibold mr-2 text-yellow-600 dark:text-yellow-400">3.</span>
                                <span>COD Charges will be fixed COD charge or COD % of the order value whichever is Higher.</span>
                            </li>
                            <li class="flex items-start">
                                <span class="font-semibold mr-2 text-yellow-600 dark:text-yellow-400">4.</span>
                                <span>Volumetric Weight (Kilogram) calculation as per IATA - Length (cm) × Breadth (cm) × Height (cm) / 5000.</span>
                            </li>
                            <li class="flex items-start">
                                <span class="font-semibold mr-2 text-yellow-600 dark:text-yellow-400">5.</span>
                                <span>Other Charges like Octroi, state entry tax and fees, address correction charges if applicable shall be charged extra.</span>
                            </li>
                            <li class="flex items-start">
                                <span class="font-semibold mr-2 text-yellow-600 dark:text-yellow-400">6.</span>
                                <span>RTO (return to origin) shipment will be charged separately from the forward delivery rate, which will be same as Forward Rates.</span>
                            </li>
                            <li class="flex items-start">
                                <span class="font-semibold mr-2 text-yellow-600 dark:text-yellow-400">7.</span>
                                <span>The maximum liability if any is limited to ₹1000/- in event of a claim by the Merchant, provided such claim is raised within one (1) month from the date of such damage or loss or theft.</span>
                            </li>
                            <li class="flex items-start">
                                <span class="font-semibold mr-2 text-yellow-600 dark:text-yellow-400">8.</span>
                                <span>The Merchant shall not book / handover or allow to be handed over any Product which is banned, restricted, illegal, prohibited, stolen, infringing of any third-party rights, liquid materials, hazardous or dangerous, or in breach of any law or regulation in force in India.</span>
                            </li>
                        </ul>

                        <p class="text-gray-500 dark:text-gray-400 text-xs mt-4 italic">
                            Other terms and conditions will be applicable as defined in the agreement.
                        </p>
                    </div>
                </div>
            </div>


            </div>

            <!-- Footer Note -->
            <div class="mt-8 text-center text-sm text-gray-500 dark:text-gray-400">
                <p>SwiftCourier Rate card .</p>
            </div>
        </div>
    {% else %}
        <section class="min-h-screen flex items-center justify-center px-4 py-16 bg-gray-100 dark:bg-[#0e1726]">
            <style>
                .custom-btn {
                    background: linear-gradient(to right, #667eea, #764ba2);
                    padding: 0.75rem 2rem;
                    border-radius: 9999px;
                    font-size: 1rem;
                    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.1);
                    transition: background 0.3s ease;
                    color: white;
                    font-weight: 600;
                    display: inline-block;
                    text-align: center;
                }

                .custom-btn:hover {
                    background: linear-gradient(to right, #5a67d8, #6b46c1);
                }
            </style>

            <div class="flex flex-col items-center justify-center gap-6 py-20 px-10 bg-gray-50 dark:bg-[#12151f] rounded-xl shadow-lg max-w-xl w-full">
                <div class="text-7xl text-gray-300 dark:text-gray-600">
                    <i class="fas fa-box-open"></i>
                </div>
                <h2 class="text-3xl font-semibold text-gray-700 dark:text-gray-200">No Rate Card Assigned</h2>
                <p class="text-center text-gray-500 dark:text-gray-400 max-w-md text-lg">
                    It looks like you haven’t been assigned any shipping rates yet.
                    Reach out to your administrator to get started!
                </p>
                <a href="#" class="custom-btn">Contact Admin</a>
            </div>
        </section>

    {% endif %}


{% endblock body %}

{% block js %}
    <script>
        // Theme toggle functionality
        const html = document.documentElement;
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;

        // Set initial theme based on system preference
        if (prefersDark) {
            html.classList.add('light');
        } else {
            html.classList.remove('dark');
        }

        // Function to highlight the lowest price in each column
        function highlightLowestPrices() {
            const columns = [{
                    index: 2,
                    prices: []
                }, // Within City
                {
                    index: 3,
                    prices: []
                }, // Within State
                {
                    index: 4,
                    prices: []
                }, // Metro to Metro
                {
                    index: 5,
                    prices: []
                }, // Rest of India
                {
                    index: 6,
                    prices: []
                }, // NE / J&K
            ];

            // Get all table rows
            const rows = document.querySelectorAll('tbody tr');

            // Collect all prices for each column
            rows.forEach(row => {
                columns.forEach(col => {
                    const cell = row.children[col.index];
                    // Find the base price element
                    const basePriceElement = cell.querySelector('.base-price');
                    if (basePriceElement) {
                        const priceText = basePriceElement.textContent;
                        const price = parseInt(priceText.replace('₹', ''));
                        col.prices.push({
                            price,
                            cell
                        });
                    }
                });
            });

            // Find the minimum for each column and highlight
            columns.forEach(col => {
                const minPrice = Math.min(...col.prices.map(item => item.price));
                col.prices.forEach(item => {
                    if (item.price === minPrice) {
                        item.cell.classList.add('highlight-cell');
                    } else {
                        item.cell.classList.remove('highlight-cell');
                    }
                });
            });
        }

        // Run on page load
        document.addEventListener('DOMContentLoaded', highlightLowestPrices);
    </script>
{% endblock js %}
