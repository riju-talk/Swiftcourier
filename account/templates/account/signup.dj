{% extends "components/layouts/auth_layout.dj" %}
{% load static %}

{% block title %}Sign Up{% endblock title %}

{% block body %}
<div class="min-h-screen w-full bg-black lg:grid lg:grid-cols-2">

    <!-- Brand panel -->
    <div class="relative hidden overflow-hidden bg-black px-10 py-12 lg:flex lg:flex-col lg:justify-between xl:px-16 xl:py-16">
        <div class="pointer-events-none absolute -left-24 -top-32 h-96 w-96 rounded-full bg-red-600/20 blur-3xl"></div>
        <div class="pointer-events-none absolute -right-16 bottom-0 h-72 w-72 rounded-full bg-red-700/10 blur-3xl"></div>

        <div class="relative">
            <span class="text-2xl font-extrabold tracking-tight text-white">
                Swift<span class="text-red-500">Courier</span>
            </span>
            <p class="mt-1 text-xs font-semibold uppercase tracking-[0.3em] text-white/40">Logistics Platform</p>
        </div>

        <div class="relative mt-16 max-w-md">
            <h1 class="text-3xl font-bold leading-tight text-white xl:text-4xl">
                Start shipping smarter in minutes.
            </h1>
            <p class="mt-4 text-base leading-relaxed text-white/60">
                Create your account to manage every courier, track shipments in real time and reconcile COD &mdash; all from one dashboard.
            </p>

            <dl class="mt-10 grid grid-cols-3 gap-6 border-t border-white/10 pt-6">
                <div>
                    <dt class="text-xs uppercase tracking-wide text-white/40">Couriers</dt>
                    <dd class="mt-1 text-xl font-bold text-white">15+</dd>
                </div>
                <div>
                    <dt class="text-xs uppercase tracking-wide text-white/40">Setup</dt>
                    <dd class="mt-1 text-xl font-bold text-white">Minutes</dd>
                </div>
                <div>
                    <dt class="text-xs uppercase tracking-wide text-white/40">Support</dt>
                    <dd class="mt-1 text-xl font-bold text-white">24/7</dd>
                </div>
            </dl>
        </div>

        <div class="relative mt-16">
            <p class="mb-4 text-xs font-semibold uppercase tracking-widest text-white/40">Ship with</p>
            <div class="grid grid-cols-4 gap-2.5">
                <span class="flex h-11 items-center justify-center rounded-lg bg-white/5 px-2 text-center text-xs font-semibold text-white/80 ring-1 ring-white/10">Delhivery</span>
                <span class="flex h-11 items-center justify-center rounded-lg bg-white/5 px-2 text-center text-xs font-bold text-white/80 ring-1 ring-white/10">DTDC</span>
                <span class="flex h-11 items-center justify-center rounded-lg bg-white/5 px-2 text-center text-xs font-bold text-white/80 ring-1 ring-white/10">Blue Dart</span>
                <span class="flex h-11 items-center justify-center rounded-lg bg-white/5 px-2 text-center text-xs font-bold text-white/80 ring-1 ring-white/10">XpressBees</span>
                <span class="flex h-11 items-center justify-center rounded-lg bg-white/5 px-2 text-center text-xs font-bold text-white/80 ring-1 ring-white/10">Shadowfax</span>
                <span class="flex h-11 items-center justify-center rounded-lg bg-white/5 px-2 text-center text-xs font-bold text-white/80 ring-1 ring-white/10">Ekart</span>
                <span class="flex h-11 items-center justify-center rounded-lg bg-white/5 px-2 text-center text-xs font-bold text-white/80 ring-1 ring-white/10">India Post</span>
                <span class="flex h-11 items-center justify-center rounded-lg bg-white/5 px-2 text-center text-xs font-bold text-white/80 ring-1 ring-white/10">Amazon</span>
            </div>
        </div>
    </div>

    <!-- Sign-up form panel -->
    <div class="flex min-h-screen items-center justify-center bg-white px-6 py-12 sm:px-10">
        <div class="w-full max-w-sm">
            <span class="text-xl font-extrabold tracking-tight text-black lg:hidden">Swift<span class="text-red-600">Courier</span></span>

            <h2 class="mt-8 text-2xl font-bold text-black">Create your account</h2>
            <p class="mt-1 text-sm text-neutral-500">Enter your details to get started</p>

            <form class="mt-8 space-y-4" action="{% url 'account:signup' %}" method="post">
                {% csrf_token %}

                <div>
                    <label for="Name" class="mb-1.5 block text-sm font-medium text-black">Full name</label>
                    <input id="Name" name="full_name" type="text" placeholder="Your name" required
                           class="block w-full rounded-lg border border-neutral-300 px-3.5 py-2.5 text-sm text-black placeholder:text-neutral-400 focus:border-red-600 focus:outline-none focus:ring-2 focus:ring-red-600/20" />
                </div>

                <div>
                    <label for="Email" class="mb-1.5 block text-sm font-medium text-black">Email</label>
                    <input id="Email" name="email" type="email" placeholder="you@company.com" required
                           class="block w-full rounded-lg border border-neutral-300 px-3.5 py-2.5 text-sm text-black placeholder:text-neutral-400 focus:border-red-600 focus:outline-none focus:ring-2 focus:ring-red-600/20" />
                </div>

                <div>
                    <label for="ContactNo" class="mb-1.5 block text-sm font-medium text-black">Contact number</label>
                    <input id="ContactNo" name="contact_no" type="tel" placeholder="10-digit mobile number" required
                           class="block w-full rounded-lg border border-neutral-300 px-3.5 py-2.5 text-sm text-black placeholder:text-neutral-400 focus:border-red-600 focus:outline-none focus:ring-2 focus:ring-red-600/20" />
                </div>

                <div>
                    <label for="Password" class="mb-1.5 block text-sm font-medium text-black">Password</label>
                    <div class="relative">
                        <input id="Password" name="password" type="password" placeholder="Create a password" required
                               class="block w-full rounded-lg border border-neutral-300 px-3.5 py-2.5 pr-10 text-sm text-black placeholder:text-neutral-400 focus:border-red-600 focus:outline-none focus:ring-2 focus:ring-red-600/20" />
                        <button type="button" id="togglePasswordEye" aria-label="Show password"
                                class="absolute inset-y-0 right-0 flex items-center pr-3 text-neutral-400 hover:text-black">
                            <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
                                <path d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                                <path d="M2.458 12C3.732 7.943 7.523 5 12 5c4.477 0 8.268 2.943 9.542 7-1.274 4.057-5.065 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
                            </svg>
                        </button>
                    </div>
                </div>

                <div>
                    <label for="ConfirmPassword" class="mb-1.5 block text-sm font-medium text-black">Confirm password</label>
                    <input id="ConfirmPassword" name="confirm_password" type="password" placeholder="Re-enter password" required
                           class="block w-full rounded-lg border border-neutral-300 px-3.5 py-2.5 text-sm text-black placeholder:text-neutral-400 focus:border-red-600 focus:outline-none focus:ring-2 focus:ring-red-600/20" />
                    <p id="passwordMismatchTip"
                       class="mt-1.5 max-h-0 overflow-hidden text-xs font-medium text-red-600 opacity-0 transition-all duration-200 ease-out">
                        Passwords do not match
                    </p>
                </div>

                <button type="submit" id="signupSubmitBtn"
                        class="w-full rounded-lg bg-black px-4 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-red-600 disabled:cursor-not-allowed disabled:opacity-50">
                    Create account
                </button>
            </form>

            <p class="mt-6 text-center text-sm text-neutral-500">
                Already have an account?
                <a href="{% url 'account:signin' %}" class="font-semibold text-red-600 hover:text-red-700">Sign in</a>
            </p>
        </div>
    </div>
</div>
{% endblock body %}

{% block js %}
<script>
document.addEventListener('DOMContentLoaded', function () {
    var passwordInput = document.getElementById('Password');
    var toggleBtn = document.getElementById('togglePasswordEye');
    if (passwordInput && toggleBtn) {
        toggleBtn.addEventListener('click', function () {
            var showing = passwordInput.type === 'password';
            passwordInput.type = showing ? 'text' : 'password';
            toggleBtn.classList.toggle('text-black', showing);
            toggleBtn.classList.toggle('text-neutral-400', !showing);
        });
    }

    var confirmInput = document.getElementById('ConfirmPassword');
    var tip = document.getElementById('passwordMismatchTip');
    var submitBtn = document.getElementById('signupSubmitBtn');
    function checkMatch() {
        var mismatch = confirmInput.value.length > 0 && passwordInput.value !== confirmInput.value;
        tip.classList.toggle('opacity-100', mismatch);
        tip.classList.toggle('max-h-6', mismatch);
        tip.classList.toggle('opacity-0', !mismatch);
        tip.classList.toggle('max-h-0', !mismatch);
        confirmInput.classList.toggle('border-red-600', mismatch);
        confirmInput.classList.toggle('focus:ring-red-600/20', !mismatch);
        submitBtn.disabled = mismatch;
    }
    if (passwordInput && confirmInput && tip && submitBtn) {
        passwordInput.addEventListener('input', checkMatch);
        confirmInput.addEventListener('input', checkMatch);
    }
});
</script>
{% endblock js %}
