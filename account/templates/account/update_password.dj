{% extends "components/layouts/layout.dj" %}

{% block title %}
    Update Password
{% endblock title %}

{% load static %}

{% block body %}
<div>
            <button onclick="history.back()"
                    class="border border-red-500 hover:bg-red-700 text-red-500 hover:text-white font-bold py-2 px-4 rounded-sm">
                Back
            </button>
        </div>
<div class="min-h-screen bg-gray-50 flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8">

    <div class="max-w-md w-full space-y-8">
        <div class="text-center">
            <h2 class="text-3xl font-extrabold text-gray-900">Update User Password</h2>
            <p class="mt-2 text-sm text-gray-600">Only admins or super admins can update passwords</p>
        </div>

        <form class="mt-8 space-y-6" method="POST" novalidate>
            {% csrf_token %}
            <div class="rounded-md shadow-xs space-y-4">
                <div>
                    <label for="new_password" class="block text-sm font-medium text-gray-700">New Password</label>
                    <input id="new_password" name="new_password" type="password" required
                        class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-xs 
                               focus:outline-hidden focus:ring-red-500 focus:border-red-500 transition duration-150"
                        placeholder="Enter new password">
                </div>

                <div>
                    <label for="confirm_password" class="block text-sm font-medium text-gray-700">Confirm Password</label>
                    <input id="confirm_password" name="confirm_password" type="password" required
                        class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-xs
                               focus:outline-hidden focus:ring-red-500 focus:border-red-500 transition duration-150"
                        placeholder="Re-enter new password">
                    <p id="passwordMismatchTip"
                       class="mt-1.5 max-h-0 overflow-hidden text-xs font-medium text-red-600 opacity-0 transition-all duration-200 ease-out">
                        Passwords do not match
                    </p>
                </div>
            </div>

            <div>
                <button type="submit" id="updatePasswordSubmitBtn"
                    class="group relative w-full flex justify-center py-2 px-4 border border-transparent text-sm font-medium
                           rounded-md text-white bg-red-600 hover:bg-red-700 focus:outline-hidden focus:ring-2
                           focus:ring-offset-2 focus:ring-red-500 transition duration-150 disabled:cursor-not-allowed disabled:opacity-50">
                    Update Password
                </button>
            </div>
        </form>
    </div>
</div>
{% endblock body %}

{% block js %}
<script>
document.addEventListener('DOMContentLoaded', function () {
    var passwordInput = document.getElementById('new_password');
    var confirmInput = document.getElementById('confirm_password');
    var tip = document.getElementById('passwordMismatchTip');
    var submitBtn = document.getElementById('updatePasswordSubmitBtn');
    function checkMatch() {
        var mismatch = confirmInput.value.length > 0 && passwordInput.value !== confirmInput.value;
        tip.classList.toggle('opacity-100', mismatch);
        tip.classList.toggle('max-h-6', mismatch);
        tip.classList.toggle('opacity-0', !mismatch);
        tip.classList.toggle('max-h-0', !mismatch);
        confirmInput.classList.toggle('border-red-600', mismatch);
        submitBtn.disabled = mismatch;
    }
    if (passwordInput && confirmInput && tip && submitBtn) {
        passwordInput.addEventListener('input', checkMatch);
        confirmInput.addEventListener('input', checkMatch);
    }
});
</script>
{% endblock js %}
