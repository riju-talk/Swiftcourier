{% extends "components/layouts/auth_layout.dj" %}
{% load static %}

{% block title %}Forgot Password{% endblock title %}

{% block body %}
<div class="min-h-screen w-full bg-black lg:grid lg:grid-cols-2">

    <!-- Brand panel -->
    <div class="relative hidden overflow-hidden bg-black px-10 py-12 lg:flex lg:flex-col lg:justify-between xl:px-16 xl:py-16">
        <div class="pointer-events-none absolute -left-24 -top-32 h-96 w-96 rounded-full bg-red-600/20 blur-3xl"></div>
        <div class="pointer-events-none absolute -right-16 bottom-0 h-72 w-72 rounded-full bg-red-700/10 blur-3xl"></div>

        <div class="relative">
            <span class="text-2xl font-extrabold tracking-tight text-white">
                Swift<span class="text-red-500">Courier</span>
            </span>
            <p class="mt-1 text-xs font-semibold uppercase tracking-[0.3em] text-white/40">Logistics Platform</p>
        </div>

        <div class="relative mt-16 max-w-md">
            <h1 class="text-3xl font-bold leading-tight text-white xl:text-4xl">
                Recover your account access.
            </h1>
            <p class="mt-4 text-base leading-relaxed text-white/60">
                Enter your email or contact number to reset your password and regain access to your shipping dashboard.
            </p>

            <dl class="mt-10 grid grid-cols-3 gap-6 border-t border-white/10 pt-6">
                <div>
                    <dt class="text-xs uppercase tracking-wide text-white/40">Couriers</dt>
                    <dd class="mt-1 text-xl font-bold text-white">15+</dd>
                </div>
                <div>
                    <dt class="text-xs uppercase tracking-wide text-white/40">Tracking</dt>
                    <dd class="mt-1 text-xl font-bold text-white">Real&#8209;time</dd>
                </div>
                <div>
                    <dt class="text-xs uppercase tracking-wide text-white/40">Support</dt>
                    <dd class="mt-1 text-xl font-bold text-white">24/7</dd>
                </div>
            </dl>
        </div>

        <div class="relative mt-16">
            <p class="mb-4 text-xs font-semibold uppercase tracking-widest text-white/40">Ship with</p>
            <div class="grid grid-cols-4 gap-2.5">
                <span class="flex h-11 items-center justify-center rounded-lg bg-white/5 px-2 text-center text-xs font-semibold text-white/80 ring-1 ring-white/10">Delhivery</span>
                <span class="flex h-11 items-center justify-center rounded-lg bg-white/5 px-2 text-center text-xs font-bold text-[#4d9de0] ring-1 ring-white/10">DTDC</span>
                <span class="flex h-11 items-center justify-center rounded-lg bg-white/5 px-2 text-center text-xs font-bold text-[#4d9de0] ring-1 ring-white/10">Blue Dart</span>
                <span class="flex h-11 items-center justify-center rounded-lg bg-white/5 px-2 text-center text-xs font-bold text-[#ff8a3d] ring-1 ring-white/10">XpressBees</span>
                <span class="flex h-11 items-center justify-center rounded-lg bg-white/5 px-2 text-center text-xs font-bold text-white/80 ring-1 ring-white/10">Velocity</span>
                <span class="flex h-11 items-center justify-center rounded-lg bg-white/5 px-2 text-center text-xs font-bold text-[#ff6b81] ring-1 ring-white/10">Shadowfax</span>
                <span class="flex h-11 items-center justify-center rounded-lg bg-white/5 px-2 text-center text-xs font-bold text-red-400 ring-1 ring-white/10">India Post</span>
                <span class="flex h-11 items-center justify-center rounded-lg bg-white/5 px-2 text-center text-xs font-bold text-white/80 ring-1 ring-white/10">Amazon Shipping</span>
            </div>
        </div>
    </div>

    <!-- Password reset form panel -->
    <div class="flex min-h-screen items-center justify-center bg-white px-6 py-12 sm:px-10">
        <div class="w-full max-w-sm">
            <span class="text-xl font-extrabold tracking-tight text-black">
                Swift<span class="text-red-600">Courier</span>
            </span>

            <h2 class="mt-8 text-2xl font-bold text-black">Forgot password?</h2>
            <p class="mt-1 text-sm text-neutral-500">Enter your email or contact number to recover your account</p>

            <form class="mt-8 space-y-5" action="{% url 'account:forget_password' %}" method="post">
                {% csrf_token %}

                <div>
                    <label for="Email" class="mb-1.5 block text-sm font-medium text-black">Email</label>
                    <input id="Email"
                           name="email"
                           type="email"
                           placeholder="you@company.com"
                           class="block w-full rounded-lg border border-neutral-300 px-3.5 py-2.5 text-sm text-black placeholder:text-neutral-400 focus:border-red-600 focus:outline-none focus:ring-2 focus:ring-red-600/20" />
                </div>

                <div>
                    <label for="ContactNo" class="mb-1.5 block text-sm font-medium text-black">Contact number</label>
                    <input id="ContactNo"
                           name="contact_no"
                           type="tel"
                           placeholder="10-digit mobile number"
                           class="block w-full rounded-lg border border-neutral-300 px-3.5 py-2.5 text-sm text-black placeholder:text-neutral-400 focus:border-red-600 focus:outline-none focus:ring-2 focus:ring-red-600/20" />
                </div>

                <button type="submit"
                        class="w-full rounded-lg bg-black px-4 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-red-600">
                    Send recovery link
                </button>
            </form>

            <p class="mt-6 text-center text-sm text-neutral-500">
                Remember your password?
                <a href="{% url 'account:signin' %}" class="font-semibold text-red-600 hover:text-red-700">Sign in</a>
            </p>
        </div>
    </div>
</div>
{% endblock body %}
