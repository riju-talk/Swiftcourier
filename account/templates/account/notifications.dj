{% extends "components/layouts/layout.dj" %}

{% block title %}
    Notifications
{% endblock title %}

{% load static %}

{% block css %}
    <style>
        .fade-in {
            animation: fadeIn 0.6s ease-in-out both;
        }

        @keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(8px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .hover-border {
            transition: border 0.3s ease, box-shadow 0.3s ease;
        }

        .hover-border:hover {
            border: 1px solid rgba(99, 102, 241, 0.6); /* indigo-500 */
            box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.1);
        }
    </style>
{% endblock css %}

{% block body %}
    <section class="bg-white dark:bg-gray-900 shadow rounded-xl p-6 md:p-8 w-full max-w-4xl mx-auto">
        <!-- Header -->
        <div class="flex justify-between items-center mb-6">
            <h2 class="text-xl font-bold text-gray-800 dark:text-gray-100">Notifications</h2>
        </div>

        <!-- Notification List -->
        <div class="space-y-5">
            {% for note in notifications %}
                <div class="fade-in flex items-start gap-4 bg-gray-50 dark:bg-gray-800 p-4 rounded-lg border border-transparent hover-border transition delay-{{ forloop.counter0|add:'1' }}00">
                    <!-- Category Icon -->
                    <div class="mt-1.5 w-6 h-6">
                        {% if note.category == 'info' %}
                            <svg class="text-blue-500 w-6 h-6" fill="none" stroke="currentColor" stroke-width="2"
                                 viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                <path stroke-linecap="round" stroke-linejoin="round"
                                      d="M13 16h-1v-4h-1m1-4h.01M12 2a10 10 0 100 20 10 10 0 000-20z"/>
                            </svg>
                        {% elif note.category == 'warning' %}
                            <svg class="text-yellow-500 w-6 h-6" fill="none" stroke="currentColor" stroke-width="2"
                                 viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                <path stroke-linecap="round" stroke-linejoin="round"
                                      d="M12 9v2m0 4h.01M5.07 19h13.86a1 1 0 00.92-1.38l-6.93-14a1 1 0 00-1.8 0l-6.93 14a1 1 0 00.92 1.38z"/>
                            </svg>
                        {% elif note.category == 'error' %}
                            <svg class="text-red-500 w-6 h-6" fill="none" stroke="currentColor" stroke-width="2"
                                 viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                <path stroke-linecap="round" stroke-linejoin="round"
                                      d="M6 18L18 6M6 6l12 12"/>
                            </svg>
                        {% elif note.category == 'success' %}
                            <svg class="text-green-500 w-6 h-6" fill="none" stroke="currentColor" stroke-width="2"
                                 viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                <path stroke-linecap="round" stroke-linejoin="round"
                                      d="M5 13l4 4L19 7"/>
                            </svg>
                        {% else %}
                            <svg class="text-gray-400 w-6 h-6" fill="none" stroke="currentColor" stroke-width="2"
                                 viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                <path stroke-linecap="round" stroke-linejoin="round"
                                      d="M12 12h.01M12 16h.01M12 8h.01M12 2a10 10 0 100 20 10 10 0 000-20z"/>
                            </svg>
                        {% endif %}
                    </div>

                    <!-- Notification Content -->
                    <div class="w-full">
                        <p class="font-medium text-gray-800 dark:text-gray-100">{{ note.msg }}</p>
                        <p class="text-sm text-gray-600 dark:text-gray-300">
                            {% if note.is_read %}
                                <span class="text-green-600 dark:text-green-400">Read</span>
                            {% else %}
                                <span class="text-red-500 dark:text-red-400 animate-pulse">Unread</span>
                            {% endif %}
                        </p>
                        <span class="text-xs text-gray-500 dark:text-gray-400">{{ note.created_at|timesince }} ago</span>
                    </div>
                </div>
            {% empty %}
                <div class="text-center text-gray-400 dark:text-gray-500 py-10">No notifications found.</div>
            {% endfor %}
        </div>

        <!-- Pagination -->
        {% if notifications.has_other_pages %}
            <div class="mt-6 flex justify-end items-center space-x-1 text-sm">
                {% if notifications.has_previous %}
                    <a href="?page={{ notifications.previous_page_number }}"
                       class="px-3 py-1 rounded-md bg-gray-200 dark:bg-gray-700 hover:bg-gray-300 dark:hover:bg-gray-600 transition">Previous</a>
                {% endif %}

                {% for num in notifications.paginator.page_range %}
                    {% if num == notifications.number %}
                        <span class="px-3 py-1 rounded-md bg-blue-600 text-white font-semibold shadow">{{ num }}</span>
                    {% elif num >= notifications.number|add:'-2' and num <= notifications.number|add:'2' %}
                        <a href="?page={{ num }}"
                           class="px-3 py-1 rounded-md bg-gray-200 dark:bg-gray-700 hover:bg-gray-300 dark:hover:bg-gray-600 transition">{{ num }}</a>
                    {% endif %}
                {% endfor %}

                {% if notifications.has_next %}
                    <a href="?page={{ notifications.next_page_number }}"
                       class="px-3 py-1 rounded-md bg-gray-200 dark:bg-gray-700 hover:bg-gray-300 dark:hover:bg-gray-600 transition">Next</a>
                {% endif %}
            </div>
        {% endif %}
    </section>
{% endblock body %}

{% block js %}
{% endblock js %}
