{% extends "components/layouts/layout.dj" %}

{% block title %}
    Recent Activity
{% endblock title %}

{% load static %}

{% block css %}
    <style>
        .fade-slide-in {
            animation: fadeSlideIn 0.5s ease-out forwards;
        }

        @keyframes fadeSlideIn {
            0% {
                opacity: 0;
                transform: translateY(10px);
            }

            100% {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .hover-border {
            transition: border 0.3s ease, box-shadow 0.3s ease;
            border: 1px solid transparent;
        }

        .hover-border:hover {
            border: 1px solid rgba(99, 102, 241, 0.5);
            /* indigo-500 */
            box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.1);
        }
    </style>
{% endblock css %}

{% block body %}
    <section class="bg-white dark:bg-gray-900 shadow rounded-xl p-6 md:p-8 w-full max-w-4xl mx-auto">
        <!-- Header -->
        <div class="flex justify-between items-center mb-6">
            <h2 class="text-xl font-bold text-gray-800 dark:text-white">Recent Activity</h2>
        </div>

        <!-- Activity Items -->
        <div class="space-y-5">
            {% for act in activities %}
                <div class="fade-slide-in hover-border flex items-start gap-4 bg-gray-50 dark:bg-gray-800 p-4 rounded-lg transition delay-{{ forloop.counter0|add:'1' }}00">
                    <!-- Icon -->
                    <div class="mt-1.5 w-6 h-6 shrink-0">
                        {% if act.activity_type == 'login' %}
                            <svg xmlns="http://www.w3.org/2000/svg"
                                 class="w-6 h-6 text-blue-500"
                                 fill="none"
                                 viewBox="0 0 24 24"
                                 stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 16l4-4m0 0l-4-4m4 4H3m13 4v1a2 2 0 002 2h4a2 2 0 002-2V7a2 2 0 00-2-2h-4a2 2 0 00-2 2v1" />
                            </svg>
                        {% elif act.activity_type == 'logout' %}
                            <svg xmlns="http://www.w3.org/2000/svg"
                                 class="w-6 h-6 text-gray-500"
                                 fill="none"
                                 viewBox="0 0 24 24"
                                 stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 16l-4-4m0 0l4-4m-4 4h11M5 19a2 2 0 01-2-2V7a2 2 0 012-2h6" />
                            </svg>
                        {% elif act.activity_type == 'password_change' %}
                            <svg xmlns="http://www.w3.org/2000/svg"
                                 class="w-6 h-6 text-red-500"
                                 fill="none"
                                 viewBox="0 0 24 24"
                                 stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 11c0-.656.01-1.306-.007-1.958a4.002 4.002 0 00-3.11-3.893C7.346 4.818 6 5.672 6 7v1m6 4v1m0 0h.01M6 10h12v6a2 2 0 01-2 2H8a2 2 0 01-2-2v-6z" />
                            </svg>
                        {% elif act.activity_type == 'profile_update' %}
                            <svg xmlns="http://www.w3.org/2000/svg"
                                 class="w-6 h-6 text-yellow-500"
                                 fill="none"
                                 viewBox="0 0 24 24"
                                 stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536M9 11l6.586-6.586a2 2 0 112.828 2.828L11.828 14H9v-2.828zM5 18h14" />
                            </svg>
                        {% elif act.activity_type == 'email_change' %}
                            <svg xmlns="http://www.w3.org/2000/svg"
                                 class="w-6 h-6 text-purple-500"
                                 fill="none"
                                 viewBox="0 0 24 24"
                                 stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 12l-4-4-4 4m0 0l4 4 4-4m-4-4v8" />
                            </svg>
                        {% elif act.activity_type == 'merchant_info_update' %}
                            <svg xmlns="http://www.w3.org/2000/svg"
                                 class="w-6 h-6 text-green-500"
                                 fill="none"
                                 viewBox="0 0 24 24"
                                 stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 10h16m-2 6h2a2 2 0 002-2v-4a2 2 0 00-2-2h-2M4 18h2a2 2 0 002-2v-4a2 2 0 00-2-2H4v8z" />
                            </svg>
                        {% elif act.activity_type == 'label_setting_update' %}
                            <svg xmlns="http://www.w3.org/2000/svg"
                                 class="w-6 h-6 text-indigo-500"
                                 fill="none"
                                 viewBox="0 0 24 24"
                                 stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c1.657 0 3 1.343 3 3s-1.343 3-3 3m0-6v6m0-6a3 3 0 100 6" />
                            </svg>
                        {% else %}
                            <svg xmlns="http://www.w3.org/2000/svg"
                                 class="w-6 h-6 text-gray-400"
                                 fill="none"
                                 viewBox="0 0 24 24"
                                 stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M12 2a10 10 0 100 20 10 10 0 000-20z" />
                            </svg>
                        {% endif %}
                    </div>

                    <!-- Activity Content -->
                    <div class="w-full">
                        <div class="flex justify-between items-center">
                            <p class="font-medium text-gray-800 dark:text-white capitalize">{{ act.get_activity_type_display }}</p>
                            {% if act.ip_address %}
                                <span class="inline-block text-xs text-gray-500 dark:text-gray-400 bg-gray-100 dark:bg-gray-700 px-2 py-0.5 rounded-full ring-1 ring-gray-300 dark:ring-gray-600">
                                    IP: {{ act.ip_address }}
                                </span>
                            {% endif %}
                        </div>
                        <p class="text-sm text-gray-600 dark:text-gray-300">{{ act.activity_description }}</p>
                        <span class="text-xs text-gray-500 dark:text-gray-400">
                            {{ act.created_at|timesince }} ago
                            {% if not act.is_read %}· <span class="text-red-500 dark:text-red-400 animate-pulse">New</span>{% endif %}
                        </span>
                    </div>
                </div>
            {% empty %}
                <div class="text-center text-gray-400 dark:text-gray-500 py-8">No activity to display.</div>
            {% endfor %}
        </div>

        <!-- Pagination -->
        {% if activities.paginator.count > 5 %}
            <div class="mt-6 p-4 border-t dark:border-gray-700 flex flex-col sm:flex-row justify-between items-center gap-4">
                <!-- Page Size Dropdown -->
                <div class="flex items-center gap-2 text-sm">
                    <span class="text-gray-700 dark:text-gray-300">Show:</span>
                    <form method="get">
                        <select name="per_page"
                                onchange="this.form.submit()"
                                class="px-2 py-1 border rounded text-sm dark:bg-gray-700 dark:border-gray-600 dark:text-gray-100">
                            {% for option in per_page_options %}
                                <option value="{{ option }}"
                                        {% if activities.paginator.per_page == option %}selected{% endif %}>{{ option }}</option>
                            {% endfor %}
                        </select>
                        <input type="hidden" name="page" value="1">
                    </form>
                </div>

                <!-- Page Navigation -->
                <div class="flex gap-1 flex-wrap text-sm">
                    {% if activities.has_previous %}
                        <a href="?page={{ activities.previous_page_number }}&per_page={{ activities.paginator.per_page }}"
                           class="px-3 py-1 bg-gray-100 hover:bg-gray-200 dark:bg-gray-700 dark:hover:bg-gray-600 rounded dark:text-gray-100">Previous</a>
                    {% endif %}

                    {% for num in activities.paginator.page_range %}
                        {% if num >= activities.number|add:"-2" and num <= activities.number|add:"2" %}
                            {% if num == activities.number %}
                                <span class="px-3 py-1 rounded bg-blue-600 text-white font-semibold shadow">{{ num }}</span>
                            {% else %}
                                <a href="?page={{ num }}&per_page={{ activities.paginator.per_page }}"
                                   class="px-3 py-1 bg-gray-100 hover:bg-gray-200 dark:bg-gray-700 dark:hover:bg-gray-600 rounded dark:text-gray-100">{{ num }}</a>
                            {% endif %}
                        {% endif %}
                    {% endfor %}

                    {% if activities.has_next %}
                        <a href="?page={{ activities.next_page_number }}&per_page={{ activities.paginator.per_page }}"
                           class="px-3 py-1 bg-gray-100 hover:bg-gray-200 dark:bg-gray-700 dark:hover:bg-gray-600 rounded dark:text-gray-100">Next</a>
                    {% endif %}
                </div>
            </div>
        {% endif %}
    </section>
{% endblock body %}

{% block js %}
{% endblock js %}
