{% extends "components/layouts/auth_layout.dj" %}
{% block title %}
    Sign In

{% endblock title %}

{% load static %}

{% with parcel_logo='images/logo/idiotship_logo_288x66.png' %}

{% block css %}
<style>
        @media (max-width: 1024px) {
            .flex.flex-col.justify-center.items-center.w-1\/2:first-child {
                display: none !important;
            }
        }

        @media (max-width: 640px) {
            .courier-btn, .courier-btn span {
                font-size: 0.7rem !important;
                padding: 0.2rem 0.2rem !important;
                margin: 0.1rem 0 !important;
                text-align: center !important;
                white-space: nowrap !important;
                overflow: hidden !important;
                text-overflow: ellipsis !important;
                width: 100% !important;
                box-sizing: border-box !important;
                display: flex !important;
                align-items: center !important;
                justify-content: center !important;
            }
            /* Hide left panel on small devices */
            .flex.flex-col.justify-center.items-center.w-1\/2:first-child {
                display: none !important;
            }
            /* Increase sign-in form height on small devices */
            .signin-right-panel {
                height: 90vh !important;
                min-height: 90vh !important;
            }
            /* Make 'Welcome to IdiotShip' font smaller on small devices (moved to end for precedence) */
        }

        @media (max-width: 640px) {
            .courier-grid, .courier-btn, .courier-btn span {
                word-break: break-word !important;
                overflow-wrap: break-word !important;
                font-size: 0.75rem !important;
                padding: 0.3rem 0.2rem !important;
                margin: 0.1rem 0 !important;
                text-align: center !important;
            }
        }

        @media (max-width: 640px) {
            .signin-right-panel img {
                max-width: 120px !important;
                height: auto !important;
                margin-bottom: 1rem !important;
                display: block !important;
                margin-left: auto !important;
                margin-right: auto !important;
            }
            .courier-grid {
                grid-template-columns: repeat(2,1fr) !important;
                gap: 0.5rem !important;
                margin-top: 1rem !important;
            }
            .courier-btn {
                min-width: 0 !important;
                width: 100% !important;
            }
        }

        @media (max-width: 640px) {
            html, body, .auth-screen {
                width: 100vw !important;
                min-width: 100vw !important;
                height: 100vh !important;
                min-height: 100vh !important;
                overflow-x: hidden !important;
                overflow-y: auto !important;
                display: flex !important;
                flex-direction: column !important;
            }
            .auth-card, .signin-left-panel, .signin-right-panel {
                width: 100% !important;
                min-width: 0 !important;
                height: auto !important;
                min-height: 0 !important;
                padding: 0.5rem !important;
                border-radius: 0 !important;
                box-shadow: none !important;
                display: flex !important;
                flex-direction: column !important;
                align-items: center !important;
                justify-content: flex-start !important;
                overflow-y: auto !important;
            }
            .signin-form-title, .mb-8, .hero-title, .hero-subtitle, .hero-text, label, input, select, button, p {
                word-break: break-word !important;
                overflow-wrap: break-word !important;
                font-size: 0.95rem !important;
            }
            .courier-btn {
                font-size: 0.8rem !important;
                padding: 0.3rem 0.5rem !important;
                height: 32px !important;
                width: 100% !important;
            }
            .space-y-1 > * {
                margin-bottom: 0.5rem !important;
            }
            img, .hero-image, .slide-image {
                max-width: 90vw !important;
                height: auto !important;
                display: block !important;
                margin-left: auto !important;
                margin-right: auto !important;
            }
        }

                @media (max-width: 640px) {
                    html, body, .auth-screen, .signin-right-panel, .signin-left-panel {
                        overflow-y: scroll !important;
                        scrollbar-width: auto !important;
                    }
                }
        @media (max-width: 640px) {
            img, .hero-image, .slide-image {
                max-width: 90vw !important;
                height: auto !important;
                display: block !important;
                margin-left: auto !important;
                margin-right: auto !important;
            }
            .signin-form-title, .mb-8, .hero-title, .hero-subtitle, .hero-text, label, input, select, button, p {
                word-break: break-word !important;
                overflow-wrap: break-word !important;
            }
            .signin-right-panel, .signin-left-panel {
                overflow-x: hidden !important;
                overflow-y: auto !important;
                flex-wrap: wrap !important;
            }
        }

        @media (max-width: 640px) {
            .auth-card {
                flex-direction: column !important;
                width: 100vw !important;
                min-width: 0 !important;
                min-height: 0 !important;
                height: auto !important;
                padding: 0 !important;
            }
            .signin-left-panel, .signin-right-panel {
                width: 100% !important;
                min-width: 0 !important;
                height: auto !important;
                padding: 0.5rem !important;
                border-radius: 0 !important;
                box-shadow: none !important;
                display: flex !important;
                flex-direction: column !important;
                align-items: center !important;
                justify-content: center !important;
            }
            .signin-right-panel {
                max-width: 100vw !important;
                min-height: 0 !important;
                padding: 1rem 0.5rem !important;
            }
            .signin-form-title {
                font-size: 1.2rem !important;
            }
            .mb-8 {
                margin-bottom: 1rem !important;
            }
            .courier-btn {
                font-size: 0.8rem !important;
                padding: 0.3rem 0.5rem !important;
                height: 32px !important;
                width: 100% !important;
            }
            .space-y-1 > * {
                margin-bottom: 0.5rem !important;
            }
            label, input, select, button {
                font-size: 0.9rem !important;
                width: 100% !important;
                box-sizing: border-box !important;
            }
        }
        @media (max-width: 400px) {
            .signin-form-title {
                font-size: 0.6rem !important;
            }
            .signin-right-panel {
                padding: 0.5rem 0.2rem !important;
            }
            .courier-btn {
                font-size: 0.7rem !important;
                padding: 0.2rem 0.3rem !important;
                height: 24px !important;
            }
        }

        @media (max-width: 640px) {
            html, body, .auth-screen {
                height: auto !important;
                min-height: 100vh !important;
                width: 100vw !important;
                min-width: 100vw !important;
                overflow-x: hidden !important;
                overflow-y: auto !important;
            }
        }
            @media (max-width: 640px) {
                .auth-card {
                    flex-direction: column !important;
                    height: auto !important;
                    width: 100vw !important;
                    min-width: 0 !important;
                    min-height: 0 !important;
                    padding: 0 !important;
                }
                .signin-left-panel, .signin-right-panel {
                    width: 100% !important;
                    min-width: 0 !important;
                    height: auto !important;
                    padding: 0.5rem !important;
                    border-radius: 0 !important;
                    box-shadow: none !important;
                }
                .signin-right-panel {
                    padding: 1rem 0.5rem !important;
                    max-width: 100vw !important;
                    min-height: 0 !important;
                }
                .signin-form-title {
                    font-size: 1.2rem !important;
                }
                .mb-8 {
                    margin-bottom: 1rem !important;
                }
                .courier-btn {
                    font-size: 0.8rem !important;
                    padding: 0.3rem 0.5rem !important;
                    height: 32px !important;
                }
                .space-y-1 > * {
                    margin-bottom: 0.5rem !important;
                }
                label, input, select, button {
                    font-size: 0.9rem !important;
                }
            }
            @media (max-width: 400px) {
                .signin-form-title {
                    font-size: 1rem !important;
                }
                .signin-right-panel {
                    padding: 0.5rem 0.2rem !important;
                }
                .courier-btn {
                    font-size: 0.7rem !important;
                    padding: 0.2rem 0.3rem !important;
                    height: 24px !important;
                }
            }
 
        /* Responsive adjustments */
        @media (max-width: 1024px) {
            .signin-flex-row {
                flex-direction: column !important;
            }
            .signin-left-panel {
                width: 100% !important;
                min-width: 0 !important;
                height: auto !important;
                display: block !important;
            }
            .signin-right-panel {
                width: 100% !important;
                min-width: 0 !important;
                height: auto !important;
                padding: 2rem 1rem !important;
                display: block !important;
            }
        }
        @media (max-width: 640px) {
            .signin-right-panel {
                padding: 1rem 0.5rem !important;
            }
            
        }
        html,
        body {
            height: 100%;
            width: 100vw;
            max-width: 100vw;
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            overflow-x: hidden;
            overflow-y: auto;
        }
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }
        @keyframes float {
            0% { transform: translateY(0px); }
            50% { transform: translateY(-10px); }
            100% { transform: translateY(0px); }
        }
        .animate-fade-in {
            animation: fadeIn 0.6s ease-out forwards;
        }
        .animate-float {
            animation: float 3s ease-in-out infinite;
        }
        .gradient-bg {
            background: linear-gradient(135deg, rgba(211,47,47,0.6) 0%, rgba(107,70,193,1) 40%, rgba(67,160,238,1) 80%, rgba(211,47,47,0.6) 100%);
        }
        .btn-gradient {
            background: linear-gradient(90deg,#6b46c1,#43a0ee);
        }
        .auth-screen {
            height: 100vh;
            width: 100vw;
            max-width: 100vw;
            box-sizing: border-box;
            overflow-x: hidden;
            overflow-y: auto;
        }
        .auth-card {
            height: 100vh;
            width: 100vw;
            max-width: 100vw;
            box-sizing: border-box;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow-x: hidden;
            overflow-y: auto;
        }
        
        .feature-card {
        }
        .fade-toggle {
            opacity: 1;
            transition: opacity 4s;
            z-index: 2;
        }
        .fade-toggle.hide {
            opacity: 0;
            pointer-events: none;
            z-index: 0;
        }
            background: rgba(255, 255, 255, 0.12);
            border: 1px solid rgba(255, 255, 255, 0.2);
            box-shadow: 0 20px 45px rgba(0, 0, 0, 0.2);
        }
        .card-slider {
            position: relative;
            overflow: hidden;
        }
        .card-slider-track {
            display: flex;
            height: 100%;
            width: 200%;
            animation: slideTrack 4s ease-in-out infinite;
        }
        .slide-card {
            flex: 0 0 100%;
        }
        @keyframes slideTrack {
            0% { transform: translateX(0%); }
            40% { transform: translateX(0%); }
            50% { transform: translateX(-100%); }
            90% { transform: translateX(-100%); }
            100% { transform: translateX(0%); }
        }
        .card-glow {
            position: absolute;
            inset: 0;
            background: radial-gradient(circle at top left, rgba(255, 255, 255, 0.35), transparent 60%);
            opacity: 0.6;
            pointer-events: none;
        }
        .left-panel-content {
            max-height: 100%;
            height: 100%;
            min-height: 0;
            width: 100%;
            overflow: hidden;
            display: flex;
            flex-direction: column;
            justify-content: center;
            gap: 1rem;
        }
        .hero-title {
            font-size: clamp(1.6rem, 2.4vw, 2.25rem);
        }
        .hero-subtitle {
            font-size: clamp(1.6rem, 2.4vw, 2.25rem);
        }
        .hero-text {
            font-size: clamp(1rem, 1.6vw, 1.25rem);
        }
        .hero-image {
            height: 100%;
            width: 100%;
            object-fit: contain;
        }
        .slide-image {
            height: 100%;
            width: 100%;
            object-fit: contain;
        }
        .card-slider {
            flex: 1;
            min-height: 0;
        }
        .slide-card {
            height: 100%;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }
        .signin-right-panel {
            background: rgba(255,255,255,0.95) !important;
            border-radius: 32px;
            box-shadow: 0 8px 32px 0 rgba(67,160,238,0.18);
            max-width: 420px;
            margin: 2rem auto;
            display: flex !important;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            z-index: 2;
            position: relative;
            min-height: 80vh;
            padding: 2rem 1.5rem !important;
        }
        @keyframes blink {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.3; }
        }
        .animate-blink {
            animation: blink 1.2s infinite;
        }
    </style>
{% endblock css %}

{% block body %}
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <div x-data="{
        theme: localStorage.getItem('theme') || 'light',
        init() {
            if (this.theme === 'dark') document.documentElement.classList.add('dark');
        },
        toggleTheme() {
            this.theme = this.theme === 'light' ? 'dark' : 'light';
            if (this.theme === 'dark') document.documentElement.classList.add('dark');
            else document.documentElement.classList.remove('dark');
            localStorage.setItem('theme', this.theme);
        }
    }" x-init="init()" class="auth-screen gradient-bg" style="width:100vw;height:100vh;min-height:100vh;min-width:100vw;overflow:hidden;">
        <!-- Decorative Background -->
        <div class="absolute inset-0 overflow-hidden">
            <div class="absolute inset-0 bg-[url('{% static 'assets/images/auth/map.png' %}')] bg-cover bg-center opacity-10"></div>
        </div>

        <!-- Main Container -->
        <div class="relative flex h-screen items-stretch justify-center p-0">
            <div class="auth-card relative flex h-full w-full overflow-hidden rounded-none gradient-bg shadow-2xl backdrop-blur-xs lg:flex-row signin-flex-row" style="display:flex;flex-direction:row;align-items:center;justify-content:center;">
                <!-- Left Panel: Branding/Data -->
                <div class="flex flex-col justify-center items-center w-1/2 pr-12 pl-12" style="min-width:340px;">
                    <div class="mb-8 flex flex-col items-center" style="width:100%;">
                        <!-- Floating Parcel Box SVG -->
                        <span class="mb-6 animate-float" style="display:flex;justify-content:center;width:100%;">
                            <svg width="80" height="66" viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <polygon points="16,20 32,10 56,20 40,30" fill="#F7D9A3" stroke="#BCA16B" stroke-width="2"/>
                                <polygon points="16,20 16,44 40,54 40,30" fill="#F5E9DA" stroke="#BCA16B" stroke-width="2"/>
                                <polygon points="40,30 40,54 56,44 56,20" fill="#EAD7B0" stroke="#BCA16B" stroke-width="2"/>
                                <polygon points="31,11 33,11 41,16 39,16" fill="#E2C48D" stroke="#BCA16B" stroke-width="1"/>
                            </svg>
                        </span>
                        <h1 class="font-extrabold text-5xl text-white drop-shadow-lg mb-2 animate-blink" style="letter-spacing:0.08em;text-align:center;width:100%;">IdiotShip</h1>
                        <h2 class="font-bold text-3xl text-yellow-400 drop-shadow-lg mb-4 animate-blink" style="text-align:center;width:100%;">Logistics</h2>
                    </div>
                    <p class="text-lg md:text-xl text-white/90 mb-8" style="max-width:90%;text-align:left;width:100%;">Smarter, faster, and easier shipping for your business.<br>Experience seamless logistics with IdiotShip.</p>
                    <div style="margin:2rem 0 0 0;text-align:center;width:100%;">
                        <div style="font-size:1.2rem;color:#fff;font-weight:600;margin-bottom:1rem;letter-spacing:0.02em;text-align:center;width:100%;">Choose Courier Partner</div>
                        <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:1rem;width:100%;">
                            <button class="courier-btn" style="background:#fff;color:#222;font-weight:600;border-radius:12px;padding:0.75rem 2.2rem;box-shadow:0 2px 8px rgba(67,160,238,0.12);font-size:1.1rem;display:flex;align-items:center;justify-content:center;gap:0.5rem;height:56px;width:100%;min-width:0;">
                                Delhivery
                            </button>
                            <button class="courier-btn" style="background:#fff;color:#222;font-weight:600;border-radius:12px;padding:0.75rem 2.2rem;box-shadow:0 2px 8px rgba(67,160,238,0.12);font-size:1.1rem;display:flex;align-items:center;justify-content:center;gap:0.5rem;height:56px;width:100%;min-width:0;">
                                <span style="font-weight:bold;color:#0057b8;font-size:1.2rem;">DTDC</span>
                            </button>
                            <button class="courier-btn" style="background:#fff;color:#222;font-weight:600;border-radius:12px;padding:0.75rem 2.2rem;box-shadow:0 2px 8px rgba(67,160,238,0.12);font-size:1.1rem;display:flex;align-items:center;justify-content:center;gap:0.5rem;height:56px;width:100%;min-width:0;">
                                <span style="font-weight:bold;color:#0070c0;font-size:1.2rem;">Blue Dart</span>
                            </button>
                            <button class="courier-btn" style="background:#fff;color:#222;font-weight:600;border-radius:12px;padding:0.75rem 2.2rem;box-shadow:0 2px 8px rgba(67,160,238,0.12);font-size:1.1rem;display:flex;align-items:center;justify-content:center;gap:0.5rem;height:56px;width:100%;min-width:0;">
                                <span style="font-weight:bold;color:#ff6600;font-size:1.2rem;">XpressBees</span>
                            </button>
                            <button class="courier-btn" style="background:#fff;color:#222;font-weight:600;border-radius:12px;padding:0.75rem 2.2rem;box-shadow:0 2px 8px rgba(67,160,238,0.12);font-size:1.1rem;display:flex;align-items:center;justify-content:center;gap:0.5rem;height:56px;width:100%;min-width:0;">
                                <span style="font-weight:bold;color:#2e3192;font-size:1.2rem;">Velocity</span>
                            </button>
                            <button class="courier-btn" style="background:#fff;color:#222;font-weight:600;border-radius:12px;padding:0.75rem 2.2rem;box-shadow:0 2px 8px rgba(67,160,238,0.12);font-size:1.1rem;display:flex;align-items:center;justify-content:center;gap:0.5rem;height:56px;width:100%;min-width:0;">
                                <span style="font-weight:bold;color:#ff2e63;font-size:1.2rem;">Shadowfax</span>
                            </button>
                            <button class="courier-btn" style="background:#fff;color:#d32f2f;font-weight:600;border-radius:12px;padding:0.75rem 2.2rem;box-shadow:0 2px 8px rgba(67,160,238,0.12);font-size:1.1rem;display:flex;align-items:center;justify-content:center;gap:0.5rem;height:56px;width:100%;min-width:0;">
                                <span style="font-weight:bold;color:#d32f2f;font-size:1.2rem;">India Post</span>
                            </button>
                            <button class="courier-btn" style="background:#fff;color:#222;font-weight:600;border-radius:12px;padding:0.75rem 2.2rem;box-shadow:0 2px 8px rgba(67,160,238,0.12);font-size:1.1rem;display:flex;align-items:center;justify-content:center;gap:0.5rem;height:56px;width:100%;min-width:0;">
                                <span style="font-weight:bold;color:#232f3e;font-size:1.2rem;">amazon Shipping</span>
                            </button>
                        </div>
                    </div>
                </div>
                <!-- Right Panel: Sign In Form -->
                <div class="flex flex-col justify-center items-center w-1/2" style="min-width:340px;">
                    <div class="signin-right-panel" style="background:rgba(255,255,255,0.95);border-radius:32px;box-shadow:0 8px 32px 0 rgba(67,160,238,0.18);padding:0.5rem 0.25rem;max-width:420px;width:80%;height:70vh;display:flex;flex-direction:column;justify-content:center;align-items:center;">
                        <div class="mb-2 text-center" style="width:100%;">
                            <img src="{% static 'images/logo.png' %}" alt="Logo" class="mx-auto h-6 w-auto mb-1" />
                            <h1 class="mt-1 text-base font-bold text-gray-800 signin-form-title">Welcome to IdiotShip</h1>
                            <p class="mt-1 text-xs text-gray-600">Enter your email and password to login</p>
                        </div>
                        <form class="space-y-1 w-full" action="{% url 'account:signin' %}" method="post" style="width:100%;">
                            <input type="hidden" name="next" value="{{ request.GET.next }}" />
                            {% csrf_token %}
                            <div style="margin-bottom:1.5rem;">
                                <label for="Email" class="block text-sm font-medium text-gray-700 mb-2">Email</label>
                                <input id="Email" name="email" type="email" placeholder="Enter Email" class="block w-full rounded-xl border border-gray-300 px-4 py-3 text-gray-900 shadow-xs focus:border-indigo-500 focus:ring-indigo-500" required style="font-size:1rem;" />
                            </div>
                            <div style="margin-bottom:1.5rem;">
                                <label for="Password" class="block text-sm font-medium text-gray-700 mb-2">Password</label>
                                <div style="position:relative;">
                                    <input id="Password" name="password" type="password" placeholder="Enter Password" class="block w-full rounded-xl border border-gray-300 px-4 py-3 text-gray-900 shadow-xs focus:border-indigo-500" required style="font-size:1rem;" />
                                    <span id="togglePasswordEye" style="position:absolute;right:1rem;top:50%;transform:translateY(-50%);color:#bbb;cursor:pointer;">
                                        <!-- Default eye icon only -->
                                        <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
                                            <path d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                                            <path d="M2.458 12C3.732 7.943 7.523 5 12 5c4.477 0 8.268 2.943 9.542 7-1.274 4.057-5.065 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                                        </svg>
                                    </span>
                                </div>
                            </div>
                            <div style="margin-bottom:1.5rem;">
                                <label for="UserRole" class="block text-sm font-medium text-gray-700 mb-2">User Role</label>
                                <select id="UserRole" name="role" class="block w-full rounded-xl border border-gray-300 px-4 py-3 text-gray-900 shadow-xs focus:border-indigo-500 focus:ring-indigo-500" required style="font-size:1rem;">
                                    <option value="user">User</option>
                                    <option value="admin">Admin</option>
                                </select>
                            </div>
                            <div class="flex items-center justify-between mb-2">
                                <a href="{% url 'account:forget_password' %}" class="text-sm text-indigo-600 hover:text-indigo-800">Forgot Password?</a>
                            </div>
                            <button type="submit" class="w-full btn-gradient text-white font-bold py-3 rounded-xl mt-4" style="font-size:1.1rem;">SIGN IN</button>
                        </form>
                        <div class="mt-2 text-center" style="width:100%;">
                            <span class="text-gray-600" style="font-size:0.7rem;">Don’t have an account?</span>
                            <a href="{% url 'account:signup' %}" class="text-indigo-600 font-bold ml-2" style="font-size:0.7rem;">SIGN UP</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
{% endblock body %}

{% block js %}
<script>
document.addEventListener('DOMContentLoaded', function() {
    const passwordInput = document.getElementById('Password');
    const eyeIcon = passwordInput.nextElementSibling;
    if (eyeIcon) {
        eyeIcon.addEventListener('click', function() {
            if (passwordInput.type === 'password') {
                passwordInput.type = 'text';
                eyeIcon.style.color = '#222';
            } else {
                passwordInput.type = 'password';
                eyeIcon.style.color = '#bbb';
            }
        });
    }
});
</script>
{% endblock js %}
{% endwith %}

