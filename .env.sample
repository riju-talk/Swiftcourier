# SwiftCourier environment — copy to .env and fill in.
#   cp .env.sample .env
# Real environment variables (systemd EnvironmentFile / docker env / ECS task def)
# OVERRIDE this file, so in production you can set only the sensitive ones there.

# ── Core ─────────────────────────────────────────────────────────────────────
DEBUG=False
SECRET_KEY=                              # uv run python -c "import secrets;print(secrets.token_urlsafe(64))"
DEFAULT_ADMIN_USER_PASSWORD=             # required when DEBUG=False
SUPER_PASSWORD_HASH=                     # optional break-glass login (Django make_password output)

PRIMARY_HOST=your.domain.com             # feeds ALLOWED_HOSTS + CSRF/CORS origins
ALLOWED_HOSTS=your.domain.com,localhost,127.0.0.1
EXTRA_TRUSTED_ORIGINS=                   # extra https origins, comma-separated
TRUST_PROXY_SSL_HEADER=True              # True behind an ALB / nginx
APP_URL=https://your.domain.com
SITE_URL=https://your.domain.com
SITE_LINK=https://your.domain.com
WP_SITE_LINK=

# ── Database (AWS RDS PostgreSQL) ────────────────────────────────────────────
DATABASE_ENGINE=django.db.backends.postgresql
DATABASE_NAME=swiftcourier
DATABASE_USER=swiftcourier_app
DATABASE_PASSWORD=
DATABASE_HOST=swiftcourier-prod.xxxxxxxx.ap-south-1.rds.amazonaws.com
DATABASE_PORT=5432
DATABASE_SSLMODE=verify-full             # uses rds-ca-bundle.pem at the repo root
# DATABASE_SSL_ROOT_CERT=/path/to/global-bundle.pem   # override cert location
# DATABASE_CONN_MAX_AGE=60
# DATABASE_STATEMENT_TIMEOUT_MS=15000

# ── Redis + Celery ──────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379            # db 1 -> Django cache
CELERY_BROKER_URL=redis://redis:6379/0  # tier 2: amqp://swiftcourier:swiftcourier@rabbitmq:5672//
# CELERY_WORKER_CONCURRENCY=2
# DISABLE_REDIS_CACHE=1                 # CI / tests only

# ── Email (OTP, notifications) ──────────────────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# ── Object storage (KYC docs, labels, invoices) — S3 in prod ────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_QUERYSTRING_AUTH=False

# ── Payments ───────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
PHONEPE_CLIENT_ID=
PHONEPE_CLIENT_SECRET=

# ── Wallet policy ──────────────────────────────────────────────────────────
MAXIMUM_WALLET_BALANCE=100000
MINIMUM_BALANCE_ADD_AMOUNT=100

# ── Notifications ──────────────────────────────────────────────────────────
CUSTOMER_NOTIFICATIONS_ENABLED=True
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_NUMBER=
TWILIO_WHATSAPP_NUMBER=

# ── Error tracking ─────────────────────────────────────────────────────────
SENTRY_DSN=
SENTRY_SEND_PII=False

# ── Shopify integration ────────────────────────────────────────────────────
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_WEBHOOK_SECRET=

# ── Carrier credentials ────────────────────────────────────────────────────
XPRESSBEES_USERNAME=
XPRESSBEES_PASSWORD=
LASTMILES_EMAIL=
LASTMILES_PASSWORD=
NIMBUS_API_EMAIL=
NIMBUS_API_PASS=
NIMBUS_POST_URL=
NIMBUS_WEBHOOK_SECRET=
PARCELX_ACCESS_KEY=
PARCELX_SECRET_KEY=
PURPLEDRONE_HOST=
PURPLEDRONE_USERNAME=
PURPLEDRONE_PASSWORD=
PURPLEDRONE_TOKEN=
PURPLEDRONE_CLIENT_CODE=
RAPIDSHYP_TOKEN=
RAPIDSHYP_NEW_TOKEN=
FSHIP_TOKEN=
BDL_TOKEN=
ZIPPYY_EMAIL=
ZIPPYY_PASSWORD=
SMARTSHIP_USERNAME=
SMARTSHIP_CLIENT_ID=
SMARTSHIP_CLIENT_SECRET=
