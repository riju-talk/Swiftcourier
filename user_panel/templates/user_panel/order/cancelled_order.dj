{% extends "components/layouts/layout.dj" %}

{% load static %}

{% block title %}
    Ready to Ship
{% endblock title %}


{% block css %}
    <style>
        [x-cloak] {
            display: none !important;
        }

        .date-transition {
            transition: all 0.2s ease-in-out;
        }
    </style>

    <style>
        /* Scrollbar Styling */
        ::-webkit-scrollbar {
            width: 8px;
            height: 8px;
        }

        ::-webkit-scrollbar-track {
            @apply bg-neutral-100 dark:bg-white/[0.06];
        }

        ::-webkit-scrollbar-thumb {
            @apply bg-neutral-300 dark:bg-neutral-600 rounded-full;
        }

        ::-webkit-scrollbar-thumb:hover {
            @apply bg-neutral-400 dark:bg-gray-500;
        }
    </style>

{% endblock css %}


{% block body %}



    <div class="max-w-7xl mx-auto bg-white dark:bg-neutral-900 rounded-lg border border-neutral-200 dark:border-white/10">
        <!-- Header Section -->
        <div class="flex flex-col sm:flex-row items-center justify-between p-4 sm:p-6 border-b border-neutral-200 dark:border-white/10 gap-4">
            <!-- Left: Title + Search -->
            <div class="flex items-center gap-4 w-full sm:w-auto">
                <h2 class="text-xl font-semibold text-black dark:text-white whitespace-nowrap">Cancelled Orders</h2>
                <input type="text"
                       id="searchInput"
                       name="q"
                       placeholder="Search Order"
                       value="{{ request.GET.q }}"
                       onenter="handleSearch(this.value)"
                       class="w-48 px-3 py-1.5 border rounded-lg text-sm focus:outline-hidden focus:ring-2 focus:ring-red-500 dark:bg-white/[0.06] dark:border-white/10 dark:text-gray-100 dark:placeholder-neutral-400">
            </div>

            <!-- Right: Buttons -->
            <div class="flex items-center gap-2 w-full sm:w-auto justify-end">
                <div id="actionButtons" class="hidden">
                    <button onclick="openCancelModal()"
                            class="px-3 py-2 bg-green-600 hover:bg-green-700 rounded-lg text-white text-sm">
                        Cancel
                    </button>
                    <button onclick="downloadLabelOfSelectedOrders()"
                            class="px-3 py-2 bg-green-600 hover:bg-green-700 rounded-lg text-white text-sm">
                        Download Labels
                    </button>
                    <button onclick="downloadInvoiceOfSelectedOrders()"
                            class="px-3 py-2 bg-red-600 hover:bg-red-700 rounded-lg text-white text-sm">
                        Download Invoices
                    </button>

                </div>
                <button id="filterToggleBtn"
                        class="inline-flex items-center gap-1.5 h-9 px-3.5 rounded-lg border border-neutral-300 bg-white hover:bg-neutral-50 dark:border-white/15 dark:bg-transparent"
                        title="Filter Orders">
                    <!-- Original filter icon -->
                    <svg class="w-5 h-5 text-red-600"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2"
                         viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2a1 1 0 01-.293.707L15 13.414V19a1 1 0 01-1.447.894l-4-2A1 1 0 019 17v-3.586L3.293 6.707A1 1 0 013 6V4z" />
                    </svg>
                    <span id="filterToggleText" class="text-red-600 font-semibold">Filter</span>
                </button>
                <button class="px-3 py-2 bg-red-600 hover:bg-red-700 rounded-lg text-white text-sm"
                        id="exportOrderButton">Export</button>
            </div>
        </div>

        {% include "components/common/user_panel_filter.dj" %}


        <!-- Table -->
        <div class="overflow-y-auto max-h-[600px] border border-white dark:border-white/10 rounded-lg">
            <table class="w-full">
                <thead class="bg-gray-50 dark:bg-white/[0.06] sticky top-0 z-10">
                    <tr>
                        <th class="px-2 py-1 text-left align-middle">
                            <div class="flex items-center">
                                <input type="checkbox"
                                       id="selectAll"
                                       class="w-4 h-4 rounded-sm border-neutral-300 dark:bg-neutral-600 dark:border-white/10-500">
                            </div>
                        </th>
                        <th class="px-2 py-1 text-left text-xs font-normal text-neutral-600 dark:text-neutral-300">CHANNEL</th>
                        <th class="px-2 py-1 text-left text-xs font-normal text-neutral-600 dark:text-neutral-300">ORDER ID</th>
                        <th class="px-2 py-1 text-left text-xs font-normal text-neutral-600 dark:text-neutral-300">ORDER NUMBER</th>
                        <th class="px-2 py-1 text-left text-xs font-normal text-neutral-600 dark:text-neutral-300">DATE</th>
                        <th class="px-2 py-1 text-left text-xs font-normal text-neutral-600 dark:text-neutral-300">CUSTOMER</th>
                        <th class="px-2 py-1 text-left text-xs font-normal text-neutral-600 dark:text-neutral-300">PRODUCTS</th>
                        <th class="px-2 py-1 text-left text-xs font-normal text-neutral-600 dark:text-neutral-300">QTY</th>
                        <th class="px-2 py-1 text-left text-xs font-normal text-neutral-600 dark:text-neutral-300">AMT</th>
                        <th class="px-2 py-1 text-left text-xs font-normal text-neutral-600 dark:text-neutral-300">TYPE</th>
                        <th class="px-2 py-1 text-left text-xs font-normal text-neutral-600 dark:text-neutral-300">STATUS</th>
                        <th class="px-2 py-1 text-left text-xs font-normal text-neutral-600 dark:text-neutral-300">ACTION</th>

                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-200 dark:divide-gray-700">
                    <!-- Sample Data -->
                    {% for order in page_obj %}
                        <tr class="hover:bg-gray-50 dark:hover:bg-black">
                            <td class="px-2 py-1">
                                <input type="checkbox"
                                       value="{{ order.id }}"
                                       class="ship-order-ids row-checkbox rounded-sm border-neutral-300 dark:bg-neutral-600">
                            </td>
                            <td class="px-1 py-0.5 text-xs text-black dark:text-neutral-300">{{ order.get_channel_display }}</td>
                            <td class="px-1 py-0.5 text-xs font-medium text-black dark:text-white">{{ order.get_order_id }}</td>
                            <td class="px-1 py-0.5 text-xs font-medium text-red-600 hover:underline dark:text-red-400">
                                <a href="{% url 'user_panel:order-details' id=order.id %}">{{ order.order_number }}</a>
                            </td>
                            <td class="px-1 py-0.5 text-xs text-black dark:text-neutral-300">{{ order.created_at|date:"M d, Y - h:i A" }}</td>
                            <td class="px-1 py-0.5 text-xs text-black dark:text-neutral-300">{{ order.shipping_address.name }}</td>
                            <td class="px-1 py-0.5 text-xs text-black dark:text-neutral-300">{{ order.items.all.0.product.name }}</td>
                            <td class="px-1 py-0.5 text-xs text-black dark:text-neutral-300">{{ order.items.all.0.quantity }}</td>
                            <td class="px-1 py-0.5 text-xs text-black dark:text-neutral-300">{{ order.total_amount }}</td>
                            <td class="px-1 py-0.5 text-xs text-black dark:text-neutral-300">Standard</td>
                            <td class="px-1 py-0.5">
                                <span class="px-1 py-0.5 text-[9px] font-medium rounded-sm bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-200">
                                    {{ order.get_status_display }}
                                </span>
                            </td>

                            <td class="px-1 py-0.5">
                                <div class="relative">
                                    <button class="action-btn p-0.5 hover:bg-neutral-100 dark:hover:bg-neutral-600 rounded-lg">⋮</button>
                                    <div class="action-menu hidden absolute right-0 mt-1 w-32 bg-white dark:bg-neutral-900 border dark:border-white/10 rounded-lg shadow-lg py-1 z-50">
                                        <a href="#"
                                           class="block px-3 py-2 text-xs hover:bg-neutral-100 dark:hover:bg-black dark:text-gray-100">
                                            Re-Ship
                                        </a>
                                        <a href="#"
                                           class="block px-3 py-2 text-xs hover:bg-neutral-100 dark:hover:bg-black dark:text-gray-100">Clone</a>
                                        <a href="#"
                                           class="block px-3 py-2 text-xs hover:bg-neutral-100 dark:hover:bg-black dark:text-gray-100">Edit</a>
                                    </div>
                                </div>
                            </td>
                        </tr>

                    {% empty %}
                        <tr>
                            <td colspan="11"
                                class="text-center py-4 text-neutral-500 dark:text-neutral-400">
                                <div class="flex justify-center items-center h-full">
                                    <svg class="w-5 h-5 mr-2"
                                         fill="none"
                                         stroke="currentColor"
                                         viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z">
                                        </path>
                                    </svg>
                                    No data found
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        <!-- Pagination -->
        <div class="p-4 border-t dark:border-white/10">
            <div class="flex flex-col sm:flex-row justify-between items-center gap-4">
                <div class="flex items-center gap-4">
                    <span class="text-sm text-black dark:text-neutral-300">Show:</span>
                    <select id="pageSize"
                            onchange="updatePageSize(this.value)"
                            class="px-2 py-1 border rounded-sm text-sm dark:bg-white/[0.06] dark:border-white/10 dark:text-gray-100">
                        <option value="10" {% if page_size == 10 %}selected{% endif %}>10</option>
                        <option value="50" {% if page_size == 50 %}selected{% endif %}>50</option>
                        <option value="100" {% if page_size == 100 %}selected{% endif %}>100</option>
                        <option value="200" {% if page_size == 200 %}selected{% endif %}>200</option>
                        <option value="500" {% if page_size == 500 %}selected{% endif %}>500</option>
                    </select>
                </div>

                <div class="flex gap-1">
                    <button onclick="navigatePage('prev')"
                            class="px-3 py-1 bg-neutral-100 hover:bg-white dark:bg-white/[0.06] dark:hover:bg-neutral-600 rounded-sm text-sm dark:text-gray-100"
                            {% if not page_obj.has_previous %}disabled{% endif %}>Previous</button>

                    {% for num in page_obj.paginator.page_range %}
                        <button onclick="navigatePage({{ num }})"
                                class="px-3 py-1
                                       {% if num == page_obj.number %}
                                           bg-red-100 text-red-600
                                       {% else %}
                                           bg-neutral-100 hover:bg-white dark:bg-white/[0.06] dark:hover:bg-neutral-600
                                       {% endif %}
                                       rounded text-sm dark:text-gray-100">{{ num }}</button>
                    {% endfor %}

                    <button onclick="navigatePage('next')"
                            class="px-3 py-1 bg-neutral-100 hover:bg-white dark:bg-white/[0.06] dark:hover:bg-neutral-600 rounded-sm text-sm dark:text-gray-100"
                            {% if not page_obj.has_next %}disabled{% endif %}>Next</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal -->
    <div id="shipModal"
         class="fixed inset-0 bg-black/50 hidden items-center justify-center z-50">
        <div class="bg-white dark:bg-neutral-900 rounded-lg shadow-lg w-96 p-6 mx-4 transform -translate-y-1/2 -translate-x-1/2 top-1/2 left-1/2 fixed">
            <h2 class="text-lg font-bold mb-4 dark:text-gray-100">Ship Selected Orders</h2>
            <form id="shipForm"
                  action="{% url 'order_manager:ship-order' %}"
                  method="post">
                {% csrf_token %}
                <input type="hidden" name="order_ids" value="">
                <label class="block mb-2 text-sm text-black dark:text-neutral-300">Select Warehouse</label>
                <select name="warehouse"
                        class="w-full mb-4 px-3 py-2 border rounded-lg dark:bg-white/[0.06] dark:border-white/10 dark:text-gray-100">
                    <option disabled>Select Warehouse</option>
                    {% for hub in request.user.hubs.all %}<option value="{{ hub.id }}">{{ hub.name }}</option>{% endfor %}
                </select>
                <label class="block mb-2 text-sm text-black dark:text-neutral-300">Courier Partner</label>
                <select name="courier"
                        class="w-full mb-4 px-3 py-2 border rounded-lg dark:bg-white/[0.06] dark:border-white/10 dark:text-gray-100">
                    <option disabled>Select Courier</option>
                    {% for courier in couriers %}<option value="{{ courier.id }}">{{ courier.name }}</option>{% endfor %}
                </select>
                <div class="flex justify-end gap-2">
                    <button type="button"
                            onclick="closeModal()"
                            class="px-4 py-2 bg-white hover:bg-neutral-300 dark:bg-white/[0.06] dark:hover:bg-neutral-600 rounded-sm dark:text-gray-100">
                        Cancel
                    </button>
                    <button type="submit"
                            onclick="shipSelectedOrders()"
                            class="px-4 py-2 bg-red-600 hover:bg-red-700 text-white rounded-sm">Submit</button>
                </div>
            </form>
        </div>
    </div>



{% endblock body %}



{% block js %}
    <script defer src="{% static 'assets/js/apexcharts.js' %}"></script>
    <script src="{% static 'assets/js/simple-datatables.js' %}"></script>


    <script>
        // Action Menu Handling
        document.querySelectorAll('.action-btn').forEach(button => {
            button.addEventListener('click', (e) => {
                e.stopPropagation();
                const menu = button.nextElementSibling;
                const isOpen = !menu.classList.contains('hidden');

                // Close all other menus
                document.querySelectorAll('.action-menu').forEach(m => m.classList.add('hidden'));

                // Toggle current menu
                menu.classList.toggle('hidden', isOpen);
            });
        });

        // Close menus when clicking outside
        document.addEventListener('click', (e) => {
            if (!e.target.closest('.action-btn')) {
                document.querySelectorAll('.action-menu').forEach(menu => {
                    menu.classList.add('hidden');
                });
            }
        });

        // Checkbox Handling
        function updateActionButtons() {
            const checkedCount = document.querySelectorAll('.row-checkbox:checked').length;
            document.getElementById('actionButtons').classList.toggle('hidden', checkedCount === 0);
        }

        document.getElementById('selectAll').addEventListener('change', (e) => {
            document.querySelectorAll('.row-checkbox').forEach(checkbox => {
                checkbox.checked = e.target.checked;
            });
            updateActionButtons();
        });

        document.querySelectorAll('.row-checkbox').forEach(checkbox => {
            checkbox.addEventListener('change', updateActionButtons);
        });

        // Modal Handling
        function openModal() {
            document.getElementById('shipModal').classList.remove('hidden');
        }

        function closeModal() {
            document.getElementById('shipModal').classList.add('hidden');
        }

        // Pagination Handling
        function getCurrentParams() {
            const params = new URLSearchParams(window.location.search);
            return {
                page: parseInt(params.get('page')) || 1,
                size: parseInt(params.get('page_size')) || 10
            };
        }

        // Initialize page size from URL
        window.addEventListener('load', () => {
            const params = getCurrentParams();
            document.getElementById('pageSize').value = params.size;
        });

        function navigatePage(action) {
            const urlParams = new URLSearchParams(window.location.search);
            const currentSearch = document.getElementById('searchInput').value;
            let page = parseInt(urlParams.get('page') || 1);

            if (action === 'prev') {
                page = Math.max(1, page - 1);
            } else if (action === 'next') {
                page = page + 1;
            } else {
                page = parseInt(action);
            }

            if (currentSearch) {
                urlParams.set('q', currentSearch);
            }

            urlParams.set('page', page);
            window.location.search = urlParams.toString();
        }

        function updatePageSize(size) {
            const urlParams = new URLSearchParams(window.location.search);
            const currentSearch = document.getElementById('searchInput').value;

            urlParams.set('page_size', size);
            urlParams.set('page', 1); // Reset to first page

            if (currentSearch) {
                urlParams.set('q', currentSearch);
            }
            window.location.search = urlParams.toString();
        }

        // Add debounce to prevent too many requests
        function handleSearch(value) {
            updateSearchParams(value);
        }

        function updateSearchParams(searchTerm) {
            const urlParams = new URLSearchParams(window.location.search);

            if (searchTerm.trim()) {
                urlParams.set('q', searchTerm);
            } else {
                urlParams.delete('q');
            }

            // Reset to first page when searching
            urlParams.set('page', 1);
            window.location.search = urlParams.toString();
        }

        document.getElementById('searchInput').addEventListener('keydown', (e) => {
            if (e.key === 'Enter') {
                updateSearchParams(e.target.value);
            }
        });

        const shipSelectedOrders = () => {
            // Get all checked checkboxes with class 'ship-order-ids'
            const selectedCheckboxes = document.querySelectorAll('.ship-order-ids:checked');

            // Extract values (order IDs) from the checked checkboxes
            const orderIds = Array.from(selectedCheckboxes).map(checkbox => checkbox.value);

            // Find the hidden input inside the form
            const hiddenInput = document.querySelector('#shipForm input[name="order_ids"]');

            // Set the value of the hidden input to comma-separated order IDs
            hiddenInput.value = orderIds.join(',');

            // Submit the form programmatically
            document.getElementById('shipForm').submit();
        };
    </script>

    <script>
        document.addEventListener("DOMContentLoaded", function() {
            const filterToggleBtn = document.getElementById("filterToggleBtn");
            const filterSection = document.getElementById("filterSection");
            // const filterDateRange = document.getElementById("filter-date-range");
            // const customDateInputs = document.getElementById("customDateInputs");
            const filterCancelBtn = document.getElementById("filterCancelBtn");
            const filterForm = document.getElementById("filterForm");

            // Toggle filter section
            filterToggleBtn.addEventListener("click", () => {
                filterSection.classList.toggle("hidden");
            });

            // Show/hide custom date inputs
            /* filterDateRange.addEventListener("change", (e) => {
                if (e.target.value === 'custom') {
                    customDateInputs.classList.remove('hidden');
                } else {
                    customDateInputs.classList.add('hidden');
                }
            }); */

            // Cancel: clear all fields
            filterCancelBtn.addEventListener("click", () => {
                filterForm.reset();
                customDateInputs.classList.add('hidden');
            });

            // Submit: default form GET submission to action endpoint
        });
    </script>



{% endblock js %}
