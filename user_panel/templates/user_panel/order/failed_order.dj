{% extends "components/layouts/layout.dj" %}

{% load static %}

{% block title %}
    Failed Orders
{% endblock title %}

{% block css %}

    <style>
        /* Tighter padding on all cells */
        #myTable th,
        #myTable td {
            padding: 0.25rem 0.5rem;
            /* 4px top/bottom, 8px left/right */
        }

        /* Add to your stylesheet */
        [x-cloak] {
            display: none !important;
        }

        .table-row {
            position: static;
        }

        [x-cloak] {
            display: none !important;
        }

        .date-transition {
            transition: all 0.2s ease-in-out;
        }
    </style>
{% endblock css %}

{% block body %}
    <div x-data="basic">
        <div class="panel mt-6">

            <div class="flex items-center justify-between mb-6">
                <!-- Left: Title -->
                <h5 class="text-[22px] font-bold tracking-tight text-neutral-900 dark:text-white">Failed Orders</h5>

                <!-- Right: Buttons (unchanged SVGs) -->
                <div class="flex items-center space-x-4">
                    <a href="#"
                       id="exportOrderBtn"
                       class="inline-flex items-center gap-1.5 h-9 px-3.5 rounded-lg border border-neutral-300 bg-white hover:bg-neutral-50 dark:border-white/15 dark:bg-transparent"
                       title="Export Orders">
                        <!-- Original download/export icon -->
                        <svg class="w-5 h-5 text-red-600"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="2"
                             viewBox="0 0 24 24">
                            <path d="M9.31995 6.49994L11.8799 3.93994L14.4399 6.49994" stroke="#b91c1c" stroke-width="1.5" stroke-miterlimit="10" stroke-linecap="round" stroke-linejoin="round" />
                            <path d="M11.88 14.18V4.01001" stroke="#b91c1c" stroke-width="1.5" stroke-miterlimit="10" stroke-linecap="round" stroke-linejoin="round" />
                            <path d="M4 12C4 16.42 7 20 12 20C17 20 20 16.42 20 12" stroke="#b91c1c" stroke-width="1.5" stroke-miterlimit="10" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                        <span id="exportOrderText" class="text-red-600 font-semibold">Export Orders</span>
                    </a>

                    <button id="filterToggleBtn"
                            class="inline-flex items-center gap-1.5 h-9 px-3.5 rounded-lg border border-neutral-300 bg-white hover:bg-neutral-50 dark:border-white/15 dark:bg-transparent"
                            title="Filter Orders">
                        <!-- Original filter icon -->
                        <svg class="w-5 h-5 text-red-600"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="2"
                             viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2a1 1 0 01-.293.707L15 13.414V19a1 1 0 01-1.447.894l-4-2A1 1 0 019 17v-3.586L3.293 6.707A1 1 0 013 6V4z" />
                        </svg>
                        <span id="filterToggleText" class="text-red-600 font-semibold">Filter</span>
                    </button>
                </div>
            </div>


            <!-- Collapsible Filter Section -->
            <form id="filterForm" action="#" method="get">
                <div id="filterSection"
                     class="hidden mb-6 bg-white dark:bg-neutral-900 rounded-2xl shadow-lg border border-white dark:border-white/10 p-6">


                    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-6">

                        <div x-data="dateRangePicker()">
                            <label for="dateRangeInput"
                                   class="block text-sm font-medium text-black dark:text-white mb-2">
                                Date Range
                            </label>
                            <!-- Input Box -->
                            <input type="text"
                                   id="dateRangeInput"
                                   class="w-full px-4 py-2 border rounded-sm cursor-pointer bg-white dark:bg-neutral-900 border-neutral-300 dark:border-white/10 text-black dark:text-white placeholder-neutral-400 dark:placeholder-neutral-500"
                                   readonly
                                   x-model="displayDateRange"
                                   @click="showDropdown = true"
                                   placeholder="Select Date Range">

                            <!-- Dropdown -->
                            <div class="absolute z-50 w-[700px] bg-white dark:bg-neutral-900 border dark:border-white/10 rounded-lg shadow-lg mt-1 transition-all duration-200 ease-out origin-top"
                                 x-show="showDropdown"
                                 x-transition:enter="transition ease-out duration-200"
                                 x-transition:enter-start="opacity-0 scale-95"
                                 x-transition:enter-end="opacity-100 scale-100"
                                 x-transition:leave="transition ease-in duration-150"
                                 x-transition:leave-start="opacity-100 scale-100"
                                 x-transition:leave-end="opacity-0 scale-95"
                                 @click.outside="showDropdown = false"
                                 x-cloak>
                                <div class="flex">
                                    <!-- Presets -->
                                    <div class="w-48 p-4 border-r dark:border-white/10">
                                        <h3 class="mb-2 font-semibold dark:text-white">Presets</h3>
                                        <template x-for="preset in presets">
                                            <button @click="setPreset(preset)"
                                                    class="w-full text-left px-2 py-1 text-sm hover:bg-neutral-100 dark:hover:bg-black rounded-sm date-transition"
                                                    :class="{ 'bg-red-100 dark:bg-red-900/50': preset.active, 'font-semibold text-red-600 dark:text-red-400': preset.label === 'Custom Range' && isCustomRange, 'text-black dark:text-neutral-300': !preset.active }">
                                                <span x-text="preset.label"></span>
                                            </button>
                                        </template>
                                    </div>

                                    <!-- Calendars -->
                                    <div class="flex-1 p-4">
                                        <div class="flex gap-8">
                                            <!-- Start Date Calendar -->
                                            <div class="flex-1">
                                                <div class="flex items-center justify-between mb-2">
                                                    <button @click="prevMonth('start')"
                                                            class="p-1 hover:bg-neutral-100 dark:hover:bg-black rounded-full date-transition text-black dark:text-neutral-300">
                                                        <svg xmlns="http://www.w3.org/2000/svg"
                                                             class="h-5 w-5"
                                                             viewBox="0 0 20 20"
                                                             fill="currentColor">
                                                            <path fill-rule="evenodd" d="M12.707 5.293a1 1 0 010 1.414L9.414 10l3.293 3.293a1 1 0 01-1.414 1.414l-4-4a1 1 0 010-1.414l4-4a1 1 0 011.414 0z" clip-rule="evenodd" />
                                                        </svg>
                                                    </button>
                                                    <h3 class="font-semibold text-center dark:text-white"
                                                        x-text="startCalendar.monthYear"></h3>
                                                    <button @click="nextMonth('start')"
                                                            class="p-1 hover:bg-neutral-100 dark:hover:bg-black rounded-full date-transition text-black dark:text-neutral-300">
                                                        <svg xmlns="http://www.w3.org/2000/svg"
                                                             class="h-5 w-5"
                                                             viewBox="0 0 20 20"
                                                             fill="currentColor">
                                                            <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd" />
                                                        </svg>
                                                    </button>
                                                </div>
                                                <div class="grid grid-cols-7 gap-1 text-sm">
                                                    <template x-for="day in startCalendar.days" :key="day">
                                                        <div class="text-center text-neutral-500 dark:text-neutral-400" x-text="day"></div>
                                                    </template>
                                                    <template x-for="date in startCalendar.dates">
                                                        <button @click="setTempStart(date.date)"
                                                                class="p-1 text-center rounded-sm date-transition relative"
                                                                :class="{ 'bg-red-500 text-white': date.isSelectedStart, 'text-neutral-400 dark:text-neutral-500': !date.isCurrentMonth, 'hover:bg-neutral-100 dark:hover:bg-black': date.isSelectable, 'opacity-50 cursor-not-allowed': !date.isSelectable, 'bg-red-100 dark:bg-red-900/30': date.isInRange && !date.isSelectedStart && !date.isSelectedEnd, 'rounded-l-full': date.isSelectedStart || (date.isInRange && date.isFirstDayOfMonth), 'rounded-r-full': date.isSelectedEnd || (date.isInRange && date.isLastDayOfMonth), 'text-black dark:text-white': date.isCurrentMonth && !date.isSelectedStart && !date.isSelectedEnd }"
                                                                :disabled="!date.isSelectable">
                                                            <span x-text="date.day"></span>
                                                        </button>
                                                    </template>
                                                </div>
                                            </div>

                                            <!-- End Date Calendar -->
                                            <div class="flex-1">
                                                <div class="flex items-center justify-between mb-2">
                                                    <button @click="prevMonth('end')"
                                                            class="p-1 hover:bg-neutral-100 dark:hover:bg-black rounded-full date-transition text-black dark:text-neutral-300">
                                                        <svg xmlns="http://www.w3.org/2000/svg"
                                                             class="h-5 w-5"
                                                             viewBox="0 0 20 20"
                                                             fill="currentColor">
                                                            <path fill-rule="evenodd" d="M12.707 5.293a1 1 0 010 1.414L9.414 10l3.293 3.293a1 1 0 01-1.414 1.414l-4-4a1 1 0 010-1.414l4-4a1 1 0 011.414 0z" clip-rule="evenodd" />
                                                        </svg>
                                                    </button>
                                                    <h3 class="font-semibold text-center dark:text-white"
                                                        x-text="endCalendar.monthYear"></h3>
                                                    <button @click="nextMonth('end')"
                                                            class="p-1 hover:bg-neutral-100 dark:hover:bg-black rounded-full date-transition text-black dark:text-neutral-300">
                                                        <svg xmlns="http://www.w3.org/2000/svg"
                                                             class="h-5 w-5"
                                                             viewBox="0 0 20 20"
                                                             fill="currentColor">
                                                            <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd" />
                                                        </svg>
                                                    </button>
                                                </div>
                                                <div class="grid grid-cols-7 gap-1 text-sm">
                                                    <template x-for="day in endCalendar.days" :key="day">
                                                        <div class="text-center text-neutral-500 dark:text-neutral-400" x-text="day"></div>
                                                    </template>
                                                    <template x-for="date in endCalendar.dates">
                                                        <button @click="setTempEnd(date.date)"
                                                                class="p-1 text-center rounded-sm date-transition relative"
                                                                :class="{ 'bg-red-500 text-white': date.isSelectedEnd, 'text-neutral-400 dark:text-neutral-500': !date.isCurrentMonth, 'hover:bg-neutral-100 dark:hover:bg-black': date.isSelectable, 'opacity-50 cursor-not-allowed': !date.isSelectable, 'bg-red-100 dark:bg-red-900/30': date.isInRange && !date.isSelectedStart && !date.isSelectedEnd, 'rounded-l-full': date.isSelectedStart || (date.isInRange && date.isFirstDayOfMonth), 'rounded-r-full': date.isSelectedEnd || (date.isInRange && date.isLastDayOfMonth), 'text-black dark:text-white': date.isCurrentMonth && !date.isSelectedStart && !date.isSelectedEnd }"
                                                                :disabled="!date.isSelectable">
                                                            <span x-text="date.day"></span>
                                                        </button>
                                                    </template>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Action Buttons -->
                                        <div class="flex justify-end gap-2 mt-4">
                                            <button @click="cancel()"
                                                    class="px-4 py-2 text-sm text-black dark:text-neutral-300 hover:bg-neutral-100 dark:hover:bg-black rounded-sm date-transition">
                                                Cancel
                                            </button>
                                            <button @click="apply()"
                                                    class="px-4 py-2 text-sm text-white bg-red-500 hover:bg-red-600 rounded-sm date-transition"
                                                    :disabled="!tempStart || !tempEnd"
                                                    :class="{ 'opacity-50 cursor-not-allowed': !tempStart || !tempEnd }">
                                                Apply
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <!-- Order Type -->
                        <div>
                            <label for="filter-order-type"
                                   class="block text-sm font-medium text-black dark:text-white mb-2">
                                Order Type
                            </label>
                            <select name="order_type"
                                    id="filter-order-type"
                                    class="w-full px-3 py-2 rounded-lg border border-neutral-300 dark:border-white/10 focus:outline-hidden focus:ring-2 focus:ring-red-200 dark:focus:ring-red-500 bg-white dark:bg-white/[0.06] text-black dark:text-white">
                                <option value="prepaid">Prepaid</option>
                                <option value="cod">COD</option>
                            </select>
                        </div>

                        <!-- Warehouse -->
                        <div>
                            <label for="filter-warehouse"
                                   class="block text-sm font-medium text-black dark:text-white mb-2">
                                Warehouse
                            </label>
                            <select name="warehouse"
                                    id="filter-warehouse"
                                    class="w-full px-3 py-2 rounded-lg border border-neutral-300 dark:border-white/10 focus:outline-hidden focus:ring-2 focus:ring-red-200 dark:focus:ring-red-500 bg-white dark:bg-white/[0.06] text-black dark:text-white">
                                <option value="HUB00012">HUB00012</option>
                                <option value="HUB00034">HUB00034</option>
                            </select>
                        </div>

                        <!-- Order ID -->
                        <div>
                            <label for="filter-order-id"
                                   class="block text-sm font-medium text-black dark:text-white mb-2">
                                Order ID
                            </label>
                            <input type="text"
                                   name="order_id"
                                   id="filter-order-id"
                                   placeholder="ORD-00124"
                                   class="w-full px-3 py-2 rounded-lg border border-neutral-300 dark:border-white/10 bg-white dark:bg-white/[0.06] text-black dark:text-white focus:outline-hidden focus:ring-2 focus:ring-red-200 dark:focus:ring-red-500" />
                        </div>

                        <!-- Product Name -->
                        <div>
                            <label for="filter-product-name"
                                   class="block text-sm font-medium text-black dark:text-white mb-2">
                                Product Name
                            </label>
                            <input type="text"
                                   name="product_name"
                                   id="filter-product-name"
                                   placeholder="T-Shirt"
                                   class="w-full px-3 py-2 rounded-lg border border-neutral-300 dark:border-white/10 bg-white dark:bg-white/[0.06] text-black dark:text-white focus:outline-hidden focus:ring-2 focus:ring-red-200 dark:focus:ring-red-500" />
                        </div>
                    </div>
                    <!-- Submit & Cancel Buttons -->
                    <div class="mt-6 flex justify-end space-x-3">
                        <button type="button"
                                id="filterCancelBtn"
                                class="px-5 py-2 rounded-lg bg-red-50 hover:bg-red-100 text-red-600 transition-colors duration-200 ease-in-out focus:outline-hidden focus:ring-2 focus:ring-red-200">
                            Cancel
                        </button>
                        <button type="submit"
                                id="filterSubmitBtn"
                                class="px-5 py-2 rounded-lg bg-green-600 hover:bg-green-700 text-white transform hover:scale-105 transition-transform duration-200 ease-out focus:outline-hidden focus:ring-2 focus:ring-green-300">
                            Apply Filters
                        </button>
                    </div>
                </div>
            </form>


            <!-- Hide any residual overflow -->
            <div class="overflow-x-auto">
                <table id="myTable"
                       class="min-w-full table-auto text-xs md:text-xs whitespace-nowrap">
                    <!-- Populated by simple-datatables -->
                </table>
            </div>
        </div>
    </div>
{% endblock body %}

{% block js %}
    <script defer src="{% static 'assets/js/apexcharts.js' %}"></script>
    <script src="{% static 'assets/js/simple-datatables.js' %}"></script>

    <script>
        let mydata = [
            [
                '', 'Email', `<a href="{% url 'user_panel:order-details' 12 %}" class="text-red-600 hover:underline">ORD-00123</a>`, `<div x-data="{ open: false }" @mouseenter="open = true" @mouseleave="open = false" class="relative inline-block">
                    <!-- trigger -->
                    <a href="#"">2025-04-15</a>

                    <!-- popover -->
                    <div x-cloak x-show="open" x-transition class="absolute bottom-full left-1/2 -translate-x-1/2 mb-2 w-56 max-w-xs p-4 bg-white border border-neutral-300 text-sm text-gray-800 rounded-lg shadow-lg whitespace-normal wrap-break-word dark:bg-neutral-900 dark:border-white/10 dark:text-white z-50" style="display: none;">
                        <p class="font-medium">Time: 9:35 AM</p>

                        <!-- arrow -->
                        <div class="absolute top-full left-1/2 -translate-x-1/2 w-0 h-0 border-l-8 border-r-8 border-t-8 border-l-transparent border-r-transparent border-t-white dark:border-t-gray-800"></div>
                    </div>
                </div>`,
                `<div x-data="{ open: false }" @mouseenter="open = true" @mouseleave="open = false" class="relative inline-block">
                    <!-- trigger -->
                    <a href="#"">Rahul Kumar</a>

                    <!-- popover -->
                    <div x-cloak x-show="open" x-transition class="absolute bottom-full left-1/2 -translate-x-1/2 mb-2 w-56 max-w-xs p-4 bg-white border border-neutral-300 text-sm text-gray-800 rounded-lg shadow-lg whitespace-normal wrap-break-word dark:bg-neutral-900 dark:border-white/10 dark:text-white z-50" style="display: none;">
                        <p class="font-medium">Name: John Doe</p>
                        <p class="mt-1">Phone: +1 234 567 8901</p>
                        <p class="mt-1">Address: 123 Main St, Springfield, USA</p>

                        <!-- arrow -->
                        <div class="absolute top-full left-1/2 -translate-x-1/2 w-0 h-0 border-l-8 border-r-8 border-t-8 border-l-transparent border-r-transparent border-t-white dark:border-t-gray-800"></div>
                    </div>
                </div>`,

                `<div x-data="{ open: false }" @mouseenter="open = true" @mouseleave="open = false" class="relative inline-block">
                    <!-- product trigger (styled as plain text) -->
                    <a href="#">
                        Awesome Widget
                    </a>

                    <!-- popover (fixed-width, wraps, light / dark) -->
                    <div x-cloak x-show="open" x-transition class="absolute bottom-full left-1/2 -translate-x-1/2 mb-2 w-56 max-w-xs p-4 bg-white border border-neutral-300 text-sm text-gray-800 rounded-lg shadow-lg whitespace-normal wrap-break-word dark:bg-neutral-900 dark:border-white/10 dark:text-white z-50" style="display: none;">
                        <p class="font-medium">Name: Awesome Widget</p>
                        <p class="mt-1">SKU: AW-12345</p>
                        <p class="mt-1">Price: $19.99</p>
                        <p class="mt-1">In Stock: 42 units</p>

                        <!-- little arrow -->
                        <div class="absolute top-full left-1/2 -translate-x-1/2 w-0 h-0 border-l-8 border-r-8 border-t-8 border-l-transparent border-r-transparent border-t-white dark:border-t-gray-800"></div>
                    </div>
                </div>`,

                3, '₹75.00', 'Standard', 'Low Balance',

                `<div class="relative inline-block text-left">
  <button type="button" class="inline-flex justify-center w-full px-2 py-1 text-sm font-medium text-black hover:text-black" onclick="toggleDropdown(this, event)">
    ⋮
  </button>
  <div class="dropdown-menu hidden absolute right-0 z-10 mt-1 w-40 origin-top-right rounded-md shadow-lg bg-white ring-1 ring-black/5">
    <div class="py-1 text-sm text-black">
      <a href="#" class="block px-4 py-2 hover:bg-neutral-100">Clone Order</a>
      <a href="#" class="block px-4 py-2 hover:bg-neutral-100">Edit Order</a>
      <a href="#" class="block px-4 py-2 hover:bg-neutral-100">Re-Ship</a>
    </div>
  </div>
</div>
`
            ],
            [
                '', 'Email', `<a href="{% url 'user_panel:order-details' 12 %}" class="text-red-600 hover:underline">ORD-00123</a>`, `<div x-data="{ open: false }" @mouseenter="open = true" @mouseleave="open = false" class="relative inline-block">
                    <!-- trigger -->
                    <a href="#"">2025-04-15</a>

                    <!-- popover -->
                    <div x-cloak x-show="open" x-transition class="absolute bottom-full left-1/2 -translate-x-1/2 mb-2 w-56 max-w-xs p-4 bg-white border border-neutral-300 text-sm text-gray-800 rounded-lg shadow-lg whitespace-normal wrap-break-word dark:bg-neutral-900 dark:border-white/10 dark:text-white z-50" style="display: none;">
                        <p class="font-medium">Time: 9:35 AM</p>

                        <!-- arrow -->
                        <div class="absolute top-full left-1/2 -translate-x-1/2 w-0 h-0 border-l-8 border-r-8 border-t-8 border-l-transparent border-r-transparent border-t-white dark:border-t-gray-800"></div>
                    </div>
                </div>`,
                `<div x-data="{ open: false }" @mouseenter="open = true" @mouseleave="open = false" class="relative inline-block">
                    <!-- trigger -->
                    <a href="#"">Rahul Kumar</a>

                    <!-- popover -->
                    <div x-cloak x-show="open" x-transition class="absolute bottom-full left-1/2 -translate-x-1/2 mb-2 w-56 max-w-xs p-4 bg-white border border-neutral-300 text-sm text-gray-800 rounded-lg shadow-lg whitespace-normal wrap-break-word dark:bg-neutral-900 dark:border-white/10 dark:text-white z-50" style="display: none;">
                        <p class="font-medium">Name: John Doe</p>
                        <p class="mt-1">Phone: +1 234 567 8901</p>
                        <p class="mt-1">Address: 123 Main St, Springfield, USA</p>

                        <!-- arrow -->
                        <div class="absolute top-full left-1/2 -translate-x-1/2 w-0 h-0 border-l-8 border-r-8 border-t-8 border-l-transparent border-r-transparent border-t-white dark:border-t-gray-800"></div>
                    </div>
                </div>`,

                `<div x-data="{ open: false }" @mouseenter="open = true" @mouseleave="open = false" class="relative inline-block">
                    <!-- product trigger (styled as plain text) -->
                    <a href="#">
                        Awesome Widget
                    </a>

                    <!-- popover (fixed-width, wraps, light / dark) -->
                    <div x-cloak x-show="open" x-transition class="absolute bottom-full left-1/2 -translate-x-1/2 mb-2 w-56 max-w-xs p-4 bg-white border border-neutral-300 text-sm text-gray-800 rounded-lg shadow-lg whitespace-normal wrap-break-word dark:bg-neutral-900 dark:border-white/10 dark:text-white z-50" style="display: none;">
                        <p class="font-medium">Name: Awesome Widget</p>
                        <p class="mt-1">SKU: AW-12345</p>
                        <p class="mt-1">Price: $19.99</p>
                        <p class="mt-1">In Stock: 42 units</p>

                        <!-- little arrow -->
                        <div class="absolute top-full left-1/2 -translate-x-1/2 w-0 h-0 border-l-8 border-r-8 border-t-8 border-l-transparent border-r-transparent border-t-white dark:border-t-gray-800"></div>
                    </div>
                </div>`,

                3, '₹75.00', 'Standard', 'Low Balance',

                `<div class="relative inline-block text-left">
  <button type="button" class="inline-flex justify-center w-full px-2 py-1 text-sm font-medium text-black hover:text-black" onclick="toggleDropdown(this, event)">
    ⋮
  </button>
  <div class="dropdown-menu hidden absolute right-0 z-10 mt-1 w-40 origin-top-right rounded-md shadow-lg bg-white ring-1 ring-black/5">
    <div class="py-1 text-sm text-black">
      <a href="#" class="block px-4 py-2 hover:bg-neutral-100">Clone Order</a>
      <a href="#" class="block px-4 py-2 hover:bg-neutral-100">Edit Order</a>
      <a href="#" class="block px-4 py-2 hover:bg-neutral-100">Re-Ship</a>
    </div>
  </div>
</div>
`
            ],
            [
                '', 'Email', `<a href="{% url 'user_panel:order-details' 12 %}" class="text-red-600 hover:underline">ORD-00123</a>`, `<div x-data="{ open: false }" @mouseenter="open = true" @mouseleave="open = false" class="relative inline-block">
                    <!-- trigger -->
                    <a href="#"">2025-04-15</a>

                    <!-- popover -->
                    <div x-cloak x-show="open" x-transition class="absolute bottom-full left-1/2 -translate-x-1/2 mb-2 w-56 max-w-xs p-4 bg-white border border-neutral-300 text-sm text-gray-800 rounded-lg shadow-lg whitespace-normal wrap-break-word dark:bg-neutral-900 dark:border-white/10 dark:text-white z-50" style="display: none;">
