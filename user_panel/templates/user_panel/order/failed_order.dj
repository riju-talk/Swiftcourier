        ];
        document.addEventListener("alpine:init", () => {
            Alpine.data('dateRangePicker', () => ({
                DateTime: luxon.DateTime,
                startDate: null,
                endDate: null,
                tempStart: null,
                tempEnd: null,
                showDropdown: false,
                startMonth: luxon.DateTime.local(),
                endMonth: luxon.DateTime.local().plus({
                    months: 1
                }),

                presets: [{
                    label: 'Today',
                    days: 0
                }, {
                    label: 'Yesterday',
                    days: -1
                }, {
                    label: 'Last 7 Days',
                    days: -6
                }, {
                    label: 'Last 30 Days',
                    days: -29
                }, {
                    label: 'This Month',
                    month: 'current'
                }, {
                    label: 'Last Month',
                    month: 'previous'
                }, {
                    label: 'Custom Range',
                    type: 'custom'
                }],

                get isCustomRange() {
                    return !this.presets.find(p => p.active)
                },

                init() {
                    this.setPreset(this.presets[0])
                },

                get displayDateRange() {
                    if (!this.startDate || !this.endDate) return ''
                    return `${this.startDate.toFormat('MMM dd, yyyy')} - ${this.endDate.toFormat('MMM dd, yyyy')}`
                },

                get startCalendar() {
                    return this.generateCalendar(this.startMonth, 'start')
                },

                get endCalendar() {
                    return this.generateCalendar(this.endMonth, 'end')
                },

                generateCalendar(referenceDate, type) {
                    const monthStart = referenceDate.startOf('month')
                    const monthEnd = monthStart.endOf('month')
                    const startDay = monthStart.weekday
                    const daysInMonth = monthEnd.day

                    const dates = []
                    let currentDate = monthStart.minus({
                        days: startDay
                    })

                    for (let i = 0; i < 42; i++) {
                        const date = currentDate.plus({
                            days: i
                        })
                        const isCurrentMonth = date.month === referenceDate.month
                        const isSelectedStart = this.tempStart && date.hasSame(this.tempStart, 'day')
                        const isSelectedEnd = this.tempEnd && date.hasSame(this.tempEnd, 'day')
                        const isInRange = this.isInRange(date)
                        const isFirstDayOfMonth = date.day === 1
                        const isLastDayOfMonth = date.day === date.endOf('month').day

                        const isSelectable = type === 'start' ?
                            (!this.tempEnd || date <= this.tempEnd) :
                            (!this.tempStart || date >= this.tempStart)

                        dates.push({
                            day: date.day,
                            date: date,
                            isCurrentMonth,
                            isSelectedStart,
                            isSelectedEnd,
                            isInRange,
                            isFirstDayOfMonth,
                            isLastDayOfMonth,
                            isSelectable: isSelectable && isCurrentMonth
                        })
                    }

                    return {
                        days: ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'],
                        dates: dates,
                        monthYear: referenceDate.toFormat('MMMM yyyy')
                    }
                },

                isInRange(date) {
                    if (!this.tempStart || !this.tempEnd) return false
                    return date > this.tempStart.startOf('day') && date < this.tempEnd.endOf('day')
                },

                setTempStart(date) {
                    this.tempStart = date.startOf('day')
                    if (!this.tempEnd || this.tempEnd < this.tempStart) {
                        this.tempEnd = this.tempStart
                    }
                    this.activateCustomRange()
                },

                setTempEnd(date) {
                    this.tempEnd = date.endOf('day')
                    if (!this.tempStart || this.tempStart > this.tempEnd) {
                        this.tempStart = this.tempEnd
                    }
                    this.activateCustomRange()
                },

                prevMonth(type) {
                    if (type === 'start') {
                        this.startMonth = this.startMonth.minus({
                            months: 1
                        })
                    } else {
                        this.endMonth = this.endMonth.minus({
                            months: 1
                        })
                    }
                    this.activateCustomRange()
                },

                nextMonth(type) {
                    if (type === 'start') {
                        this.startMonth = this.startMonth.plus({
                            months: 1
                        })
                    } else {
                        this.endMonth = this.endMonth.plus({
                            months: 1
                        })
                    }
                    this.activateCustomRange()
                },

                setPreset(preset) {
                    this.presets.forEach(p => p.active = false)
                    preset.active = true

                    const today = this.DateTime.local()
                    switch (preset.label) {
                        case 'Today':
                            this.tempStart = today.startOf('day')
                            this.tempEnd = today.endOf('day')
                            this.startMonth = today
                            this.endMonth = today
                            break
                        case 'Yesterday':
                            const yesterday = today.minus({
                                days: 1
                            })
                            this.tempStart = yesterday.startOf('day')
                            this.tempEnd = yesterday.endOf('day')
                            this.startMonth = yesterday
                            this.endMonth = yesterday
                            break
                        case 'Last 7 Days':
                            this.tempStart = today.minus({
                                days: 6
                            }).startOf('day')
                            this.tempEnd = today.endOf('day')
                            this.startMonth = this.tempStart
                            this.endMonth = this.tempEnd
                            break
                        case 'Last 30 Days':
                            this.tempStart = today.minus({
                                days: 29
                            }).startOf('day')
                            this.tempEnd = today.endOf('day')
                            this.startMonth = this.tempStart
                            this.endMonth = this.tempEnd
                            break
                        case 'This Month':
                            this.tempStart = today.startOf('month')
                            this.tempEnd = today.endOf('month')
                            this.startMonth = today
                            this.endMonth = today
                            break
                        case 'Last Month':
                            const lastMonth = today.minus({
                                months: 1
                            })
                            this.tempStart = lastMonth.startOf('month')
                            this.tempEnd = lastMonth.endOf('month')
                            this.startMonth = lastMonth
                            this.endMonth = lastMonth
                            break
                        case 'Custom Range':
                            this.tempStart = null
                            this.tempEnd = null
                            this.startMonth = today
                            this.endMonth = today.plus({
                                months: 1
                            })
                            break
                    }
                },

                activateCustomRange() {
                    this.presets.forEach(p => {
                        if (p.label === 'Custom Range') p.active = true
                        else p.active = false
                    })
                },

                cancel() {
                    this.tempStart = this.startDate
                    this.tempEnd = this.endDate
                    this.showDropdown = false
                },

                apply() {
                    if (this.tempStart && this.tempEnd) {
                        this.startDate = this.tempStart
                        this.endDate = this.tempEnd
                        this.showDropdown = false
                    }
                }
            }));
            Alpine.data("basic", () => ({
                datatable: null,

                init() {
                    this.datatable = new simpleDatatables.DataTable('#myTable', {
                        data: {
                            headings: [
                                `<input type="checkbox" @click="toggleAll($event)" />`,
                                "CHANNEL",
                                "ORDER ID",
                                "DATE",
                                "CUSTOMER",
                                "PRODUCTS",
                                "QTY",
                                "AMT",
                                "TYPE",
                                "STATUS",
                                "ACTION"
                            ],
                            data: mydata
                        },
                        searchable: true,
                        perPage: 10,
                        perPageSelect: [10, 20, 30, 50, 100],
                        columns: [{
                                select: 0,
                                sortable: false,
                                className: 'px-2 py-1',
                                render: (data, cell, row) =>
                                    `<input type="checkbox" class="row-checkbox" />`
                            }
                            // other columns default to text
                        ],
                        firstLast: true,
                        firstText: '<svg>…</svg>',
                        lastText: '<svg>…</svg>',
                        prevText: '<svg>…</svg>',
                        nextText: '<svg>…</svg>',
                        labels: {
                            perPage: "{select}"
                        },
                        layout: {
                            top: "{search}",
                            bottom: "{info}{select}{pager}"
                        }
                    });

                    // in case you add sparkline columns later
                    this.datatable.on('datatable.sort', () => this.initChart());
                    this.datatable.on('datatable.page', () => this.initChart());
                    this.datatable.on('datatable.perpage', () => this.initChart());
                    setTimeout(() => this.initChart(), 300);
                },

                toggleAll(event) {
                    const checked = event.target.checked;
                    document.querySelectorAll('.row-checkbox')
                        .forEach(chk => chk.checked = checked);
                },

                initChart() {
                    document.querySelectorAll('.progress-chart').forEach(el => {
                        el.innerHTML = '';
                        new ApexCharts(el, this.chart_options).render();
                    });
                },

                get chart_options() {
                    return {
                        series: [{
                            data: [21, 9, 36, 12, 44, 25, 59]
                        }],
                        chart: {
                            type: 'line',
                            height: 30,
                            sparkline: {
                                enabled: true
                            }
                        },
                        stroke: {
                            curve: 'smooth',
                            width: 2
                        },
                        markers: {
                            size: [4, 7],
                            strokeWidth: 0
                        },
                        colors: [this.randomColor()],
                        grid: {
                            padding: {
                                top: 5,
                                bottom: 5
                            }
                        },
                        tooltip: {
                            x: {
                                show: false
                            },
                            y: {
                                title: {
                                    formatter: () => ''
                                }
                            }
                        }
                    };
                },

                randomColor() {
                    const c = ['#dc2626', '#805dca', '#00ab55', '#e7515a', '#e2a03f', '#2196f3'];
                    return c[Math.floor(Math.random() * c.length)];
                }
            }));
        });
    </script>

    <!-- JavaScript: Toggle, Date Logic & Buttons -->
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            const filterToggleBtn = document.getElementById("filterToggleBtn");
            const filterSection = document.getElementById("filterSection");
            // const filterDateRange = document.getElementById("filter-date-range");
            // const customDateInputs = document.getElementById("customDateInputs");
            const filterCancelBtn = document.getElementById("filterCancelBtn");
            const filterForm = document.getElementById("filterForm");

            // Toggle filter section
            filterToggleBtn.addEventListener("click", () => {
                filterSection.classList.toggle("hidden");
            });

            // Show/hide custom date inputs
            /* filterDateRange.addEventListener("change", (e) => {
                if (e.target.value === 'custom') {
                    customDateInputs.classList.remove('hidden');
                } else {
                    customDateInputs.classList.add('hidden');
                }
            }); */

            // Cancel: clear all fields
            filterCancelBtn.addEventListener("click", () => {
                filterForm.reset();
                customDateInputs.classList.add('hidden');
            });

            // Submit: default form GET submission to action endpoint
        });
    </script>

    <script>
        function toggleDropdown(button) {
            const dropdown = button.nextElementSibling;
            const allDropdowns = document.querySelectorAll('.dropdown-menu');

            // Hide all other dropdowns
            allDropdowns.forEach(d => {
                if (d !== dropdown) d.classList.add('hidden');
            });

            dropdown.classList.toggle('hidden');
        }

        // Hide dropdowns when clicking outside
        document.addEventListener('click', function(e) {
            if (!e.target.closest('.relative')) {
                document.querySelectorAll('.dropdown-menu').forEach(d => d.classList.add('hidden'));
            }
        });
    </script>


    <!-- start hightlight js -->
    <link rel="stylesheet" href="{% static 'assets/css/highlight.min.css' %}">
    <script src="{% static 'assets/js/highlight.min.js' %}"></script>



    <!-- end hightlight js -->

    <script>
        // Toggle one dropdown open/closed, but don't let its own click close it immediately
        function toggleDropdown(btn, evt) {
            evt.stopPropagation();
            const menu = btn.nextElementSibling;
            menu.classList.toggle('hidden');
        }

        // Close all dropdowns when clicking anywhere else
        document.addEventListener('click', () => {
            document
                .querySelectorAll('.dropdown-menu')
                .forEach(menu => menu.classList.add('hidden'));
        });
    </script>



{% endblock js %}
