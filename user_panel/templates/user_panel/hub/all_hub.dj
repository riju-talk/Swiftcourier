{% extends "components/layouts/layout.dj" %}

{% load static %}

{% block title %}
    All Hub
{% endblock title %}

{% block css %}
{% endblock css %}

{% block body %}
    <div x-data="basic">
        <div class="panel mt-6">
            <h5 class="font-semibold text-lg dark:text-white-light">Warehouse List</h5>
            <div class="flex justify-end">
                <div class="flex flex-wrap gap-3">

                    <!-- + New Warehouse Button -->
                    <a href="{% url 'user_panel:add-hub' %}"
                       class="px-4 py-2 rounded-lg border text-blue-600 dark:text-blue-400 border-blue-500 bg-transparent hover:bg-blue-100 dark:hover:bg-blue-900/20 focus:outline-none focus:ring-2 focus:ring-blue-400 transition">
                        + New Warehouse
                    </a>

                    <!-- Import Button -->
                    <button class="px-4 py-2 rounded-lg border text-green-600 dark:text-green-400 border-green-500 bg-transparent hover:bg-green-100 dark:hover:bg-green-900/20 focus:outline-none focus:ring-2 focus:ring-green-400 transition">
                        Import
                    </button>

                    <!-- Export Button -->
                    <button class="px-4 py-2 rounded-lg border text-yellow-600 dark:text-yellow-400 border-yellow-500 bg-transparent hover:bg-yellow-100 dark:hover:bg-yellow-900/20 focus:outline-none focus:ring-2 focus:ring-yellow-400 transition">
                        Export
                    </button>

                </div>
            </div>

            <table id="myTable" class="whitespace-nowrap table-hover">
                <!-- table will be populated by simple-datatables -->
            </table>
        </div>
    </div>
{% endblock body %}

{% block js %}
    <script defer src="{% static 'assets/js/apexcharts.js' %}"></script>
    <script src="{% static 'assets/js/simple-datatables.js' %}"></script>

    <script>
        mydata = [
            // two demo rows only\
            {% for hub in hubs %}
            [
                '', // checkbox cell (rendered via columns.render)
                '{{ hub.id }}', // CHANNEL
                '{{ hub.name }}', // CHANNEL
                `<div class="leading-tight">
                    <span>{{ hub.contact_person }}</span><br>
                    <span class="text-gray-600">{{ hub.phone }}</span><br>
                    <span class="text-gray-600">{{ hub.email }}</span>
                </div>
                `, // ORDER ID
                                `<div class="leading-tight">
                    <span>{{ hub.address_line1 }}</span><br>
                    <span class="text-gray-600">{{ hub.address_line2 }}</span><br>
                    <span class="text-gray-600">{{ hub.city }}</span>
                    <span class="text-gray-600">{{ hub.pin_code }}</span>
                </div>
                `, // DATE
                                `<div class="flex gap-4">

                    <!-- Deactivate Button -->
                    <a href="{% url 'user_panel:deactivate-hub' %}?id={{ hub.id }}" class="px-4 py-2 rounded-lg border border-red-400 text-red-600 dark:text-red-300 bg-red-50 dark:bg-red-900/10 hover:bg-red-100 dark:hover:bg-red-900/20 transition font-medium">
                        Deactivate
                    </a>

                    <!-- Make Primary Button -->
                    {# Check if the hub is already primary #}
                    {% if hub.is_primary %}
                        <button class="px-4 py-2 rounded-lg text-white bg-green-600 transition font-medium" disabled>
                            Primary
                        </button>
                    {% else %}
                        <a href="{% url 'user_panel:make-primary-hub' %}?id={{ hub.id }}" class="px-4 py-2 rounded-lg border border-green-400 text-green-600 dark:text-green-300 bg-green-50 dark:bg-green-900/10 hover:bg-green-100 dark:hover:bg-green-900/20 transition font-medium">
                            Make Primary
                        </a>
                    {% endif %}
                </div>
                `, // CUSTOMER
            ], 
            {% endfor %}
        ]
        document.addEventListener("alpine:init", () => {
            Alpine.data("basic", () => ({
                datatable: null,

                init() {
                    this.datatable = new simpleDatatables.DataTable('#myTable', {
                        data: {
                            headings: [
                                // “select all” checkbox in header
                                `<input type="checkbox" @click="toggleAll($event)" />`,
                                "ID",
                                "WAREHOUSE NAME",
                                "CONTACT PERSON",
                                "WAREHOUSE DETAILS",
                                "ACTION"
                            ],
                            data: mydata
                        },
                        searchable: false,
                        perPage: 10,
                        perPageSelect: [10, 20, 30, 50, 100],
                        columns: [{
                                select: 0,
                                sortable: false,
                                render: (data, cell, row) => {
                                    // per-row checkbox
                                    return `<input type="checkbox" class="row-checkbox" />`;
                                }
                            }
                            // All other columns will render as simple text by default
                        ],
                        firstLast: true,
                        firstText: '<svg …>…</svg>',
                        lastText: '<svg …>…</svg>',
                        prevText: '<svg …>…</svg>',
                        nextText: '<svg …>…</svg>',
                        labels: {
                            perPage: "{select}"
                        },
                        layout: {
                            top: "{search}",
                            bottom: "{info}{select}{pager}"
                        }
                    });

                    // keep your chart hooks in case you add sparkline columns later
                    this.datatable.on('datatable.sort', () => this.initChart());
                    this.datatable.on('datatable.page', () => this.initChart());
                    this.datatable.on('datatable.perpage', () => this.initChart());
                    setTimeout(() => this.initChart(), 300);
                },

                // toggle all row checkboxes
                toggleAll(event) {
                    const checked = event.target.checked;
                    document.querySelectorAll('.row-checkbox').forEach(chk => {
                        chk.checked = checked;
                    });
                },

                // chart init stub
                initChart() {
                    const ele = document.querySelectorAll('.progress-chart');
                    ele.forEach((el, i) => {
                        el.innerHTML = '';
                        new ApexCharts(el, this.chart_options).render();
                    });
                },

                get chart_options() {
                    return {
                        series: [{
                            data: [21, 9, 36, 12, 44, 25, 59]
                        }],
                        chart: {
                            type: 'line',
                            height: 30,
                            sparkline: {
                                enabled: true
                            }
                        },
                        stroke: {
                            curve: 'smooth',
                            width: 2
                        },
                        markers: {
                            size: [4, 7],
                            strokeWidth: 0
                        },
                        colors: [this.randomColor()],
                        grid: {
                            padding: {
                                top: 5,
                                bottom: 5
                            }
                        },
                        tooltip: {
                            x: {
                                show: false
                            },
                            y: {
                                title: {
                                    formatter: () => ''
                                }
                            }
                        }
                    };
                },

                randomColor() {
                    const c = ['#4361ee', '#805dca', '#00ab55', '#e7515a', '#e2a03f', '#2196f3'];
                    return c[Math.floor(Math.random() * c.length)];
                },

                // (you can remove unused methods below if you like)
                randomStatusColor() {
                    /* … */
                },
                randomStatus() {
                    /* … */
                },
                getRandomNumber() {
                    /* … */
                },
                getCountry() {
                    /* … */
                }
            }));
        });
    </script>
{% endblock js %}
