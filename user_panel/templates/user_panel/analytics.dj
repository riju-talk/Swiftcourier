{% extends "components/layouts/layout.dj" %}
{% block title %}
    Analytics
{% endblock title %}
{% block css %}
    <script src="https://cdn.jsdelivr.net/npm/apexcharts"></script>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        primary: "#4361ee",
                        secondary: "#805dca",
                        success: "#00ab55",
                        danger: "#e7515a",
                        warning: "#e2a03f",
                        info: "#2196f3",
                        dark: "#3b3f5c"
                    }
                }
            }
        }
    </script>
    <style>
        [x-cloak] {
            display: none !important;
        }
        .panel {
            @apply bg-white dark:bg-black rounded-xl shadow-[0_0_15px_0_rgba(0, 0, 0, 0.05)] dark:shadow-[0_0_15px_0_rgba(0, 0, 0, 0.2)] border border-white-light dark:border-dark p-5;
        }
        .badge {
            @apply inline-flex items-center justify-center px-2.5 py-0.5 text-xs font-medium rounded-full;
        }
        .loading {
            @apply animate-pulse bg-gray-200 dark:bg-gray-700 rounded;
        }
    </style>
{% endblock css %}
{% load static %}
{% block body %}
    <div class="p-6">
        <!-- Breadcrumb -->
        <ul class="flex space-x-2 rtl:space-x-reverse mb-6">
            <li>
                <a href="javascript:;" class="text-primary hover:underline">Dashboard</a>
            </li>
            <li class="before:content-['/'] ltr:before:mr-1 rtl:before:ml-1">
                <span>Analytics</span>
            </li>
        </ul>
        <!-- Loading Indicator -->
        <div id="loading-indicator"
             class="fixed inset-0 bg-gray-600/50 overflow-y-auto h-full w-full z-50 flex items-center justify-center">
            <div class="bg-white dark:bg-gray-800 rounded-lg p-8 shadow-xl">
                <div class="flex items-center space-x-4">
                    <div class="animate-spin rounded-full h-8 w-8 border-b-2 border-primary"></div>
                    <div class="text-lg font-semibold text-gray-700 dark:text-gray-300">Loading Analytics Data...</div>
                </div>
            </div>
        </div>
        <!-- Stats Cards -->
        <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-6 mb-6 text-white">
            <!-- Total Orders -->
            <div class="panel bg-linear-to-r from-cyan-500 to-cyan-400 p-5 rounded-lg">
                <div class="text-md font-semibold">Total Orders</div>
                <div class="text-3xl font-bold mt-3" id="total-orders">-</div>
                <div class="mt-2 text-sm font-medium">
                    Last month: <span id="total-orders-last-month">-</span>
                </div>
            </div>
            <!-- In Transit -->
            <div class="panel bg-linear-to-r from-violet-500 to-violet-400 p-5 rounded-lg">
                <div class="text-md font-semibold">In Transit</div>
                <div class="text-3xl font-bold mt-3" id="in-transit">-</div>
                <div class="mt-2 text-sm font-medium">
                    Last month: <span id="in-transit-last-month">-</span>
                </div>
            </div>
            <!-- Delivered -->
            <div class="panel bg-linear-to-r from-blue-500 to-blue-400 p-5 rounded-lg">
                <div class="text-md font-semibold">Delivered</div>
                <div class="text-3xl font-bold mt-3" id="delivered">-</div>
                <div class="mt-2 text-sm font-medium">
                    Last month: <span id="delivered-last-month">-</span>
                </div>
            </div>
            <!-- RTO -->
            <div class="panel bg-linear-to-r from-fuchsia-500 to-fuchsia-400 p-5 rounded-lg">
                <div class="text-md font-semibold">RTO</div>
                <div class="text-3xl font-bold mt-3" id="rto">-</div>
                <div class="mt-2 text-sm font-medium">
                    Last month: <span id="rto-last-month">-</span>
                </div>
            </div>
        </div>
        <!-- Orders Stats -->
        <div>
            <div class="flex items-center mb-5 font-bold">
                <span class="text-lg">Current Month Data</span>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-3 lg:grid-cols-6 gap-6 md:mb-5">
                <!-- Total Orders -->
                <div class="panel p-4 text-center">
                    <div class="shrink-0 w-12 h-12 bg-cyan-500 text-white rounded-full grid place-content-center mx-auto">📦</div>
                    <h6 class="mt-3 font-semibold text-dark dark:text-white-light">Total Orders</h6>
                    <div class="text-2xl font-bold mt-1" id="current-month-total-orders">-</div>
                </div>
                <!-- Pickup Pending -->
                <div class="panel p-4 text-center">
                    <div class="shrink-0 w-12 h-12 bg-amber-500 text-white rounded-full grid place-content-center mx-auto">⏳</div>
                    <h6 class="mt-3 font-semibold text-dark dark:text-white-light">Pickup Pending</h6>
                    <div class="text-2xl font-bold mt-1" id="current-month-pickup-pending">-</div>
                </div>
                <!-- In Transit -->
                <div class="panel p-4 text-center">
                    <div class="shrink-0 w-12 h-12 bg-violet-500 text-white rounded-full grid place-content-center mx-auto">🚚</div>
                    <h6 class="mt-3 font-semibold text-dark dark:text-white-light">In Transit</h6>
                    <div class="text-2xl font-bold mt-1" id="current-month-in-transit">-</div>
                </div>
                <!-- OFD -->
                <div class="panel p-4 text-center">
                    <div class="shrink-0 w-12 h-12 bg-blue-500 text-white rounded-full grid place-content-center mx-auto">📬</div>
                    <h6 class="mt-3 font-semibold text-dark dark:text-white-light">OFD</h6>
                    <div class="text-2xl font-bold mt-1" id="current-month-ofd">-</div>
                </div>
                <!-- Delivered -->
                <div class="panel p-4 text-center">
                    <div class="shrink-0 w-12 h-12 bg-green-500 text-white rounded-full grid place-content-center mx-auto">✅</div>
                    <h6 class="mt-3 font-semibold text-dark dark:text-white-light">Delivered</h6>
                    <div class="text-2xl font-bold mt-1" id="current-month-delivered">-</div>
                </div>
                <!-- RTO -->
                <div class="panel p-4 text-center">
                    <div class="shrink-0 w-12 h-12 bg-fuchsia-500 text-white rounded-full grid place-content-center mx-auto">🔄</div>
                    <h6 class="mt-3 font-semibold text-dark dark:text-white-light">RTO</h6>
                    <div class="text-2xl font-bold mt-1" id="current-month-rto">-</div>
                </div>
            </div>
        </div>
        <div class="grid grid-cols-1 xl:grid-cols-2 gap-6">
            <div class="grid gap-6 xl:grid-flow-row">
                <!-- last month stats -->
                <div class="panel overflow-hidden p-5">
                    <!-- Title -->
                    <div class="flex items-center justify-between mb-6">
                        <div class="text-lg font-bold">Last Month</div>
                    </div>
                    <!-- Stats -->
                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
                        <!-- Total Orders -->
                        <div class="flex items-center gap-3">
                            <div class="w-10 h-10 rounded-full bg-blue-100 text-blue-600 flex items-center justify-center">
                                <svg xmlns="http://www.w3.org/2000/svg"
                                     class="w-6 h-6"
                                     fill="none"
                                     viewBox="0 0 24 24"
                                     stroke="currentColor"
                                     stroke-width="2">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M3 7h18M3 12h18m-9 5h9" />
                                </svg>
                            </div>
                            <div>
                                <div class="text-gray-500 text-sm">Total Orders</div>
                                <div class="text-xl font-semibold" id="last-month-total-orders">-</div>
                            </div>
                        </div>
                        <!-- Delivered -->
                        <div class="flex items-center gap-3">
                            <div class="w-10 h-10 rounded-full bg-green-100 text-green-600 flex items-center justify-center">
                                <svg xmlns="http://www.w3.org/2000/svg"
                                     class="w-6 h-6"
                                     fill="none"
                                     viewBox="0 0 24 24"
                                     stroke="currentColor"
                                     stroke-width="2">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                                </svg>
                            </div>
                            <div>
                                <div class="text-gray-500 text-sm">Delivered</div>
                                <div class="text-xl font-semibold">
                                    <span id="last-month-delivered">-</span>
                                    <span class="text-sm text-green-500" id="last-month-delivered-percent"></span>
                                </div>
                            </div>
                        </div>
                        <!-- RTO -->
                        <div class="flex items-center gap-3">
                            <div class="w-10 h-10 rounded-full bg-red-100 text-red-600 flex items-center justify-center">
                                <svg xmlns="http://www.w3.org/2000/svg"
                                     class="w-6 h-6"
                                     fill="none"
                                     viewBox="0 0 24 24"
                                     stroke="currentColor"
                                     stroke-width="2">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                                </svg>
                            </div>
                            <div>
                                <div class="text-gray-500 text-sm">RTO</div>
                                <div class="text-xl font-semibold">
                                    <span id="last-month-rto">-</span>
                                    <span class="text-sm text-red-500" id="last-month-rto-percent"></span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <!-- current month stats -->
                <div class="panel overflow-hidden p-5">
                    <!-- Title -->
                    <div class="flex items-center justify-between mb-6">
                        <div class="text-lg font-bold">Current Month</div>
                    </div>
                    <!-- Stats -->
                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
                        <!-- Total Orders -->
                        <div class="flex items-center gap-3">
                            <div class="w-10 h-10 rounded-full bg-blue-100 text-blue-600 flex items-center justify-center">
                                <svg xmlns="http://www.w3.org/2000/svg"
                                     class="w-6 h-6"
                                     fill="none"
                                     viewBox="0 0 24 24"
                                     stroke="currentColor"
                                     stroke-width="2">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M3 7h18M3 12h18m-9 5h9" />
                                </svg>
                            </div>
                            <div>
                                <div class="text-gray-500 text-sm">Total Orders</div>
                                <div class="text-xl font-semibold" id="current-month-summary-total-orders">-</div>
                            </div>
                        </div>
                        <!-- Delivered -->
                        <div class="flex items-center gap-3">
                            <div class="w-10 h-10 rounded-full bg-green-100 text-green-600 flex items-center justify-center">
                                <svg xmlns="http://www.w3.org/2000/svg"
                                     class="w-6 h-6"
                                     fill="none"
                                     viewBox="0 0 24 24"
                                     stroke="currentColor"
                                     stroke-width="2">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                                </svg>
                            </div>
                            <div>
                                <div class="text-gray-500 text-sm">Delivered</div>
                                <div class="text-xl font-semibold">
                                    <span id="current-month-summary-delivered">-</span>
                                    <span class="text-sm text-green-500" id="current-month-delivered-percent"></span>
                                </div>
                            </div>
                        </div>
                        <!-- RTO -->
                        <div class="flex items-center gap-3">
                            <div class="w-10 h-10 rounded-full bg-red-100 text-red-600 flex items-center justify-center">
                                <svg xmlns="http://www.w3.org/2000/svg"
                                     class="w-6 h-6"
                                     fill="none"
                                     viewBox="0 0 24 24"
                                     stroke="currentColor"
                                     stroke-width="2">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                                </svg>
                            </div>
                            <div>
                                <div class="text-gray-500 text-sm">RTO</div>
                                <div class="text-xl font-semibold">
                                    <span id="current-month-summary-rto">-</span>
                                    <span class="text-sm text-red-500" id="current-month-rto-percent"></span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <!-- Sales By Category -->
            <div class="panel h-full">
                <div class="flex items-center mb-5">
                    <h5 class="font-semibold text-lg dark:text-white-light">Sales By Courier</h5>
                </div>
                <div class="overflow-hidden">
                    <div id="category-chart"
                         class="bg-white dark:bg-black rounded-lg min-h-[353px]"></div>
                </div>
            </div>
            <!-- zone wise load -->
            <div class="panel h-full">
                <div class="flex items-center mb-5">
                    <h5 class="font-semibold text-lg dark:text-white-light">Zone Wise Load</h5>
                </div>
                <div class="overflow-hidden">
                    <div id="zone-wise-load-chart"
                         class="bg-white dark:bg-black rounded-lg min-h-[353px]"></div>
                </div>
            </div>
            
            <!-- Coming Soon: State Wise Load Info -->
            <div class="panel overflow-hidden p-5 relative">
                <div class="flex items-center justify-between mb-6">
                    <div class="text-lg font-bold">State Wise Load</div>
                </div>
                <!-- Disabled content -->
                <div class="w-full h-[400px] rounded-sm bg-gray-100 dark:bg-gray-800 opacity-30"></div>

                <!-- Big Coming Soon Overlay -->
                <div class="absolute inset-0 flex flex-col items-center justify-center text-center">
                    <div class="text-4xl md:text-5xl font-extrabold tracking-wide text-gray-700 dark:text-gray-200">
                        🚀 COMING SOON
                    </div>
                    <div class="mt-3 text-lg md:text-xl text-gray-500 dark:text-gray-400">
                        State-wise insights are on the way
                    </div>
                </div>
            </div>


            <!-- Courier wise load -->
            <section class="p-4 bg-white dark:bg-gray-900 rounded-2xl shadow-md transition-colors duration-300">
                <h2 class="text-lg font-semibold text-gray-800 dark:text-gray-100 mb-3">Courier Wise Status</h2>
                <div class="w-full">
                    <table class="w-full text-sm border border-gray-200 dark:border-gray-700 rounded-lg">
                        <thead class="bg-gray-100 dark:bg-gray-800">
                            <tr class="text-gray-700 dark:text-gray-200">
                                <th class="px-2 py-2 border-b border-gray-200 dark:border-gray-700 text-left">Courier</th>
                                <th class="px-2 py-2 border-b border-gray-200 dark:border-gray-700 text-center">Total</th>
                                <th class="px-2 py-2 border-b border-gray-200 dark:border-gray-700 text-center">Unshipped</th>
                                <th class="px-2 py-2 border-b border-gray-200 dark:border-gray-700 text-center">Pending</th>
                                <th class="px-2 py-2 border-b border-gray-200 dark:border-gray-700 text-center">Transit</th>
                                <th class="px-2 py-2 border-b border-gray-200 dark:border-gray-700 text-center">Delivered (%)</th>
                                <th class="px-2 py-2 border-b border-gray-200 dark:border-gray-700 text-center">RTO</th>
                            </tr>
                        </thead>
                        <tbody id="courier-wise-status-body"
                               class="text-gray-800 dark:text-gray-100">
                            <!-- Data will be populated by JavaScript -->
                            <tr>
                                <td colspan="7" class="px-2 py-4 text-center text-gray-500">Loading data...</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </section>
            <!-- Date wise summary -->
            <section class="p-4 bg-white dark:bg-gray-900 rounded-2xl shadow-md transition-colors duration-300">
                <h2 class="text-lg font-semibold text-gray-800 dark:text-gray-100 mb-3">Date Wise Summary</h2>
                <div class="w-full">
                    <table class="w-full text-sm border border-gray-200 dark:border-gray-700 rounded-lg">
                        <thead class="bg-gray-100 dark:bg-gray-800">
                            <tr class="text-gray-700 dark:text-gray-200">
                                <th class="px-2 py-2 border-b border-gray-200 dark:border-gray-700 text-left">Date</th>
                                <th class="px-2 py-2 border-b border-gray-200 dark:border-gray-700 text-center">No. of Packets</th>
                                <th class="px-2 py-2 border-b border-gray-200 dark:border-gray-700 text-center">Pickup Pending</th>
                                <th class="px-2 py-2 border-b border-gray-200 dark:border-gray-700 text-center">In Transit</th>
                                <th class="px-2 py-2 border-b border-gray-200 dark:border-gray-700 text-center">Delivered</th>
                                <th class="px-2 py-2 border-b border-gray-200 dark:border-gray-700 text-center">RTO</th>
                            </tr>
                        </thead>
                        <tbody id="date-wise-summary-body" class="text-gray-800 dark:text-gray-100">
                            <!-- Data will be populated by JavaScript -->
                            <tr>
                                <td colspan="6" class="px-2 py-4 text-center text-gray-500">Loading data...</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </section>
        </div>
    </div>
{% endblock body %}
{% block js %}
    <script>
        // Global chart variables
        let stateWiseLoadChart = null;
        let stateWiseLoadChartPrev = null;
        let categoryChart = null;
        let zoneWiseLoadChart = null;

        // Function to fetch data from API
        async function fetchAnalyticsData() {
            try {
                const response = await fetch('?getData=true');
                const result = await response.json();
                if (result.status === 'success') {
                    return result.data;
                } else {
                    throw new Error('Failed to fetch data');
                }
            } catch (error) {
                console.error('Error fetching analytics data:', error);
                return null;
            }
        }

        // Function to update statistics cards
        function updateStatisticsCards(data) {
            const stats = data.statistics;
            document.getElementById('total-orders').textContent = stats.total_orders.value;
            document.getElementById('total-orders-last-month').textContent = stats.total_orders.last_month;
            document.getElementById('in-transit').textContent = stats.in_transit.value;
            document.getElementById('in-transit-last-month').textContent = stats.in_transit.last_month;
            document.getElementById('delivered').textContent = stats.delivered.value;
            document.getElementById('delivered-last-month').textContent = stats.delivered.last_month;
            document.getElementById('rto').textContent = stats.rto.value;
            document.getElementById('rto-last-month').textContent = stats.rto.last_month;
        }

        // Function to update current month data
        function updateCurrentMonthData(data) {
            const currentMonth = data.current_month_data;
            document.getElementById('current-month-total-orders').textContent = currentMonth.total_orders;
            document.getElementById('current-month-pickup-pending').textContent = currentMonth.pickup_pending;
            document.getElementById('current-month-in-transit').textContent = currentMonth.in_transit;
            document.getElementById('current-month-ofd').textContent = currentMonth.ofd;
            document.getElementById('current-month-delivered').textContent = currentMonth.delivered;
            document.getElementById('current-month-rto').textContent = currentMonth.rto;
            document.getElementById('current-month-summary-total-orders').textContent = currentMonth.total_orders;
            document.getElementById('current-month-summary-delivered').textContent = currentMonth.delivered;
            document.getElementById('current-month-summary-rto').textContent = currentMonth.rto;
            const deliveredPercent = ((currentMonth.delivered / currentMonth.total_orders) * 100).toFixed(1);
            const rtoPercent = ((currentMonth.rto / currentMonth.total_orders) * 100).toFixed(1);
            document.getElementById('current-month-delivered-percent').textContent = `(${deliveredPercent}%)`;
            document.getElementById('current-month-rto-percent').textContent = `(${rtoPercent}%)`;
        }

        // Function to update last month data
        function updateLastMonthData(data) {
            const lastMonth = data.last_month_data;
            document.getElementById('last-month-total-orders').textContent = lastMonth.total_orders;
            document.getElementById('last-month-delivered').textContent = lastMonth.delivered;
            document.getElementById('last-month-rto').textContent = lastMonth.rto;
            const deliveredPercent = ((lastMonth.delivered / lastMonth.total_orders) * 100).toFixed(1);
            const rtoPercent = ((lastMonth.rto / lastMonth.total_orders) * 100).toFixed(1);
            document.getElementById('last-month-delivered-percent').textContent = `(${deliveredPercent}%)`;
            document.getElementById('last-month-rto-percent').textContent = `(${rtoPercent}%)`;
        }

        // Function to update Sales By Category Chart
        function updateSalesByCategoryChart(data) {
            const categoryData = data.sales_by_category;
            if (categoryChart) {
                categoryChart.destroy();
            }
            categoryChart = new ApexCharts(document.getElementById("category-chart"), {
                series: categoryData.series,
                labels: categoryData.labels,
                chart: {
                    type: 'donut',
                    height: 460,
                    fontFamily: 'Nunito, sans-serif'
                },
                dataLabels: {
                    enabled: false
                },
                stroke: {
                    show: true,
                    width: 25,
                    colors: ['#fff']
                },
                colors: ['#5c1ac3', '#e2a03f', '#e7515a'],
                legend: {
                    position: 'bottom',
                    horizontalAlign: 'center'
                },
                plotOptions: {
                    pie: {
                        donut: {
                            size: '65%',
                            background: 'transparent',
                            labels: {
                                show: true,
                                name: {
                                    show: true,
                                    fontSize: '29px',
                                    offsetY: -10
                                },
                                value: {
                                    show: true,
                                    fontSize: '26px',
                                    offsetY: 16,
                                    formatter: (val) => val
                                },
                                total: {
                                    show: true,
                                    label: 'Total',
                                    fontSize: '22px',
                                    formatter: () => categoryData.total
                                }
                            }
                        }
                    }
                }
            });
            categoryChart.render();
        }
        // Function to update zone wise load Chart
        function updateZoneWiseLoadChart(data) {
            const Data = data.zone_wise_load;
            if (zoneWiseLoadChart) {
                zoneWiseLoadChart.destroy();
            }
            zoneWiseLoadChart = new ApexCharts(document.getElementById("zone-wise-load-chart"), {
                series: Data.series,
                labels: Data.labels,
                chart: {
                    type: 'donut',
                    height: 460,
                    fontFamily: 'Nunito, sans-serif'
                },
                dataLabels: {
                    enabled: false
                },
                stroke: {
                    show: true,
                    width: 25,
                    colors: ['#fff']
                },
                colors: ['#5c1ac3', '#e2a03f', '#e7515a'],
                legend: {
                    position: 'bottom',
                    horizontalAlign: 'center'
                },
                plotOptions: {
                    pie: {
                        donut: {
                            size: '65%',
                            background: 'transparent',
                            labels: {
                                show: true,
                                name: {
                                    show: true,
                                    fontSize: '29px',
                                    offsetY: -10
                                },
                                value: {
                                    show: true,
                                    fontSize: '26px',
                                    offsetY: 16,
                                    formatter: (val) => val
                                },
                                total: {
                                    show: true,
                                    label: 'Total',
                                    fontSize: '22px',
                                    formatter: () => Data.total
                                }
                            }
                        }
                    }
                }
            });
            zoneWiseLoadChart.render();
        }

        // Function to update state wise load chart
        function updateStateWiseLoadChart(data) {
            const stateData = data.state_wise_load.current;
            const states = Object.keys(stateData).map(key => ({
                name: key.replace(/_/g, ' ').replace(/\b\w/g, l => l.toUpperCase()),
                count: stateData[key]
            }));
            states.sort((a, b) => b.count - a.count);
            const options = {
                chart: {
                    type: 'bar',
                    height: 430,
                    toolbar: {
                        show: false
                    },
                },
                plotOptions: {
                    bar: {
                        horizontal: true,
                        borderRadius: 4,
                        distributed: false,
                        barHeight: '55%',
                        dataLabels: {
                            position: 'right'
                        },
                    },
                },
                dataLabels: {
                    enabled: false
                },
                tooltip: {
                    theme: document.documentElement.classList.contains('dark') ? 'dark' : 'light',
                    y: {
                        formatter: val => `${val} packets`
                    }
                },
                series: [{
                    name: "Load",
                    data: states.map(s => s.count)
                }],
                xaxis: {
                    categories: states.map(s => s.name),
                    axisBorder: {
                        show: false
                    },
                    axisTicks: {
                        show: false
                    },
                    labels: {
                        style: {
                            colors: document.documentElement.classList.contains('dark') ? '#cbd5e1' : '#475569',
                            fontSize: '13px',
                        },
                    },
                },
                yaxis: {
                    labels: {
                        offsetX: 1,
                        style: {
                            colors: document.documentElement.classList.contains('dark') ? '#cbd5e1' : '#475569',
                            fontSize: '13px',
                        },
                    },
                },
                grid: {
                    show: false
                },
                legend: {
                    show: false
                },
                colors: ['#3B82F6'],
            };
            if (stateWiseLoadChart) {
                stateWiseLoadChart.destroy();
            }
            // stateWiseLoadChart = new ApexCharts(document.querySelector("#state-wise-load"), options);
            // stateWiseLoadChart.render();
        }
        // Function to update state wise load prev month chart
        function updateStateWiseLoadPrevMonthChart(data) {
            const stateData = data.state_wise_load.prev;
            const states = Object.keys(stateData).map(key => ({
                name: key.replace(/_/g, ' ').replace(/\b\w/g, l => l.toUpperCase()),
                count: stateData[key]
            }));
            states.sort((a, b) => b.count - a.count);
            const options = {
                chart: {
                    type: 'bar',
                    height: 430,
                    toolbar: {
                        show: false
                    },
                },
                plotOptions: {
                    bar: {
                        horizontal: true,
                        borderRadius: 4,
                        distributed: false,
                        barHeight: '55%',
                        dataLabels: {
                            position: 'right'
                        },
                    },
                },
                dataLabels: {
                    enabled: false
                },
                tooltip: {
                    theme: document.documentElement.classList.contains('dark') ? 'dark' : 'light',
                    y: {
                        formatter: val => `${val} packets`
                    }
                },
                series: [{
                    name: "Load",
                    data: states.map(s => s.count)
                }],
                xaxis: {
                    categories: states.map(s => s.name),
                    axisBorder: {
                        show: false
                    },
                    axisTicks: {
                        show: false
                    },
                    labels: {
                        style: {
                            colors: document.documentElement.classList.contains('dark') ? '#cbd5e1' : '#475569',
                            fontSize: '13px',
                        },
                    },
                },
                yaxis: {
                    labels: {
                        offsetX: 1,
                        style: {
                            colors: document.documentElement.classList.contains('dark') ? '#cbd5e1' : '#475569',
                            fontSize: '13px',
                        },
                    },
                },
                grid: {
                    show: false
                },
                legend: {
                    show: false
                },
                colors: ['#3B82F6'],
            };
            if (stateWiseLoadChartPrev) {
                stateWiseLoadChartPrev.destroy();
            }
            // stateWiseLoadChartPrev = new ApexCharts(document.querySelector("#state-wise-load-prev"), options);
            // stateWiseLoadChartPrev.render();
        }

        // Function to update courier wise status table
        function updateCourierWiseStatus(data) {
            const courierData = data.courier_wise_status;
            const tbody = document.getElementById('courier-wise-status-body');
            tbody.innerHTML = '';
            Object.entries(courierData).forEach(([courier, stats]) => {
                const row = document.createElement('tr');
                row.className = 'hover:bg-gray-50 dark:hover:bg-gray-800 transition';
                row.innerHTML = `
                    <td class="px-2 py-2 font-medium">${courier.charAt(0).toUpperCase() + courier.slice(1)}</td>
                    <td class="px-2 py-2 text-center">${stats.total}</td>
                    <td class="px-2 py-2 text-center">${stats.unshipped}</td>
                    <td class="px-2 py-2 text-center">${stats.pending}</td>
                    <td class="px-2 py-2 text-center">${stats.in_transit}</td>
                    <td class="px-2 py-2 text-center text-green-600 dark:text-green-400 font-semibold">${stats.delivered}</td>
                    <td class="px-2 py-2 text-center text-red-600 dark:text-red-400 font-semibold">${stats.rto}</td>
                `;
                tbody.appendChild(row);
            });
        }

        // Function to update date wise summary table
        function updateDateWiseSummary(data) {
            const dateData = data.date_wise_summary;
            const tbody = document.getElementById('date-wise-summary-body');
            tbody.innerHTML = '';
            Object.entries(dateData).forEach(([dateKey, stats]) => {
                const row = document.createElement('tr');
                row.className = 'hover:bg-gray-50 dark:hover:bg-gray-800 transition';
                const formattedDate = dateKey.replace(/_/g, ' ')
                    .split(' ')
                    .map(word => word.charAt(0).toUpperCase() + word.slice(1))
                    .join(' ');
                const deliveredPercent = ((stats.delivered / stats.no_of_packets) * 100).toFixed(1);
                row.innerHTML = `
                    <td class="px-2 py-2 font-medium">${formattedDate}</td>
                    <td class="px-2 py-2 text-center">${stats.no_of_packets}</td>
                    <td class="px-2 py-2 text-center">${stats.pickup_pending}</td>
                    <td class="px-2 py-2 text-center">${stats.in_transit}</td>
                    <td class="px-2 py-2 text-center text-green-600 dark:text-green-400 font-semibold">
                        ${stats.delivered} (${deliveredPercent}%)
                    </td>
                    <td class="px-2 py-2 text-center text-red-600 dark:text-red-400 font-semibold">${stats.rto}</td>
                `;
                tbody.appendChild(row);
            });
        }

        // Main function to load all data
        async function loadAnalyticsData() {
            const loadingIndicator = document.getElementById('loading-indicator');
            try {
                loadingIndicator.style.display = 'flex';
                const data = await fetchAnalyticsData();
                if (data) {
                    updateStatisticsCards(data);
                    updateCurrentMonthData(data);
                    updateLastMonthData(data);
                    updateSalesByCategoryChart(data);
                    updateZoneWiseLoadChart(data);
                    updateStateWiseLoadChart(data);
                    updateStateWiseLoadPrevMonthChart(data);
                    updateCourierWiseStatus(data);
                    updateDateWiseSummary(data);
                } else {
                    throw new Error('No data received');
                }
            } catch (error) {
                console.error('Error loading analytics data:', error);
                alert('Failed to load analytics data. Please try again.');
            } finally {
                loadingIndicator.style.display = 'none';
            }
        }

        // Initialize when DOM is loaded
        document.addEventListener('DOMContentLoaded', function() {
            loadAnalyticsData();
        });

        // Handle theme changes for the chart
        const observer = new MutationObserver(() => {
            const theme = document.documentElement.classList.contains('dark') ? 'dark' : 'light';
            if (stateWiseLoadChart) {
                stateWiseLoadChart.updateOptions({
                    tooltip: { theme },
                    xaxis: {
                        labels: {
                            style: {
                                colors: theme === 'dark' ? '#cbd5e1' : '#475569'
                            }
                        }
                    },
                    yaxis: {
                        labels: {
                            style: {
                                colors: theme === 'dark' ? '#cbd5e1' : '#475569'
                            }
                        }
                    }
                });
            }
            if (stateWiseLoadChartPrev) {
                stateWiseLoadChartPrev.updateOptions({
                    tooltip: { theme },
                    xaxis: {
                        labels: {
                            style: {
                                colors: theme === 'dark' ? '#cbd5e1' : '#475569'
                            }
                        }
                    },
                    yaxis: {
                        labels: {
                            style: {
                                colors: theme === 'dark' ? '#cbd5e1' : '#475569'
                            }
                        }
                    }
                });
            }
            if (categoryChart) {
                categoryChart.updateOptions({
                    tooltip: { theme },
                    legend: {
                        labels: {
                            colors: theme === 'dark' ? '#cbd5e1' : '#475569'
                        }
                    }
                });
            }
            if (zoneWiseLoadChart) {
                zoneWiseLoadChart.updateOptions({
                    tooltip: { theme },
                    legend: {
                        labels: {
                            colors: theme === 'dark' ? '#cbd5e1' : '#475569'
                        }
                    }
                });
            }
        });
        observer.observe(document.documentElement, {
            attributes: true,
            attributeFilter: ['class']
        });
    </script>
{% endblock js %}
