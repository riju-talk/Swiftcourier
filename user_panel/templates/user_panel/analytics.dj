{% extends "components/layouts/layout.dj" %}
{% load static %}
{% block title %}
    Analytics
{% endblock title %}
{% block css %}
    {% comment %} apexcharts is bundled locally; the Tailwind Play CDN + its broken
    inline config used to load here and clobber the compiled stylesheet - removed. {% endcomment %}
    <script src="{% static 'assets/js/apexcharts.js' %}"></script>
    <style>
        [x-cloak] { display: none !important; }
        .analytics-panel { padding: 1.25rem; }
        .badge { display: inline-flex; align-items: center; justify-content: center; padding: 0.125rem 0.625rem; font-size: 0.75rem; font-weight: 500; border-radius: 9999px; }
    </style>
{% endblock css %}
{% load static %}
{% block body %}
    <div class="p-6">
        <div class="mb-6">
            <h1 class="text-[22px] font-bold leading-tight tracking-tight text-neutral-900 dark:text-white">Analytics</h1>
            <p class="mt-0.5 text-[13px] text-neutral-500 dark:text-neutral-400">Shipment performance for this month against last.</p>
        </div>
        <!-- Loading Indicator: unobtrusive corner chip, never blocks the page -->
        <div id="loading-indicator"
             class="fixed bottom-6 right-6 z-50 flex items-center gap-3 rounded-xl border border-neutral-200/80 bg-white px-4 py-3 shadow-lg dark:border-white/10 dark:bg-neutral-900">
            <div class="h-4 w-4 animate-spin rounded-full border-2 border-neutral-200 border-t-red-600"></div>
            <span class="text-sm font-medium text-neutral-600 dark:text-neutral-300">Loading analytics…</span>
        </div>
        <!-- headline: this month vs last -->
        <div class="mb-6 grid grid-cols-2 gap-3 sm:gap-4 lg:grid-cols-4">
            <div class="rounded-xl border border-neutral-200/80 bg-white p-4 dark:border-white/10 dark:bg-neutral-950 sm:p-5">
                <p class="text-[11px] font-semibold uppercase tracking-[0.09em] text-neutral-400">Total Orders</p>
                <p class="mt-2 text-[26px] font-bold leading-none tabular-nums tracking-tight text-neutral-900 dark:text-white" id="total-orders">-</p>
                <p class="mt-2 text-[11px] text-neutral-400">Last month: <span id="total-orders-last-month">-</span></p>
            </div>
            <div class="rounded-xl border border-neutral-200/80 bg-white p-4 dark:border-white/10 dark:bg-neutral-950 sm:p-5">
                <p class="text-[11px] font-semibold uppercase tracking-[0.09em] text-neutral-400">In Transit</p>
                <p class="mt-2 text-[26px] font-bold leading-none tabular-nums tracking-tight text-neutral-900 dark:text-white" id="in-transit">-</p>
                <p class="mt-2 text-[11px] text-neutral-400">Last month: <span id="in-transit-last-month">-</span></p>
            </div>
            <div class="rounded-xl border border-neutral-200/80 bg-white p-4 dark:border-white/10 dark:bg-neutral-950 sm:p-5">
                <p class="text-[11px] font-semibold uppercase tracking-[0.09em] text-neutral-400">Delivered</p>
                <p class="mt-2 text-[26px] font-bold leading-none tabular-nums tracking-tight text-emerald-600 dark:text-emerald-400" id="delivered">-</p>
                <p class="mt-2 text-[11px] text-neutral-400">Last month: <span id="delivered-last-month">-</span></p>
            </div>
            <div class="rounded-xl border border-neutral-200/80 bg-white p-4 dark:border-white/10 dark:bg-neutral-950 sm:p-5">
                <p class="text-[11px] font-semibold uppercase tracking-[0.09em] text-neutral-400">RTO</p>
                <p class="mt-2 text-[26px] font-bold leading-none tabular-nums tracking-tight text-red-600 dark:text-red-400" id="rto">-</p>
                <p class="mt-2 text-[11px] text-neutral-400">Last month: <span id="rto-last-month">-</span></p>
            </div>
        </div>

        <!-- current month status split -->
        <div class="mb-6 overflow-hidden rounded-xl border border-neutral-200/80 bg-white dark:border-white/10 dark:bg-neutral-950">
            <div class="border-b border-neutral-200/80 px-5 py-4 dark:border-white/10">
                <h2 class="text-sm font-bold text-neutral-900 dark:text-white">Current Month</h2>
            </div>
            <div class="grid grid-cols-2 gap-px bg-neutral-200/70 dark:bg-white/10 sm:grid-cols-3 lg:grid-cols-6">
                <div class="bg-white px-5 py-4 text-center dark:bg-neutral-950">
                    <p class="text-[11px] font-semibold uppercase tracking-wider text-neutral-400">Total Orders</p>
                    <p class="mt-1.5 text-xl font-bold tabular-nums text-neutral-900 dark:text-white" id="current-month-total-orders">-</p>
                </div>
                <div class="bg-white px-5 py-4 text-center dark:bg-neutral-950">
                    <p class="text-[11px] font-semibold uppercase tracking-wider text-neutral-400">Pickup Pending</p>
                    <p class="mt-1.5 text-xl font-bold tabular-nums text-neutral-900 dark:text-white" id="current-month-pickup-pending">-</p>
                </div>
                <div class="bg-white px-5 py-4 text-center dark:bg-neutral-950">
                    <p class="text-[11px] font-semibold uppercase tracking-wider text-neutral-400">In Transit</p>
                    <p class="mt-1.5 text-xl font-bold tabular-nums text-neutral-900 dark:text-white" id="current-month-in-transit">-</p>
                </div>
                <div class="bg-white px-5 py-4 text-center dark:bg-neutral-950">
                    <p class="text-[11px] font-semibold uppercase tracking-wider text-neutral-400">Out For Delivery</p>
                    <p class="mt-1.5 text-xl font-bold tabular-nums text-neutral-900 dark:text-white" id="current-month-ofd">-</p>
                </div>
                <div class="bg-white px-5 py-4 text-center dark:bg-neutral-950">
                    <p class="text-[11px] font-semibold uppercase tracking-wider text-neutral-400">Delivered</p>
                    <p class="mt-1.5 text-xl font-bold tabular-nums text-emerald-600 dark:text-emerald-400" id="current-month-delivered">-</p>
                </div>
                <div class="bg-white px-5 py-4 text-center dark:bg-neutral-950">
                    <p class="text-[11px] font-semibold uppercase tracking-wider text-neutral-400">RTO</p>
                    <p class="mt-1.5 text-xl font-bold tabular-nums text-red-600 dark:text-red-400" id="current-month-rto">-</p>
                </div>
            </div>
        </div>
        <div class="grid grid-cols-1 xl:grid-cols-2 gap-6">
            <div class="grid gap-6 xl:grid-flow-row">
                <!-- last month stats -->
                <div class="panel overflow-hidden p-5">
                    <!-- Title -->
                    <div class="flex items-center justify-between mb-6">
                        <div class="text-lg font-bold">Last Month</div>
                    </div>
                    <!-- Stats -->
                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
                        <!-- Total Orders -->
                        <div class="flex items-center gap-3">
                            <div class="w-10 h-10 rounded-full bg-red-100 text-red-600 flex items-center justify-center">
                                <svg xmlns="http://www.w3.org/2000/svg"
                                     class="w-6 h-6"
                                     fill="none"
                                     viewBox="0 0 24 24"
                                     stroke="currentColor"
                                     stroke-width="2">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M3 7h18M3 12h18m-9 5h9" />
                                </svg>
                            </div>
                            <div>
                                <div class="text-neutral-500 text-sm">Total Orders</div>
                                <div class="text-xl font-semibold" id="last-month-total-orders">-</div>
                            </div>
                        </div>
                        <!-- Delivered -->
                        <div class="flex items-center gap-3">
                            <div class="w-10 h-10 rounded-full bg-green-100 text-green-600 flex items-center justify-center">
                                <svg xmlns="http://www.w3.org/2000/svg"
                                     class="w-6 h-6"
                                     fill="none"
                                     viewBox="0 0 24 24"
                                     stroke="currentColor"
                                     stroke-width="2">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                                </svg>
                            </div>
                            <div>
                                <div class="text-neutral-500 text-sm">Delivered</div>
                                <div class="text-xl font-semibold">
                                    <span id="last-month-delivered">-</span>
                                    <span class="text-sm text-green-500" id="last-month-delivered-percent"></span>
                                </div>
                            </div>
                        </div>
                        <!-- RTO -->
                        <div class="flex items-center gap-3">
                            <div class="w-10 h-10 rounded-full bg-red-100 text-red-600 flex items-center justify-center">
                                <svg xmlns="http://www.w3.org/2000/svg"
                                     class="w-6 h-6"
                                     fill="none"
                                     viewBox="0 0 24 24"
                                     stroke="currentColor"
                                     stroke-width="2">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                                </svg>
                            </div>
                            <div>
                                <div class="text-neutral-500 text-sm">RTO</div>
                                <div class="text-xl font-semibold">
                                    <span id="last-month-rto">-</span>
                                    <span class="text-sm text-red-500" id="last-month-rto-percent"></span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <!-- current month stats -->
                <div class="panel overflow-hidden p-5">
                    <!-- Title -->
                    <div class="flex items-center justify-between mb-6">
                        <div class="text-lg font-bold">Current Month</div>
                    </div>
                    <!-- Stats -->
                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
                        <!-- Total Orders -->
                        <div class="flex items-center gap-3">
                            <div class="w-10 h-10 rounded-full bg-red-100 text-red-600 flex items-center justify-center">
                                <svg xmlns="http://www.w3.org/2000/svg"
                                     class="w-6 h-6"
                                     fill="none"
                                     viewBox="0 0 24 24"
                                     stroke="currentColor"
                                     stroke-width="2">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M3 7h18M3 12h18m-9 5h9" />
                                </svg>
                            </div>
                            <div>
                                <div class="text-neutral-500 text-sm">Total Orders</div>
                                <div class="text-xl font-semibold" id="current-month-summary-total-orders">-</div>
                            </div>
                        </div>
                        <!-- Delivered -->
                        <div class="flex items-center gap-3">
                            <div class="w-10 h-10 rounded-full bg-green-100 text-green-600 flex items-center justify-center">
                                <svg xmlns="http://www.w3.org/2000/svg"
                                     class="w-6 h-6"
                                     fill="none"
                                     viewBox="0 0 24 24"
                                     stroke="currentColor"
                                     stroke-width="2">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                                </svg>
                            </div>
                            <div>
                                <div class="text-neutral-500 text-sm">Delivered</div>
                                <div class="text-xl font-semibold">
                                    <span id="current-month-summary-delivered">-</span>
                                    <span class="text-sm text-green-500" id="current-month-delivered-percent"></span>
                                </div>
                            </div>
                        </div>
                        <!-- RTO -->
                        <div class="flex items-center gap-3">
                            <div class="w-10 h-10 rounded-full bg-red-100 text-red-600 flex items-center justify-center">
                                <svg xmlns="http://www.w3.org/2000/svg"
                                     class="w-6 h-6"
                                     fill="none"
                                     viewBox="0 0 24 24"
                                     stroke="currentColor"
                                     stroke-width="2">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                                </svg>
                            </div>
                            <div>
                                <div class="text-neutral-500 text-sm">RTO</div>
                                <div class="text-xl font-semibold">
                                    <span id="current-month-summary-rto">-</span>
                                    <span class="text-sm text-red-500" id="current-month-rto-percent"></span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <!-- Sales By Category -->
            <div class="panel h-full">
                <div class="flex items-center mb-5">
                    <h5 class="text-[22px] font-bold tracking-tight text-neutral-900 dark:text-white">Sales By Courier</h5>
                </div>
                <div class="overflow-hidden">
                    <div id="category-chart"
                         class="rounded-lg min-h-[300px]"></div>
                </div>
            </div>
            <!-- zone wise load -->
            <div class="panel h-full">
                <div class="flex items-center mb-5">
                    <h5 class="text-[22px] font-bold tracking-tight text-neutral-900 dark:text-white">Zone Wise Load</h5>
                </div>
                <div class="overflow-hidden">
                    <div id="zone-wise-load-chart"
                         class="rounded-lg min-h-[300px]"></div>
                </div>
            </div>
            
            <!-- Coming Soon: State Wise Load Info -->
            <div class="panel overflow-hidden p-5 relative">
                <div class="flex items-center justify-between mb-6">
                    <div class="text-lg font-bold">State Wise Load</div>
                </div>
                <!-- Disabled content -->
                <div class="w-full h-[400px] rounded-sm bg-neutral-100 dark:bg-neutral-900 opacity-30"></div>

                <!-- Big Coming Soon Overlay -->
                <div class="absolute inset-0 flex flex-col items-center justify-center text-center">
                    <div class="text-4xl md:text-5xl font-extrabold tracking-wide text-black dark:text-white">
                        🚀 COMING SOON
                    </div>
                    <div class="mt-3 text-lg md:text-xl text-neutral-500 dark:text-neutral-400">
                        State-wise insights are on the way
                    </div>
                </div>
            </div>


            <!-- Courier wise load -->
            <section class="p-4 bg-white dark:bg-neutral-900 rounded-2xl shadow-md transition-colors duration-300">
                <h2 class="text-lg font-semibold text-black dark:text-white mb-3">Courier Wise Status</h2>
                <div class="w-full">
                    <table class="w-full text-sm border border-white dark:border-white/10 rounded-lg">
                        <thead class="bg-neutral-100 dark:bg-neutral-900">
                            <tr class="text-black dark:text-white">
                                <th class="px-2 py-2 border-b border-white dark:border-white/10 text-left">Courier</th>
                                <th class="px-2 py-2 border-b border-white dark:border-white/10 text-center">Total</th>
                                <th class="px-2 py-2 border-b border-white dark:border-white/10 text-center">Unshipped</th>
                                <th class="px-2 py-2 border-b border-white dark:border-white/10 text-center">Pending</th>
                                <th class="px-2 py-2 border-b border-white dark:border-white/10 text-center">Transit</th>
                                <th class="px-2 py-2 border-b border-white dark:border-white/10 text-center">Delivered (%)</th>
                                <th class="px-2 py-2 border-b border-white dark:border-white/10 text-center">RTO</th>
                            </tr>
                        </thead>
                        <tbody id="courier-wise-status-body"
                               class="text-black dark:text-white">
                            <!-- Data will be populated by JavaScript -->
                            <tr>
                                <td colspan="7" class="px-2 py-4 text-center text-neutral-500">Loading data...</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </section>
            <!-- Date wise summary -->
            <section class="p-4 bg-white dark:bg-neutral-900 rounded-2xl shadow-md transition-colors duration-300">
                <h2 class="text-lg font-semibold text-black dark:text-white mb-3">Date Wise Summary</h2>
                <div class="w-full">
                    <table class="w-full text-sm border border-white dark:border-white/10 rounded-lg">
                        <thead class="bg-neutral-100 dark:bg-neutral-900">
                            <tr class="text-black dark:text-white">
                                <th class="px-2 py-2 border-b border-white dark:border-white/10 text-left">Date</th>
                                <th class="px-2 py-2 border-b border-white dark:border-white/10 text-center">No. of Packets</th>
                                <th class="px-2 py-2 border-b border-white dark:border-white/10 text-center">Pickup Pending</th>
                                <th class="px-2 py-2 border-b border-white dark:border-white/10 text-center">In Transit</th>
                                <th class="px-2 py-2 border-b border-white dark:border-white/10 text-center">Delivered</th>
                                <th class="px-2 py-2 border-b border-white dark:border-white/10 text-center">RTO</th>
                            </tr>
                        </thead>
                        <tbody id="date-wise-summary-body" class="text-black dark:text-white">
                            <!-- Data will be populated by JavaScript -->
                            <tr>
                                <td colspan="6" class="px-2 py-4 text-center text-neutral-500">Loading data...</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </section>
        </div>
    </div>
{% endblock body %}
{% block js %}
    <script>
        // Global chart variables
        let stateWiseLoadChart = null;
        let stateWiseLoadChartPrev = null;
        let categoryChart = null;
        let zoneWiseLoadChart = null;

        // Function to fetch data from API
        async function fetchAnalyticsData() {
            try {
                const response = await fetch('?getData=true');
                const result = await response.json();
                if (result.status === 'success') {
                    return result.data;
                } else {
                    throw new Error('Failed to fetch data');
                }
            } catch (error) {
                console.error('Error fetching analytics data:', error);
                return null;
            }
        }

        // Function to update statistics cards
        function updateStatisticsCards(data) {
            const stats = data.statistics;
            document.getElementById('total-orders').textContent = stats.total_orders.value;
            document.getElementById('total-orders-last-month').textContent = stats.total_orders.last_month;
            document.getElementById('in-transit').textContent = stats.in_transit.value;
            document.getElementById('in-transit-last-month').textContent = stats.in_transit.last_month;
            document.getElementById('delivered').textContent = stats.delivered.value;
            document.getElementById('delivered-last-month').textContent = stats.delivered.last_month;
            document.getElementById('rto').textContent = stats.rto.value;
            document.getElementById('rto-last-month').textContent = stats.rto.last_month;
        }

        // Function to update current month data
        function updateCurrentMonthData(data) {
            const currentMonth = data.current_month_data;
            document.getElementById('current-month-total-orders').textContent = currentMonth.total_orders;
            document.getElementById('current-month-pickup-pending').textContent = currentMonth.pickup_pending;
            document.getElementById('current-month-in-transit').textContent = currentMonth.in_transit;
            document.getElementById('current-month-ofd').textContent = currentMonth.ofd;
            document.getElementById('current-month-delivered').textContent = currentMonth.delivered;
            document.getElementById('current-month-rto').textContent = currentMonth.rto;
            document.getElementById('current-month-summary-total-orders').textContent = currentMonth.total_orders;
            document.getElementById('current-month-summary-delivered').textContent = currentMonth.delivered;
            document.getElementById('current-month-summary-rto').textContent = currentMonth.rto;
            const deliveredPercent = ((currentMonth.delivered / currentMonth.total_orders) * 100).toFixed(1);
            const rtoPercent = ((currentMonth.rto / currentMonth.total_orders) * 100).toFixed(1);
            document.getElementById('current-month-delivered-percent').textContent = `(${deliveredPercent}%)`;
            document.getElementById('current-month-rto-percent').textContent = `(${rtoPercent}%)`;
        }

        // Function to update last month data
        function updateLastMonthData(data) {
            const lastMonth = data.last_month_data;
            document.getElementById('last-month-total-orders').textContent = lastMonth.total_orders;
            document.getElementById('last-month-delivered').textContent = lastMonth.delivered;
            document.getElementById('last-month-rto').textContent = lastMonth.rto;
            const deliveredPercent = ((lastMonth.delivered / lastMonth.total_orders) * 100).toFixed(1);
            const rtoPercent = ((lastMonth.rto / lastMonth.total_orders) * 100).toFixed(1);
            document.getElementById('last-month-delivered-percent').textContent = `(${deliveredPercent}%)`;
            document.getElementById('last-month-rto-percent').textContent = `(${rtoPercent}%)`;
        }

        // Function to update Sales By Category Chart
        function updateSalesByCategoryChart(data) {
            const categoryData = data.sales_by_category;
            if (categoryChart) {
                categoryChart.destroy();
            }
            categoryChart = new ApexCharts(document.getElementById("category-chart"), {
                series: categoryData.series,
                labels: categoryData.labels,
                chart: {
                    type: 'donut',
                    height: 460,
                    fontFamily: 'Nunito, sans-serif'
                },
                dataLabels: {
                    enabled: false
                },
                stroke: {
                    show: true,
                    width: 25,
                    colors: ['#fff']
                },
                colors: ['#5c1ac3', '#e2a03f', '#e7515a'],
                legend: {
                    position: 'bottom',
                    horizontalAlign: 'center'
                },
                plotOptions: {
                    pie: {
                        donut: {
                            size: '65%',
                            background: 'transparent',
                            labels: {
                                show: true,
                                name: {
                                    show: true,
                                    fontSize: '29px',
                                    offsetY: -10
                                },
                                value: {
                                    show: true,
                                    fontSize: '26px',
                                    offsetY: 16,
                                    formatter: (val) => val
                                },
                                total: {
                                    show: true,
                                    label: 'Total',
                                    fontSize: '22px',
                                    formatter: () => categoryData.total
                                }
                            }
                        }
                    }
                }
            });
            categoryChart.render();
        }
        // Function to update zone wise load Chart
        function updateZoneWiseLoadChart(data) {
            const Data = data.zone_wise_load;
            if (zoneWiseLoadChart) {
                zoneWiseLoadChart.destroy();
            }
            zoneWiseLoadChart = new ApexCharts(document.getElementById("zone-wise-load-chart"), {
                series: Data.series,
                labels: Data.labels,
                chart: {
                    type: 'donut',
                    height: 460,
                    fontFamily: 'Nunito, sans-serif'
                },
                dataLabels: {
                    enabled: false
                },
                stroke: {
                    show: true,
                    width: 25,
                    colors: ['#fff']
                },
                colors: ['#5c1ac3', '#e2a03f', '#e7515a'],
                legend: {
                    position: 'bottom',
                    horizontalAlign: 'center'
                },
                plotOptions: {
                    pie: {
                        donut: {
                            size: '65%',
                            background: 'transparent',
                            labels: {
                                show: true,
                                name: {
                                    show: true,
                                    fontSize: '29px',
                                    offsetY: -10
                                },
                                value: {
                                    show: true,
                                    fontSize: '26px',
                                    offsetY: 16,
                                    formatter: (val) => val
                                },
                                total: {
                                    show: true,
                                    label: 'Total',
                                    fontSize: '22px',
                                    formatter: () => Data.total
                                }
                            }
                        }
                    }
                }
            });
            zoneWiseLoadChart.render();
        }

        // Function to update state wise load chart
        function updateStateWiseLoadChart(data) {
            const stateData = data.state_wise_load.current;
            const states = Object.keys(stateData).map(key => ({
                name: key.replace(/_/g, ' ').replace(/\b\w/g, l => l.toUpperCase()),
                count: stateData[key]
            }));
            states.sort((a, b) => b.count - a.count);
            const options = {
                chart: {
                    type: 'bar',
                    height: 430,
                    toolbar: {
                        show: false
                    },
                },
                plotOptions: {
                    bar: {
                        horizontal: true,
                        borderRadius: 4,
                        distributed: false,
                        barHeight: '55%',
                        dataLabels: {
                            position: 'right'
                        },
                    },
                },
                dataLabels: {
                    enabled: false
                },
                tooltip: {
                    theme: document.documentElement.classList.contains('dark') ? 'dark' : 'light',
                    y: {
                        formatter: val => `${val} packets`
                    }
                },
                series: [{
                    name: "Load",
                    data: states.map(s => s.count)
                }],
                xaxis: {
                    categories: states.map(s => s.name),
                    axisBorder: {
                        show: false
                    },
                    axisTicks: {
                        show: false
                    },
                    labels: {
                        style: {
                            colors: document.documentElement.classList.contains('dark') ? '#cbd5e1' : '#475569',
                            fontSize: '13px',
                        },
                    },
                },
                yaxis: {
                    labels: {
                        offsetX: 1,
                        style: {
                            colors: document.documentElement.classList.contains('dark') ? '#cbd5e1' : '#475569',
                            fontSize: '13px',
                        },
                    },
                },
                grid: {
                    show: false
                },
                legend: {
                    show: false
                },
                colors: ['#ef4444'],
            };
            if (stateWiseLoadChart) {
                stateWiseLoadChart.destroy();
            }
            // stateWiseLoadChart = new ApexCharts(document.querySelector("#state-wise-load"), options);
            // stateWiseLoadChart.render();
        }
        // Function to update state wise load prev month chart
        function updateStateWiseLoadPrevMonthChart(data) {
            const stateData = data.state_wise_load.prev;
            const states = Object.keys(stateData).map(key => ({
                name: key.replace(/_/g, ' ').replace(/\b\w/g, l => l.toUpperCase()),
                count: stateData[key]
            }));
            states.sort((a, b) => b.count - a.count);
            const options = {
                chart: {
                    type: 'bar',
                    height: 430,
                    toolbar: {
                        show: false
                    },
                },
                plotOptions: {
                    bar: {
                        horizontal: true,
                        borderRadius: 4,
                        distributed: false,
                        barHeight: '55%',
                        dataLabels: {
                            position: 'right'
                        },
                    },
                },
                dataLabels: {
                    enabled: false
                },
                tooltip: {
                    theme: document.documentElement.classList.contains('dark') ? 'dark' : 'light',
                    y: {
                        formatter: val => `${val} packets`
                    }
                },
                series: [{
                    name: "Load",
                    data: states.map(s => s.count)
                }],
                xaxis: {
                    categories: states.map(s => s.name),
                    axisBorder: {
                        show: false
                    },
                    axisTicks: {
                        show: false
                    },
                    labels: {
                        style: {
                            colors: document.documentElement.classList.contains('dark') ? '#cbd5e1' : '#475569',
                            fontSize: '13px',
                        },
                    },
                },
                yaxis: {
                    labels: {
                        offsetX: 1,
                        style: {
                            colors: document.documentElement.classList.contains('dark') ? '#cbd5e1' : '#475569',
                            fontSize: '13px',
                        },
                    },
                },
                grid: {
                    show: false
                },
                legend: {
                    show: false
                },
                colors: ['#ef4444'],
            };
            if (stateWiseLoadChartPrev) {
                stateWiseLoadChartPrev.destroy();
            }
            // stateWiseLoadChartPrev = new ApexCharts(document.querySelector("#state-wise-load-prev"), options);
            // stateWiseLoadChartPrev.render();
        }

        // Function to update courier wise status table
        function updateCourierWiseStatus(data) {
            const courierData = data.courier_wise_status;
            const tbody = document.getElementById('courier-wise-status-body');
            tbody.innerHTML = '';
            Object.entries(courierData).forEach(([courier, stats]) => {
                const row = document.createElement('tr');
                row.className = 'hover:bg-gray-50 dark:hover:bg-gray-800 transition';
                row.innerHTML = `
                    <td class="px-2 py-2 font-medium">${courier.charAt(0).toUpperCase() + courier.slice(1)}</td>
                    <td class="px-2 py-2 text-center">${stats.total}</td>
                    <td class="px-2 py-2 text-center">${stats.unshipped}</td>
                    <td class="px-2 py-2 text-center">${stats.pending}</td>
                    <td class="px-2 py-2 text-center">${stats.in_transit}</td>
                    <td class="px-2 py-2 text-center text-green-600 dark:text-green-400 font-semibold">${stats.delivered}</td>
                    <td class="px-2 py-2 text-center text-red-600 dark:text-red-400 font-semibold">${stats.rto}</td>
                `;
                tbody.appendChild(row);
            });
        }

        // Function to update date wise summary table
        function updateDateWiseSummary(data) {
            const dateData = data.date_wise_summary;
            const tbody = document.getElementById('date-wise-summary-body');
            tbody.innerHTML = '';
            Object.entries(dateData).forEach(([dateKey, stats]) => {
                const row = document.createElement('tr');
                row.className = 'hover:bg-gray-50 dark:hover:bg-gray-800 transition';
                const formattedDate = dateKey.replace(/_/g, ' ')
                    .split(' ')
                    .map(word => word.charAt(0).toUpperCase() + word.slice(1))
                    .join(' ');
                const deliveredPercent = ((stats.delivered / stats.no_of_packets) * 100).toFixed(1);
                row.innerHTML = `
                    <td class="px-2 py-2 font-medium">${formattedDate}</td>
                    <td class="px-2 py-2 text-center">${stats.no_of_packets}</td>
                    <td class="px-2 py-2 text-center">${stats.pickup_pending}</td>
                    <td class="px-2 py-2 text-center">${stats.in_transit}</td>
                    <td class="px-2 py-2 text-center text-green-600 dark:text-green-400 font-semibold">
                        ${stats.delivered} (${deliveredPercent}%)
                    </td>
                    <td class="px-2 py-2 text-center text-red-600 dark:text-red-400 font-semibold">${stats.rto}</td>
                `;
                tbody.appendChild(row);
            });
        }

        // Main function to load all data
        async function loadAnalyticsData() {
            const loadingIndicator = document.getElementById('loading-indicator');
            const hide = () => { if (loadingIndicator) loadingIndicator.style.display = 'none'; };
            // never let the overlay trap the page - drop it after 12s no matter what
            const safety = setTimeout(hide, 12000);
            try {
                const data = await fetchAnalyticsData();
                if (!data) return;
                const steps = [updateStatisticsCards, updateCurrentMonthData, updateLastMonthData,
                    updateSalesByCategoryChart, updateZoneWiseLoadChart, updateStateWiseLoadChart,
                    updateStateWiseLoadPrevMonthChart, updateCourierWiseStatus, updateDateWiseSummary];
                for (const step of steps) {
                    try { step(data); } catch (e) { console.error('analytics step failed:', step.name, e); }
                }
            } catch (error) {
                console.error('Error loading analytics data:', error);
            } finally {
                clearTimeout(safety);
                hide();
            }
        }

        // Initialize when DOM is loaded
        document.addEventListener('DOMContentLoaded', function() {
            loadAnalyticsData();
        });

        // Handle theme changes for the chart
        const observer = new MutationObserver(() => {
            const theme = document.documentElement.classList.contains('dark') ? 'dark' : 'light';
            if (stateWiseLoadChart) {
                stateWiseLoadChart.updateOptions({
                    tooltip: { theme },
                    xaxis: {
                        labels: {
                            style: {
                                colors: theme === 'dark' ? '#cbd5e1' : '#475569'
                            }
                        }
                    },
                    yaxis: {
                        labels: {
                            style: {
                                colors: theme === 'dark' ? '#cbd5e1' : '#475569'
                            }
                        }
                    }
                });
            }
            if (stateWiseLoadChartPrev) {
                stateWiseLoadChartPrev.updateOptions({
                    tooltip: { theme },
                    xaxis: {
                        labels: {
                            style: {
                                colors: theme === 'dark' ? '#cbd5e1' : '#475569'
                            }
                        }
                    },
                    yaxis: {
                        labels: {
                            style: {
                                colors: theme === 'dark' ? '#cbd5e1' : '#475569'
                            }
                        }
                    }
                });
            }
            if (categoryChart) {
                categoryChart.updateOptions({
                    tooltip: { theme },
                    legend: {
                        labels: {
                            colors: theme === 'dark' ? '#cbd5e1' : '#475569'
                        }
                    }
                });
            }
            if (zoneWiseLoadChart) {
                zoneWiseLoadChart.updateOptions({
                    tooltip: { theme },
                    legend: {
                        labels: {
                            colors: theme === 'dark' ? '#cbd5e1' : '#475569'
                        }
                    }
                });
            }
        });
        observer.observe(document.documentElement, {
            attributes: true,
            attributeFilter: ['class']
        });
    </script>
{% endblock js %}
