{% extends "components/layouts/layout.dj" %}

{% load static %}

{% load humanize %}

{% block title %}
    Shipping Charges
{% endblock title %}


{% block body %}
    <div class="space-y-6">

        <div class="flex flex-wrap items-end justify-between gap-3">
            <div>
                <h1 class="text-[22px] font-bold leading-tight tracking-tight text-neutral-900 dark:text-white">Shipping Charges</h1>
                <p class="mt-0.5 text-[13px] text-neutral-500 dark:text-neutral-400">Freight, RTO and GST billed per shipment.</p>
            </div>
            <button id="exportOrderButton" class="inline-flex h-9 items-center gap-1.5 rounded-lg border border-neutral-300 bg-white px-4 text-sm font-semibold text-neutral-700 transition-colors hover:bg-neutral-50 dark:border-white/15 dark:bg-transparent dark:text-neutral-200">Export CSV</button>
        </div>

        <div class="overflow-hidden rounded-xl border border-neutral-200/80 bg-white dark:border-white/10 dark:bg-neutral-950">
            <div class="flex flex-wrap items-center justify-between gap-3 border-b border-neutral-200/80 px-5 py-4 dark:border-white/10">
                <h2 class="text-sm font-bold text-neutral-900 dark:text-white">Charged shipments</h2>
                <input type="text" placeholder="Search order or AWB…" id="searchOrder"
                       class="h-9 w-64 rounded-lg border border-neutral-300 px-3 text-sm focus:outline-hidden focus:ring-2 focus:ring-red-500 dark:border-white/10 dark:bg-white/[0.06] dark:text-gray-100 dark:placeholder-neutral-400" />
            </div>

            <div class="overflow-x-auto">
                <table id="ordersTable" class="w-full whitespace-nowrap">
                    <thead>
                        <tr>
                            <th class="px-4 py-3 text-left text-[11px] font-semibold uppercase tracking-wider text-neutral-500">S.No</th>
                            <th class="px-4 py-3 text-left text-[11px] font-semibold uppercase tracking-wider text-neutral-500">Order ID</th>
                            <th class="px-4 py-3 text-left text-[11px] font-semibold uppercase tracking-wider text-neutral-500">SwiftCourier ID</th>
                            <th class="px-4 py-3 text-left text-[11px] font-semibold uppercase tracking-wider text-neutral-500">Date</th>
                            <th class="px-4 py-3 text-left text-[11px] font-semibold uppercase tracking-wider text-neutral-500">AWB</th>
                            <th class="px-4 py-3 text-left text-[11px] font-semibold uppercase tracking-wider text-neutral-500">Courier</th>
                            <th class="px-4 py-3 text-left text-[11px] font-semibold uppercase tracking-wider text-neutral-500">Status</th>
                            <th class="px-4 py-3 text-right text-[11px] font-semibold uppercase tracking-wider text-neutral-500">Freight</th>
                            <th class="px-4 py-3 text-right text-[11px] font-semibold uppercase tracking-wider text-neutral-500">RTO</th>
                            <th class="px-4 py-3 text-right text-[11px] font-semibold uppercase tracking-wider text-neutral-500">GST</th>
                            <th class="px-4 py-3 text-right text-[11px] font-semibold uppercase tracking-wider text-neutral-500">Total Freight</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for item in orders_with_freight %}
                            <tr class="border-t border-neutral-100 hover:bg-neutral-50 dark:border-white/5 dark:hover:bg-white/[0.03]">
                                <td class="px-4 py-3 text-[13px] text-neutral-400">{{ forloop.counter }}</td>
                                <td class="px-4 py-3 text-[13px] font-medium text-neutral-900 dark:text-white">{{ item.order.order_number }}</td>
                                <td class="px-4 py-3 font-mono text-[12px] text-neutral-500 dark:text-neutral-400">{{ item.order.get_order_id }}</td>
                                <td class="px-4 py-3 text-[13px] text-neutral-600 dark:text-neutral-300">{{ item.order.placed_at|date:"d M Y" }}</td>
                                <td class="px-4 py-3 font-mono text-[12px] text-neutral-500 dark:text-neutral-400">{{ item.order.awb_number }}</td>
                                <td class="px-4 py-3 text-[13px] text-neutral-600 dark:text-neutral-300">{{ item.order.logistic_partner.name|default:"N/A" }}</td>
                                <td class="px-4 py-3">{% include "components/ui/status_pill.dj" with status=item.order.status label=item.order.get_status_display %}</td>
                                <td class="px-4 py-3 text-right text-[13px] tabular-nums text-neutral-700 dark:text-neutral-200">₹{{ item.freight|floatformat:2 }}</td>
                                <td class="px-4 py-3 text-right text-[13px] tabular-nums text-neutral-500">{{ item.rto_charges|default:"—" }}</td>
                                <td class="px-4 py-3 text-right text-[13px] tabular-nums text-neutral-500">₹{{ item.freight_gst|floatformat:2 }}</td>
                                <td class="px-4 py-3 text-right text-[13px] font-semibold tabular-nums text-neutral-900 dark:text-white">₹{{ item.total_freight|floatformat:2 }}</td>
                            </tr>
                        {% empty %}
                            <tr><td colspan="11" class="px-4 py-12 text-center text-sm text-neutral-400">No charged shipments yet.</td></tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <script>
        // Simple search functionality
        document.getElementById('searchOrder').addEventListener('keyup', function() {
            const searchText = this.value.toLowerCase();
            const rows = document.querySelectorAll('tbody tr');
            rows.forEach(row => {
                const orderId = row.cells[1]?.textContent.toLowerCase();
                const awb = row.cells[4]?.textContent.toLowerCase();
                if (orderId?.includes(searchText) || awb?.includes(searchText)) {
                    row.style.display = '';
                } else {
                    row.style.display = 'none';
                }
            });
        });
    </script>
    <script>
        document.getElementById("exportOrderButton").addEventListener("click", function() {
            let table = document.getElementById("ordersTable");
            let rows = table.querySelectorAll("tr");
            let csv = [];

            rows.forEach(row => {
                let cols = row.querySelectorAll("th, td");
                let rowData = [];
                cols.forEach(col => {
                    // escape double quotes inside text
                    let data = col.innerText.replace(/"/g, '""');
                    rowData.push('"' + data + '"');
                });
                csv.push(rowData.join(","));
            });

            // create downloadable CSV file
            let csvContent = "data:text/csv;charset=utf-8," + csv.join("\n");
            let link = document.createElement("a");
            link.setAttribute("href", encodeURI(csvContent));
            link.setAttribute("download", "orders_export.csv");
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        });
    </script>
{% endblock body %}
