{% extends "components/layouts/layout.dj" %}

{% load static %}

{% block title %}
    COD Remittance
{% endblock title %}


{% block css %}
    <style>
        [x-cloak] {
            display: none !important;
        }

        .date-transition {
            transition: all 0.2s ease-in-out;
        }

        /* Scrollbar Styling */
        ::-webkit-scrollbar {
            width: 8px;
            height: 8px;
        }

        ::-webkit-scrollbar-track {
            @apply bg-gray-100 dark:bg-gray-700;
        }

        ::-webkit-scrollbar-thumb {
            @apply bg-gray-300 dark:bg-gray-600 rounded-full;
        }

        ::-webkit-scrollbar-thumb:hover {
            @apply bg-gray-400 dark:bg-gray-500;
        }

        /* Optimized tooltip styling */
        .tooltip {
            min-width: 120px;
            pointer-events: none;
            transform-origin: top center;
            will-change: transform, opacity;
        }

        /* Dark mode compatibility */
        .dark .tooltip {
            background-color: #374151;
            color: #f9fafb;
        }
    </style>
{% endblock css %}


{% block body %}
    <div class="w-full bg-white dark:bg-gray-800 rounded-lg shadow-sm">
        <!-- Summary Section -->
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-6 gap-4 mb-8">
            <div class="bg-gradient-to-br from-indigo-300/20 to-indigo-500/20 dark:from-indigo-300/20 dark:to-indigo-500/20 backdrop-blur-sm rounded-lg p-4 shadow-lg text-center text-gray-800 dark:text-white hover:scale-105 hover:shadow-xl transition-all duration-300 cursor-pointer">
                <svg class="w-8 h-8 mx-auto mb-2 text-indigo-600" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M3 4a1 1 0 011-1h12a1 1 0 011 1v2a1 1 0 01-1 1H4a1 1 0 01-1-1V4zM3 10a1 1 0 011-1h6a1 1 0 011 1v6a1 1 0 01-1 1H4a1 1 0 01-1-1v-6zM14 9a1 1 0 00-1 1v6a1 1 0 001 1h2a1 1 0 001-1v-6a1 1 0 00-1-1h-2z" clip-rule="evenodd"/>
                </svg>
                <p class="text-xs text-indigo-600 font-bold mt-1">Total COD Collected</p>
                <p class="text-lg text-gray-500 dark:text-gray-300 mt-1 font-semibold">₹{{ total_cod_collected|default:"0" }}</p>
            </div>
            <div class="bg-gradient-to-br from-teal-300/20 to-teal-500/20 dark:from-teal-300/20 dark:to-teal-500/20 backdrop-blur-sm rounded-lg p-4 shadow-lg text-center text-gray-800 dark:text-white hover:scale-105 hover:shadow-xl transition-all duration-300 cursor-pointer">
                <svg class="w-8 h-8 mx-auto mb-2 text-teal-600" fill="currentColor" viewBox="0 0 20 20">
                    <path d="M4 4a2 2 0 00-2 2v4a2 2 0 002 2V6h10a2 2 0 00-2-2H4zm2 6a2 2 0 012-2h8a2 2 0 012 2v4a2 2 0 01-2 2H8a2 2 0 01-2-2v-4zm6 4a2 2 0 100-4 2 2 0 000 4z"/>
                </svg>
                <p class="text-xs text-teal-600 font-bold mt-1">Remitted Till Date</p>
                <p class="text-lg text-gray-500 dark:text-gray-300 mt-1 font-semibold">₹{{ remitted_till_date|default:"0" }}</p>
            </div>
            <div class="bg-gradient-to-br from-emerald-300/20 to-emerald-500/20 dark:from-emerald-300/20 dark:to-emerald-500/20 backdrop-blur-sm rounded-lg p-4 shadow-lg text-center text-gray-800 dark:text-white hover:scale-105 hover:shadow-xl transition-all duration-300 cursor-pointer">
                <svg class="w-8 h-8 mx-auto mb-2 text-emerald-600" fill="currentColor" viewBox="0 0 20 20">
                    <path d="M8 16.5a1.5 1.5 0 11-3 0 1.5 1.5 0 013 0zM15 16.5a1.5 1.5 0 11-3 0 1.5 1.5 0 013 0z"/>
                    <path d="M3 4a1 1 0 00-1 1v10a1 1 0 001 1h1.05a2.5 2.5 0 014.9 0H10a1 1 0 001-1V5a1 1 0 00-1-1H3zM14 7a1 1 0 00-1 1v6.05A2.5 2.5 0 0115.95 16H17a1 1 0 001-1V8a1 1 0 00-1-1h-3z"/>
                </svg>
                <p class="text-xs text-emerald-600 font-bold mt-1">Total Freight Adjusted</p>
                <p class="text-lg text-gray-500 dark:text-gray-300 mt-1 font-semibold">₹{{ total_freight_adjusted|default:"0" }}</p>
            </div>
            <div class="bg-gradient-to-br from-amber-300/20 to-amber-500/20 dark:from-amber-300/20 dark:to-amber-500/20 backdrop-blur-sm rounded-lg p-4 shadow-lg text-center text-gray-800 dark:text-white hover:scale-105 hover:shadow-xl transition-all duration-300 cursor-pointer">
                <svg class="w-8 h-8 mx-auto mb-2 text-amber-600" fill="currentColor" viewBox="0 0 20 20">
                    <path d="M10 12a2 2 0 100-4 2 2 0 000 4z"/>
                    <path fill-rule="evenodd" d="M.458 10C1.732 5.943 5.522 3 10 3s8.268 2.943 9.542 7c-1.274 4.057-5.064 7-9.542 7S1.732 14.057.458 10zM14 10a4 4 0 11-8 0 4 4 0 018 0z" clip-rule="evenodd"/>
                </svg>
                <p class="text-xs text-amber-600 font-bold mt-1">Last Remittance</p>
                <p class="text-lg text-gray-500 dark:text-gray-300 mt-1 font-semibold">₹{{ last_remittance|default:"0" }}</p>
            </div>
            <div class="bg-gradient-to-br from-violet-300/20 to-violet-500/20 dark:from-violet-300/20 dark:to-violet-500/20 backdrop-blur-sm rounded-lg p-4 shadow-lg text-center text-gray-800 dark:text-white hover:scale-105 hover:shadow-xl transition-all duration-300 cursor-pointer">
                <svg class="w-8 h-8 mx-auto mb-2 text-violet-600" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd"/>
                </svg>
                <p class="text-xs text-violet-600 font-bold mt-1">Next Remittance (Expected)</p>
                <p class="text-lg text-gray-500 dark:text-gray-300 mt-1 font-semibold">₹{{ next_remittance_expected|default:"0" }}</p>
            </div>
            <div class="bg-gradient-to-br from-rose-300/20 to-rose-500/20 dark:from-rose-300/20 dark:to-rose-500/20 backdrop-blur-sm rounded-lg p-4 shadow-lg text-center text-gray-800 dark:text-white hover:scale-105 hover:shadow-xl transition-all duration-300 cursor-pointer">
                <svg class="w-8 h-8 mx-auto mb-2 text-rose-600" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/>
                </svg>
                <p class="text-xs text-rose-600 font-bold mt-1">Total Remittance Due</p>
                <p class="text-lg text-gray-500 dark:text-gray-300 mt-1 font-semibold">₹{{ total_remittance_due|default:"0" }}</p>
            </div>
        </div>
       


        <!-- Table Section -->
        <div class="overflow-x-auto">
        <div class="flex flex-col sm:flex-row items-center justify-between p-4 sm:p-6 border-b dark:border-gray-700 gap-4 flex-nowrap">
            <!-- Left: Title + Search -->

            <div class="flex items-center w-full sm:w-auto flex-shrink-0">
                <h2 class="text-xl font-semibold text-gray-800 dark:text-gray-100 whitespace-nowrap mr-4 flex-shrink-0">COD Remittance</h2>
                <input type="text"
                       id="searchInput"
                       name="q"
                       placeholder="Search..."
                       value="{{ request.GET.q }}"
                       onenter="handleSearch(this.value)"
                       class="w-48 px-3 py-1.5 border rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-700 dark:border-gray-600 dark:text-gray-100 dark:placeholder-gray-400 flex-shrink-0">
            </div>

        </div>
            <table class="w-full bg-white border border-gray-300">
                <thead class="bg-gray-100">
                    <tr>
                        <th class="px-4 py-2 text-center text-xs font-semibold text-black border-b border-gray-300">ID</th>
                        <th class="px-4 py-2 text-center text-xs font-semibold text-black border-b border-gray-300">Payout Date</th>
                        <th class="px-4 py-2 text-center text-xs font-semibold text-black border-b border-gray-300">Payout amount</th>
                        <th class="px-4 py-2 text-center text-xs font-semibold text-black border-b border-gray-300">Order Count</th>
                        <th class="px-4 py-2 text-center text-xs font-semibold text-black border-b border-gray-300">Freight Deduction</th>
                        <th class="px-4 py-2 text-center text-xs font-semibold text-black border-b border-gray-300">Early COD Charges %</th>
                        <th class="px-4 py-2 text-center text-xs font-semibold text-black border-b border-gray-300">Early COD Charges </th>
                        <th class="px-4 py-2 text-center text-xs font-semibold text-black border-b border-gray-300">Remittance Amount</th>
                        <th class="px-4 py-2 text-center text-xs font-semibold text-black border-b border-gray-300">Amount Paid</th>
                        <th class="px-4 py-2 text-center text-xs font-semibold text-black border-b border-gray-300">UTR</th>
                        <th class="px-4 py-2 text-center text-xs font-semibold text-black border-b border-gray-300">Remarks</th>
                        <th class="px-4 py-2 text-center text-xs font-semibold text-black border-b border-gray-300">Status</th>
                        <th class="px-4 py-2 text-center text-xs font-semibold text-black border-b border-gray-300">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for remittance in cod_remittances %}
                        <tr class="hover:bg-gray-50 border-b border-gray-200" data-row-id="{{ remittance.id }}">
                            <td class="px-6 py-2 text-xs text-center text-black">{{ remittance.id }}</td>
                            <td class="px-6 py-2 text-xs text-center text-black whitespace-nowrap">{{ remittance.payout_date }}</td>
                            <td class="px-6 py-2 text-xs text-center text-black">₹{{ remittance.payout_amount|default:"0" }}</td>
                            <td class="px-6 py-2 text-xs text-center text-black">{{ remittance.order_count|default:"0" }}</td>
                            <td class="px-6 py-2 text-xs text-center text-black">₹{{ remittance.frieght_deduction|default:"0" }}</td>
                            <td class="px-6 py-2 text-xs text-center text-black">{{ remittance.early_cod_charges_percentage|default:"0" }}</td>
                            <td class="px-6 py-2 text-xs text-center text-black">₹{{ remittance.early_cod_charges|default:"0" }}</td>
                            <td class="px-6 py-2 text-xs text-center text-black">₹{{ remittance.remittance_amount|default:"0" }}</td>
                            <td class="px-6 py-2 text-xs text-center text-black">₹{{ remittance.amount_paid|default:"0" }}</td>
                            <td class="px-6 py-2 text-xs text-center text-black">{{ remittance.utr|default:"-" }}</td>
                            <td class="px-6 py-2 text-xs text-center text-black">{{ remittance.remarks|default:"-" }}</td>
                            <td class="px-6 py-2 text-xs text-center text-black">{{ remittance.status }}</td>
                            <td class="px-6 py-2 text-xs text-center text-black">
                                <a class="px-2 py-1 bg-blue-500 hover:bg-blue-600 text-white text-xs rounded" href="{% url 'user_panel:download-cod-remittance-file' remittance.id %}" target="_blank">Export</a>
                                {% comment %} <a class="px-2 py-1 bg-blue-500 hover:bg-blue-600 text-white text-xs rounded" href="{% if remittance._file %}{{ remittance._file.url }}{% endif %}" target="_blank">Export</a> {% endcomment %}
                            </td>
                        </tr>
                    {% empty %}
                    <tr>
                        <td colspan="15" class="px-6 py-4 text-center text-gray-500">No remittances found.</td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>


        <!-- Pagination -->
        <div class="p-4 border-t dark:border-gray-700">
            <div class="flex flex-col sm:flex-row justify-between items-center gap-4">
                <div class="flex items-center gap-4">
                    <span class="text-sm text-gray-700 dark:text-gray-300">Show:</span>
                    <select id="pageSize"
                            onchange="updatePageSize(this.value)"
                            class="px-2 py-1 border rounded text-sm dark:bg-gray-700 dark:border-gray-600 dark:text-gray-100">
                        <option value="10" {% if page_size == 10 %}selected{% endif %}>10</option>
                        <option value="50" {% if page_size == 50 %}selected{% endif %}>50</option>
                        <option value="100" {% if page_size == 100 %}selected{% endif %}>100</option>
                        <option value="200" {% if page_size == 200 %}selected{% endif %}>200</option>
                        <option value="500" {% if page_size == 500 %}selected{% endif %}>500</option>
                    </select>
                </div>

                <div class="flex gap-1 flex-wrap">
                    <button onclick="navigatePage('prev')"
                            class="px-3 py-1 bg-gray-100 hover:bg-gray-200 dark:bg-gray-700 dark:hover:bg-gray-600 rounded text-sm dark:text-gray-100"
                            {% if not page_obj.has_previous %}disabled{% endif %}>Previous</button>

                    {% if page_obj.number > 3 %}
                        <button onclick="navigatePage(1)"
                                class="px-3 py-1 bg-gray-100 hover:bg-gray-200 dark:bg-gray-700 dark:hover:bg-gray-600 rounded text-sm dark:text-gray-100">
                            1
                        </button>
                        <span class="px-2 text-gray-500 dark:text-gray-300">...</span>
                    {% endif %}

                    {% for num in page_obj.paginator.page_range %}
                        {% if num >= page_obj.number|add:'-2' and num <= page_obj.number|add:'2' %}
                            <button onclick="navigatePage({{ num }})"
                                    class="px-3 py-1
                                           {% if num == page_obj.number %}
                                               bg-blue-100 text-blue-600
                                           {% else %}
                                               bg-gray-100 hover:bg-gray-200 dark:bg-gray-700 dark:hover:bg-gray-600
                                           {% endif %}
                                           rounded text-sm dark:text-gray-100">{{ num }}</button>
                        {% endif %}
                    {% endfor %}

                    {% if page_obj.number < page_obj.paginator.num_pages|add:'-2' %}
                        <span class="px-2 text-gray-500 dark:text-gray-300">...</span>
                        <button onclick="navigatePage({{ page_obj.paginator.num_pages }})"
                                class="px-3 py-1 bg-gray-100 hover:bg-gray-200 dark:bg-gray-700 dark:hover:bg-gray-600 rounded text-sm dark:text-gray-100">
                            {{ page_obj.paginator.num_pages }}
                        </button>
                    {% endif %}

                    <button onclick="navigatePage('next')"
                            class="px-3 py-1 bg-gray-100 hover:bg-gray-200 dark:bg-gray-700 dark:hover:bg-gray-600 rounded text-sm dark:text-gray-100"
                            {% if not page_obj.has_next %}disabled{% endif %}>Next</button>
                </div>

            </div>
        </div>
    </div>
{% endblock body %}



{% block js %}
    <script defer src="{% static 'assets/js/apexcharts.js' %}"></script>
    <script src="{% static 'assets/js/simple-datatables.js' %}"></script>



    <script>
        // Action Menu Handling
        document.querySelectorAll('.action-btn').forEach(button => {
            button.addEventListener('click', (e) => {
                e.stopPropagation();
                const menu = button.nextElementSibling;
                const isOpen = !menu.classList.contains('hidden');

                // Close all other menus
                document.querySelectorAll('.action-menu').forEach(m => m.classList.add('hidden'));

                // Toggle current menu
                menu.classList.toggle('hidden', isOpen);
            });
        });

        // Close menus when clicking outside
        document.addEventListener('click', (e) => {
            if (!e.target.closest('.action-btn')) {
                document.querySelectorAll('.action-menu').forEach(menu => {
                    menu.classList.add('hidden');
                });
            }
        });

        

        // Pagination Handling
        function getCurrentParams() {
            const params = new URLSearchParams(window.location.search);
            return {
                page: parseInt(params.get('page')) || 1,
                size: parseInt(params.get('page_size')) || 10
            };
        }

        // Initialize page size from URL
        window.addEventListener('load', () => {
            const params = getCurrentParams();
            document.getElementById('pageSize').value = params.size;
        });

        function navigatePage(action) {
            const urlParams = new URLSearchParams(window.location.search);
            const currentSearch = document.getElementById('searchInput').value;
            let page = parseInt(urlParams.get('page') || 1);

            if (action === 'prev') {
                page = Math.max(1, page - 1);
            } else if (action === 'next') {
                page = page + 1;
            } else {
                page = parseInt(action);
            }

            if (currentSearch) {
                urlParams.set('q', currentSearch);
            }

            urlParams.set('page', page);
            window.location.search = urlParams.toString();
        }

        function updatePageSize(size) {
            const urlParams = new URLSearchParams(window.location.search);
            const currentSearch = document.getElementById('searchInput').value;

            urlParams.set('page_size', size);
            urlParams.set('page', 1); // Reset to first page

            if (currentSearch) {
                urlParams.set('q', currentSearch);
            }
            window.location.search = urlParams.toString();
        }

        // Add debounce to prevent too many requests
        function handleSearch(value) {
            updateSearchParams(value);
        }

        function updateSearchParams(searchTerm) {
            const urlParams = new URLSearchParams(window.location.search);

            if (searchTerm.trim()) {
                urlParams.set('q', searchTerm);
            } else {
                urlParams.delete('q');
            }

            // Reset to first page when searching
            urlParams.set('page', 1);
            window.location.search = urlParams.toString();
        }

        document.getElementById('searchInput').addEventListener('keydown', (e) => {
            if (e.key === 'Enter') {
                updateSearchParams(e.target.value);
            }
        });

        const shipSelectedOrders = () => {
            // Get all checked checkboxes with class 'ship-order-ids'
            const selectedCheckboxes = document.querySelectorAll('.ship-order-ids:checked');

            // Extract values (order IDs) from the checked checkboxes
            const orderIds = Array.from(selectedCheckboxes).map(checkbox => checkbox.value);

            // Find the hidden input inside the form
            const hiddenInput = document.querySelector('#shipForm input[name="order_ids"]');

            // Set the value of the hidden input to comma-separated order IDs
            hiddenInput.value = orderIds.join(',');

            // Submit the form programmatically
            document.getElementById('shipForm').submit();
        };

        const exportRowCSV = (rowId) => {
            // Find the row by data-row-id attribute
            const row = document.querySelector(`tr[data-row-id="${rowId}"]`);

            if (!row) {
                alert('Row not found');
                return;
            }

            // Extract data from the row cells (excluding the Actions column)
            const cells = row.querySelectorAll('td');
            const rowData = [];

            // Skip the last cell (Actions column)
            for (let i = 0; i < cells.length - 1; i++) {
                const cell = cells[i];
                // Get text content and clean it up
                let text = cell.textContent.trim();
                // Remove currency symbols and format numbers
                text = text.replace(/₹/g, '').replace(/,/g, '');
                rowData.push(text);
            }

            // Create CSV content with headers
            const headers = ['ID', 'Payout Date', 'Payout Amount', 'Order Count', 'Freight Deduction', 'Early COD Charges %', 'Early COD Charges', 'Remittance Amount', 'Amount Paid', 'UTR', 'Remarks', 'Status'];
            const csvContent = [headers.join(','), rowData.join(',')].join('\n');

            // Create and download the CSV file
            const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
            const link = document.createElement('a');

            if (link.download !== undefined) {
                const url = URL.createObjectURL(blob);
                link.setAttribute('href', url);
                link.setAttribute('download', `${rowId}_remittance.csv`);
                link.style.visibility = 'hidden';
                document.body.appendChild(link);
                link.click();
                document.body.removeChild(link);
            }
        };

        // Checkbox Handling
        function updateActionButtons() {
            const checkedCount = document.querySelectorAll('.row-checkbox:checked').length;
            document.getElementById('actionButtons').classList.toggle('hidden', checkedCount === 0);
            document.getElementById('cancelActionButtons').classList.toggle('hidden', checkedCount === 0);
        }

        document.getElementById('selectAll').addEventListener('change', (e) => {
            document.querySelectorAll('.row-checkbox').forEach(checkbox => {
                checkbox.checked = e.target.checked;
            });
            updateActionButtons();
        });

        document.querySelectorAll('.row-checkbox').forEach(checkbox => {
            checkbox.addEventListener('change', updateActionButtons);
        });

        // Modal Handling
        function openModal() {
            document.getElementById('shipModal').classList.remove('hidden');
        }

        function closeModal() {
            document.getElementById('shipModal').classList.add('hidden');
        }
    </script>

{% endblock js %}
