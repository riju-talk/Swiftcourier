{% extends "components/layouts/layout.dj" %}

{% load static %}

{% block title %}
    COD Remittance
{% endblock title %}


{% block css %}
    <style>
        [x-cloak] {
            display: none !important;
        }

        .date-transition {
            transition: all 0.2s ease-in-out;
        }

        /* Scrollbar Styling */
        ::-webkit-scrollbar {
            width: 8px;
            height: 8px;
        }

        ::-webkit-scrollbar-track {
            @apply bg-neutral-100 dark:bg-white/[0.06];
        }

        ::-webkit-scrollbar-thumb {
            @apply bg-neutral-300 dark:bg-neutral-600 rounded-full;
        }

        ::-webkit-scrollbar-thumb:hover {
            @apply bg-neutral-400 dark:bg-gray-500;
        }

        /* Optimized tooltip styling */
        .tooltip {
            min-width: 120px;
            pointer-events: none;
            transform-origin: top center;
            will-change: transform, opacity;
        }

        /* Dark mode compatibility */
        .dark .tooltip {
            background-color: #374151;
            color: #f9fafb;
        }
    </style>
{% endblock css %}


{% block body %}
    <div class="space-y-6">

        <div>
            <h1 class="text-[22px] font-bold leading-tight tracking-tight text-neutral-900 dark:text-white">COD Remittance</h1>
            <p class="mt-0.5 text-[13px] text-neutral-500 dark:text-neutral-400">COD you collected, what has been paid out, and what is due.</p>
        </div>

        <!-- summary -->
        <div class="grid grid-cols-2 gap-3 sm:gap-4 lg:grid-cols-3 xl:grid-cols-6">
            {% include "components/ui/stat_tile.dj" with label="COD Collected" value=total_cod_collected|default:"0" prefix="₹" %}
            {% include "components/ui/stat_tile.dj" with label="Remitted To Date" value=remitted_till_date|default:"0" prefix="₹" tone="good" %}
            {% include "components/ui/stat_tile.dj" with label="Freight Adjusted" value=total_freight_adjusted|default:"0" prefix="₹" %}
            {% include "components/ui/stat_tile.dj" with label="Last Remittance" value=last_remittance|default:"0" prefix="₹" %}
            {% include "components/ui/stat_tile.dj" with label="Next (Expected)" value=next_remittance_expected|default:"0" prefix="₹" %}
            {% include "components/ui/stat_tile.dj" with label="Remittance Due" value=total_remittance_due|default:"0" prefix="₹" tone="bad" %}
        </div>

        <!-- table panel -->
        <div class="overflow-hidden rounded-xl border border-neutral-200/80 bg-white dark:border-white/10 dark:bg-neutral-950">
            <div class="flex flex-wrap items-center justify-between gap-3 border-b border-neutral-200/80 px-5 py-4 dark:border-white/10">
                <h2 class="text-sm font-bold text-neutral-900 dark:text-white">Payouts</h2>
                <input type="text" id="searchInput" name="q" placeholder="Search UTR, remarks…" value="{{ request.GET.q }}" onenter="handleSearch(this.value)"
                       class="h-9 w-64 rounded-lg border border-neutral-300 px-3 text-sm focus:outline-hidden focus:ring-2 focus:ring-red-500 dark:border-white/10 dark:bg-white/[0.06] dark:text-gray-100 dark:placeholder-neutral-400">
            </div>

            <div class="overflow-x-auto">
            <table class="w-full whitespace-nowrap">
                <thead>
                    <tr>
                        <th class="px-4 py-3 text-left text-[11px] font-semibold uppercase tracking-wider text-neutral-500">ID</th>
                        <th class="px-4 py-3 text-left text-[11px] font-semibold uppercase tracking-wider text-neutral-500">Payout Date</th>
                        <th class="px-4 py-3 text-right text-[11px] font-semibold uppercase tracking-wider text-neutral-500">Payout</th>
                        <th class="px-4 py-3 text-right text-[11px] font-semibold uppercase tracking-wider text-neutral-500">Orders</th>
                        <th class="px-4 py-3 text-right text-[11px] font-semibold uppercase tracking-wider text-neutral-500">Freight Ded.</th>
                        <th class="px-4 py-3 text-right text-[11px] font-semibold uppercase tracking-wider text-neutral-500">Early COD %</th>
                        <th class="px-4 py-3 text-right text-[11px] font-semibold uppercase tracking-wider text-neutral-500">Early COD</th>
                        <th class="px-4 py-3 text-right text-[11px] font-semibold uppercase tracking-wider text-neutral-500">Remittance</th>
                        <th class="px-4 py-3 text-right text-[11px] font-semibold uppercase tracking-wider text-neutral-500">Paid</th>
                        <th class="px-4 py-3 text-left text-[11px] font-semibold uppercase tracking-wider text-neutral-500">UTR</th>
                        <th class="px-4 py-3 text-left text-[11px] font-semibold uppercase tracking-wider text-neutral-500">Remarks</th>
                        <th class="px-4 py-3 text-left text-[11px] font-semibold uppercase tracking-wider text-neutral-500">Status</th>
                        <th class="px-4 py-3 text-right text-[11px] font-semibold uppercase tracking-wider text-neutral-500">Action</th>
                    </tr>
                </thead>
                <tbody>
                    {% for remittance in cod_remittances %}
                        <tr class="border-t border-neutral-100 hover:bg-neutral-50 dark:border-white/5 dark:hover:bg-white/[0.03]" data-row-id="{{ remittance.id }}">
                            <td class="px-4 py-3 text-[13px] text-neutral-400">{{ remittance.id }}</td>
                            <td class="px-4 py-3 text-[13px] text-neutral-600 dark:text-neutral-300">{{ remittance.payout_date }}</td>
                            <td class="px-4 py-3 text-right text-[13px] tabular-nums text-neutral-700 dark:text-neutral-200">₹{{ remittance.payout_amount|default:"0" }}</td>
                            <td class="px-4 py-3 text-right text-[13px] tabular-nums text-neutral-500">{{ remittance.order_count|default:"0" }}</td>
                            <td class="px-4 py-3 text-right text-[13px] tabular-nums text-neutral-500">₹{{ remittance.frieght_deduction|default:"0" }}</td>
                            <td class="px-4 py-3 text-right text-[13px] tabular-nums text-neutral-500">{{ remittance.early_cod_charges_percentage|default:"0" }}</td>
                            <td class="px-4 py-3 text-right text-[13px] tabular-nums text-neutral-500">₹{{ remittance.early_cod_charges|default:"0" }}</td>
                            <td class="px-4 py-3 text-right text-[13px] tabular-nums text-neutral-700 dark:text-neutral-200">₹{{ remittance.remittance_amount|default:"0" }}</td>
                            <td class="px-4 py-3 text-right text-[13px] font-semibold tabular-nums text-neutral-900 dark:text-white">₹{{ remittance.amount_paid|default:"0" }}</td>
                            <td class="px-4 py-3 font-mono text-[12px] text-neutral-500 dark:text-neutral-400">{{ remittance.utr|default:"—" }}</td>
                            <td class="px-4 py-3 text-[13px] text-neutral-500">{{ remittance.remarks|default:"—" }}</td>
                            <td class="px-4 py-3">{% include "components/ui/status_pill.dj" with status=remittance.status %}</td>
                            <td class="px-4 py-3 text-right">
                                <a class="inline-flex items-center rounded-lg border border-neutral-300 bg-white px-2.5 py-1 text-xs font-semibold text-neutral-700 transition-colors hover:bg-neutral-50 dark:border-white/15 dark:bg-transparent dark:text-neutral-200" href="{% url 'user_panel:download-cod-remittance-file' remittance.id %}" target="_blank">Export</a>
                            </td>
                        </tr>
                    {% empty %}
                    <tr>
                        <td colspan="13" class="px-4 py-12 text-center text-sm text-neutral-400">No remittances yet.</td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
            </div>
        </div>


        <!-- Pagination -->
        <div class="rounded-xl border border-neutral-200/80 bg-white p-4 dark:border-white/10 dark:bg-neutral-950">
            <div class="flex flex-col sm:flex-row justify-between items-center gap-4">
                <div class="flex items-center gap-4">
                    <span class="text-sm text-black dark:text-neutral-300">Show:</span>
                    <select id="pageSize"
                            onchange="updatePageSize(this.value)"
                            class="px-2 py-1 border rounded-sm text-sm dark:bg-white/[0.06] dark:border-white/10 dark:text-gray-100">
                        <option value="10" {% if page_size == 10 %}selected{% endif %}>10</option>
                        <option value="50" {% if page_size == 50 %}selected{% endif %}>50</option>
                        <option value="100" {% if page_size == 100 %}selected{% endif %}>100</option>
                        <option value="200" {% if page_size == 200 %}selected{% endif %}>200</option>
                        <option value="500" {% if page_size == 500 %}selected{% endif %}>500</option>
                    </select>
                </div>

                <div class="flex gap-1 flex-wrap">
                    <button onclick="navigatePage('prev')"
                            class="px-3 py-1 bg-neutral-100 hover:bg-white dark:bg-white/[0.06] dark:hover:bg-neutral-600 rounded-sm text-sm dark:text-gray-100"
                            {% if not page_obj.has_previous %}disabled{% endif %}>Previous</button>

                    {% if page_obj.number > 3 %}
                        <button onclick="navigatePage(1)"
                                class="px-3 py-1 bg-neutral-100 hover:bg-white dark:bg-white/[0.06] dark:hover:bg-neutral-600 rounded-sm text-sm dark:text-gray-100">
                            1
                        </button>
                        <span class="px-2 text-neutral-500 dark:text-neutral-300">...</span>
                    {% endif %}

                    {% for num in page_obj.paginator.page_range %}
                        {% if num >= page_obj.number|add:'-2' and num <= page_obj.number|add:'2' %}
                            <button onclick="navigatePage({{ num }})"
                                    class="px-3 py-1
                                           {% if num == page_obj.number %}
                                               bg-red-100 text-red-600
                                           {% else %}
                                               bg-neutral-100 hover:bg-white dark:bg-white/[0.06] dark:hover:bg-neutral-600
                                           {% endif %}
                                           rounded text-sm dark:text-gray-100">{{ num }}</button>
                        {% endif %}
                    {% endfor %}

                    {% if page_obj.number < page_obj.paginator.num_pages|add:'-2' %}
                        <span class="px-2 text-neutral-500 dark:text-neutral-300">...</span>
                        <button onclick="navigatePage({{ page_obj.paginator.num_pages }})"
                                class="px-3 py-1 bg-neutral-100 hover:bg-white dark:bg-white/[0.06] dark:hover:bg-neutral-600 rounded-sm text-sm dark:text-gray-100">
                            {{ page_obj.paginator.num_pages }}
                        </button>
                    {% endif %}

                    <button onclick="navigatePage('next')"
                            class="px-3 py-1 bg-neutral-100 hover:bg-white dark:bg-white/[0.06] dark:hover:bg-neutral-600 rounded-sm text-sm dark:text-gray-100"
                            {% if not page_obj.has_next %}disabled{% endif %}>Next</button>
                </div>

            </div>
        </div>

    </div>
{% endblock body %}



{% block js %}
    <script defer src="{% static 'assets/js/apexcharts.js' %}"></script>
    <script src="{% static 'assets/js/simple-datatables.js' %}"></script>



    <script>
        // Action Menu Handling
        document.querySelectorAll('.action-btn').forEach(button => {
            button.addEventListener('click', (e) => {
                e.stopPropagation();
                const menu = button.nextElementSibling;
                const isOpen = !menu.classList.contains('hidden');

                // Close all other menus
                document.querySelectorAll('.action-menu').forEach(m => m.classList.add('hidden'));

                // Toggle current menu
                menu.classList.toggle('hidden', isOpen);
            });
        });

        // Close menus when clicking outside
        document.addEventListener('click', (e) => {
            if (!e.target.closest('.action-btn')) {
                document.querySelectorAll('.action-menu').forEach(menu => {
                    menu.classList.add('hidden');
                });
            }
        });

        

        // Pagination Handling
        function getCurrentParams() {
            const params = new URLSearchParams(window.location.search);
            return {
                page: parseInt(params.get('page')) || 1,
                size: parseInt(params.get('page_size')) || 10
            };
        }

        // Initialize page size from URL
        window.addEventListener('load', () => {
            const params = getCurrentParams();
            document.getElementById('pageSize').value = params.size;
        });

        function navigatePage(action) {
            const urlParams = new URLSearchParams(window.location.search);
            const currentSearch = document.getElementById('searchInput').value;
            let page = parseInt(urlParams.get('page') || 1);

            if (action === 'prev') {
                page = Math.max(1, page - 1);
            } else if (action === 'next') {
                page = page + 1;
            } else {
                page = parseInt(action);
            }

            if (currentSearch) {
                urlParams.set('q', currentSearch);
            }

            urlParams.set('page', page);
            window.location.search = urlParams.toString();
        }

        function updatePageSize(size) {
            const urlParams = new URLSearchParams(window.location.search);
            const currentSearch = document.getElementById('searchInput').value;

            urlParams.set('page_size', size);
            urlParams.set('page', 1); // Reset to first page

            if (currentSearch) {
                urlParams.set('q', currentSearch);
            }
            window.location.search = urlParams.toString();
        }

        // Add debounce to prevent too many requests
        function handleSearch(value) {
            updateSearchParams(value);
        }

        function updateSearchParams(searchTerm) {
            const urlParams = new URLSearchParams(window.location.search);

            if (searchTerm.trim()) {
                urlParams.set('q', searchTerm);
            } else {
                urlParams.delete('q');
            }

            // Reset to first page when searching
            urlParams.set('page', 1);
            window.location.search = urlParams.toString();
        }

        document.getElementById('searchInput').addEventListener('keydown', (e) => {
            if (e.key === 'Enter') {
                updateSearchParams(e.target.value);
            }
        });

        const shipSelectedOrders = () => {
            // Get all checked checkboxes with class 'ship-order-ids'
            const selectedCheckboxes = document.querySelectorAll('.ship-order-ids:checked');

            // Extract values (order IDs) from the checked checkboxes
            const orderIds = Array.from(selectedCheckboxes).map(checkbox => checkbox.value);

            // Find the hidden input inside the form
            const hiddenInput = document.querySelector('#shipForm input[name="order_ids"]');

            // Set the value of the hidden input to comma-separated order IDs
            hiddenInput.value = orderIds.join(',');

            // Submit the form programmatically
            document.getElementById('shipForm').submit();
        };

        const exportRowCSV = (rowId) => {
            // Find the row by data-row-id attribute
            const row = document.querySelector(`tr[data-row-id="${rowId}"]`);

            if (!row) {
                alert('Row not found');
                return;
            }

            // Extract data from the row cells (excluding the Actions column)
            const cells = row.querySelectorAll('td');
            const rowData = [];

            // Skip the last cell (Actions column)
            for (let i = 0; i < cells.length - 1; i++) {
                const cell = cells[i];
                // Get text content and clean it up
                let text = cell.textContent.trim();
                // Remove currency symbols and format numbers
                text = text.replace(/₹/g, '').replace(/,/g, '');
                rowData.push(text);
            }

            // Create CSV content with headers
            const headers = ['ID', 'Payout Date', 'Payout Amount', 'Order Count', 'Freight Deduction', 'Early COD Charges %', 'Early COD Charges', 'Remittance Amount', 'Amount Paid', 'UTR', 'Remarks', 'Status'];
            const csvContent = [headers.join(','), rowData.join(',')].join('\n');

            // Create and download the CSV file
            const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
            const link = document.createElement('a');

            if (link.download !== undefined) {
                const url = URL.createObjectURL(blob);
                link.setAttribute('href', url);
                link.setAttribute('download', `${rowId}_remittance.csv`);
                link.style.visibility = 'hidden';
                document.body.appendChild(link);
                link.click();
                document.body.removeChild(link);
            }
        };

        // Checkbox Handling
        function updateActionButtons() {
            const checkedCount = document.querySelectorAll('.row-checkbox:checked').length;
            document.getElementById('actionButtons').classList.toggle('hidden', checkedCount === 0);
            document.getElementById('cancelActionButtons').classList.toggle('hidden', checkedCount === 0);
        }

        document.getElementById('selectAll').addEventListener('change', (e) => {
            document.querySelectorAll('.row-checkbox').forEach(checkbox => {
                checkbox.checked = e.target.checked;
            });
            updateActionButtons();
        });

        document.querySelectorAll('.row-checkbox').forEach(checkbox => {
            checkbox.addEventListener('change', updateActionButtons);
        });

        // Modal Handling
        function openModal() {
            document.getElementById('shipModal').classList.remove('hidden');
        }

        function closeModal() {
            document.getElementById('shipModal').classList.add('hidden');
        }
    </script>

{% endblock js %}
