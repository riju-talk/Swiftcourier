{% extends "components/layouts/layout.dj" %}

{% load static %}

{% block title %}
    All Recharges
{% endblock title %}


{% block css %}
    <style>
        [x-cloak] {
            display: none !important;
        }

        .date-transition {
            transition: all 0.2s ease-in-out;
        }

        /* Scrollbar Styling */
        ::-webkit-scrollbar {
            width: 8px;
            height: 8px;
        }

        ::-webkit-scrollbar-track {
            @apply bg-neutral-100 dark:bg-white/[0.06];
        }

        ::-webkit-scrollbar-thumb {
            @apply bg-neutral-300 dark:bg-neutral-600 rounded-full;
        }

        ::-webkit-scrollbar-thumb:hover {
            @apply bg-neutral-400 dark:bg-gray-500;
        }

        /* Optimized tooltip styling */
        .tooltip {
            min-width: 120px;
            pointer-events: none;
            transform-origin: top center;
            will-change: transform, opacity;
        }

        /* Dark mode compatibility */
        .dark .tooltip {
            background-color: #374151;
            color: #f9fafb;
        }
    </style>
{% endblock css %}


{% block body %}
    <div class="space-y-6">

        <div class="flex flex-wrap items-end justify-between gap-3">
            <div>
                <h1 class="text-[22px] font-bold leading-tight tracking-tight text-neutral-900 dark:text-white">All Recharges</h1>
                <p class="mt-0.5 text-[13px] text-neutral-500 dark:text-neutral-400">Every wallet top-up and adjustment on your account.</p>
            </div>
            <div class="flex items-center gap-2">
                <button id="filterToggleBtn" class="inline-flex h-9 items-center gap-1.5 rounded-lg border border-neutral-300 bg-white px-3.5 text-sm font-semibold text-neutral-700 transition-colors hover:bg-neutral-50 dark:border-white/15 dark:bg-transparent dark:text-neutral-200" title="Filter">
                    <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2a1 1 0 01-.293.707L15 13.414V19a1 1 0 01-1.447.894l-4-2A1 1 0 019 17v-3.586L3.293 6.707A1 1 0 013 6V4z" /></svg>
                    <span id="filterToggleText">Filter</span>
                </button>
                <button id="exportOrderButton" class="inline-flex h-9 items-center rounded-lg bg-neutral-900 px-4 text-sm font-semibold text-white transition-colors hover:bg-red-600 dark:bg-white dark:text-black dark:hover:bg-red-600 dark:hover:text-white">Export</button>
            </div>
        </div>

        {% include "components/common/user_panel_filter.dj" %}

        <div class="overflow-hidden rounded-xl border border-neutral-200/80 bg-white dark:border-white/10 dark:bg-neutral-950">
            <div class="overflow-x-auto">
                <table class="w-full whitespace-nowrap">
                    <thead>
                        <tr>
                            <th class="px-4 py-3 text-left text-[11px] font-semibold uppercase tracking-wider text-neutral-500">#</th>
                            <th class="px-4 py-3 text-left text-[11px] font-semibold uppercase tracking-wider text-neutral-500">Date</th>
                            <th class="px-4 py-3 text-left text-[11px] font-semibold uppercase tracking-wider text-neutral-500">Transaction ID</th>
                            <th class="px-4 py-3 text-right text-[11px] font-semibold uppercase tracking-wider text-neutral-500">Amount</th>
                            <th class="px-4 py-3 text-right text-[11px] font-semibold uppercase tracking-wider text-neutral-500">Closing</th>
                            <th class="px-4 py-3 text-left text-[11px] font-semibold uppercase tracking-wider text-neutral-500">Type</th>
                            <th class="px-4 py-3 text-left text-[11px] font-semibold uppercase tracking-wider text-neutral-500">Narration</th>
                            <th class="px-4 py-3 text-right text-[11px] font-semibold uppercase tracking-wider text-neutral-500">Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for txn in page_obj %}
                            <tr class="border-t border-neutral-100 hover:bg-neutral-50 dark:border-white/5 dark:hover:bg-white/[0.03]">
                                <td class="px-4 py-3 text-[13px] text-neutral-400">{{ forloop.counter0|add:page_obj.start_index }}</td>
                                <td class="px-4 py-3 text-[13px] text-neutral-600 dark:text-neutral-300">{{ txn.created_at|date:"Y-m-d H:i" }}</td>
                                <td class="px-4 py-3 font-mono text-[12px] text-neutral-500 dark:text-neutral-400">{{ txn.merchant_transaction_id }}</td>
                                <td class="px-4 py-3 text-right text-[13px] font-semibold tabular-nums {% if txn.transaction_type == 'debit' %}text-red-600 dark:text-red-400{% else %}text-emerald-600 dark:text-emerald-400{% endif %}">
                                    {% if txn.transaction_type == "debit" %}&minus;{% else %}+{% endif %}₹{{ txn.amount }}
                                </td>
                                <td class="px-4 py-3 text-right text-[13px] tabular-nums text-neutral-600 dark:text-neutral-300">₹{{ txn.closing_amount }}</td>
                                <td class="px-4 py-3 text-[13px] text-neutral-600 dark:text-neutral-300">{{ txn.get_transaction_type_display }}</td>
                                <td class="px-4 py-3 text-[13px] text-neutral-500">{{ txn.get_desc_display }}</td>
                                <td class="px-4 py-3 text-right">{% include "components/ui/status_pill.dj" with status=txn.status %}</td>
                            </tr>
                        {% empty %}
                            <tr><td colspan="8" class="px-4 py-12 text-center text-sm text-neutral-400">No wallet recharges yet.</td></tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>

        {% include "components/common/pagination.dj" %}
    </div>
{% endblock body %}



{% block js %}
    <script defer src="{% static 'assets/js/apexcharts.js' %}"></script>
    <script src="{% static 'assets/js/simple-datatables.js' %}"></script>

    <script>
        // Action Menu Handling
        document.querySelectorAll('.action-btn').forEach(button => {
            button.addEventListener('click', (e) => {
                e.stopPropagation();
                const menu = button.nextElementSibling;
                const isOpen = !menu.classList.contains('hidden');

                // Close all other menus
                document.querySelectorAll('.action-menu').forEach(m => m.classList.add('hidden'));

                // Toggle current menu
                menu.classList.toggle('hidden', isOpen);
            });
        });

        // Close menus when clicking outside
        document.addEventListener('click', (e) => {
            if (!e.target.closest('.action-btn')) {
                document.querySelectorAll('.action-menu').forEach(menu => {
                    menu.classList.add('hidden');
                });
            }
        });

        // Checkbox Handling
        function updateActionButtons() {
            const checkedCount = document.querySelectorAll('.row-checkbox:checked').length;
            document.getElementById('actionButtons').classList.toggle('hidden', checkedCount === 0);
            document.getElementById('cancelActionButtons').classList.toggle('hidden', checkedCount === 0);
        }

        document.getElementById('selectAll').addEventListener('change', (e) => {
            document.querySelectorAll('.row-checkbox').forEach(checkbox => {
                checkbox.checked = e.target.checked;
            });
            updateActionButtons();
        });

        document.querySelectorAll('.row-checkbox').forEach(checkbox => {
            checkbox.addEventListener('change', updateActionButtons);
        });

        // Modal Handling
        function openModal() {
            document.getElementById('shipModal').classList.remove('hidden');
        }

        function closeModal() {
            document.getElementById('shipModal').classList.add('hidden');
        }

        // Add debounce to prevent too many requests
        function handleSearch(value) {
            updateSearchParams(value);
        }

        function updateSearchParams(searchTerm) {
            const urlParams = new URLSearchParams(window.location.search);

            if (searchTerm.trim()) {
                urlParams.set('q', searchTerm);
            } else {
                urlParams.delete('q');
            }

            // Reset to first page when searching
            urlParams.set('page', 1);
            window.location.search = urlParams.toString();
        }

        document.getElementById('searchInput').addEventListener('keydown', (e) => {
            if (e.key === 'Enter') {
                updateSearchParams(e.target.value);
            }
        });

        const shipSelectedOrders = () => {
            // Get all checked checkboxes with class 'ship-order-ids'
            const selectedCheckboxes = document.querySelectorAll('.ship-order-ids:checked');

            // Extract values (order IDs) from the checked checkboxes
            const orderIds = Array.from(selectedCheckboxes).map(checkbox => checkbox.value);

            // Find the hidden input inside the form
            const hiddenInput = document.querySelector('#shipForm input[name="order_ids"]');

            // Set the value of the hidden input to comma-separated order IDs
            hiddenInput.value = orderIds.join(',');

            // Submit the form programmatically
            document.getElementById('shipForm').submit();
        };
    </script>

{% endblock js %}
