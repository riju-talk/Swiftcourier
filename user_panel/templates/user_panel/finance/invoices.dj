{% extends "components/layouts/layout.dj" %}
{% load static %}

{% block title %}Invoices{% endblock title %}

{% block css %}
    <style>
        [x-cloak] { display: none !important; }

        ::-webkit-scrollbar { width: 8px; height: 8px; }
        ::-webkit-scrollbar-thumb { background: #d1d5db; border-radius: 9999px; }
    </style>
{% endblock css %}

{% block body %}
    <div class="space-y-6">

        <div>
            <h1 class="text-[22px] font-bold leading-tight tracking-tight text-neutral-900 dark:text-white">Invoices</h1>
            <p class="mt-0.5 text-[13px] text-neutral-500 dark:text-neutral-400">Monthly shipping and service invoices, ready to download.</p>
        </div>

        <div class="overflow-hidden rounded-xl border border-neutral-200/80 bg-white dark:border-white/10 dark:bg-neutral-950">
            <div class="flex flex-wrap items-center justify-between gap-3 border-b border-neutral-200/80 px-5 py-4 dark:border-white/10">
                <h2 class="text-sm font-bold text-neutral-900 dark:text-white">All invoices</h2>
                <input type="text" id="searchInput" name="q" placeholder="Search invoice #…" value="{{ request.GET.q }}"
                       class="h-9 w-64 rounded-lg border border-neutral-300 px-3 text-sm focus:outline-hidden focus:ring-2 focus:ring-red-500 dark:border-white/10 dark:bg-white/[0.06] dark:text-gray-100">
            </div>

            <div class="overflow-x-auto">
                <table class="w-full">
                    <thead>
                        <tr>
                            <th class="px-4 py-3 text-left text-[11px] font-semibold uppercase tracking-wider text-neutral-500">Invoice #</th>
                            <th class="px-4 py-3 text-left text-[11px] font-semibold uppercase tracking-wider text-neutral-500">Service</th>
                            <th class="px-4 py-3 text-left text-[11px] font-semibold uppercase tracking-wider text-neutral-500">Date</th>
                            <th class="px-4 py-3 text-left text-[11px] font-semibold uppercase tracking-wider text-neutral-500">Period</th>
                            <th class="px-4 py-3 text-right text-[11px] font-semibold uppercase tracking-wider text-neutral-500">Amount</th>
                            <th class="px-4 py-3 text-right text-[11px] font-semibold uppercase tracking-wider text-neutral-500">Download</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for invoice in invoices %}
                        <tr class="border-t border-neutral-100 hover:bg-neutral-50 dark:border-white/5 dark:hover:bg-white/[0.03]">
                            <td class="px-4 py-3 text-[13px] font-medium text-neutral-900 dark:text-white">{{ invoice.number }}</td>
                            <td class="px-4 py-3 text-[13px] text-neutral-600 dark:text-neutral-300">{{ invoice.service_type }}</td>
                            <td class="px-4 py-3 text-[13px] text-neutral-600 dark:text-neutral-300">{{ invoice.date_from }}</td>
                            <td class="px-4 py-3 text-[13px] text-neutral-500">{{ invoice.date_from }} – {{ invoice.date_to }}</td>
                            <td class="px-4 py-3 text-right text-[13px] font-semibold tabular-nums text-neutral-900 dark:text-white">₹{{ invoice.amount }}</td>
                            <td class="px-4 py-3 text-right">
                                <div class="inline-flex gap-1.5">
                                {% if invoice.pdf_file %}<a href="{{ invoice.pdf_file.url|default:'#' }}" target="_blank" class="inline-flex items-center rounded-lg border border-neutral-300 bg-white px-2.5 py-1 text-xs font-semibold text-neutral-700 hover:bg-neutral-50 dark:border-white/15 dark:bg-transparent dark:text-neutral-200">PDF</a>{% endif %}
                                {% if invoice.excel_file %}<a href="{{ invoice.excel_file.url|default:'#' }}" target="_blank" class="inline-flex items-center rounded-lg border border-neutral-300 bg-white px-2.5 py-1 text-xs font-semibold text-neutral-700 hover:bg-neutral-50 dark:border-white/15 dark:bg-transparent dark:text-neutral-200">Excel</a>{% endif %}
                                {% if not invoice.pdf_file and not invoice.excel_file %}<span class="text-xs text-neutral-400">—</span>{% endif %}
                                </div>
                            </td>
                        </tr>
                        {% empty %}
                        <tr><td colspan="6" class="px-4 py-12 text-center text-sm text-neutral-400">No invoices yet.</td></tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Pagination -->
        <div class="rounded-xl border border-neutral-200/80 bg-white p-4 dark:border-white/10 dark:bg-neutral-950 flex flex-col sm:flex-row justify-between gap-4">
            <!-- Page Size -->
            <div class="flex items-center gap-2">
                <span class="text-sm">Show</span>
                <select id="pageSize" onchange="updatePageSize(this.value)"
                    class="px-2 py-1 border rounded-sm text-sm dark:bg-white/[0.06]">
                    <option value="10" {% if page_size == 10 %}selected{% endif %}>10</option>
                    <option value="50" {% if page_size == 50 %}selected{% endif %}>50</option>
                    <option value="100" {% if page_size == 100 %}selected{% endif %}>100</option>
                    <option value="200" {% if page_size == 200 %}selected{% endif %}>200</option>
                    <option value="500" {% if page_size == 500 %}selected{% endif %}>500</option>  
                </select>
            </div>

            <!-- Page Controls -->
            <div class="flex gap-1 flex-wrap">
                <button onclick="navigatePage('prev')" {% if not page_obj.has_previous %}disabled{% endif %}>
                    Prev
                </button>

                {% for num in page_obj.paginator.page_range %}
                    {% if num >= page_obj.number|add:"-2" and num <= page_obj.number|add:"2" %}
                    <button onclick="navigatePage({{ num }})"
                        class="{% if num == page_obj.number %}font-bold text-red-600{% endif %}">
                        {{ num }}
                    </button>
                    {% endif %}
                {% endfor %}

                <button onclick="navigatePage('next')" {% if not page_obj.has_next %}disabled{% endif %}>
                    Next
                </button>
            </div>
        </div>
    </div>
{% endblock body %}

{% block js %}
    <script>
        /* ---------------- SEARCH ---------------- */
        document.getElementById('searchInput').addEventListener('keydown', (e) => {
            if (e.key === 'Enter') {
                e.preventDefault();
                updateSearchParams(e.target.value);
            }
        });

        function updateSearchParams(value) {
            const params = new URLSearchParams(window.location.search);

            if (value.trim()) {
                params.set('q', value);
            } else {
                params.delete('q');
            }

            params.set('page', 1);
            window.location.search = params.toString();
        }

        /* ---------------- PAGINATION ---------------- */
        function navigatePage(action) {
            const params = new URLSearchParams(window.location.search);
            let page = parseInt(params.get('page') || 1);

            if (action === 'prev') page--;
            else if (action === 'next') page++;
            else page = action;

            params.set('page', page);
            window.location.search = params.toString();
        }

        function updatePageSize(size) {
            const params = new URLSearchParams(window.location.search);
            params.set('page_size', size);
            params.set('page', 1);
            window.location.search = params.toString();
        }
    </script>
{% endblock js %}
