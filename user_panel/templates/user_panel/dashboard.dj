{% extends "components/layouts/layout.dj" %}
{% block title %}
    Dashboard
{% endblock title %}
{% load static %}
{% block css %}
    <style>
        .truncate {
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            max-width: 150px;
            display: block;
        }
    </style>
{% endblock css %}
{% block body %}
    <div class="pt-5">
        <!-- Revenue & Sales By Category Section -->
        <div class="grid xl:grid-cols-3 gap-6 mb-6">
            <!-- Revenue Chart -->
            <div class="panel h-full xl:col-span-2">
                <div class="flex items-center dark:text-white-light mb-5">
                    <h5 class="font-semibold text-lg">Revenue</h5>
                </div>
                <p class="text-lg dark:text-white-light/90">
                    Total Profit <span class="text-primary ml-2">₹{{ summary.prepaid.amount|default:0|add:summary.cod.amount|default:0 }}</span>
                </p>
                <div class="relative overflow-hidden">
                    <div id="revenue-chart"
                         class="bg-white dark:bg-black rounded-lg min-h-[325px]"></div>
                </div>
            </div>
            <!-- Sales By Category -->
            <div class="panel h-full">
                <div class="flex items-center mb-5">
                    <h5 class="font-semibold text-lg dark:text-white-light">Sales By Category</h5>
                </div>
                <div class="overflow-hidden">
                    <div id="category-chart"
                         class="bg-white dark:bg-black rounded-lg min-h-[353px]"></div>
                </div>
            </div>
        </div>
        <!-- Daily Sales & Summary & Total Orders Section -->
        <div class="grid sm:grid-cols-2 xl:grid-cols-3 gap-6 mb-6">
            <!-- Daily Sales -->
            <div class="panel h-full sm:col-span-2 xl:col-span-1">
                <div class="flex items-center mb-5">
                    <h5 class="font-semibold text-lg dark:text-white-light">
                        Daily Sales <span class="block text-white-dark text-sm font-normal">Go to columns for details.</span>
                    </h5>
                </div>
                <div class="overflow-hidden">
                    <div id="daily-sales-chart"
                         class="bg-white dark:bg-black rounded-lg min-h-[175px]"></div>
                </div>
            </div>
            <!-- Summary -->
            <div class="panel h-full">
                <div class="flex items-center dark:text-white-light mb-5">
                    <h5 class="font-semibold text-lg">Summary</h5>
                </div>
                <div class="space-y-9">
                    <!-- Prepaid Packets -->
                    <div class="flex items-center">
                        <div class="w-9 h-9 ltr:mr-3 rtl:ml-3">
                            <div class="bg-secondary-light dark:bg-secondary text-secondary dark:text-secondary-light rounded-full w-9 h-9 grid place-content-center">
                                <svg width="20"
                                     height="20"
                                     viewBox="0 0 24 24"
                                     fill="none"
                                     xmlns="http://www.w3.org/2000/svg">
                                    <path d="M3.74157 18.5545C4.94119 20 7.17389 20 11.6393 20H12.3605C16.8259 20 19.0586 20 20.2582 18.5545M3.74157 18.5545C2.54194 17.1091 2.9534 14.9146 3.77633 10.5257C4.36155 7.40452 4.65416 5.84393 5.76506 4.92196M3.74157 18.5545C3.74156 18.5545 3.74157 18.5545 3.74157 18.5545ZM20.2582 18.5545C21.4578 17.1091 21.0464 14.9146 20.2235 10.5257C19.6382 7.40452 19.3456 5.84393 18.2347 4.92196M20.2582 18.5545C20.2582 18.5545 20.2582 18.5545 20.2582 18.5545ZM18.2347 4.92196C17.1238 4 15.5361 4 12.3605 4H11.6393C8.46374 4 6.87596 4 5.76506 4.92196M18.2347 4.92196C18.2347 4.92196 18.2347 4.92196 18.2347 4.92196ZM5.76506 4.92196C5.76506 4.92196 5.76506 4.92196 5.76506 4.92196Z" stroke="currentColor" stroke-width="1.5" />
                                    <path opacity="0.5" d="M9.1709 8C9.58273 9.16519 10.694 10 12.0002 10C13.3064 10 14.4177 9.16519 14.8295 8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                                </svg>
                            </div>
                        </div>
                        <div class="flex-1">
                            <div class="flex font-semibold text-white-dark mb-2">
                                <h6>Prepaid Packets</h6>
                                <p class="ltr:ml-auto rtl:mr-auto">₹{{ summary.prepaid.amount|default:0 }}</p>
                            </div>
                            <div class="rounded-full h-2 bg-dark-light dark:bg-[#1b2e4b] shadow">
                                <div class="bg-gradient-to-r from-[#7579ff] to-[#b224ef] h-full rounded-full"
                                     style="width: {{ summary.prepaid.progress|default:0 }}%"></div>
                            </div>
                        </div>
                    </div>
                    <!-- COD Packets -->
                    <div class="flex items-center">
                        <div class="w-9 h-9 ltr:mr-3 rtl:ml-3">
                            <div class="bg-success-light dark:bg-success text-success dark:text-success-light rounded-full w-9 h-9 grid place-content-center">
                                <svg width="20"
                                     height="20"
                                     viewBox="0 0 24 24"
                                     fill="none"
                                     xmlns="http://www/w3.org/2000/svg">
                                    <path d="M4.72848 16.1369C3.18295 14.5914 2.41018 13.8186 2.12264 12.816C1.83509 11.8134 2.08083 10.7485 2.57231 8.61875L2.85574 7.39057C3.26922 5.59881 3.47597 4.70292 4.08944 4.08944C4.70292 3.47597 5.59881 3.26922 7.39057 2.85574L8.61875 2.57231C10.7485 2.08083 11.8134 1.83509 12.816 2.12264C13.8186 2.41018 14.5914 3.18295 16.1369 4.72848L17.9665 6.55812C20.6555 9.24711 22 10.5916 22 12.2623C22 13.933 20.6555 15.2775 17.9665 17.9665C15.2775 20.6555 13.933 22 12.2623 22C10.5916 22 9.24711 20.6555 6.55812 17.9665L4.72848 16.1369Z" stroke="currentColor" stroke-width="1.5" />
                                    <circle opacity="0.5" cx="8.60699" cy="8.87891" r="2" transform="rotate(-45 8.60699 8.87891)" stroke="currentColor" stroke-width="1.5" />
                                    <path opacity="0.5" d="M11.5417 18.5L18.5208 11.5208" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                                </svg>
                            </div>
                        </div>
                        <div class="flex-1">
                            <div class="flex font-semibold text-white-dark mb-2">
                                <h6>COD Packets</h6>
                                <p class="ltr:ml-auto rtl:mr-auto">₹{{ summary.cod.amount|default:0 }}</p>
                            </div>
                            <div class="w-full rounded-full h-2 bg-dark-light dark:bg-[#1b2e4b] shadow">
                                <div class="bg-gradient-to-r from-[#3cba92] to-[#0ba360] h-full rounded-full"
                                     style="width: {{ summary.cod.progress|default:0 }}%"></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <!-- Total Orders -->
            <div class="panel h-full p-0">
                <div class="flex items-center justify-between w-full p-5 absolute">
                    <div class="relative">
                        <div class="text-success dark:text-success-light bg-success-light dark:bg-success w-11 h-11 rounded-lg flex items-center justify-center">
                            <svg width="24"
                                 height="24"
                                 viewBox="0 0 24 24"
                                 fill="none"
                                 xmlns="http://www.w3.org/2000/svg">
                                <path d="M2 3L2.26491 3.0883C3.58495 3.52832 4.24497 3.74832 4.62248 4.2721C5 4.79587 5 5.49159 5 6.88304V9.5C5 12.3284 5 13.7426 5.87868 14.6213C6.75736 15.5 8.17157 15.5 11 15.5H19" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                                <path opacity="0.5" d="M7.5 18C8.32843 18 9 18.6716 9 19.5C9 20.3284 8.32843 21 7.5 21C6.67157 21 6 20.3284 6 19.5C6 18.6716 6.67157 18 7.5 18Z" stroke="currentColor" stroke-width="1.5" />
                                <path opacity="0.5" d="M16.5 18.0001C17.3284 18.0001 18 18.6716 18 19.5001C18 20.3285 17.3284 21.0001 16.5 21.0001C15.6716 21.0001 15 20.3285 15 19.5001C15 18.6716 15.6716 18.0001 16.5 18.0001Z" stroke="currentColor" stroke-width="1.5" />
                                <path opacity="0.5" d="M11 9H8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                                <path d="M5 6H16.4504C18.5054 6 19.5328 6 19.9775 6.67426C20.4221 7.34853 20.0173 8.29294 19.2078 10.1818L18.7792 11.1818C18.4013 12.0636 18.2123 12.5045 17.8366 12.7523C17.4609 13 16.9812 13 16.0218 13H5" stroke="currentColor" stroke-width="1.5" />
                            </svg>
                        </div>
                    </div>
                    <h5 class="font-semibold text-2xl ltr:text-right rtl:text-left dark:text-white-light">
                        {{ total_orders.count|default:0 }}
                        <span class="block text-sm font-normal">Total Orders</span>
                    </h5>
                </div>
                <div id="total-orders-chart"
                     class="bg-transparent rounded-lg overflow-hidden min-h-[290px]"></div>
            </div>
        </div>
        <!-- Recent Activities & Transactions & Wallet Section -->
        <div class="grid sm:grid-cols-2 xl:grid-cols-3 gap-6 mb-6">
            <!-- Recent Activities -->
            <div class="panel h-full sm:col-span-2 xl:col-span-1 pb-0">
                <h5 class="font-semibold text-lg dark:text-white-light mb-5">Recent Activities</h5>
                <div class="perfect-scrollbar relative mb-4 h-[290px] pr-3 -mr-3 overflow-y-auto">
                    <div class="text-sm cursor-pointer">
                        {% for activity in recent_activities %}
                            <div class="flex items-center py-1.5 relative group">
                                <div class="bg-{{ activity.type }} w-1.5 h-1.5 rounded-full ltr:mr-1 rtl:ml-1.5"></div>
                                <div class="flex-1 truncate">{{ activity.content }}</div>
                                <div class="ltr:ml-auto rtl:mr-auto text-xs text-white-dark dark:text-gray-500">{{ activity.time }}</div>
                                <span class="badge badge-outline-{{ activity.type }} absolute ltr:right-0 rtl:left-0 text-xs bg-{{ activity.type }}-light dark:bg-[#0e1726] opacity-0 group-hover:opacity-100">{{ activity.badge }}</span>
                            </div>
                        {% empty %}
                            <div class="text-center py-4 text-white-dark">No recent activities.</div>
                        {% endfor %}
                    </div>
                </div>
                <div class="border-t border-white-light dark:border-white/10">
                    <a href="javascript:;"
                       class="font-semibold group hover:text-primary p-4 flex items-center justify-center group">
                        View All
                        <svg class="w-4 h-4 rtl:rotate-180 group-hover:translate-x-1 rtl:group-hover:-translate-x-1 transition duration-300 ltr:ml-1 rtl:mr-1"
                             viewBox="0 0 24 24"
                             fill="none"
                             xmlns="http://www.w3.org/2000/svg">
                            <path d="M4 12H20M20 12L14 6M20 12L14 18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                    </a>
                </div>
            </div>
            <!-- Transactions -->
            <div class="panel h-full">
                <div class="flex items-center justify-between dark:text-white-light mb-5">
                    <h5 class="font-semibold text-lg">Transactions</h5>
                </div>
                <div>
                    <div class="space-y-3">
                        {% for txn in transactions %}
                            <div class="flex items-center">
                                <span class="shrink-0 grid place-content-center text-xs w-9 h-9 rounded-md
                                            {% if txn.is_credit %}
                                                bg-success-light dark:bg-success text-success dark:text-success-light
                                            {% else %}
                                                bg-danger-light dark:bg-danger text-danger dark:text-danger-light
                                            {% endif %}">
                                    {{ txn.type }}
                                </span>
                                <div class="px-3 flex-1">
                                    <div class="truncate font-medium">{{ txn.title }}</div>
                                    <div class="text-xs text-white-dark dark:text-gray-500">{{ txn.time }}</div>
                                </div>
                                <div class="ltr:ml-auto rtl:mr-auto text-right">
                                    <span class="text-
                                                {% if txn.is_credit %}
                                                    success
                                                {% else %}
                                                    danger
                                                {% endif %}
                                                text-base font-medium whitespace-nowrap">
                                        {% if txn.is_credit %}
                                            +₹
                                        {% else %}
                                            -₹
                                        {% endif %}
                                        {{ txn.amount }}
                                    </span>
                                </div>
                            </div>
                        {% empty %}
                            <div class="text-center py-4 text-white-dark">No transactions.</div>
                        {% endfor %}
                    </div>
                </div>
            </div>

            <!-- Wallet Balance -->
            <div class="panel h-full p-0 border-0 overflow-hidden">
                <div class="p-6 bg-gradient-to-r from-[#4361ee] to-[#160f6b] min-h-[190px]">
                    <div class="flex justify-between items-center mb-6">
                        <div class="bg-black/50 rounded-full p-1 ltr:pr-3 rtl:pl-3 flex items-center text-white font-semibold">
                            <img class="w-8 h-8 rounded-full border-2 border-white/50 block object-cover ltr:mr-1 rtl:ml-1"
                                 src="{% static 'assets/images/user-profile.jpg' %}"
                                 alt="image" />
                            {{ userName|default:"User" }}
                        </div>
                        <button type="button"
                                class="ltr:ml-auto rtl:mr-auto flex items-center justify-between w-9 h-9 bg-black text-white rounded-md hover:opacity-80">
                            <svg class="w-6 h-6 m-auto"
                                 viewBox="0 0 24 24"
                                 stroke="currentColor"
                                 stroke-width="1.5"
                                 fill="none"
                                 stroke-linecap="round"
                                 stroke-linejoin="round">
                                <line x1="12" y1="5" x2="12" y2="19"></line>
                                <line x1="5" y1="12" x2="19" y2="12"></line>
                            </svg>
                        </button>
                    </div>
                    <div class="text-white flex justify-between items-center">
                        <p class="text-xl">Wallet Balance</p>
                        <h5 class="ltr:ml-auto rtl:mr-auto text-2xl">
                            <span class="text-white-light">₹</span>{{ wallet_balance|default:0 }}
                        </h5>
                    </div>
                </div>
                <div class="p-5">
                    <div class="text-center px-2 flex justify-around">
                        <button type="button" class="btn btn-secondary ltr:mr-2 rtl:ml-2">View Details</button>
                        <button type="button" class="btn btn-success">Recharge Wallet</button>
                    </div>
                </div>
            </div>
        </div>
        <!-- Recent Orders Section -->
        <div class="grid lg:grid-cols-2 grid-cols-1 gap-6">
            <div class="panel h-full w-full">
                <div class="flex items-center justify-between mb-5">
                    <h5 class="font-semibold text-lg dark:text-white-light">Recent Orders</h5>
                </div>
                <div class="table-responsive">
                    <table>
                        <thead>
                            <tr>
                                <th class="ltr:rounded-l-md rtl:rounded-r-md">Customer</th>
                                <th>Product</th>
                                <th>Price</th>
                                <th class="ltr:rounded-r-md rtl:rounded-l-md">Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for order in recent_orders %}
                                <tr class="text-white-dark hover:text-black dark:hover:text-white-light/90 group">
                                    <td class="min-w-[150px] text-black dark:text-white">
                                        <div class="flex items-center">
                                            <img class="w-8 h-8 rounded-md ltr:mr-3 rtl:ml-3 object-cover"
                                                 src="{% static 'assets/images/profile-1.jpeg' %}"
                                                 alt="avatar" />
                                            <span class="whitespace-nowrap truncate">{{ order.customer_name|default:"N/A" }}</span>
                                        </div>
                                    </td>
                                    <td class="text-primary truncate">{{ order.product|default:"N/A" }}</td>
                                    <td>₹{{ order.price|default:0 }}</td>
                                    <td>
                                        <span class="badge bg-{{ order.status_class|default:'secondary' }} shadow-md dark:group-hover:bg-transparent">{{ order.status|default:"N/A" }}</span>
                                    </td>
                                </tr>
                            {% empty %}
                                <tr>
                                    <td colspan="4" class="text-center py-4 text-white-dark">No recent orders.</td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="panel h-full w-full">
                <div class="flex items-center justify-between mb-5">
                    <h5 class="font-semibold text-lg dark:text-white-light">Top Selling Product</h5>
                </div>
                <div class="table-responsive">
                    <table>
                        <thead>
                            <tr class="border-b-0">
                                <th class="ltr:rounded-l-md rtl:rounded-r-md">Product</th>
                                <th>Price</th>
                                <th>Discount</th>
                                <th>Sold</th>
                                <th class="ltr:rounded-r-md rtl:rounded-l-md">Source</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for product in top_products %}
                                <tr class="text-white-dark hover:text-black dark:hover:text-white-light/90 group">
                                    <td class="min-w-[150px] text-black dark:text-white">
                                        <div class="flex">
                                            <img class="w-8 h-8 rounded-md ltr:mr-3 rtl:ml-3 object-cover"
                                                 src="{% static 'assets/images/product-headphones.jpg' %}"
                                                 alt="avatar" />
                                            <p class="whitespace-nowrap">
                                                <span class="truncate">{{ product.name|default:"N/A" }}</span>
                                                <span class="text-primary block text-xs">{{ product.category|default:"N/A" }}</span>
                                            </p>
                                        </div>
                                    </td>
                                    <td>₹{{ product.price|default:0 }}</td>
                                    <td>₹{{ product.discount|default:0 }}</td>
                                    <td>{{ product.sold|default:0 }}</td>
                                    <td>
                                        <a class="text-{{ product.source_class|default:'secondary' }} flex items-center"
                                           href="javascript:;">
                                            <svg class="w-3.5 h-3.5 rtl:rotate-180 ltr:mr-1 rtl:ml-1"
                                                 viewBox="0 0 24 24"
                                                 fill="none"
                                                 xmlns="http://www.w3.org/2000/svg">
                                                <path d="M12.6644 5.47875L16.6367 9.00968C18.2053 10.404 18.9896 11.1012 18.9896 11.9993C18.9896 12.8975 18.2053 13.5946 16.6367 14.989L12.6644 18.5199C11.9484 19.1563 11.5903 19.4746 11.2952 19.342C11 19.2095 11 18.7305 11 17.7725V15.4279C7.4 15.4279 3.5 17.1422 2 19.9993C2 10.8565 7.33333 8.57075 11 8.57075V6.22616C11 5.26817 11 4.78917 11.2952 4.65662C11.5903 4.52407 11.9484 4.8423 12.6644 5.47875Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                                                <path opacity="0.5" d="M15.5386 4.5L20.7548 9.34362C21.5489 10.081 22.0001 11.1158 22.0001 12.1994C22.0001 13.3418 21.4989 14.4266 20.629 15.1671L15.5386 19.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                                            </svg>
                                            {{ product.source|default:"N/A" }}
                                        </a>
                                    </td>
                                </tr>
                            {% empty %}
                                <tr>
                                    <td colspan="5" class="text-center py-4 text-white-dark">No top selling products.</td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
{% endblock body %}
{% block js %}
    <script src="https://cdn.jsdelivr.net/npm/apexcharts"></script>
    <script>
        
        document.addEventListener("DOMContentLoaded", function() {
            // Revenue Chart
            const revenueChart = new ApexCharts(document.getElementById("revenue-chart"), {
                series: [
                    {% for serie in revenue_chart.series %}
                        {
                            name: "{{ serie.name }}",
                            data: {{ serie.data|safe }}
                        }{% if not forloop.last %},{% endif %}
                    {% endfor %}
                ],
                chart: {
                    height: 325,
                    type: 'line',
                    fontFamily: 'Nunito, sans-serif',
                    zoom: {
                        enabled: false
                    },
                    toolbar: {
                        show: false
                    }
                },
                dataLabels: {
                    enabled: false
                },
                stroke: {
                    curve: 'smooth',
                    width: 3
                },
                colors: ['#1b55e2', '#e7515a'],
                xaxis: {
                    categories: {{ revenue_chart.categories|safe }}
                },
                yaxis: {
                    tickAmount: 6,
                    labels: {
                        formatter: (value) => '₹' + (value / 1000) + 'K'
                    }
                },
                grid: {
                    borderColor: '#e0e6ed',
                    strokeDashArray: 5
                },
                legend: {
                    position: 'top',
                    horizontalAlign: 'right'
                },
                markers: {
                    size: 4,
                    hover: {
                        size: 6
                    }
                }
            });
            revenueChart.render();
            // Category Chart
            const categoryChart = new ApexCharts(document.getElementById("category-chart"), {
                series: {{ category_chart.series|safe }},
                labels: {{ category_chart.labels|safe }},
                chart: {
                    type: 'donut',
                    height: 460,
                    fontFamily: 'Nunito, sans-serif'
                },
                dataLabels: {
                    enabled: false
                },
                stroke: {
                    show: true,
                    width: 25,
                    colors: ['#fff']
                },
                colors: ['#5c1ac3', '#e2a03f', '#e7515a'],
                legend: {
                    position: 'bottom',
                    horizontalAlign: 'center'
                },
                plotOptions: {
                    pie: {
                        donut: {
                            size: '65%',
                            background: 'transparent',
                            labels: {
                                show: true,
                                name: {
                                    show: true,
                                    fontSize: '29px',
                                    offsetY: -10
                                },
                                value: {
                                    show: true,
                                    fontSize: '26px',
                                    offsetY: 16,
                                    formatter: (val) => val
                                },
                                total: {
                                    show: true,
                                    label: 'Total',
                                    fontSize: '22px',
                                    formatter: () => {{ category_chart.total }}
                                }
                            }
                        }
                    }
                }
            });
            categoryChart.render();
            // Daily Sales Chart
            const dailySalesChart = new ApexCharts(document.getElementById("daily-sales-chart"), {
                series: [
                    {% for serie in daily_sales_chart.series %}
                        {
                            name: "{{ serie.name }}",
                            data: {{ serie.data|safe }}
                        }{% if not forloop.last %},{% endif %}
                    {% endfor %}
                ],
                chart: {
                    type: 'bar',
                    height: 160,
                    fontFamily: 'Nunito, sans-serif',
                    toolbar: {
                        show: false
                    },
                    stacked: false
                },
                dataLabels: {
                    enabled: false
                },
                stroke: {
                    width: 1
                },
                colors: ['#5c1ac3', '#e2a03f', '#e7515a'],
                xaxis: {
                    categories: {{ daily_sales_chart.categories|safe }}
                },
                yaxis: {
                    show: true,
                    labels: {
                        formatter: (val) => val
                    }
                },
                grid: {
                    show: true,
                    borderColor: '#e0e6ed',
                    strokeDashArray: 3
                },
                legend: {
                    show: false
                },
                plotOptions: {
                    bar: {
                        horizontal: false,
                        columnWidth: '35%',
                        endingShape: 'rounded'
                    }
                }
            });
            dailySalesChart.render();
            // Total Orders Chart
            const totalOrdersChart = new ApexCharts(document.getElementById("total-orders-chart"), {
                series: [{
                    name: 'Total Orders',
                    data: {{ total_orders.trend|safe }}
                }],
                chart: {
                    height: 290,
                    type: 'area',
                    fontFamily: 'Nunito, sans-serif',
                    sparkline: {
                        enabled: true
                    }
                },
                stroke: {
                    curve: 'smooth',
                    width: 2
                },
                colors: ['#00ab55'],
                yaxis: {
                    show: false
                },
                grid: {
                    padding: {
                        top: 125,
                        right: 0,
                        bottom: 0,
                        left: 0
                    }
                },
                fill: {
                    type: 'gradient',
                    gradient: {
                        type: 'vertical',
                        shadeIntensity: 1,
                        inverseColors: false,
                        opacityFrom: 0.3,
                        opacityTo: 0.05,
                        stops: [100, 100]
                    }
                },
                tooltip: {
                    x: {
                        show: false
                    }
                }
            });
            totalOrdersChart.render();
        });
        
    </script>
{% endblock js %}
