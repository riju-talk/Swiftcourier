{% extends "components/layouts/layout.dj" %}

{% block title %}
    Courier Rules
{% endblock title %}

{% load static %}

{% block css %}
    <style>
        .swap-highlight {
            border: 2px dashed #3b82f6 !important;
            background-color: rgba(59, 130, 246, 0.1) !important;
        }

        /* Drop line */
        .drop-line {
            height: 4px;
            border-radius: 2px;
            background-color: #3b82f6;
            /* blue-500 */
            margin: 6px 0;
        }

        /* Dark mode visibility */
        @media (prefers-color-scheme: dark) {
            .drop-line {
                background-color: #60a5fa;
                /* blue-400 */
            }
        }
    </style>
{% endblock css %}

{% block body %}
    <div x-data="shippingPriority" class="max-w-md mx-auto mt-10 p-4">
        <h2 class="text-2xl font-bold text-center mb-6 text-gray-800 dark:text-gray-200">🚚 Shipping Partner Priority</h2>

        <!-- FORM -->
        <form id="priorityForm" method="post">
            {% csrf_token %}
            <input type="hidden" name="priority" id="priorityField">

            <ul id="draggableList" class="space-y-3 relative">
                {% for courier in couriers %}
                    <li draggable="true"
                        data-id="{{ courier.id }}"
                        class="drag-item flex items-center gap-4 bg-gray-50 dark:bg-gray-800 p-4 rounded-xl shadow-sm dark:shadow-gray-900 cursor-grab transition">
                        <img src="{{ courier.icon.url }}"
                             alt="{{ courier.name }}"
                             class="w-12 h-12 rounded-md object-cover" />
                        <span class="font-medium text-gray-800 dark:text-gray-200">{{ courier.name }}</span>
                    </li>
                {% endfor %}
            </ul>

            <!-- SUBMIT BUTTON -->
            <button type="submit"
                    id="saveButton"
                    class="w-full mt-6 bg-blue-600 hover:bg-blue-700 text-white py-3 rounded-xl shadow-sm transition dark:shadow-gray-900">
                Save Priorities
            </button>
        </form>
    </div>
{% endblock body %}

{% block js %}
    <script>
        const list = document.getElementById("draggableList");
        const form = document.getElementById("priorityForm");
        const priorityField = document.getElementById("priorityField");

        let draggingItem = null;
        let dropLine = null;

        function createDropLine() {
            const line = document.createElement("div");
            line.className = "drop-line";
            return line;
        }

        document.querySelectorAll(".drag-item").forEach(item => {
            item.addEventListener("dragstart", () => {
                draggingItem = item;
                item.classList.add("dragging");
                if (dropLine) dropLine.remove();
            });

            item.addEventListener("dragend", () => {
                item.classList.remove("dragging");
                if (dropLine) dropLine.remove();
                dropLine = null;
                draggingItem = null;
            });
        });

        list.addEventListener("dragover", e => {
            e.preventDefault();
            const afterElement = getDragAfterElement(list, e.clientY);

            if (!dropLine) {
                dropLine = createDropLine();
            }
            dropLine.remove();

            if (afterElement == null) {
                list.appendChild(dropLine);
            } else {
                list.insertBefore(dropLine, afterElement);
            }
        });

        list.addEventListener("drop", () => {
            if (!dropLine) return;
            list.insertBefore(draggingItem, dropLine);
            dropLine.remove();
            dropLine = null;
        });

        function getDragAfterElement(container, y) {
            const elements = [...container.querySelectorAll(".drag-item:not(.dragging)")];

            return elements.reduce((closest, child) => {
                const box = child.getBoundingClientRect();
                const offset = y - box.top - box.height / 2;

                return offset < 0 && offset > closest.offset ?
                    {
                        offset,
                        element: child
                    } :
                    closest;

            }, {
                offset: Number.NEGATIVE_INFINITY,
                element: null
            }).element;
        }

        // fill hidden input with sorted ids before submitting
        form.addEventListener("submit", e => {
            const ids = [...document.querySelectorAll(".drag-item")].map(item => item.dataset.id);
            priorityField.value = ids.join(",");
        });
    </script>
{% endblock js %}
