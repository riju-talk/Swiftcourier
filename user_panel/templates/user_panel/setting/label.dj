{% block js %}

    <script>
        // Utility to toggle visibility

        function togglePickupAddress(checkboxId, pickupId, returnContainerId) {
            const checkbox = document.getElementById(checkboxId);
            const pickup = document.getElementById(pickupId);
            const returnContainer = document.getElementById(returnContainerId);

            function updateVisibility() {
                const isHidden = checkbox.checked;
                pickup.style.display = isHidden ? 'none' : '';
                returnContainer.classList.toggle('md:w-full', isHidden);
                returnContainer.classList.toggle('md:w-1/2', !isHidden);
            }

            checkbox.addEventListener('change', updateVisibility);
            updateVisibility(); // Initialize on load
        }






        function toggleVisibility(controlId, targetId) {
            const ctl = document.getElementById(controlId);
            const tgt = document.getElementById(targetId);
            if (!ctl || !tgt) return;
            // on change, hide when checked, show when unchecked
            ctl.addEventListener('change', () => {
                tgt.style.display = ctl.checked ? 'none' : '';
            });
            // initialize on load
            tgt.style.display = ctl.checked ? 'none' : '';
        }

        function toggleVisibilityClasses(controlId, targetClass) {
            const ctl = document.getElementById(controlId);
            if (!ctl) return;

            // Handler to show/hide all elements with the given class
            const updateVisibility = () => {
                document.querySelectorAll(`.${targetClass}`).forEach(el => {
                    el.style.display = ctl.checked ? 'none' : '';
                });
            };

            // Wire up on-change behavior
            ctl.addEventListener('change', updateVisibility);

            // Initialize on load
            updateVisibility();
        }
        toggleVisibilityClasses('hideProduct', 'product_hide');
        toggleVisibilityClasses('hidePoweredBy', 'powered_by_hide');
        toggleVisibilityClasses('hideTotalAmount', 'hide_total_amount');
        toggleVisibilityClasses('hidePicupReturnAddress', 'hide_picup_return_address');
        toggleVisibilityClasses('hideSupportInfo', 'hide_support_info');


        // 1. Support dropdown
        // toggleVisibility('hideEmail', 'email_hide');
        toggleVisibility('hideMobileNo', 'mobile_number_hide');

        // 2. Stand-alone
        toggleVisibility('hideCustomerMobile', 'customer_mobile_number_hide');
        toggleVisibility('hidePickupAddress', 'pikcup_address_hide'); // note the given ID
        toggleVisibility('hideProduct', 'product_hide');

        // 3. Total Amount dropdown
        toggleVisibility('hideWeight', 'weight_hide');
        toggleVisibility('hideDimension', 'dimension_hide');
    </script>

    <!-- JavaScript -->
    <script>
        const showLogoCheckbox = document.getElementById('showLogoCheckbox');
        const logoUploadWrapper = document.getElementById('logoUploadWrapper');
        const logoUploader = document.getElementById('logoUploader');
        const companyLogoDiv = document.getElementById('company_logo');

        // Show/hide upload input
        showLogoCheckbox.addEventListener('change', function() {
            logoUploadWrapper.classList.toggle('hidden', !this.checked);
        });

        // Change logo preview on upload
        logoUploader.addEventListener('change', function(event) {
            const file = event.target.files[0];
            if (!file || !file.type.startsWith('image/')) {
                alert("Please upload a valid image file.");
                return;
            }

            const reader = new FileReader();
            reader.onload = function(e) {
                companyLogoDiv.innerHTML = `<img src="${e.target.result}" alt="Uploaded Logo" class="h-12 w-48 object-contain mx-auto rounded-sm shadow-md">`;
            };
            reader.readAsDataURL(file);
        });




        // Add this JavaScript to handle the new functionality
        document.addEventListener('DOMContentLoaded', function() {
            const showSupportCheckbox = document.getElementById('showSupportInfo');
            const supportFields = document.getElementById('supportInfoFields');
            const supportEmailInput = document.getElementById('supportEmail');
            const supportMobileInput = document.getElementById('supportMobile');
            const supportPreview = document.querySelector('.hide_support_info p');

            // Toggle support info visibility and fields
            function updateSupportInfo() {
                const isChecked = showSupportCheckbox.checked;

                // Toggle fields visibility
                supportFields.classList.toggle('hidden', !isChecked);

                // Toggle preview visibility
                document.querySelectorAll('.hide_support_info').forEach(el => {
                    el.style.display = isChecked ? 'block' : 'none';
                });

                // Update preview content
                const email = supportEmailInput.value || 'support@idiotship.com';
                const mobile = supportMobileInput.value || '6576576765';
                supportPreview.textContent = `For queries: Mob ${mobile} | Email: ${email}`;
            }

            // Event listeners
            showSupportCheckbox.addEventListener('change', updateSupportInfo);
            supportEmailInput.addEventListener('input', updateSupportInfo);
            supportMobileInput.addEventListener('input', updateSupportInfo);

            // Initial state check
            updateSupportInfo();
        });
    </script>

{% endblock js %}
