                        lastText: '<svg …>…</svg>',
                        prevText: '<svg …>…</svg>',
                        nextText: '<svg …>…</svg>',
                        labels: {
                            perPage: "{select}"
                        },
                        layout: {
                            top: "{search}",
                            bottom: "{info}{select}{pager}"
