                            width: 2
                        },
                        markers: {
                            size: [4, 7],
                            strokeWidth: 0
                        },
                        colors: [this.randomColor()],
                        grid: {
                            padding: {
                                top: 5,
                                bottom: 5
                            }
                        },
                        tooltip: {
                            x: {
                                show: false
                            },
                            y: {
                                title: {
                                    formatter: () => ''
                                }
                            }
                        }
                    };
                },

                randomColor() {
                    const c = ['#4361ee', '#805dca', '#00ab55', '#e7515a', '#e2a03f', '#2196f3'];
                    return c[Math.floor(Math.random() * c.length)];
                },

                // (you can remove unused methods below if you like)
                randomStatusColor() {
                    /* … */
                },
                randomStatus() {
                    /* … */
                },
                getRandomNumber() {
                    /* … */
                },
                getCountry() {
                    /* … */
                }
            }));

            // credits tab
            Alpine.data("rechargesbasic", () => ({
                datatable: null,

                init() {
                    this.datatable = new simpleDatatables.DataTable('#recharges', {
                        data: {
                            headings: [
                                // “select all” checkbox in header
                                `<input type="checkbox" @click="toggleAll($event)" />`,
                                "CHANNEL",
                                "ORDER ID",
                                "DATE",
                                "CUSTOMER",
                            ],
                            data: [
                                // two demo rows only
                                [
                                    '', // checkbox cell (rendered via columns.render)
                                    'Email', // CHANNEL
                                    'ORD-00123', // ORDER ID
                                    '2025-04-15', // DATE
                                    'John Doe', // CUSTOMER
                                ],
                                [
                                    '',
                                    'Social',
                                    'ORD-00124',
                                    '2025-04-16',
                                    'Jane Smith',
                                ]
                            ]
                        },
                        searchable: true,
                        perPage: 10,
                        perPageSelect: [10, 20, 30, 50, 100],
                        columns: [{
                                select: 0,
