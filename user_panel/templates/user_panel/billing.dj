                datatable: null,

                init() {
                    this.datatable = new simpleDatatables.DataTable('#invoice', {
                        data: {
                            headings: [
                                `<input type="checkbox" @click="toggleAll($event)" />`,
                                "INVOICE NO",
                                "INVOICE STATE",
                                "INVOICE DATE",
                                "INVOICE PERIOD",
                                "INVOICE AMOUNT",
                                "DOWNLOAD"
                            ],
                            data: [
                                [
                                    '', // checkbox cell
                                    'INV-0001', // INVOICE NO
                                    'Generated', // INVOICE STATE
                                    '2025-04-01', // INVOICE DATE
                                    'Mar 2025', // INVOICE PERIOD
                                    '$500.00', // INVOICE AMOUNT
                                    `<a href="#" class="text-blue-500">Download</a>` // DOWNLOAD
                                ],
                                [
                                    '',
                                    'INV-0002',
                                    'Pending',
                                    '2025-04-05',
                                    'Mar 2025',
                                    '$720.00',
                                    `<a href="#" class="text-blue-500">Download</a>`
                                ],
                                [
                                    '',
                                    'INV-0003',
                                    'Generated',
                                    '2025-04-10',
                                    'Apr 2025',
                                    '$310.00',
                                    `<a href="#" class="text-blue-500">Download</a>`
                                ],
                                [
                                    '',
                                    'INV-0004',
                                    'Generated',
                                    '2025-04-15',
                                    'Apr 2025',
                                    '$1,050.00',
                                    `<a href="#" class="text-blue-500">Download</a>`
                                ]
                            ]
                        },

                        searchable: true,
                        perPage: 10,
