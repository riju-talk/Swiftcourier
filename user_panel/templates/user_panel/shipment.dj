{% extends "components/layouts/layout.dj" %}

{% load static %}

{% block title %}
    {{ status_display }}
{% endblock title %}


{% block css %}
    <style>
        [x-cloak] {
            display: none !important;
        }

        .date-transition {
            transition: all 0.2s ease-in-out;
        }
    </style>

    <style>
        /* Scrollbar Styling */
        ::-webkit-scrollbar {
            width: 8px;
            height: 8px;
        }

        ::-webkit-scrollbar-track {
            @apply bg-gray-100 dark:bg-gray-700;
        }

        ::-webkit-scrollbar-thumb {
            @apply bg-gray-300 dark:bg-gray-600 rounded-full;
        }

        ::-webkit-scrollbar-thumb:hover {
            @apply bg-gray-400 dark:bg-gray-500;
        }
    </style>

{% endblock css %}


{% block body %}

    {% include "user_panel/components/common/shipment_navbar.dj" %}


    <div class="max-w-7xl mx-auto bg-white dark:bg-gray-800 rounded-lg shadow-sm">
        <!-- Header Section -->
        <div class="flex flex-col sm:flex-row items-center justify-between p-4 sm:p-6 border-b dark:border-gray-700 gap-4">
            <!-- Left: Title + Search -->
            <div class="flex items-center gap-4 w-full sm:w-auto">
                <h2 class="text-xl font-semibold text-gray-800 dark:text-gray-100 whitespace-nowrap">{{ status_display }}</h2>
                <input type="text"
                       id="searchInput"
                       name="q"
                       placeholder="Search Order"
                       value="{{ request.GET.q }}"
                       onenter="handleSearch(this.value)"
                       class="w-48 px-3 py-1.5 border rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-700 dark:border-gray-600 dark:text-gray-100 dark:placeholder-gray-400">
            </div>

            <!-- Right: Buttons -->
            <div class="flex items-center gap-2 w-full sm:w-auto justify-end">
                <div id="actionButtons" class="hidden">
                    <button onclick="openModal()"
                            class="px-3 py-2 bg-green-600 hover:bg-green-700 rounded-lg text-white text-sm">
                        Ship
                    </button>
                </div>
                <button id="filterToggleBtn"
                        class="flex items-center space-x-2 px-4 py-2 rounded-2xl bg-indigo-50 hover:bg-indigo-100 shadow-sm"
                        title="Filter Orders">
                    <!-- Original filter icon -->
                    <svg class="w-5 h-5 text-indigo-600"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2"
                         viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2a1 1 0 01-.293.707L15 13.414V19a1 1 0 01-1.447.894l-4-2A1 1 0 019 17v-3.586L3.293 6.707A1 1 0 013 6V4z" />
                    </svg>
                    <span id="filterToggleText" class="text-indigo-600 font-semibold">Filter</span>
                </button>
                <button class="px-3 py-2 bg-blue-600 hover:bg-blue-700 rounded-lg text-white text-sm" id="exportOrderButton">Export</button>
            </div>
        </div>





        <form id="filterForm" action="#" method="get">
            <div id="filterSection"
                 class="hidden mb-6 bg-white dark:bg-gray-800 rounded-2xl shadow-lg border border-gray-200 dark:border-gray-700 p-6">

                <div class="flex items-end space-x-4">
                    <div x-data="dateRangePicker()" class="relative w-65 flex-1">
                        <label for="myfilter-date-range"
                               class="block text-sm font-medium text-gray-700 dark:text-gray-200 mb-2">
                            Date Range
                        </label>
                        <!-- Input Box -->
                        <input type="text"
                               class="w-full px-4 py-2 border rounded cursor-pointer bg-white dark:bg-gray-800 border-gray-300 dark:border-gray-600 text-gray-900 dark:text-gray-100 placeholder-gray-400 dark:placeholder-gray-500 max-w-xs mb-4"
                               readonly
                               name="date_range"
                               id="myfilter-date-range"
                               x-model="displayDateRange"
                               @click="showDropdown = true"
                               placeholder="Select Date Range">

                        <!-- Dropdown -->
                        <div class="absolute z-50 w-[700px] bg-white dark:bg-gray-800 border dark:border-gray-700 rounded-lg shadow-lg mt-1 transition-all duration-200 ease-out origin-top"
                             x-show="showDropdown"
                             x-transition:enter="transition ease-out duration-200"
                             x-transition:enter-start="opacity-0 scale-95"
                             x-transition:enter-end="opacity-100 scale-100"
                             x-transition:leave="transition ease-in duration-150"
                             x-transition:leave-start="opacity-100 scale-100"
                             x-transition:leave-end="opacity-0 scale-95"
                             @click.outside="showDropdown = false"
                             x-cloak>
                            <div class="flex">
                                <!-- Presets -->
                                <div class="w-48 p-4 border-r dark:border-gray-700">
                                    <h3 class="mb-2 font-semibold dark:text-gray-200">Presets</h3>
                                    <template x-for="preset in presets">
                                        <button @click="setPreset(preset)"
                                                class="w-full text-left px-2 py-1 text-sm hover:bg-gray-100 dark:hover:bg-gray-700 rounded date-transition"
                                                :class="{ 'bg-blue-100 dark:bg-blue-900/50': preset.active, 'font-semibold text-blue-600 dark:text-blue-400': preset.label === 'Custom Range' && isCustomRange, 'text-gray-700 dark:text-gray-300': !preset.active }">
                                            <span x-text="preset.label"></span>
                                        </button>
                                    </template>
                                </div>

                                <!-- Calendars -->
                                <div class="flex-1 p-4">
                                    <div class="flex gap-8">
                                        <!-- Start Date Calendar -->
                                        <div class="flex-1">
                                            <div class="flex items-center justify-between mb-2">
                                                <button @click="prevMonth('start')"
                                                        class="p-1 hover:bg-gray-100 dark:hover:bg-gray-700 rounded-full date-transition text-gray-700 dark:text-gray-300">
                                                    <svg xmlns="http://www.w3.org/2000/svg"
                                                         class="h-5 w-5"
                                                         viewBox="0 0 20 20"
                                                         fill="currentColor">
                                                        <path fill-rule="evenodd" d="M12.707 5.293a1 1 0 010 1.414L9.414 10l3.293 3.293a1 1 0 01-1.414 1.414l-4-4a1 1 0 010-1.414l4-4a1 1 0 011.414 0z" clip-rule="evenodd" />
                                                    </svg>
                                                </button>
                                                <h3 class="font-semibold text-center dark:text-gray-200"
                                                    x-text="startCalendar.monthYear"></h3>
                                                <button @click="nextMonth('start')"
                                                        class="p-1 hover:bg-gray-100 dark:hover:bg-gray-700 rounded-full date-transition text-gray-700 dark:text-gray-300">
                                                    <svg xmlns="http://www.w3.org/2000/svg"
                                                         class="h-5 w-5"
                                                         viewBox="0 0 20 20"
                                                         fill="currentColor">
                                                        <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd" />
                                                    </svg>
                                                </button>
                                            </div>
                                            <div class="grid grid-cols-7 gap-1 text-sm">
                                                <template x-for="day in startCalendar.days" :key="day">
                                                    <div class="text-center text-gray-500 dark:text-gray-400" x-text="day"></div>
                                                </template>
                                                <template x-for="date in startCalendar.dates">
                                                    <button @click="setTempStart(date.date)"
                                                            class="p-1 text-center rounded date-transition relative"
                                                            :class="{ 'bg-blue-500 text-white': date.isSelectedStart, 'text-gray-400 dark:text-gray-500': !date.isCurrentMonth, 'hover:bg-gray-100 dark:hover:bg-gray-700': date.isSelectable, 'opacity-50 cursor-not-allowed': !date.isSelectable, 'bg-blue-100 dark:bg-blue-900/30': date.isInRange && !date.isSelectedStart && !date.isSelectedEnd, 'rounded-l-full': date.isSelectedStart || (date.isInRange && date.isFirstDayOfMonth), 'rounded-r-full': date.isSelectedEnd || (date.isInRange && date.isLastDayOfMonth), 'text-gray-900 dark:text-gray-100': date.isCurrentMonth && !date.isSelectedStart && !date.isSelectedEnd }"
                                                            :disabled="!date.isSelectable">
                                                        <span x-text="date.day"></span>
                                                    </button>
                                                </template>
                                            </div>
                                        </div>

                                        <!-- End Date Calendar -->
                                        <div class="flex-1">
                                            <div class="flex items-center justify-between mb-2">
                                                <button @click="prevMonth('end')"
                                                        class="p-1 hover:bg-gray-100 dark:hover:bg-gray-700 rounded-full date-transition text-gray-700 dark:text-gray-300">
                                                    <svg xmlns="http://www.w3.org/2000/svg"
                                                         class="h-5 w-5"
                                                         viewBox="0 0 20 20"
                                                         fill="currentColor">
                                                        <path fill-rule="evenodd" d="M12.707 5.293a1 1 0 010 1.414L9.414 10l3.293 3.293a1 1 0 01-1.414 1.414l-4-4a1 1 0 010-1.414l4-4a1 1 0 011.414 0z" clip-rule="evenodd" />
                                                    </svg>
                                                </button>
                                                <h3 class="font-semibold text-center dark:text-gray-200"
                                                    x-text="endCalendar.monthYear"></h3>
                                                <button @click="nextMonth('end')"
                                                        class="p-1 hover:bg-gray-100 dark:hover:bg-gray-700 rounded-full date-transition text-gray-700 dark:text-gray-300">
                                                    <svg xmlns="http://www.w3.org/2000/svg"
                                                         class="h-5 w-5"
                                                         viewBox="0 0 20 20"
                                                         fill="currentColor">
                                                        <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd" />
                                                    </svg>
                                                </button>
                                            </div>
                                            <div class="grid grid-cols-7 gap-1 text-sm">
                                                <template x-for="day in endCalendar.days" :key="day">
                                                    <div class="text-center text-gray-500 dark:text-gray-400" x-text="day"></div>
                                                </template>
                                                <template x-for="date in endCalendar.dates">
                                                    <button @click="setTempEnd(date.date)"
                                                            class="p-1 text-center rounded date-transition relative"
                                                            :class="{ 'bg-blue-500 text-white': date.isSelectedEnd, 'text-gray-400 dark:text-gray-500': !date.isCurrentMonth, 'hover:bg-gray-100 dark:hover:bg-gray-700': date.isSelectable, 'opacity-50 cursor-not-allowed': !date.isSelectable, 'bg-blue-100 dark:bg-blue-900/30': date.isInRange && !date.isSelectedStart && !date.isSelectedEnd, 'rounded-l-full': date.isSelectedStart || (date.isInRange && date.isFirstDayOfMonth), 'rounded-r-full': date.isSelectedEnd || (date.isInRange && date.isLastDayOfMonth), 'text-gray-900 dark:text-gray-100': date.isCurrentMonth && !date.isSelectedStart && !date.isSelectedEnd }"
                                                            :disabled="!date.isSelectable">
                                                        <span x-text="date.day"></span>
                                                    </button>
                                                </template>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Action Buttons -->
                                    <div class="flex justify-end gap-2 mt-4">
                                        <button @click="cancel()"
                                                class="px-4 py-2 text-sm text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700 rounded date-transition">
                                            Cancel
                                        </button>
                                        <button @click="apply()"
                                                class="px-4 py-2 text-sm text-white bg-blue-500 hover:bg-blue-600 rounded date-transition"
                                                :disabled="!tempStart || !tempEnd"
                                                :class="{ 'opacity-50 cursor-not-allowed': !tempStart || !tempEnd }">
                                            Apply
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="flex-1 mb-4">
                        <div>
                            <label for="filter-order-id"
                                   class="block text-sm font-medium text-gray-700 dark:text-gray-200 mb-2">
                                Order ID
                            </label>
                            <input type="text"
                                   name="order_id"
                                   value="{{ request.GET.order_id }}"
                                   id="filter-order-id"
                                   placeholder="ORD-00123"
                                   class="w-full px-3 py-2 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 text-gray-800 dark:text-gray-100 focus:outline-none focus:ring-2 focus:ring-indigo-200 dark:focus:ring-indigo-500" />
                        </div>
                    </div>
                    <div class="flex-1 mb-4">
                        <div>
                            <label for="awb-number"
                                   class="block text-sm font-medium text-gray-700 dark:text-gray-200 mb-2">
                                AWB No.
                            </label>
                            <input type="text"
                                   name="awb_number"
                                   value="{{ request.GET.awb_number }}"
                                   id="awb-number"
                                   placeholder="456546"
                                   class="w-full px-3 py-2 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 text-gray-800 dark:text-gray-100 focus:outline-none focus:ring-2 focus:ring-indigo-200 dark:focus:ring-indigo-500" />
                        </div>
                    </div>
                </div>
                <!-- End Date Range -->



                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
                    <!-- Order Type -->
                    <div>
                        <label for="filter-order-type"
                               class="block text-sm font-medium text-gray-700 dark:text-gray-200 mb-2">
                            Order Type
                        </label>
                        <select name="order_type"
                                id="filter-order-type"
                                class="w-full px-3 py-2 rounded-lg border border-gray-300 dark:border-gray-600 focus:outline-none focus:ring-2 focus:ring-indigo-200 dark:focus:ring-indigo-500 bg-white dark:bg-gray-700 text-gray-800 dark:text-gray-100">
                            <option value="">Select Order Type</option>
                            <option value="prepaid">Prepaid</option>
                            <option value="cod">COD</option>
                        </select>
                    </div>

                    <!-- Warehouse -->
                    <div>
                        <label for="filter-warehouse"
                               class="block text-sm font-medium text-gray-700 dark:text-gray-200 mb-2">
                            Warehouse
                        </label>
                        <select name="warehouse"
                                id="filter-warehouse"
                                class="w-full px-3 py-2 rounded-lg border border-gray-300 dark:border-gray-600 focus:outline-none focus:ring-2 focus:ring-indigo-200 dark:focus:ring-indigo-500 bg-white dark:bg-gray-700 text-gray-800 dark:text-gray-100">
                            <option value="">Select Warehouse</option>
                            {% for hub in request.user.hubs.all %}<option value="{{ hub.id }}">{{ hub.name }}</option>{% endfor %}
                        </select>
                    </div>

                    <!-- Courier Partner -->
                    <div>
                        <label for="filter-courier-partners"
                               class="block text-sm font-medium text-gray-700 dark:text-gray-200 mb-2">Channel</label>
                        <select name="courier_partners"
                                id="filter-courier-partners"
                                class="w-full px-3 py-2 rounded-lg border border-gray-300 dark:border-gray-600 focus:outline-none focus:ring-2 focus:ring-indigo-200 dark:focus:ring-indigo-500 bg-white dark:bg-gray-700 text-gray-800 dark:text-gray-100">
                            <option value="">Select Channel</option>
                            <option value="Custom">Custom</option>
                            <option value="Amazon">Amazon</option>
                        </select>
                    </div>

                    <!-- Product Name -->
                    <div>
                        <label for="filter-product-name"
                               class="block text-sm font-medium text-gray-700 dark:text-gray-200 mb-2">
                            Product Name
                        </label>
                        <input type="text"
                               name="product_name"
                               value="{{ request.GET.product_name }}"
                               id="filter-product-name"
                               placeholder="T-Shirt"
                               class="w-full px-3 py-2 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 text-gray-800 dark:text-gray-100 focus:outline-none focus:ring-2 focus:ring-indigo-200 dark:focus:ring-indigo-500" />
                    </div>
                </div>
                <!-- Submit & Cancel Buttons -->
                <div class="mt-6 flex justify-end space-x-3">
                    <button type="button"
                            id="filterCancelBtn"
                            class="px-5 py-2 rounded-lg bg-red-50 hover:bg-red-100 text-red-600 transition-colors duration-200 ease-in-out focus:outline-none focus:ring-2 focus:ring-red-200">
                        Reset
                    </button>
                    <button type="submit"
                            id="filterSubmitBtn"
                            class="px-5 py-2 rounded-lg bg-green-600 hover:bg-green-700 text-white transform hover:scale-105 transition-transform duration-200 ease-out focus:outline-none focus:ring-2 focus:ring-green-300">
                        Apply Filters
                    </button>
                </div>
            </div>
        </form>





        <!-- Table -->
        <div class="overflow-x-auto">
            <table class="w-full">
                <thead class="bg-gray-50 dark:bg-gray-700">
                    <tr>
                        <th class="px-4 py-3">
                            <input type="checkbox"
                                   id="selectAll"
                                   class="rounded border-gray-300 dark:bg-gray-600 dark:border-gray-500">
                        </th>
                        <th class="px-4 py-3 text-left text-sm font-medium text-gray-600 dark:text-gray-300">CHANNEL</th>
                        <th class="px-4 py-3 text-left text-sm font-medium text-gray-600 dark:text-gray-300">ORDER ID</th>
                        <th class="px-4 py-3 text-left text-sm font-medium text-gray-600 dark:text-gray-300">DATE</th>
                        <th class="px-4 py-3 text-left text-sm font-medium text-gray-600 dark:text-gray-300">CUSTOMER</th>
                        <th class="px-4 py-3 text-left text-sm font-medium text-gray-600 dark:text-gray-300">PRODUCTS</th>
                        <th class="px-4 py-3 text-left text-sm font-medium text-gray-600 dark:text-gray-300">QTY</th>
                        <th class="px-4 py-3 text-left text-sm font-medium text-gray-600 dark:text-gray-300">AMT</th>
                        <th class="px-4 py-3 text-left text-sm font-medium text-gray-600 dark:text-gray-300">TYPE</th>
                        <th class="px-4 py-3 text-left text-sm font-medium text-gray-600 dark:text-gray-300">STATUS</th>
                        <th class="px-4 py-3 text-left text-sm font-medium text-gray-600 dark:text-gray-300">ACTION</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-200 dark:divide-gray-700">
                    <!-- Sample Data -->
                    {% for order in page_obj %}
                        <tr class="hover:bg-gray-50 dark:hover:bg-gray-700">
                            <td class="px-4 py-3">
                                <input type="checkbox"
                                       value="{{ order.id }}"
                                       class="ship-order-ids row-checkbox rounded border-gray-300 dark:bg-gray-600">
                            </td>
                            <td class="px-4 py-3 text-sm text-gray-700 dark:text-gray-300">{{ order.get_channel_display }}</td>
                            <td class="px-4 py-3 text-sm font-medium text-gray-900 dark:text-gray-100">{{ order.order_number }}</td>
                            <td class="px-4 py-3 text-sm text-gray-700 dark:text-gray-300">{{ order.created_at }}</td>
                            <td class="px-4 py-3 text-sm text-gray-700 dark:text-gray-300">{{ order.shipping_address.name }}</td>
                            <td class="px-4 py-3 text-sm text-gray-700 dark:text-gray-300">{{ order.items.first.product.name }}</td>
                            <td class="px-4 py-3 text-sm text-gray-700 dark:text-gray-300">{{ order.items.first.quantity}}</td>
                            <td class="px-4 py-3 text-sm text-gray-700 dark:text-gray-300">{{ order.total_amount }}</td>
                            <td class="px-4 py-3 text-sm text-gray-700 dark:text-gray-300">Standard</td>
                            <td class="px-4 py-3">
                                <span class="px-2 py-1 text-xs font-medium rounded-full bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-200">{{ order.get_status_display }}</span>
                            </td>
                            <td class="px-4 py-3">
                                <div class="relative">
                                    <button class="action-btn p-1 hover:bg-gray-100 dark:hover:bg-gray-600 rounded-lg">⋮</button>
                                    <div class="action-menu hidden absolute right-0 mt-1 w-32 bg-white dark:bg-gray-800 border dark:border-gray-700 rounded-lg shadow-lg py-1 z-50">
                                        <a href="#"
                                           class="block px-3 py-2 text-sm hover:bg-gray-100 dark:hover:bg-gray-700 dark:text-gray-100">Clone</a>
                                        <a href="#"
                                           class="block px-3 py-2 text-sm hover:bg-gray-100 dark:hover:bg-gray-700 dark:text-gray-100">Edit</a>
                                        <a href="#"
                                           class="block px-3 py-2 text-sm hover:bg-gray-100 dark:hover:bg-gray-700 dark:text-gray-100">Re-Ship</a>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    {% empty %}
                        <tr>
                            <td colspan="11"
                                class="text-center py-4 text-gray-500 dark:text-gray-400">
                                <div class="flex justify-center items-center h-full">
                                    <svg class="w-5 h-5 mr-2"
                                         fill="none"
                                         stroke="currentColor"
                                         viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z">
                                        </path>
                                    </svg>
                                    No data found
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        <!-- Pagination -->
        <div class="p-4 border-t dark:border-gray-700">
            <div class="flex flex-col sm:flex-row justify-between items-center gap-4">
                <div class="flex items-center gap-4">
                    <span class="text-sm text-gray-700 dark:text-gray-300">Show:</span>
                    <select id="pageSize"
                            onchange="updatePageSize(this.value)"
                            class="px-2 py-1 border rounded text-sm dark:bg-gray-700 dark:border-gray-600 dark:text-gray-100">
                        <option value="10" {% if page_size == 10 %}selected{% endif %}>10</option>
                        <option value="50" {% if page_size == 50 %}selected{% endif %}>50</option>
                        <option value="100" {% if page_size == 100 %}selected{% endif %}>100</option>
                        <option value="200" {% if page_size == 200 %}selected{% endif %}>200</option>
                        <option value="500" {% if page_size == 500 %}selected{% endif %}>500</option>
                    </select>
                </div>

                <div class="flex gap-1">
                    <button onclick="navigatePage('prev')"
                            class="px-3 py-1 bg-gray-100 hover:bg-gray-200 dark:bg-gray-700 dark:hover:bg-gray-600 rounded text-sm dark:text-gray-100"
                            {% if not page_obj.has_previous %}disabled{% endif %}>Previous</button>

                    {% for num in page_obj.paginator.page_range %}
                        <button onclick="navigatePage({{ num }})"
                                class="px-3 py-1
                                       {% if num == page_obj.number %}
                                           bg-blue-100 text-blue-600
                                       {% else %}
                                           bg-gray-100 hover:bg-gray-200 dark:bg-gray-700 dark:hover:bg-gray-600
                                       {% endif %}
                                       rounded text-sm dark:text-gray-100">{{ num }}</button>
                    {% endfor %}

                    <button onclick="navigatePage('next')"
                            class="px-3 py-1 bg-gray-100 hover:bg-gray-200 dark:bg-gray-700 dark:hover:bg-gray-600 rounded text-sm dark:text-gray-100"
                            {% if not page_obj.has_next %}disabled{% endif %}>Next</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal -->
    <div id="shipModal"
         class="fixed inset-0 bg-black bg-opacity-50 hidden items-center justify-center z-50">
        <div class="bg-white dark:bg-gray-800 rounded-lg shadow-lg w-96 p-6 mx-4 transform -translate-y-1/2 -translate-x-1/2 top-1/2 left-1/2 fixed">
            <h2 class="text-lg font-bold mb-4 dark:text-gray-100">Ship Selected Orders</h2>
            <form id="shipForm"
                  action="{% url 'order_manager:ship-order' %}"
                  method="post">
                {% csrf_token %}
                <input type="hidden" name="order_ids" value="">
                <label class="block mb-2 text-sm text-gray-700 dark:text-gray-300">Courier Partner</label>
                <select name="courier"
                        class="w-full mb-4 px-3 py-2 border rounded-lg dark:bg-gray-700 dark:border-gray-600 dark:text-gray-100">
                    <option disabled>Select Courier</option>
                    <option>Xpressbees</option>
                    <option>Delhivery</option>
                    <option>Bluedart</option>
                </select>
                <div class="flex justify-end gap-2">
                    <button type="button"
                            onclick="closeModal()"
                            class="px-4 py-2 bg-gray-200 hover:bg-gray-300 dark:bg-gray-700 dark:hover:bg-gray-600 rounded dark:text-gray-100">
                        Cancel
                    </button>
                    <button type="submit"
                            onclick="shipSelectedOrders()"
                            class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded">Submit</button>
                </div>
            </form>
        </div>
    </div>



{% endblock body %}



{% block js %}
    <script defer src="{% static 'assets/js/apexcharts.js' %}"></script>
    <script src="{% static 'assets/js/simple-datatables.js' %}"></script>


    <script>
        // Action Menu Handling
        document.querySelectorAll('.action-btn').forEach(button => {
            button.addEventListener('click', (e) => {
                e.stopPropagation();
                const menu = button.nextElementSibling;
                const isOpen = !menu.classList.contains('hidden');

                // Close all other menus
                document.querySelectorAll('.action-menu').forEach(m => m.classList.add('hidden'));

                // Toggle current menu
                menu.classList.toggle('hidden', isOpen);
            });
        });

        // Close menus when clicking outside
        document.addEventListener('click', (e) => {
            if (!e.target.closest('.action-btn')) {
                document.querySelectorAll('.action-menu').forEach(menu => {
                    menu.classList.add('hidden');
                });
            }
        });

        // Checkbox Handling
        function updateActionButtons() {
            const checkedCount = document.querySelectorAll('.row-checkbox:checked').length;
            document.getElementById('actionButtons').classList.toggle('hidden', checkedCount === 0);
        }

        document.getElementById('selectAll').addEventListener('change', (e) => {
            document.querySelectorAll('.row-checkbox').forEach(checkbox => {
                checkbox.checked = e.target.checked;
            });
            updateActionButtons();
        });

        document.querySelectorAll('.row-checkbox').forEach(checkbox => {
            checkbox.addEventListener('change', updateActionButtons);
        });

        // Modal Handling
        function openModal() {
            document.getElementById('shipModal').classList.remove('hidden');
        }

        function closeModal() {
            document.getElementById('shipModal').classList.add('hidden');
        }

        // Pagination Handling
        function getCurrentParams() {
            const params = new URLSearchParams(window.location.search);
            return {
                page: parseInt(params.get('page')) || 1,
                size: parseInt(params.get('page_size')) || 10
            };
        }

        // Initialize page size from URL
        window.addEventListener('load', () => {
            const params = getCurrentParams();
            document.getElementById('pageSize').value = params.size;
        });

        function navigatePage(action) {
            const urlParams = new URLSearchParams(window.location.search);
            const currentSearch = document.getElementById('searchInput').value;
            let page = parseInt(urlParams.get('page') || 1);

            if (action === 'prev') {
                page = Math.max(1, page - 1);
            } else if (action === 'next') {
                page = page + 1;
            } else {
                page = parseInt(action);
            }

            if (currentSearch) {
                urlParams.set('q', currentSearch);
            }

            urlParams.set('page', page);
            window.location.search = urlParams.toString();
        }

        function updatePageSize(size) {
            const urlParams = new URLSearchParams(window.location.search);
            const currentSearch = document.getElementById('searchInput').value;

            urlParams.set('page_size', size);
            urlParams.set('page', 1); // Reset to first page

            if (currentSearch) {
                urlParams.set('q', currentSearch);
            }
            window.location.search = urlParams.toString();
        }

        // Add debounce to prevent too many requests
        function handleSearch(value) {
            updateSearchParams(value);
        }

        function updateSearchParams(searchTerm) {
            const urlParams = new URLSearchParams(window.location.search);

            if (searchTerm.trim()) {
                urlParams.set('q', searchTerm);
            } else {
                urlParams.delete('q');
            }

            // Reset to first page when searching
            urlParams.set('page', 1);
            window.location.search = urlParams.toString();
        }

        document.getElementById('searchInput').addEventListener('keydown', (e) => {
            if (e.key === 'Enter') {
                updateSearchParams(e.target.value);
            }
        });

        const shipSelectedOrders = () => {
            // Get all checked checkboxes with class 'ship-order-ids'
            const selectedCheckboxes = document.querySelectorAll('.ship-order-ids:checked');

            // Extract values (order IDs) from the checked checkboxes
            const orderIds = Array.from(selectedCheckboxes).map(checkbox => checkbox.value);

            // Find the hidden input inside the form
            const hiddenInput = document.querySelector('#shipForm input[name="order_ids"]');

            // Set the value of the hidden input to comma-separated order IDs
            hiddenInput.value = orderIds.join(',');

            // Submit the form programmatically
            document.getElementById('shipForm').submit();
        };
    </script>

    <script>
        document.addEventListener("DOMContentLoaded", function() {
            const filterToggleBtn = document.getElementById("filterToggleBtn");
            const filterSection = document.getElementById("filterSection");
            // const filterDateRange = document.getElementById("filter-date-range");
            // const customDateInputs = document.getElementById("customDateInputs");
            const filterCancelBtn = document.getElementById("filterCancelBtn");
            const filterForm = document.getElementById("filterForm");

            // Toggle filter section
            filterToggleBtn.addEventListener("click", () => {
                filterSection.classList.toggle("hidden");
            });

            // Show/hide custom date inputs
            /* filterDateRange.addEventListener("change", (e) => {
                if (e.target.value === 'custom') {
                    customDateInputs.classList.remove('hidden');
                } else {
                    customDateInputs.classList.add('hidden');
                }
            }); */

            // Cancel: clear all fields
            filterCancelBtn.addEventListener("click", () => {
                filterForm.reset();
                customDateInputs.classList.add('hidden');
            });

            // Submit: default form GET submission to action endpoint
        });
    </script>


    <script>
        document.addEventListener("alpine:init", () => {
            Alpine.data('dateRangePicker', () => ({
                DateTime: luxon.DateTime,
                startDate: null,
                endDate: null,
                tempStart: null,
                tempEnd: null,
                showDropdown: false,
                startMonth: luxon.DateTime.local(),
                endMonth: luxon.DateTime.local().plus({
                    months: 1
                }),

                presets: [{
                    label: 'Today',
                    days: 0
                }, {
                    label: 'Yesterday',
                    days: -1
                }, {
                    label: 'Last 7 Days',
                    days: -6
                }, {
                    label: 'Last 30 Days',
                    days: -29
                }, {
                    label: 'This Month',
                    month: 'current'
                }, {
                    label: 'Last Month',
                    month: 'previous'
                }, {
                    label: 'Custom Range',
                    type: 'custom'
                }],

                get isCustomRange() {
                    return !this.presets.find(p => p.active)
                },

                init() {
                    this.setPreset(this.presets[0])
                },

                get displayDateRange() {
                    if (!this.startDate || !this.endDate) return ''
                    return `${this.startDate.toFormat('MMM dd, yyyy')} - ${this.endDate.toFormat('MMM dd, yyyy')}`
                },

                get startCalendar() {
                    return this.generateCalendar(this.startMonth, 'start')
                },

                get endCalendar() {
                    return this.generateCalendar(this.endMonth, 'end')
                },

                generateCalendar(referenceDate, type) {
                    const monthStart = referenceDate.startOf('month')
                    const monthEnd = monthStart.endOf('month')
                    const startDay = monthStart.weekday
                    const daysInMonth = monthEnd.day

                    const dates = []
                    let currentDate = monthStart.minus({
                        days: startDay
                    })

                    for (let i = 0; i < 42; i++) {
                        const date = currentDate.plus({
                            days: i
                        })
                        const isCurrentMonth = date.month === referenceDate.month
                        const isSelectedStart = this.tempStart && date.hasSame(this.tempStart, 'day')
                        const isSelectedEnd = this.tempEnd && date.hasSame(this.tempEnd, 'day')
                        const isInRange = this.isInRange(date)
                        const isFirstDayOfMonth = date.day === 1
                        const isLastDayOfMonth = date.day === date.endOf('month').day

                        const isSelectable = type === 'start' ?
                            (!this.tempEnd || date <= this.tempEnd) :
                            (!this.tempStart || date >= this.tempStart)

                        dates.push({
                            day: date.day,
                            date: date,
                            isCurrentMonth,
                            isSelectedStart,
                            isSelectedEnd,
                            isInRange,
                            isFirstDayOfMonth,
                            isLastDayOfMonth,
                            isSelectable: isSelectable && isCurrentMonth
                        })
                    }

                    return {
                        days: ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'],
                        dates: dates,
                        monthYear: referenceDate.toFormat('MMMM yyyy')
                    }
                },

                isInRange(date) {
                    if (!this.tempStart || !this.tempEnd) return false
                    return date > this.tempStart.startOf('day') && date < this.tempEnd.endOf('day')
                },

                setTempStart(date) {
                    this.tempStart = date.startOf('day')
                    if (!this.tempEnd || this.tempEnd < this.tempStart) {
                        this.tempEnd = this.tempStart
                    }
                    this.activateCustomRange()
                },

                setTempEnd(date) {
                    this.tempEnd = date.endOf('day')
                    if (!this.tempStart || this.tempStart > this.tempEnd) {
                        this.tempStart = this.tempEnd
                    }
                    this.activateCustomRange()
                },

                prevMonth(type) {
                    if (type === 'start') {
                        this.startMonth = this.startMonth.minus({
                            months: 1
                        })
                    } else {
                        this.endMonth = this.endMonth.minus({
                            months: 1
                        })
                    }
                    this.activateCustomRange()
                },

                nextMonth(type) {
                    if (type === 'start') {
                        this.startMonth = this.startMonth.plus({
                            months: 1
                        })
                    } else {
                        this.endMonth = this.endMonth.plus({
                            months: 1
                        })
                    }
                    this.activateCustomRange()
                },

                setPreset(preset) {
                    this.presets.forEach(p => p.active = false)
                    preset.active = true

                    const today = this.DateTime.local()
                    switch (preset.label) {
                        case 'Today':
                            this.tempStart = today.startOf('day')
                            this.tempEnd = today.endOf('day')
                            this.startMonth = today
                            this.endMonth = today
                            break
                        case 'Yesterday':
                            const yesterday = today.minus({
                                days: 1
                            })
                            this.tempStart = yesterday.startOf('day')
                            this.tempEnd = yesterday.endOf('day')
                            this.startMonth = yesterday
                            this.endMonth = yesterday
                            break
                        case 'Last 7 Days':
                            this.tempStart = today.minus({
                                days: 6
                            }).startOf('day')
                            this.tempEnd = today.endOf('day')
                            this.startMonth = this.tempStart
                            this.endMonth = this.tempEnd
                            break
                        case 'Last 30 Days':
                            this.tempStart = today.minus({
                                days: 29
                            }).startOf('day')
                            this.tempEnd = today.endOf('day')
                            this.startMonth = this.tempStart
                            this.endMonth = this.tempEnd
                            break
                        case 'This Month':
                            this.tempStart = today.startOf('month')
                            this.tempEnd = today.endOf('month')
                            this.startMonth = today
                            this.endMonth = today
                            break
                        case 'Last Month':
                            const lastMonth = today.minus({
                                months: 1
                            })
                            this.tempStart = lastMonth.startOf('month')
                            this.tempEnd = lastMonth.endOf('month')
                            this.startMonth = lastMonth
                            this.endMonth = lastMonth
                            break
                        case 'Custom Range':
                            this.tempStart = null
                            this.tempEnd = null
                            this.startMonth = today
                            this.endMonth = today.plus({
                                months: 1
                            })
                            break
                    }
                },

                activateCustomRange() {
                    this.presets.forEach(p => {
                        if (p.label === 'Custom Range') p.active = true
                        else p.active = false
                    })
                },

                cancel() {
                    this.tempStart = this.startDate
                    this.tempEnd = this.endDate
                    this.showDropdown = false
                },

                apply() {
                    if (this.tempStart && this.tempEnd) {
                        this.startDate = this.tempStart
                        this.endDate = this.tempEnd
                        this.showDropdown = false
                    }
                }
            }));
        });
    </script>
{% endblock js %}
