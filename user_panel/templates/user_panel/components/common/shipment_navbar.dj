<nav class="order-nav mb-4">
    <ul class="order-nav__list flex flex-nowrap gap-1.5 overflow-x-auto no-scrollbar py-1">
        <li><a href="{% url 'user_panel:shipment' 'all_orders' %}" data-slug="all_orders" class="order-nav__link">All Orders ({{ count.all_orders }})</a></li>
        <li><a href="{% url 'user_panel:shipment' 'ready_to_ship' %}" data-slug="ready_to_ship" class="order-nav__link">Ready To Ship ({{ count.ready_to_ship }})</a></li>
        <li><a href="{% url 'user_panel:shipment' 'processing' %}" data-slug="processing" class="order-nav__link">Processing ({{ count.processing }})</a></li>
        <li><a href="{% url 'user_panel:shipment' 'pending_pickup' %}" data-slug="pending_pickup" class="order-nav__link">Pending Pickup ({{ count.pending_pickup }})</a></li>
        <li><a href="{% url 'user_panel:shipment' 'in_transit' %}" data-slug="in_transit" class="order-nav__link">In Transit ({{ count.in_transit }})</a></li>
        <li><a href="{% url 'user_panel:shipment' 'out_for_delivery' %}" data-slug="out_for_delivery" class="order-nav__link">OFD ({{ count.out_for_delivery }})</a></li>
        <li><a href="{% url 'user_panel:shipment' 'delivered' %}" data-slug="delivered" class="order-nav__link">Delivered ({{ count.delivered }})</a></li>
        <li><a href="{% url 'user_panel:shipment' 'rto' %}" data-slug="rto" class="order-nav__link">RTO/RTS ({{ count.rto }})</a></li>
        <li><a href="{% url 'user_panel:shipment' 'cancelled' %}" data-slug="cancelled" class="order-nav__link">Cancelled ({{ count.cancelled }})</a></li>
    </ul>
</nav>

<style>
    .order-nav__link {
        display: inline-block;
        padding: .5rem .875rem;
        border-radius: .5rem;
        font-size: 13px;
        font-weight: 600;
        white-space: nowrap;
        color: #737373;
        background: #f5f5f5;
        transition: background-color .15s ease, color .15s ease;
    }
    .order-nav__link:hover { background: #e5e5e5; color: #171717; }
    .order-nav__link.is-active { background: #0e1726; color: #fff; }
    .dark .order-nav__link { background: rgba(255,255,255,.06); color: #a3a3a3; }
    .dark .order-nav__link:hover { background: rgba(255,255,255,.12); color: #fff; }
    .dark .order-nav__link.is-active { background: #fff; color: #0e1726; }
</style>

<script>
    (function () {
        var path = window.location.pathname;
        document.querySelectorAll(".order-nav__link").forEach(function (link) {
            if (link.getAttribute("href") === path) link.classList.add("is-active");
        });
    })();
</script>
