                                <path d="M22 14V17C22 18.66 20.66 20 19 20H18C18 18.9 17.1 18 16 18C14.9 18 14 18.9 14 20H10C10 18.9 9.1 18 8 18C6.9 18 6 18.9 6 20H5C3.34 20 2 18.66 2 17V14H13C14.1 14 15 13.1 15 12V5H16.84C17.56 5 18.22 5.39001 18.58 6.01001L20.29 9H19C18.45 9 18 9.45 18 10V13C18 13.55 18.45 14 19 14H22Z" fill="currentColor" />
                                <path opacity="0.4" d="M8 22C9.10457 22 10 21.1046 10 20C10 18.8954 9.10457 18 8 18C6.89543 18 6 18.8954 6 20C6 21.1046 6.89543 22 8 22Z" fill="currentColor" />
                                <path opacity="0.4" d="M16 22C17.1046 22 18 21.1046 18 20C18 18.8954 17.1046 18 16 18C14.8954 18 14 18.8954 14 20C14 21.1046 14.8954 22 16 22Z" fill="currentColor" />
                                <path opacity="0.4" d="M22 12.53V14H19C18.45 14 18 13.55 18 13V10C18 9.45 18.45 9 19 9H20.29L21.74 11.54C21.91 11.84 22 12.18 22 12.53Z" fill="currentColor" />
                            </svg>


                            <span class="ltr:pl-3 rtl:pr-3 text-black dark:text-[#506690] dark:group-hover:text-white-dark">Shipments</span>
                        </div>
                        <div class="rtl:rotate-180"
                             :class="{ '!rotate-90': activeDropdown === 'shipments' }">
                            <svg width="16"
                                 height="16"
                                 viewBox="0 0 24 24"
                                 fill="none"
                                 xmlns="http://www.w3.org/2000/svg">
                                <path d="M9 5L15 12L9 19" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                            </svg>
                        </div>
                    </button>
                    <ul x-cloak
                        x-show="activeDropdown === 'shipments'"
                        x-collapse
                        class="sub-menu text-gray-500">
                        <li>
                            <a href="{% url 'user_panel:shipment' 'ready_to_ship' %}"
                               class="flex items-center gap-2">

                                <svg width="18"
                                     height="18"
                                     viewBox="0 0 100 100"
                                     fill="none"
                                     xmlns="http://www.w3.org/2000/svg"
                                     stroke="currentColor">
                                    <path d="M53 53.6V78c0 .6.4 1 1 1 .2 0 .4 0 .5-.1 4.8-2.7 19.4-11 19.4-11 1.9-1.1 3.1-3.1 3.1-5.3V40.7c0-.6-.4-1-1-1-.2 0-.4 0-.5.1L54 51.9c-.6.3-1 .9-1 1.7zm-2-6.8L72.6 34.7a1 1 0 0 0 0-1.7c-4.8-2.7-19.5-11.1-19.5-11.1-1.9-1.1-4.3-1.1-6.2 0 0 0-14.7 8.3-19.5 11.1a1 1 0 0 0 0 1.7L49 46.8c.6.3 1.4.3 2 0zM46 51.9 24.5 39.8a1 1 0 0 0-1.5.9v21.8c0 2.2 1.2 4.2 3.1 5.3 0 0 14.6 8.3 19.4 11a1 1 0 0 0 1.5-.9V53.6c0-.7-.4-1.4-1-1.7z" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                                </svg>

