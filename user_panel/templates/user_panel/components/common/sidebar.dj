                         stroke="currentColor"
                         stroke-width="1.5"
                         fill="none"
                         stroke-linecap="round"
                         stroke-linejoin="round">
                        <line x1="5" y1="12" x2="19" y2="12"></line>
                    </svg>
                    <span>Finance</span>
                </h2>

                <li class="menu nav-item">
                    <button type="button"
                            class="nav-link group"
                            :class="{ 'active': activeDropdown === 'finance' }"
                            @click="activeDropdown === 'finance' ? activeDropdown = null : activeDropdown = 'finance'">
                        <div class="flex items-center">
                            <svg class="group-hover:!text-primary shrink-0"
                                 width="20"
                                 height="20"
                                 viewBox="0 0 32 32"
