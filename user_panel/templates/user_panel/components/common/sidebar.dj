{% load static %}

<div :class="{ 'dark text-white-dark': $store.app.semidark }">
    <nav x-data="sidebar"
         class="sidebar fixed min-h-screen h-full top-0 bottom-0 w-[260px] z-50 transition-all duration-300">
        <div class="h-full flex flex-col">

            <!-- brand row -->
            <div class="flex items-center justify-between px-4 h-14 shrink-0">
                <a href="/" class="main-logo flex items-center gap-2">
                    <span class="flex h-8 w-8 flex-none items-center justify-center rounded-lg text-sm font-extrabold">S</span>
                    <span class="text-xl font-extrabold tracking-tight">Swift<span class="text-red-500">Courier</span></span>
                </a>
                <a href="javascript:;"
                   class="collapse-icon w-8 h-8 rounded-full flex items-center justify-center transition rtl:rotate-180"
                   @click="$store.app.toggleSidebar()">
                    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none">
                        <path d="M13 19L7 12L13 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                        <path opacity="0.5" d="M17 19L11 12L17 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                </a>
            </div>

            <!-- primary CTA -->
            <a href="{% url 'user_panel:add-order' %}" class="side-cta">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M12 5v14m7-7H5"/></svg>
                <span>New Shipment</span>
            </a>

            <!-- nav -->
            <ul class="perfect-scrollbar flex-1 space-y-0.5 overflow-y-auto overflow-x-hidden px-3 pb-4">

                {% comment %} icon set: 1.5-stroke line icons, 20px {% endcomment %}
                <li class="menu nav-item">
                    <a href="{% url 'user_panel:dashboard' %}" class="nav-link group">
                        <div class="flex items-center">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" class="shrink-0"><rect x="3" y="3" width="7" height="9" rx="1.5"/><rect x="14" y="3" width="7" height="5" rx="1.5"/><rect x="14" y="12" width="7" height="9" rx="1.5"/><rect x="3" y="16" width="7" height="5" rx="1.5"/></svg>
                            <span class="ltr:pl-3 rtl:pr-3">Dashboard</span>
                        </div>
                    </a>
                </li>

                <li class="menu nav-item">
                    <a href="{% url 'user_panel:shipment' 'ready_to_ship' %}" class="nav-link group">
                        <div class="flex items-center">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" class="shrink-0"><path d="M3 8.5 12 4l9 4.5v7L12 20l-9-4.5v-7Z"/><path d="M3 8.5 12 13m0 0 9-4.5M12 13v7"/></svg>
                            <span class="ltr:pl-3 rtl:pr-3">Shipments</span>
                        </div>
                    </a>
                </li>

                <li class="menu nav-item">
                    <a href="{% url 'user_panel:ndr' %}" class="nav-link group">
                        <div class="flex items-center">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" class="shrink-0"><path d="M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h16.9a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0Z"/><path d="M12 9v4m0 4h.01"/></svg>
                            <span class="ltr:pl-3 rtl:pr-3">NDR</span>
                        </div>
                    </a>
                </li>

                <li class="menu nav-item">
                    <a href="{% url 'user_panel:weight-discrepancies' %}" class="nav-link group">
                        <div class="flex items-center">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" class="shrink-0"><path d="M12 3v3m-7 3h14l2 9a5 5 0 0 1-9 0m-5-9L3 18a5 5 0 0 0 9 0M6 6h12"/></svg>
                            <span class="ltr:pl-3 rtl:pr-3">Weight Disputes</span>
                        </div>
                    </a>
                </li>

                <li class="menu nav-item">
                    <a href="{% url 'user_panel:add-reverse-order' %}" class="nav-link group">
                        <div class="flex items-center">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" class="shrink-0"><path d="M9 14 4 9l5-5"/><path d="M4 9h11a5 5 0 0 1 0 10H9"/></svg>
                            <span class="ltr:pl-3 rtl:pr-3">Reverse Pickup</span>
                        </div>
                    </a>
                </li>

                <li class="pt-3"><div class="mx-3 border-t border-white/[0.06]"></div></li>

                <li class="menu nav-item">
                    <a href="{% url 'user_panel:wallet-history' %}" class="nav-link group">
                        <div class="flex items-center">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" class="shrink-0"><rect x="3" y="6" width="18" height="13" rx="2.5"/><path d="M3 10h18M16 15h2"/></svg>
                            <span class="ltr:pl-3 rtl:pr-3">Wallet</span>
                        </div>
                    </a>
                </li>

                <li class="menu nav-item">
                    <a href="{% url 'user_panel:billing' %}" class="nav-link group">
                        <div class="flex items-center">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" class="shrink-0"><path d="M6 2h9l5 5v13a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2Z"/><path d="M14 2v6h6M9 13h6M9 17h4"/></svg>
                            <span class="ltr:pl-3 rtl:pr-3">Billing</span>
                        </div>
                    </a>
                </li>

                <li class="menu nav-item">
                    <a href="{% url 'user_panel:cod-remittance' %}" class="nav-link group">
                        <div class="flex items-center">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" class="shrink-0"><circle cx="12" cy="12" r="9"/><path d="M15 9.5a3.5 3.5 0 0 0-6 2.5c0 3 6 2 6 5a3.5 3.5 0 0 1-6 2.5M12 6v1.5M12 16.5V18"/></svg>
                            <span class="ltr:pl-3 rtl:pr-3">COD Remittance</span>
                        </div>
                    </a>
                </li>

                <li class="pt-3"><div class="mx-3 border-t border-white/[0.06]"></div></li>

                <li class="menu nav-item">
                    <a href="{% url 'user_panel:analytics' %}" class="nav-link group">
                        <div class="flex items-center">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" class="shrink-0"><path d="M4 20V10m6 10V4m6 16v-7m4 7H2"/></svg>
                            <span class="ltr:pl-3 rtl:pr-3">Analytics</span>
                        </div>
                    </a>
                </li>

                <li class="menu nav-item">
                    <a href="{% url 'user_panel:mis' %}" class="nav-link group">
                        <div class="flex items-center">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" class="shrink-0"><path d="M4 5h16M4 12h16M4 19h10"/></svg>
                            <span class="ltr:pl-3 rtl:pr-3">MIS Reports</span>
                        </div>
                    </a>
                </li>

                <li class="menu nav-item">
                    <a href="{% url 'user_panel:tool-rate-calculator' %}" class="nav-link group">
                        <div class="flex items-center">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" class="shrink-0"><rect x="5" y="2" width="14" height="20" rx="2.5"/><path d="M8 6h8M8 10h2m4 0h2M8 14h2m4 0h2M8 18h6"/></svg>
                            <span class="ltr:pl-3 rtl:pr-3">Rate Calculator</span>
                        </div>
                    </a>
                </li>

                <li class="menu nav-item">
                    <a href="{% url 'user_panel:tool-pincode-serviceability' %}" class="nav-link group">
                        <div class="flex items-center">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" class="shrink-0"><path d="M12 21c-4-4-7-7.5-7-11a7 7 0 1 1 14 0c0 3.5-3 7-7 11Z"/><circle cx="12" cy="10" r="2.5"/></svg>
                            <span class="ltr:pl-3 rtl:pr-3">Serviceability</span>
                        </div>
                    </a>
                </li>

                <li class="menu nav-item">
                    <a href="{% url 'user_panel:rate-card' %}" class="nav-link group">
                        <div class="flex items-center">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" class="shrink-0"><path d="M3 7a2 2 0 0 1 2-2h11l5 5v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7Z"/><circle cx="8" cy="10" r="1.5"/></svg>
                            <span class="ltr:pl-3 rtl:pr-3">Rate Card</span>
                        </div>
                    </a>
                </li>

                <li class="pt-3"><div class="mx-3 border-t border-white/[0.06]"></div></li>

                <li class="menu nav-item">
                    <a href="{% url 'user_panel:all-hub' %}" class="nav-link group">
                        <div class="flex items-center">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" class="shrink-0"><path d="M3 21V9l9-6 9 6v12M9 21v-6h6v6"/></svg>
                            <span class="ltr:pl-3 rtl:pr-3">Warehouses</span>
                        </div>
                    </a>
                </li>

                <li class="menu nav-item">
                    <a href="{% url 'user_panel:shopify-integration' %}" class="nav-link group">
                        <div class="flex items-center">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" class="shrink-0"><path d="M12 3a4 4 0 0 0-4 4v1H6a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-9a2 2 0 0 0-2-2h-2V7a4 4 0 0 0-4-4Z"/></svg>
                            <span class="ltr:pl-3 rtl:pr-3">Integrations</span>
                        </div>
                    </a>
                </li>

                <li class="menu nav-item">
                    <a href="{% url 'user_panel:courier-rules' %}" class="nav-link group">
                        <div class="flex items-center">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" class="shrink-0"><path d="M4 6h11M4 12h16M4 18h9"/><circle cx="18" cy="6" r="2"/><circle cx="16" cy="18" r="2"/></svg>
                            <span class="ltr:pl-3 rtl:pr-3">Courier Rules</span>
                        </div>
                    </a>
                </li>

                <li class="menu nav-item">
                    <a href="{% url 'user_panel:kyc' %}" class="nav-link group">
                        <div class="flex items-center">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" class="shrink-0"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.7 1.7 0 0 0 .3 1.9l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-2.9 1.2V21a2 2 0 1 1-4 0v-.1A1.7 1.7 0 0 0 7 19.4l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0-1.2-2.9H3a2 2 0 1 1 0-4h.1A1.7 1.7 0 0 0 4.6 7l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.9.3H9a1.7 1.7 0 0 0 1-1.6V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 2.9 1.2l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 2.9V15Z"/></svg>
                            <span class="ltr:pl-3 rtl:pr-3">Settings &amp; KYC</span>
                        </div>
                    </a>
                </li>

            </ul>
        </div>
    </nav>
</div>

<script>
    document.addEventListener("alpine:init", () => {
        Alpine.data("sidebar", () => ({
            init() {
                const path = window.location.pathname;
                const links = this.$el.querySelectorAll('a.nav-link');
                let best = null;
                links.forEach(a => {
                    const href = a.getAttribute('href');
                    if (!href || href === '/') return;
                    if (path === href) best = a;
                    else if (path.startsWith(href) && (!best || href.length > best.getAttribute('href').length)) best = a;
                });
                // Shipments link covers every /user_panel/shipment/<status>/ page
                if (path.startsWith('/user_panel/shipment/')) {
                    best = this.$el.querySelector('a[href*="/shipment/"]');
                }
                if (best) best.classList.add('active');
            },
        }));
    });
</script>
