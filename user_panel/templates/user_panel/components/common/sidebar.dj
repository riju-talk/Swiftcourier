                                     fill="none"
                                     xmlns="http://www.w3.org/2000/svg">
                                    <path d="M11.017 4.424c0-.732-.597-1.407-1.335-1.407H8.913c.035-.169.057-.343.057-.523C8.97 1.12 7.855 0 6.486 0 5.116 0 4.002 1.12 4.002 2.494c0 .18.021.355.057.523h-.744c-.735 0-1.332.675-1.332 1.407L.008 13.674C.008 14.407.606 15 1.344 15h10.313c.736 0 1.333-.593 1.333-1.326L11.017 4.424zM5 2.508C5 1.676 5.673 1 6.5 1S8 1.676 8 2.508a1.58 1.58 0 0 1-.088.492H5.089A1.58 1.58 0 0 1 5 2.508zM6.047 9.005H5.045v.948h1.002v1.067H4.982v-1.005h-.939v1.005H2.962V5.911h1.081v3.031h.939V7.937h1.065v1.068zM10.047 13.023H9.047v1.023H7.985v-1.008l.064-.063.892-.017.012-1.937H6.986L6.978 7.952l3.07.013v5.058z" fill="currentColor" />
                                </svg>

                            Weight Discrepancies</a>
                        </li>
                        <li>
                            <a href="{% url 'user_panel:ndr' %}" class="flex items-center gap-2">
                                <svg width="18"
                                     height="18"
                                     viewBox="0 0 24 24"
                                     fill="none"
