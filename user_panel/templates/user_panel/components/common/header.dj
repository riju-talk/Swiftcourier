                value: 'hu',
            }, {
                id: 8,
                key: 'Italian',
                value: 'it',
            }, {
                id: 9,
                key: 'Japanese',
                value: 'ja',
            }, {
                id: 10,
                key: 'Polish',
                value: 'pl',
            }, {
                id: 11,
                key: 'Portuguese',
                value: 'pt',
            }, {
                id: 12,
                key: 'Russian',
                value: 'ru',
            }, {
