            }, {
                id: 15,
                key: 'Turkish',
                value: 'tr',
            }, {
                id: 16,
                key: 'Arabic',
                value: 'ae',
            }, ],


            removeActivity(value) {
                this.activities = this.activities.filter((d) => d.id !== value);
            },

            removeNotification(value) {
                this.notifications = this.notifications.filter((d) => d.id !== value);
            },
        }));
    });
</script>
