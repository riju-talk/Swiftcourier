<!-- Pagination -->
<div class="flex flex-col items-center justify-between gap-4 border-t border-neutral-200 p-4 dark:border-white/10 sm:flex-row">
    <div class="flex items-center gap-2">
        <span class="text-xs font-medium text-neutral-500 dark:text-neutral-400">Rows per page</span>
        <select id="pageSize" onchange="updatePageSize(this.value)"
                class="h-8 rounded-lg border border-neutral-300 bg-white px-2 text-sm text-neutral-700 dark:border-white/15 dark:bg-transparent dark:text-neutral-200">
            <option value="10" {% if page_size == 10 %}selected{% endif %}>10</option>
            <option value="50" {% if page_size == 50 %}selected{% endif %}>50</option>
            <option value="100" {% if page_size == 100 %}selected{% endif %}>100</option>
            <option value="200" {% if page_size == 200 %}selected{% endif %}>200</option>
            <option value="500" {% if page_size == 500 %}selected{% endif %}>500</option>
        </select>
    </div>

    <div class="flex flex-wrap items-center gap-1">
        <button onclick="navigatePage('prev')"
                class="inline-flex h-8 items-center rounded-lg border border-neutral-300 px-3 text-sm font-medium text-neutral-600 transition-colors hover:bg-neutral-50 disabled:opacity-40 dark:border-white/15 dark:text-neutral-300 dark:hover:bg-white/5"
                {% if not page_obj.has_previous %}disabled{% endif %}>Previous</button>

        {% if page_obj.number > 3 %}
            <button onclick="navigatePage(1)" class="inline-flex h-8 min-w-8 items-center justify-center rounded-lg px-2 text-sm font-medium text-neutral-600 hover:bg-neutral-100 dark:text-neutral-300 dark:hover:bg-white/5">1</button>
            <span class="px-1 text-neutral-400">&hellip;</span>
        {% endif %}

        {% for num in page_obj.paginator.page_range %}
            {% if num >= page_obj.number|add:'-2' and num <= page_obj.number|add:'2' %}
                <button onclick="navigatePage({{ num }})"
                        class="inline-flex h-8 min-w-8 items-center justify-center rounded-lg px-2 text-sm font-semibold transition-colors {% if num == page_obj.number %}bg-black text-white dark:bg-white dark:text-black{% else %}text-neutral-600 hover:bg-neutral-100 dark:text-neutral-300 dark:hover:bg-white/5{% endif %}">{{ num }}</button>
            {% endif %}
        {% endfor %}

        {% if page_obj.number < page_obj.paginator.num_pages|add:'-2' %}
            <span class="px-1 text-neutral-400">&hellip;</span>
            <button onclick="navigatePage({{ page_obj.paginator.num_pages }})" class="inline-flex h-8 min-w-8 items-center justify-center rounded-lg px-2 text-sm font-medium text-neutral-600 hover:bg-neutral-100 dark:text-neutral-300 dark:hover:bg-white/5">{{ page_obj.paginator.num_pages }}</button>
        {% endif %}

        <button onclick="navigatePage('next')"
                class="inline-flex h-8 items-center rounded-lg border border-neutral-300 px-3 text-sm font-medium text-neutral-600 transition-colors hover:bg-neutral-50 disabled:opacity-40 dark:border-white/15 dark:text-neutral-300 dark:hover:bg-white/5"
                {% if not page_obj.has_next %}disabled{% endif %}>Next</button>
    </div>
</div>

<script>
    // Pagination Handling
    function getCurrentParams() {
        const params = new URLSearchParams(window.location.search);
        return {
            page: parseInt(params.get('page')) || 1,
            size: parseInt(params.get('page_size')) || 50
        };
    }

    // Initialize page size from URL
    window.addEventListener('load', () => {
        const params = getCurrentParams();
        document.getElementById('pageSize').value = params.size;
    });

    function navigatePage(action) {
        const urlParams = new URLSearchParams(window.location.search);
        const currentSearch = document.getElementById('searchInput').value;
        let page = parseInt(urlParams.get('page') || 1);

        if (action === 'prev') {
            page = Math.max(1, page - 1);
        } else if (action === 'next') {
            page = page + 1;
        } else {
            page = parseInt(action);
        }

        if (currentSearch) {
            urlParams.set('q', currentSearch);
        }

        urlParams.set('page', page);
        window.location.search = urlParams.toString();
    }

    function updatePageSize(size) {
        const urlParams = new URLSearchParams(window.location.search);
        const currentSearch = document.getElementById('searchInput').value;

        urlParams.set('page_size', size);
        urlParams.set('page', 1); // Reset to first page

        if (currentSearch) {
            urlParams.set('q', currentSearch);
        }
        window.location.search = urlParams.toString();
    }
</script>
