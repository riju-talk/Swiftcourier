{% load static %}

<ul x-cloak
    x-show="open"
    x-transition
    x-transition.duration.300ms
    class="ltr:-right-2 rtl:-left-2 top-11 !py-0 text-dark dark:text-white-dark w-[300px] sm:w-[350px] divide-y dark:divide-white/10">
    <li>
        <div class="flex items-center px-4 py-2 justify-between font-semibold hover:!bg-transparent">
            <h4 class="text-lg">Activities</h4>
            <span class="badge bg-primary/80">{{ total_unread_activities }} New</span>
        </div>
    </li>
    {% for activity in unread_5_activities %}
        <li>
            <div class="flex flex-col px-4 py-2 group"
                 @click.self="toggle">
                <div class="flex justify-between items-center">
                    <h5 class="font-semibold text-sm text-gray-800 dark:text-white">{{ activity.get_activity_type_display }}</h5>
                    <span class="text-xs text-gray-500 dark:text-gray-400">{{ activity.created_at|timesince }} ago</span>
                </div>
                <p class="mt-1 text-sm text-gray-600 dark:text-gray-400">{{ activity.activity_description }}</p>
            </div>
        </li>
    {% empty %}
        <li>
            <div class="!grid place-content-center hover:!bg-transparent text-lg min-h-[200px]">
                <div class="mx-auto ring-4 ring-primary/30 rounded-full mb-4 text-primary">
                    <svg width="40"
                         height="40"
                         viewBox="0 0 20 20"
                         fill="none"
                         xmlns="http://www.w3.org/2000/svg">
                        <path opacity="0.5" d="M20 10C20 4.47715 15.5228 0 10 0C4.47715 0 0 4.47715 0 10C0 15.5228 4.47715 20 10 20C15.5228 20 20 15.5228 20 10Z" fill="currentColor" />
                        <path d="M10 4.25C10.4142 4.25 10.75 4.58579 10.75 5V11C10.75 11.4142 10.4142 11.75 10 11.75C9.58579 11.75 9.25 11.4142 9.25 11V5C9.25 4.58579 9.58579 4.25 10 4.25Z" fill="currentColor" />
                        <path d="M10 15C10.5523 15 11 14.5523 11 14C11 13.4477 10.5523 13 10 13C9.44772 13 9 13.4477 9 14C9 14.5523 9.44772 15 10 15Z" fill="currentColor" />
                    </svg>
                </div>
                No unread activity
            </div>
        </li>
    {% endfor %}
    <li>
        <div class="p-4">
            <a class="btn btn-primary block w-full btn-small" href="{% url 'account:activities' %}">Read All Activities</a>
        </div>
    </li>
</ul>
