<form id="filterForm" action="#" method="get">
    <input type="hidden" name="exportOrders" id="exportOrders" />

    <div id="filterSection"
         class="hidden mb-6 bg-white dark:bg-gray-800 rounded-2xl shadow-lg border border-gray-200 dark:border-gray-700 p-6">

        <div class="flex items-end space-x-4">

            {% include "components/common/date_range.dj" %}

            <div class="flex-1 mb-4">
                <div>
                    <label for="filter-order-id"
                           class="block text-sm font-medium text-gray-700 dark:text-gray-200 mb-2">Order ID</label>
                    <input type="text"
                           name="order_id"
                           value="{{ request.GET.order_id }}"
                           id="filter-order-id"
                           placeholder="ORD-00123"
                           class="w-full px-3 py-2 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 text-gray-800 dark:text-gray-100 focus:outline-none focus:ring-2 focus:ring-indigo-200 dark:focus:ring-indigo-500" />
                </div>
            </div>

            <div class="flex-1 mb-4">
                <div>
                    <label for="filter-courier-partners"
                           class="block text-sm font-medium text-gray-700 dark:text-gray-200 mb-2">Courier</label>
                    <select name="courier_partner"
                            id="filter-courier-partners"
                            class="w-full px-3 py-2 rounded-lg border border-gray-300 dark:border-gray-600 focus:outline-none focus:ring-2 focus:ring-indigo-200 dark:focus:ring-indigo-500 bg-white dark:bg-gray-700 text-gray-800 dark:text-gray-100">
                        <option value="">Select Courier</option>
                        {% for i, j in request.user.rate_cards.first.get_couriers_available_for_user.items %}
                            <option value="{{ i }}">{{ j.name }}</option>
                        {% endfor %}
                    </select>
                </div>
            </div>

            {% if status != "ready_to_ship" %}
                <div class="flex-1 mb-4">
                    <div>
                        <label for="awb-number"
                               class="block text-sm font-medium text-gray-700 dark:text-gray-200 mb-2">AWB No.</label>
                        <input type="text"
                               name="awb_number"
                               value="{{ request.GET.awb_number }}"
                               id="awb-number"
                               placeholder="456546"
                               class="w-full px-3 py-2 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 text-gray-800 dark:text-gray-100 focus:outline-none focus:ring-2 focus:ring-indigo-200 dark:focus:ring-indigo-500" />
                    </div>
                </div>
            {% endif %}
        </div>
        <!-- End Date Range -->

        <div class="grid gap-6"
             style="grid-template-columns: repeat(auto-fit, minmax(200px, 1fr))">
            <!-- Order Type -->
            <div>
                <label for="filter-payment-method"
                       class="block text-sm font-medium text-gray-700 dark:text-gray-200 mb-2">Payment Method</label>
                <select name="payment_method"
                        id="filter-payment-method"
                        class="w-full px-3 py-2 rounded-lg border border-gray-300 dark:border-gray-600 focus:outline-none focus:ring-2 focus:ring-indigo-200 dark:focus:ring-indigo-500 bg-white dark:bg-gray-700 text-gray-800 dark:text-gray-100">
                    <option value="">Select Payment Method</option>
                    {% for i, j in request.user.orders.first.payment.PAYMENT_METHODS %}
                        <option value="{{ i }}">{{ j }}</option>
                    {% endfor %}
                </select>
            </div>

            {% if status != "ready_to_ship" %}
                <!-- Warehouse -->
                <div>
                    <label for="filter-warehouse"
                           class="block text-sm font-medium text-gray-700 dark:text-gray-200 mb-2">Warehouse</label>
                    <select name="warehouse"
                            id="filter-warehouse"
                            class="w-full px-3 py-2 rounded-lg border border-gray-300 dark:border-gray-600 focus:outline-none focus:ring-2 focus:ring-indigo-200 dark:focus:ring-indigo-500 bg-white dark:bg-gray-700 text-gray-800 dark:text-gray-100">
                        <option value="">Select Warehouse</option>
                        {% for hub in request.user.hubs.all %}<option value="{{ hub.id }}">{{ hub.name }}</option>{% endfor %}
                    </select>
                </div>
            {% endif %}

            <!-- Courier Partner -->
            <div>
                <label for="filter-channel"
                       class="block text-sm font-medium text-gray-700 dark:text-gray-200 mb-2">Channel</label>
                <select name="channel"
                        id="filter-channel"
                        class="w-full px-3 py-2 rounded-lg border border-gray-300 dark:border-gray-600 focus:outline-none focus:ring-2 focus:ring-indigo-200 dark:focus:ring-indigo-500 bg-white dark:bg-gray-700 text-gray-800 dark:text-gray-100">
                    <option value="">Select Channel</option>
                    {% for i, j in request.user.orders.first.CHANNEL_CHOICES %}<option value="{{ i }}">{{ j }}</option>{% endfor %}
                </select>
            </div>

            <!-- Product Name -->
            <div>
                <label for="filter-product-name"
                       class="block text-sm font-medium text-gray-700 dark:text-gray-200 mb-2">Product Name</label>
                <input type="text"
                       name="product_name"
                       value="{{ request.GET.product_name }}"
                       id="filter-product-name"
                       placeholder="T-Shirt"
                       class="w-full px-3 py-2 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 text-gray-800 dark:text-gray-100 focus:outline-none focus:ring-2 focus:ring-indigo-200 dark:focus:ring-indigo-500" />
            </div>
        </div>
        <!-- Submit & Cancel Buttons -->
        <div class="mt-6 flex justify-end space-x-3">
            <button type="button"
                    id="filterCancelBtn"
                    class="px-5 py-2 rounded-lg bg-red-50 hover:bg-red-100 text-red-600 transition-colors duration-200 ease-in-out focus:outline-none focus:ring-2 focus:ring-red-200">
                Reset
            </button>
            <button type="button"
                    id="filterSubmitBtn"
                    class="px-5 py-2 rounded-lg bg-green-600 hover:bg-green-700 text-white transform hover:scale-105 transition-transform duration-200 ease-out focus:outline-none focus:ring-2 focus:ring-green-300">
                Apply Filters
            </button>
        </div>
    </div>
</form>


<script>
    document.addEventListener("DOMContentLoaded", function() {
        const filterToggleBtn = document.getElementById("filterToggleBtn");
        const filterSection = document.getElementById("filterSection");
        const filterCancelBtn = document.getElementById("filterCancelBtn");
        const filterForm = document.getElementById("filterForm");

        // Toggle filter section
        filterToggleBtn.addEventListener("click", () => {
            filterSection.classList.toggle("hidden");
        });

        document.getElementById("filterSubmitBtn").addEventListener("click", () => {
            let input_element = document.getElementById("exportOrders");
            input_element.value = "false";

            document.getElementById("filterForm").submit();
        });

        // Show/hide custom date inputs
        /* filterDateRange.addEventListener("change", (e) => {
            if (e.target.value === 'custom') {
                customDateInputs.classList.remove('hidden');
            } else {
                customDateInputs.classList.add('hidden');
            }
        }); */

        // Cancel: clear all fields
        filterCancelBtn.addEventListener("click", () => {
            document.getElementById("filterForm").reset();
            customDateInputs.classList.add('hidden');
        });
    });

    document.getElementById("exportOrderButton").addEventListener("click", () => {
        // Get current URL
        const url = new URL(window.location.href);

        // Set parameter (creates if not exists, updates if exists)
        url.searchParams.set("exportOrders", "true");

        // open in new tab
        window.open(url.toString(), "_blank");
    });
</script>
