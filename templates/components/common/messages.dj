{% if messages %}
  <div id="toast-stack"
       class="pointer-events-none fixed inset-x-3 top-3 z-[999] flex flex-col gap-2 sm:inset-x-auto sm:right-4 sm:top-4 sm:w-full sm:max-w-sm">
    {% for message in messages %}
      <div class="toast pointer-events-auto relative flex items-start gap-3 overflow-hidden rounded-lg border border-neutral-200 bg-white p-3.5 pr-10 shadow-lg
                  dark:border-white/10 dark:bg-neutral-900
                  before:absolute before:inset-y-0 before:left-0 before:w-1
                  {% if 'success' in message.tags %}before:bg-green-600
                  {% elif 'warning' in message.tags %}before:bg-amber-500
                  {% elif 'error' in message.tags %}before:bg-red-600
                  {% else %}before:bg-black dark:before:bg-white{% endif %}">

        <span class="mt-0.5 flex h-6 w-6 flex-none items-center justify-center rounded-md
                     {% if 'success' in message.tags %}bg-green-50 text-green-600 dark:bg-green-500/15 dark:text-green-400
                     {% elif 'warning' in message.tags %}bg-amber-50 text-amber-600 dark:bg-amber-500/15 dark:text-amber-400
                     {% elif 'error' in message.tags %}bg-red-50 text-red-600 dark:bg-red-500/15 dark:text-red-400
                     {% else %}bg-neutral-100 text-black dark:bg-white/10 dark:text-white{% endif %}">
          {% if 'success' in message.tags %}
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
          {% elif 'warning' in message.tags %}
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 9v4M12 17h.01M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0Z"/></svg>
          {% elif 'error' in message.tags %}
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="m15 9-6 6M9 9l6 6"/></svg>
          {% else %}
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4M12 8h.01"/></svg>
          {% endif %}
        </span>

        <div class="min-w-0 flex-1 pt-0.5">
          <p class="text-[11px] font-bold uppercase tracking-wider
                    {% if 'success' in message.tags %}text-green-600 dark:text-green-400
                    {% elif 'warning' in message.tags %}text-amber-600 dark:text-amber-400
                    {% elif 'error' in message.tags %}text-red-600 dark:text-red-400
                    {% else %}text-neutral-500 dark:text-neutral-400{% endif %}">
            {{ message.tags|title|default:"Notice" }}
          </p>
          <p class="mt-0.5 break-words text-sm text-neutral-700 dark:text-neutral-200">{{ message }}</p>
        </div>

        <button type="button"
                aria-label="Dismiss"
                class="alert-del absolute right-2 top-2 flex h-6 w-6 items-center justify-center rounded-md text-neutral-400 transition-colors hover:bg-neutral-100 hover:text-black dark:hover:bg-white/10 dark:hover:text-white">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
        </button>

        <span class="absolute bottom-0 left-0 h-0.5 w-full bg-neutral-100 dark:bg-white/10">
          <span class="progress block h-full
                       {% if 'success' in message.tags %}bg-green-600
                       {% elif 'warning' in message.tags %}bg-amber-500
                       {% elif 'error' in message.tags %}bg-red-600
                       {% else %}bg-black dark:bg-white{% endif %}"></span>
        </span>
      </div>
    {% endfor %}
  </div>
{% endif %}

<style>
  #toast-stack .toast {
    animation: toast-in .28s cubic-bezier(.21, 1.02, .73, 1) both;
  }
  #toast-stack .toast.fade-out {
    opacity: 0;
    transform: translateX(12px);
    transition: opacity .4s ease, transform .4s ease;
  }
  @keyframes toast-in {
    from { opacity: 0; transform: translateX(16px); }
    to   { opacity: 1; transform: translateX(0); }
  }
  #toast-stack .progress {
    width: 100%;
    animation: toast-shrink 5s linear forwards;
  }
  @keyframes toast-shrink { from { width: 100%; } to { width: 0%; } }
  @media (prefers-reduced-motion: reduce) {
    #toast-stack .toast, #toast-stack .progress { animation: none; }
  }
</style>

<script>
  (function () {
    function dismiss(toast) {
      toast.classList.add('fade-out');
      setTimeout(function () { toast.remove(); }, 400);
    }
    function setupToasts() {
      document.querySelectorAll('#toast-stack .alert-del').forEach(function (btn) {
        btn.addEventListener('click', function () { dismiss(btn.closest('.toast')); });
      });
      document.querySelectorAll('#toast-stack .toast').forEach(function (toast) {
        var timer = setTimeout(function () { dismiss(toast); }, 5200);
        toast.addEventListener('mouseenter', function () { clearTimeout(timer); });
      });
    }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', setupToasts);
    } else {
      setupToasts();
    }
  })();
</script>
