{% if messages %}
    <div style="position:fixed;top:0;left:0;width:100%;z-index:999;" class="space-y-3">
        {% for message in messages %}
            <div class="relative flex justify-between items-center rounded-xl shadow-md p-4 transition-all
                        {% if 'success' in message.tags %}
                            bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-200
                        {% elif 'info' in message.tags %}
                            bg-blue-100 text-blue-800 dark:bg-blue-900 dark:text-blue-200
                        {% elif 'warning' in message.tags %}
                            bg-yellow-100 text-yellow-800 dark:bg-yellow-900 dark:text-yellow-200
                        {% elif 'error' in message.tags %}
                            bg-red-100 text-red-800 dark:bg-red-900 dark:text-red-200
                        {% else %}
                            bg-gray-100 text-gray-800 dark:bg-gray-800 dark:text-gray-200
                        {% endif %}">
                <p class="text-sm sm:text-base font-medium">
                    <strong class="mr-1">{{ message.tags|title }}:</strong>{{ message }}
                </p>
                <button class="text-2xl font-bold cursor-pointer alert-del px-2 hover:opacity-70">&times;</button>
                <!-- Progress bar -->
                <div class="absolute bottom-0 left-0 h-1 bg-black/20 dark:bg-white/30 w-full overflow-hidden rounded-b-xl">
                    <div class="progress h-1 bg-current"></div>
                </div>
            </div>
        {% endfor %}
    </div>
{% endif %}

<style>
    /* Fade out animation */
    .fade-out {
        opacity: 0;
        transform: translateY(-10px);
        transition: opacity 0.6s ease, transform 0.6s ease;
    }

    /* Progress bar animation */
    .progress {
        width: 100%;
        animation: shrink 5s linear forwards;
    }

    @keyframes shrink {
        from {
            width: 100%;
        }

        to {
            width: 0%;
        }
    }
</style>

<script>
    function setupAlertAutoHide() {
        document.querySelectorAll('.alert-del').forEach((btn) => {
            btn.onclick = function() {
                let alert = btn.parentElement;
                alert.classList.add('fade-out');
                setTimeout(() => alert.classList.add('hidden'), 600);
            };
        });
        document.querySelectorAll('.space-y-3 > div').forEach((alert) => {
            setTimeout(() => {
                alert.classList.add('fade-out');
                setTimeout(() => alert.classList.add('hidden'), 600);
            }, 5000);
        });
    }
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', setupAlertAutoHide);
    } else {
        setupAlertAutoHide();
    }
</script>
