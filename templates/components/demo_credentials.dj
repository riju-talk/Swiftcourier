{% comment %}
Demo accounts card. Include on auth pages: {% include "components/demo_credentials.dj" %}
"Use" fills the sign-in form, or jumps to the right sign-in page from sign-up.
Controlled by settings.SHOW_DEMO_CREDENTIALS; accounts come from settings.DEMO_ACCOUNTS.
{% endcomment %}
{% if show_demo_credentials %}
<div class="demo-creds mt-6 rounded-xl border border-dashed border-red-600/40 bg-red-50/60 p-4" id="demoCreds">
    <div class="mb-3 flex items-center justify-between">
        <p class="text-sm font-semibold text-black">Demo accounts</p>
        <span class="rounded-full bg-red-600 px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wide text-white">Test only</span>
    </div>
    <div class="space-y-2">
        {% for a in demo_accounts %}
        <div class="demo-row flex items-center justify-between gap-3 rounded-lg border border-neutral-200 bg-white px-3 py-2"
             data-role="{{ a.role }}" data-email="{{ a.email }}" data-password="{{ a.password }}">
            <div class="min-w-0">
                <p class="text-xs font-semibold text-black">{{ a.label }}</p>
                <p class="truncate text-xs text-neutral-600">{{ a.email }}</p>
                <p class="truncate font-mono text-xs text-neutral-500">{{ a.password }}</p>
            </div>
            <button type="button" data-demo-use
                    class="shrink-0 rounded-md bg-black px-3 py-1.5 text-xs font-semibold text-white hover:bg-red-600">Use</button>
        </div>
        {% endfor %}
    </div>
</div>
<script>
(function () {
    var SIGNIN = "{% url 'account:signin' %}";
    var SUPER = "{% url 'account:superadmin_signin' %}";
    var email = document.getElementById('Email');
    var pass = document.getElementById('Password');
    var roleSel = document.getElementById('UserRole');
    var onSignup = !!document.querySelector('form[action="{% url 'account:signup' %}"]');
    var onSuper = !!document.querySelector('form[action="{% url 'account:superadmin_signin' %}"]');

    function fill(row) {
        var role = row.dataset.role;
        var sameForm = !onSignup && ((role === 'super_admin') === onSuper);
        if (!sameForm) { // wrong page for this role: jump there with the account preselected
            window.location.href = (role === 'super_admin' ? SUPER : SIGNIN) + '?demo=' + encodeURIComponent(role);
            return;
        }
        email.value = row.dataset.email;
        pass.value = row.dataset.password;
        if (roleSel && roleSel.querySelector('option[value="' + role + '"]')) roleSel.value = role;
        row.classList.remove('demo-flash'); void row.offsetWidth; row.classList.add('demo-flash');
        pass.focus();
    }
    document.querySelectorAll('#demoCreds [data-demo-use]').forEach(function (btn) {
        btn.addEventListener('click', function () { fill(btn.closest('.demo-row')); });
    });
    // Arrived via ?demo=<role> from another page: prefill automatically.
    var want = new URLSearchParams(window.location.search).get('demo');
    if (want && !onSignup && email && pass) {
        var row = document.querySelector('#demoCreds .demo-row[data-role="' + want + '"]');
        if (row) fill(row);
    }
})();
</script>
{% endif %}
