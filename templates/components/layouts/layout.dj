{% load static tailwind_tags %}

<!DOCTYPE html>
<html lang="en" dir="ltr">

    <head>
        <meta charset='utf-8' />
        <meta http-equiv='X-UA-Compatible' content='IE=edge' />
        <title>

            {% block title %}
                Home
            {% endblock title %}

            | SwiftCourier
        </title>

        {% tailwind_css %}

        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="keywords"
              content="SwiftCourier, shipping, logistics, delivery, services" />
        <meta name="description" content="{% block description %}SwiftCourier dashboard — manage orders, shipments, and courier rates in one place.{% endblock description %}" />
        <meta name="robots" content="noindex, nofollow" />
        <link rel="icon"
              type="image/x-icon"
              href="{% static 'favicon/favicon.ico' %}" />

        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="stylesheet"
              href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.0/css/all.min.css"
              integrity="sha512-DxV+EoADOkOygM4IR9yXP8Sb2qwgidEmeqAEmDKIOfPRQZOWbXCzLC6vjbZyy0vPisbH2SyW27+ddLVCN+OMzQ=="
              crossorigin="anonymous"
              referrerpolicy="no-referrer" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400&family=Nunito:wght@400;500;600;700&display=swap"
              rel="stylesheet" />

        <link rel='stylesheet'
              type='text/css'
              media='screen'
              href="{% static 'assets/css/perfect-scrollbar.min.css' %}" />
        <link defer
              rel='stylesheet'
              type='text/css'
              media='screen'
              href="{% static 'assets/css/animate.css' %}" />
        {% comment %}
        The compiled Tailwind bundle (assets/css/styles.css) is already loaded once,
        cache-busted, by the tailwind_css tag above. A second plain link to the same
        file used to sit here; being unversioned, the browser kept serving a stale
        cached copy that overrode the fresh one - which is why CSS changes looked like
        they had no effect. Removed.
        {% endcomment %}

        <script src="{% static 'assets/js/perfect-scrollbar.min.js' %}"></script>
        <script defer src="{% static 'assets/js/popper.min.js' %}"></script>
        <style>
            /* Smoother default transitions site-wide, without touching every class. */
            a, button, input, select, textarea, .transition-colors {
                transition-property: color, background-color, border-color, box-shadow, transform, opacity;
                transition-duration: 200ms;
                transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
            }
            select {
                appearance: none;
                /* For most browsers */
                -webkit-appearance: none;
                /* Safari / Chrome */
                -moz-appearance: none;
                /* Firefox */
                background-image: none;
                /* Remove default arrow */
            }
        </style>

        {% block css %}
        {% endblock css %}

    </head>

    <body x-data="main"
          class="antialiased relative font-nunito text-sm font-normal overflow-x-hidden"
          :class="[ $store.app.sidebar ? 'toggle-sidebar' : '', $store.app.theme === 'dark' || $store.app.isDarkMode ?  'dark' : '', $store.app.menu, $store.app.layout,$store.app.rtlClass]">

        <!-- sidebar menu overlay -->
        <div x-cloak
             class="fixed inset-0 bg-[black]/60 z-50 lg:hidden"
             :class="{ 'hidden': !$store.app.sidebar }"
             @click="$store.app.toggleSidebar()"></div>


        <!-- screen loader: a single quiet brand mark, no spinning theatrics -->
        <div class="screen_loader fixed inset-0 z-60 grid place-content-center bg-[#f6f6f7] dark:bg-[#07090f]">
            <span class="flex h-11 w-11 animate-pulse items-center justify-center rounded-xl bg-black text-lg font-extrabold text-white dark:bg-white dark:text-black">S</span>
        </div>

        <!-- scrollToTop -->
        <div class="fixed bottom-6 ltr:right-6 rtl:left-6 z-50"
             x-data="scrollToTop">
            <template x-if="showTopButton">
                <button type="button"
                        class="btn btn-outline-primary rounded-full p-2 animate-pulse bg-[#fafafa] dark:bg-[#060818] dark:hover:bg-primary"
                        @click="goToTop">
                    <svg width="24"
                         height="24"
                         class="h-4 w-4"
                         viewBox="0 0 24 24"
                         fill="none"
                         xmlns="http://www.w3.org/2000/svg">
                        <path opacity="0.5" fill-rule="evenodd" clip-rule="evenodd" d="M12 20.75C12.4142 20.75 12.75 20.4142 12.75 20L12.75 10.75L11.25 10.75L11.25 20C11.25 20.4142 11.5858 20.75 12 20.75Z" fill="currentColor" />
                        <path d="M6.00002 10.75C5.69667 10.75 5.4232 10.5673 5.30711 10.287C5.19103 10.0068 5.25519 9.68417 5.46969 9.46967L11.4697 3.46967C11.6103 3.32902 11.8011 3.25 12 3.25C12.1989 3.25 12.3897 3.32902 12.5304 3.46967L18.5304 9.46967C18.7449 9.68417 18.809 10.0068 18.6929 10.287C18.5768 10.5673 18.3034 10.75 18 10.75L6.00002 10.75Z" fill="currentColor" />
                    </svg>
                </button>
            </template>
        </div>

        <script>
            document.addEventListener("alpine:init", () => {
                Alpine.data("scrollToTop", () => ({
                    showTopButton: false,
                    init() {
                        window.onscroll = () => {
                            this.scrollFunction();
                        };
                    },

                    scrollFunction() {
                        if (document.body.scrollTop > 50 || document.documentElement.scrollTop > 50) {
                            this.showTopButton = true;
                        } else {
                            this.showTopButton = false;
                        }
                    },

                    goToTop() {
                        document.body.scrollTop = 0;
                        document.documentElement.scrollTop = 0;
                    },
                }));
            });
        </script>

        {% include "components/common/user_panel_agreement_popup.dj" %}
        {% comment %} {% include "components/common/theme-customiser.dj" %} {% endcomment %}

        <div class="main-container text-black dark:text-white-dark min-h-screen bg-neutral-50 dark:bg-[#0a0d14]"
             :class="[$store.app.navbar]">

            {% if request.user.role == "user" %}

                {% include "user_panel/components/common/sidebar.dj" %}

            {% elif request.user.role == "admin" %}

                {% include "admin_panel/components/common/sidebar.dj" %}

            {% elif request.user.role == "super_admin" %}

                {% include "superadmin_panel/components/common/sidebar.dj" %}

            {% endif %}

            <div class="main-content flex flex-col min-h-screen">

                {% include "components/common/header.dj" %}

                <div class="p-4 sm:p-6 animate__animated" :class="[$store.app.animation]">

                    {% include "components/common/messages.dj" %}

                    {% block body %}
                    {% endblock body %}

                </div>

                {% include "components/common/footer.dj" %}

            </div>
        </div>

        <script src="{% static 'assets/js/alpine-collaspe.min.js' %}"></script>
        <script src="{% static 'assets/js/alpine-persist.min.js' %}"></script>
        <script src="https://cdn.jsdelivr.net/npm/luxon@3.4.4/build/global/luxon.min.js"></script>
        <script defer src="{% static 'assets/js/alpine.min.js' %}"></script>
        <script src="{% static 'assets/js/custom.js' %}"></script>
        <script defer src="{% static 'assets/js/alpine-ui.min.js' %}"></script>
        <script defer src="{% static 'assets/js/alpine-focus.min.js' %}"></script>

        {% block js %}
        {% endblock js %}

        <script src="{% static 'js/my_vertical_collapse.js' %}"></script>

    </body>

</html>
