{% extends 'components/layouts/auth_layout.dj' %}
{% load static %}

{% block body %}
  <div class="relative flex min-h-screen items-center justify-center overflow-hidden">
    <div class="px-6 py-16 text-center font-semibold before:container before:absolute before:left-1/2 before:-translate-x-1/2 before:rounded-full before:bg-[linear-gradient(180deg,#4361EE_0%,rgba(67,97,238,0)_50.73%)] before:aspect-square before:opacity-10 md:py-20">
      <div class="relative">
        <h1 class="mt-5 text-2xl font-bold dark:text-white">500 - Internal Server Error</h1>
        <p class="mt-3 text-base dark:text-white">Something went wrong on our end. Please try again later.</p>
        <a href="/" class="btn btn-gradient mx-auto mt-7! w-max border-0 uppercase shadow-none">Go Back Home</a>
      </div>
    </div>
  </div>
{% endblock %}
