{% extends "components/errors/base.dj" %}

{% block code %}500 — Server error{% endblock %}
{% block bigcode %}500{% endblock %}
{% block eyebrow %}Server error{% endblock %}
{% block heading %}Something broke on our side{% endblock %}
{% block message %}
  This one is on us, not you. The team has been notified. Please try again in a
  few minutes &mdash; your shipments and wallet are unaffected.
{% endblock %}
{% block actions %}
  <a class="btn btn--primary" href="/">Back to dashboard</a>
  <a class="btn btn--ghost" href="javascript:location.reload()">Try again</a>
{% endblock %}
{% block ref %}
  {% if request_id %}<p class="ref">Reference <code>{{ request_id }}</code></p>{% endif %}
{% endblock %}
