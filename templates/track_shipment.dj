<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>Track Shipment</title>

    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
  </head>

  <body class="bg-gray-100 dark:bg-[#0B1220] text-gray-800 dark:text-gray-200">
    <!-- ================= TRACK SHIPMENT ================= -->
    <section class="w-full">
      <!-- Header / Search -->
      <div class="w-full bg-linear-to-br from-red-100 to-red-50 dark:from-[#0F172A] dark:to-[#020617] px-4 py-12 md:px-12 lg:px-24">
        <div class="text-center">
          <h1 class="text-3xl md:text-5xl font-bold text-gray-900 dark:text-white">Track Shipment</h1>
          <p class="mt-3 font-medium text-gray-600 dark:text-gray-400">Get real-time delivery updates instantly</p>
        </div>

        <form action="{% url 'track-shipment' %}" method="get" class="mt-10">
          <div class="relative mx-auto max-w-3xl">
            <input type="text" name="awb_number" id="awb_number_input" value="{{ request.GET.awb_number }}" required placeholder="Enter your AWB Number" class="w-full rounded-lg border border-gray-300 dark:border-[#1E293B] bg-white dark:bg-[#020617] py-4 pl-5 pr-[120px] text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-gray-500 focus:outline-hidden focus:ring-2 focus:ring-red-500 dark:focus:ring-red-400" />

            <button type="submit" class="absolute right-1 top-1 h-[52px] rounded-lg px-8 bg-red-600 hover:bg-red-700 dark:bg-red-500 dark:hover:bg-red-600 text-white font-semibold transition">Track</button>
          </div>
        </form>
      </div>

      {% if request.GET.awb_number %}
        {% if valid_order %}
            <div class="flex justify-center">
                <div class="relative border-l border-gray-300 dark:border-gray-700 ml-4 m-5">
                    {% for item in past_timeline %}
                    <div class="mb-8 ml-6">
                        <span class="absolute -left-2.5 flex h-5 w-5 items-center justify-center rounded-full bg-green-600 ring-4 ring-white dark:ring-gray-900"></span>
                        <h4 class="font-semibold text-gray-800 dark:text-white">
                            {{ item.0 }}
                        </h4>
                        <p class="text-sm text-gray-500 dark:text-gray-400">
                          {% if item.1 %}
                            {{ item.1 }}
                          {% endif %}
                        </p>
                    </div>
                    {% endfor %}

                    {% for item in current_timeline %}
                    <div class="mb-8 ml-6">
                        <span class="absolute -left-2.5 flex h-5 w-5 items-center justify-center rounded-full bg-red-600 ring-4 ring-white dark:ring-gray-900 animate-pulse"></span>
                        <h4 class="font-semibold text-gray-800 dark:text-white">
                            {{ item.0 }}
                        </h4>
                        <p class="text-sm text-gray-500 dark:text-gray-400">
                            {% if item.1 %}
                              {{ item.1 }}
                            {% endif %}
                        </p>
                    </div>
                    {% endfor %}

                    {% for item in future_timeline %}
                    <div class="mb-8 ml-6">
                        <span class="absolute -left-2.5 flex h-5 w-5 items-center justify-center rounded-full bg-gray-400 dark:bg-gray-600 ring-4 ring-white dark:ring-gray-900"></span>
                        <h4 class="font-semibold text-gray-400 dark:text-gray-500">
                            {{ item.0 }}
                        </h4>
                        <p class="text-sm text-gray-400 dark:text-gray-500">
                            {% if item.1 %}
                              {{ item.1 }}
                            {% endif %}
                        </p>
                    </div>
                    {% endfor %}
                </div>
            </div>
        {% else %}
            <section class="w-full min-h-[70vh] flex items-center justify-center bg-gray-100 dark:bg-[#020617] p-4">
                <div class="max-w-xl w-full text-center">
                    <!-- Icon -->
                    <div class="mx-auto mb-6 flex h-20 w-20 items-center justify-center rounded-full
                                bg-red-100 dark:bg-red-500/10">
                        <svg
                            class="h-10 w-10 text-red-600 dark:text-red-400"
                            viewBox="0 0 16 16"
                            fill="none"
                            xmlns="http://www.w3.org/2000/svg">
                            <path d="M7.493 0.015 C 7.442 0.021,7.268 0.039,7.107 0.055 C 5.234 0.242,3.347 1.208,2.071 2.634 C 0.660 4.211,-0.057 6.168,0.009 8.253 C 0.124 11.854,2.599 14.903,6.110 15.771 C 8.169 16.280,10.433 15.917,12.227 14.791 C 14.017 13.666,15.270 11.933,15.771 9.887 C 15.943 9.186,15.983 8.829,15.983 8.000 C 15.983 7.171,15.943 6.814,15.771 6.113 C 14.979 2.878,12.315 0.498,9.000 0.064 C 8.716 0.027,7.683 -0.006,7.493 0.015 M8.853 1.563 C 9.548 1.653,10.198 1.848,10.840 2.160 C 11.538 2.500,12.020 2.846,12.587 3.413 C 13.154 3.980,13.500 4.462,13.840 5.160 C 14.285 6.075,14.486 6.958,14.486 8.000 C 14.486 9.054,14.284 9.932,13.826 10.867 C 13.654 11.218,13.307 11.781,13.145 11.972 L 13.090 12.037 8.527 7.473 L 3.963 2.910 4.028 2.855 C 4.219 2.693,4.782 2.346,5.133 2.174 C 6.305 1.600,7.555 1.395,8.853 1.563 M7.480 8.534 L 12.040 13.095 11.973 13.148 C 11.734 13.338,11.207 13.662,10.867 13.828 C 10.239 14.135,9.591 14.336,8.880 14.444 C 8.456 14.509,7.544 14.509,7.120 14.444 C 5.172 14.148,3.528 13.085,2.493 11.451 C 2.279 11.114,1.999 10.526,1.859 10.119 C 1.468 8.989,1.403 7.738,1.670 6.535 C 1.849 5.734,2.268 4.820,2.766 4.147 C 2.836 4.052,2.899 3.974,2.907 3.974 C 2.914 3.974,4.972 6.026,7.480 8.534 " stroke="none" fill-rule="evenodd" fill="#000000">
                            </path>
                        </svg>
                    </div>

                    <!-- Heading -->
                    <h2 class="text-2xl font-bold text-gray-900 dark:text-white">
                        Order Not Found
                    </h2>

                    <!-- Message -->
                    <p class="mt-3 text-sm text-gray-600 dark:text-gray-400">
                        We couldn't find any shipment matching
                        <span class="font-semibold text-gray-900 dark:text-white">
                            {{ request.GET.awb_number }}
                        </span>.
                        Please double-check your tracking ID or try again.
                    </p>

                    <!-- Actions -->
                    <div class="mt-8 flex flex-col sm:flex-row gap-4 justify-center">

                        <button onclick="document.getElementById('awb_number_input').scrollIntoView({behavior:'smooth'}); document.getElementById('awb_number_input').focus();"
                            class="inline-flex items-center justify-center rounded-lg
                                bg-red-600 px-6 py-2.5 text-sm font-semibold text-white
                                hover:bg-red-700 transition">
                            Track Another Order
                        </button>

                        <a href="mailto:support@idiotship.tech"
                        class="inline-flex items-center justify-center rounded-lg
                                border border-gray-300 dark:border-gray-700
                                px-6 py-2.5 text-sm font-semibold
                                text-gray-700 dark:text-gray-300
                                hover:bg-gray-200 dark:hover:bg-gray-800 transition">
                            Contact Support
                        </a>

                    </div>

                    <!-- Help text -->
                    <p class="mt-6 text-xs text-gray-500 dark:text-gray-500">
                        Still facing issues? Our support team is here to help you.
                    </p>

                </div>
            </section>
        {% endif %}
      {% endif %}

      <!-- Features -->
      <div class="w-full bg-red-50 dark:bg-[#020617] px-4 py-10 md:px-12 lg:px-24">
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          <div class="rounded-xl bg-white dark:bg-[#0F172A] border border-gray-200 dark:border-[#1E293B] p-6 text-center shadow-xs">
            <h3 class="font-semibold text-lg text-gray-900 dark:text-white">Live Tracking</h3>
            <p class="mt-2 text-sm text-gray-600 dark:text-gray-400">Track your shipments in real-time with accurate updates.</p>
          </div>

          <div class="rounded-xl bg-white dark:bg-[#0F172A] border border-gray-200 dark:border-[#1E293B] p-6 text-center shadow-xs">
            <h3 class="font-semibold text-lg text-gray-900 dark:text-white">Order Management</h3>
            <p class="mt-2 text-sm text-gray-600 dark:text-gray-400">Manage and monitor all your orders from one dashboard.</p>
          </div>

          <div class="rounded-xl bg-white dark:bg-[#0F172A] border border-gray-200 dark:border-[#1E293B] p-6 text-center shadow-xs">
            <h3 class="font-semibold text-lg text-gray-900 dark:text-white">Secure Delivery</h3>
            <p class="mt-2 text-sm text-gray-600 dark:text-gray-400">End-to-end secure delivery with trusted partners.</p>
          </div>

          <div class="rounded-xl bg-white dark:bg-[#0F172A] border border-gray-200 dark:border-[#1E293B] p-6 text-center shadow-xs">
            <h3 class="font-semibold text-lg text-gray-900 dark:text-white">Easy Returns</h3>
            <p class="mt-2 text-sm text-gray-600 dark:text-gray-400">Hassle-free reverse logistics and quick returns.</p>
          </div>
        </div>
      </div>

      <!-- FAQ -->
      <div class="w-full bg-white dark:bg-[#020617] px-4 py-12 md:px-12 lg:px-24">
        <h2 class="text-2xl font-bold text-center text-gray-900 dark:text-white">Frequently Asked Questions</h2>

        <div class="mt-8 max-w-4xl mx-auto space-y-4">
          <details class="rounded-lg border border-gray-200 dark:border-[#1E293B] bg-gray-50 dark:bg-[#0F172A] p-4">
            <summary class="cursor-pointer font-medium text-gray-900 dark:text-white">Where can I find my AWB number?</summary>
            <p class="mt-2 text-sm text-gray-600 dark:text-gray-400">Your AWB number is shared via SMS, email, or order details page.</p>
          </details>

          <details class="rounded-lg border border-gray-200 dark:border-[#1E293B] bg-gray-50 dark:bg-[#0F172A] p-4">
            <summary class="cursor-pointer font-medium text-gray-900 dark:text-white">How often is tracking updated?</summary>
            <p class="mt-2 text-sm text-gray-600 dark:text-gray-400">Tracking updates occur in real-time as the shipment progresses.</p>
          </details>

          <details class="rounded-lg border border-gray-200 dark:border-[#1E293B] bg-gray-50 dark:bg-[#0F172A] p-4">
            <summary class="cursor-pointer font-medium text-gray-900 dark:text-white">What if my shipment is delayed?</summary>
            <p class="mt-2 text-sm text-gray-600 dark:text-gray-400">Delays may occur due to operational or weather issues.</p>
          </details>
        </div>
      </div>

      <!-- Still Need Help -->
      <div class="w-full bg-red-100 dark:bg-[#0F172A] px-4 py-12 md:px-12 lg:px-24 text-center">
        <h2 class="text-2xl font-bold text-gray-900 dark:text-white">Still need help?</h2>
        <p class="mt-3 text-gray-600 dark:text-gray-400">Our support team is here to help you with shipment queries.</p>

        <a href="mailto:support@idiotship.tech" class="inline-block mt-6 rounded-lg px-8 py-3 bg-red-600 hover:bg-red-700 dark:bg-red-500 dark:hover:bg-red-600 text-white font-semibold transition">Contact Support</a>
      </div>
    </section>
    <!-- ================= END ================= -->
  </body>
</html>
