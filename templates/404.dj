{% extends "components/errors/base.dj" %}

{% block code %}404 — Page not found{% endblock %}
{% block bigcode %}404{% endblock %}
{% block eyebrow %}Page not found{% endblock %}
{% block heading %}This page has shipped elsewhere{% endblock %}
{% block message %}
  The link may be broken, or the page may have been moved. Check the address, or
  head back to your dashboard.
{% endblock %}
{% block actions %}
  <a class="btn btn--primary" href="/">Back to dashboard</a>
  <a class="btn btn--ghost" href="/track-shipment/">Track a shipment</a>
{% endblock %}
